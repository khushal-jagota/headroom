     "type": "object"
    },
    {
     "properties": {
      "appBrand": {
       "anyOf": [
        {
         "$ref": "#/definitions/LoginAppBrand"
        },
        {
         "type": "null"
        }
       ],
       "default": null
      },
      "codexStreamlinedLogin": {
       "type": "boolean"
