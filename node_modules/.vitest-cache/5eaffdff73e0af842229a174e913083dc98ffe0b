'../../local_child_contracts.ts';\nimport type {\n  LocalChildCustodyRow,\n  RecordedSourceSettlement,\n} from '../../local_child_custody_contracts.ts';\nimport type { WorkspaceIdentity } from '../../../ticket_workspaces/contracts.ts';\nimport type { TurnToken } from '../../backends/contracts.ts';\nimport { BackendSpawnFailed } from '../../backends/contracts.ts';\nimport { AUTOMATIC_COMPACTION_MINIMUM_INPUT_TOKENS } from '../../runtime/configuration.ts';\nimport { read_unresolved_turns } from '../../deploy_interruptions/capture.ts';\nimport * as custody from './child_custody.ts';\nimport { SUPERVISED_CHILD_GENERATION_PREFIX } from '../../child_custody.ts';\nimport * as supervision_records from '../../../worker_supervision/records.ts';\nimport {\n  release_worker_step_claim,\n  read_ticket,\n  automated_maintenance_suppression_reason,\n} from '../../../tickets/data/index.ts';\nimport {\n  conversation_holds_an_unanswered_memory_loss,\n  new_memory_notice_message_id,\n  ticket_needs_memory_notice,\n} from '../../../runtime/worker_memory.ts';\nimport { worker_step_memory_loss_prompt } from '../../../runtime/logic/worker_step_prompt.ts';\n/** Durable record primitives. Event append is completed with its projection in PR2. */\nimport { randomUUID } from 'node:crypto';\nimport { capture_savepoint_rollback } from '../../../core/database/index.ts';\nimport type {\n  Database,\n  ReadSql,\n  SqlValue,\n  TransactionSql,\n  WriteOptions,\n} from '../../../core/database/contracts.ts';\nimport {\n  ComposerCatalogEntry,\n  ConversationAlreadyStarted,\n  PromptDeliveryStarted,\n  PromptDispatchDecision,\n} from '../../contracts.ts';\nimport type {\n  ResolvedConversationStart,\n  NativeMessageOperation,\n  NativeMessageAdmission,\n  DeploymentRecoveryReference,\n} from '../../contracts.ts';\nimport {\n  conversation_event_payload_from_canonical_json,\n  conversation_event_payload_to_canonical_json,\n} from '../codec.ts';\nimport { ConversationRecord, ConversationRecordMissing } from '../contracts.ts';\nimport type {\n  ConversationRecordValues,\n  SessionUpdate,\n  StoredConversationEvent,\n  ConversationStoreOptions,\n  AppendOptions,\n  EventMutation,\n  EventTransactionResult,\n  PreparedAttention,\n  DeliveredPromptOptions,\n  OpenRunTurn,\n  ConversationRecordStore,\n  AcceptedRecordEvent,\n  RecordCommitParticipant,\n  ConversationAttentionFacts,\n  WorkerStepMemoryNote,\n} from '../contracts.ts';\nimport {\n  LIFECYCLE_CONTRACT_VERSION,\n  LifecycleKind as K,\n  LifecycleOperation as O,\n  LifecycleStatus as S,\n} from '../lifecycle.ts';\nimport type { ConversationTransactionParticipant, LifecycleFact } from '../lifecycle.ts';\nimport { apply_facts, participate, read_facts } from './lifecycle.ts';\nimport { RecordSettlement } from '../settlement.ts';\nimport type { RecordingSettlementOptions } from '../settlement.ts';\nimport { facts_after_restart } from '../../logic/retained_turn.ts';\nimport { append_projection } from '../../views/data/writer.ts';\nimport {\n  conversation_event_kinds_need_the_change_signal,\n  PromptDiscardedEventPayload,\n} from '../../events.ts';\nimport type { ConversationEventPayload } from '../../events.ts';\n\ninterface ConversationRow extends Omit<\n  ConversationRecordValues,\n  'identity_environment_variables' | 'composer_catalog'\n> {\n  identity_environment_variables: string;\n  composer_catalog: string;\n}\ninterface EventRow extends Omit<StoredConversationEvent, 'payload'> {\n  payload: string;\n}\nconst EVENT_COLUMNS = 'conversation_id,sequence,kind,payload,created_at';\nfunction record(row: ConversationRow): ConversationRecord {\n  return new ConversationRecord({\n    ...row,\n    identity_environment_variables: JSON.parse(row.identity_environment_variables) as [\n      string,\n      string,\n    ][],\n    composer_catalog: (\n      JSON.parse(row.composer_catalog) as ConstructorParameters<typeof ComposerCatalogEntry>[0][]\n    ).map((entry) => new ComposerCatalogEntry(entry)),\n  });\n}\nfunction stored_event(row: EventRow): StoredConversationEvent {\n  return { ...row, payload: conversation_event_payload_from_canonical_json(row.kind, row.payload) };\n}\nfunction record_from_start(\n  start: ResolvedConversationStart,\n  created_at: number,\n): ConversationRecord {\n  return new ConversationRecord({\n    conversation_id: start.conversation_id,\n    backend_key: start.backend_key,\n    model: start.model,\n    reasoning_effort: start.reasoning_effort,\n    workspace_folder: start.workspace_folder,\n    workspace_path_policy: start.workspace_path_policy,\n    role_text: start.role_materials?.role_text ?? null,\n    identity_environment_variables: start.role_materials?.identity_environment_variables ?? [],\n    access: start.access,\n    vendor_session_cursor: null,\n    composer_catalog: [],\n    latest_sequence: 0,\n    latest_agent_activity_at: null,\n    latest_agent_activity_sequence: 0,\n    automatically_compacted_through_sequence: 0,\n    working_turn_compacted_through_sequence: 0,\n    automatic_compaction_attempted_through_sequence: 0,\n    owner_read_through_sequence: 0,\n    created_at,\n  });\n}\nfunction composer_catalog_to_json(entries: readonly ComposerCatalogEntry[]): string {\n  return JSON.stringify(\n    entries.map((entry) => ({\n      kind: entry.kind,\n      display_text: entry.display_text,\n      insertion_text: entry.insertion_text,\n      description: entry.description,\n      argument_hint: entry.argument_hint,\n    })),\n  );\n}\n\nfunction worker_step_ticket(\n  sql: ReadSql,\n  conversation_id: string,\n  sender_message_id: string | null,\n): string | null {\n  return (\n    sql.get<{ id: string }>(\n      'SELECT t.id FROM worker_step_dispatch_intents d JOIN tickets t ON t.id=d.ticket_id ' +\n        'WHERE d.sender_message_id=? AND t.conversation_id=?',\n      [sender_message_id, conversation_id],\n    )?.id ?? null\n  );\n}\n\n/** Common record reads and reservation primitives shared by the complete store. */\nexport class ConversationStorePrimitives {\n  readonly blocked_local_conversations = new Set<string>();\n  protected readonly database: Database;\n  protected readonly integer_now: () => number;\n  protected readonly transaction_participant: ConversationTransactionParticipant | null;\n  constructor(\n    database: Database,\n    options: {\n      integer_now?: () => number;\n      transaction_participant?: ConversationTransactionParticipant | null;\n    } = {},\n  ) {\n    this.database = database;\n    this.integer_now = options.integer_now ?? (() => Math.floor(Date.now() / 1000));\n    this.transaction_participant = options.transaction_participant ?? null;\n  }\n  create_conversation(start: ResolvedConversationStart): ConversationRecord {\n    const value = record_from_start(start, this.integer_now());\n    try {\n      this.database.write((tx) => {\n        tx.run(\n          'INSERT INTO conversations (conversation_id,backend_key,model,reasoning_effort,workspace_folder,' +\n            'workspace_path_policy,role_text,identity_environment_variables,access,vendor_session_cursor,' +\n            'composer_catalog,latest_sequence,latest_agent_activity_at,latest_agent_activity_sequence,' +\n            'automatically_compacted_through_sequence,automatic_compaction_attempted_through_sequence,' +\n            'owner_read_through_sequence,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)',\n          [\n            value.conversation_id,\n            value.backend_key,\n            value.model,\n            value.reasoning_effort,\n            value.workspace_folder,\n            value.workspace_path_policy,\n            value.role_text,\n            identity_environment_json(value.identity_environment_variables),\n            value.access,\n            value.vendor_session_cursor,\n            composer_catalog_to_json(value.composer_catalog),\n            value.latest_sequence,\n            value.latest_agent_activity_at,\n            value.latest_agent_activity_sequence,\n            value.automatically_compacted_through_sequence,\n            value.automatic_compaction_attempted_through_sequence,\n            value.owner_read_through_sequence,\n            value.created_at,\n          ],\n        );\n        custody.write_never_started(tx, value.conversation_id);\n      });\n    } catch (error) {\n      if (\n        error !== null &&\n        typeof error === 'object' &&\n        'code' in error &&\n        typeof error.code === 'string' &&\n        error.code.startsWith('SQLITE_CONSTRAINT')\n      ) {\n        throw new ConversationAlreadyStarted(value.conversation_id, { cause: error });\n      }\n      throw error;\n    }\n    return value;\n  }\n  read_conversation(conversation_id: string): ConversationRecord | null {\n    return this.database.read((sql) => {\n      const row = sql.get<ConversationRow>('SELECT * FROM conversations WHERE conversation_id=?', [\n        conversation_id,\n      ]);\n      return row === undefined ? null : record(row);\n    });\n  }\n  read_conversation_records(conversation_ids: readonly string[]): readonly ConversationRecord[] {\n    const ids = [...new Set(conversation_ids)];\n    if (!ids.length) {\n      return [];\n    }\n    return this.database.read((sql) =>\n      sql\n        .all<ConversationRow>(\n          `SELECT * FROM conversations WHERE conversation_id IN (${ids.map(() => '?').join(',')}) ORDER BY conversation_id`,\n          ids,\n        )\n        .map(record),\n    );\n  }\n  get start_admission_database(): AdmissionDatabase {\n    return this.database;\n  }\n  automatic_start_request(identity: string, conversation_id: string): StartRequest {\n    return this.database.read((sql) => {\n      const row = sql.get<{ machine_id: string }>(\n        'SELECT machine_id FROM tickets WHERE conversation_id=?',\n        [conversation_id],\n      );\n      return {\n        identity,\n        work_class: row ? 'worker' : 'supervisor',\n        destination: row?.machine_id ?? HOME_MACHINE_ID,\n      };\n    });\n  }\n  reserve_turn(conversation_id: string, requests: readonly StartRequest[] = []): number {\n    return this.database.write(\n      (tx) => {\n        const facts = tx.get<{ maximum: number }>(\n          'SELECT COALESCE(MAX(turn_number),0) AS maximum ' +\n            'FROM conversation_lifecycle_facts WHERE conversation_id=?',\n          [conversation_id],\n        )!;\n        const occurrence = tx.get<{ maximum: number }>(\n          'SELECT COALESCE(MAX(turn_number),0) AS maximum ' +\n            'FROM conversation_turn_occurrences WHERE conversation_id=?',\n          [conversation_id],\n        )!;\n        const number = Math.max(facts.maximum, occurrence.maximum) + 1;\n        const epoch = tx.get<{ epoch: string }>(\n          'SELECT epoch FROM conversation_runtime_epoch WHERE singleton=1',\n        );\n        if (epoch === undefined) {\n          throw new Error('conversation runtime epoch is absent');\n        }\n        tx.run('INSERT INTO conversation_turn_occurrences VALUES (?,?,?,?)', [\n          conversation_id,\n          number,\n          randomUUID().replaceAll('-', ''),\n          epoch.epoch,\n        ]);\n        if (!this.blocked_local_conversations.has(conversation_id))\n          custody.bind_current_turn(tx, conversation_id);\n        write_bindings(tx, { conversation_id, turn_number: number }, requests);\n        apply_facts(tx, conversation_id, [\n          {\n            kind: K.turn,\n            identity: String(number),\n            turn_number: number,\n            operation: O.turn,\n            status: S.intent,\n            provider_identity: null,\n          },\n          {\n            kind: K.attempt,\n            identity: `prompt:${number}`,\n            turn_number: number,\n            operation: O.prompt,\n            status: S.intent,\n            provider_identity: null,\n          },\n        ]);\n        participate(tx, this.transaction_participant, {\n          conversation_id,\n          facts: read_facts(tx, conversation_id),\n          receipt_sequences: [],\n          contract_version: LIFECYCLE_CONTRACT_VERSION,\n        });\n        return number;\n      },\n      { changeSignal: 'silent' },\n    );\n  }\n  lifecycle_facts(conversation_id: string): readonly LifecycleFact[] {\n    return this.database.read((sql) => read_facts(sql, conversation_id));\n  }\n  read_events_after(\n    conversation_id: string,\n    after_sequence: number,\n  ): readonly StoredConversationEvent[] {\n    return this.database.read((sql) =>\n      sql\n        .all<EventRow>(\n          `SELECT ${EVENT_COLUMNS} FROM conversation_events ` +\n            'WHERE conversation_id=? AND sequence>? ORDER BY sequence',\n          [conversation_id, after_sequence],\n        )\n        .map(stored_event),\n    );\n  }\n  read_latest_events(\n    conversation_id: string,\n    options: { before_sequence: number | null; limit: number },\n  ): readonly StoredConversationEvent[] {\n    const parameters: SqlValue[] = [conversation_id];\n    const before = options.before_sequence === null ? '' : ' AND sequence<?';\n    if (options.before_sequence !== null) {\n      parameters.push(options.before_sequence);\n    }\n    parameters.push(options.limit);\n    return this.database.read((sql) =>\n      sql\n        .all<EventRow>(\n          `SELECT * FROM (SELECT ${EVENT_COLUMNS} FROM conversation_events ` +\n            `WHERE conversation_id=?${before} ORDER BY sequence DESC LIMIT ?) ORDER BY sequence`,\n          parameters,\n        )\n        .map(stored_event),\n    );\n  }\n  read_event(conversation_id: string, sequence: number): StoredConversationEvent | null {\n    return this.database.read((sql) => {\n      const row = sql.get<EventRow>(\n        `SELECT ${EVENT_COLUMNS} FROM conversation_events WHERE conversation_id=? AND sequence=?`,\n        [conversation_id, sequence],\n      );\n      return row === undefined ? null : stored_event(row);\n    });\n  }\n  /** An accepted non-steer prompt starts the current turn; a steer continues it. */\n  current_turn_start_sequence(conversation_id: string): number | null {\n    return this.database.read(\n      (sql) =>\n        sql.get<{ sequence: number }>(\n          \"SELECT sequence FROM conversation_events WHERE conversation_id=? AND kind='prompt' \" +\n            \"AND json_extract(payload,'$.mode')<>'steer' ORDER BY sequence DESC LIMIT 1\",\n          [conversation_id],\n        )?.sequence ?? null,\n    );\n  }\n  sender_message_outcome(\n    conversation_id: string,\n    sender_message_id: string,\n  ): StoredConversationEvent | null {\n    return this.database.read((sql) => {\n      const row = sql.get<EventRow>(\n        `SELECT ${EVENT_COLUMNS} FROM conversation_events ` +\n          \"WHERE conversation_id=? AND json_extract(payload,'$.sender_message_id')=? \" +\n          \"AND kind IN ('prompt','prompt_delivery_refused','prompt_delivery_uncertain','prompt_discarded','message_to_owner') \" +\n          'ORDER BY sequence DESC LIMIT 1',\n        [conversation_id, sender_message_id],\n      );\n      return row === undefined ? null : stored_event(row);\n    });\n  }\n  latest_turn_ended_sequences(conversation_ids: readonly string[]): ReadonlyMap<string, number> {\n    const ids = [...new Set(conversation_ids)];\n    if (!ids.length) {\n      return new Map();\n    }\n    return this.database.read(\n      (sql) =>\n        new Map(\n          sql\n            .all<{ conversation_id: string; latest: number }>(\n              'SELECT conversation_id,MAX(sequence) AS latest FROM conversation_events ' +\n                `WHERE kind='turn_ended' AND conversation_id IN (${ids.map(() => '?').join(',')}) GROUP BY conversation_id ORDER BY conversation_id`,\n              ids,\n            )\n            .map((row) => [row.conversation_id, row.latest]),\n        ),\n    );\n  }\n  owner_read_through_sequences(conversation_ids: readonly string[]): ReadonlyMap<string, number> {\n    const ids = [...new Set(conversation_ids)];\n    if (!ids.length) {\n      return new Map();\n    }\n    return this.database.read(\n      (sql) =>\n        new Map(\n          sql\n            .all<{ conversation_id: string; owner_read_through_sequence: number }>(\n              'SELECT conversation_id,owner_read_through_sequence FROM conversations ' +\n                `WHERE conversation_id IN (${ids.map(() => '?').join(',')}) ORDER BY conversation_id`,\n              ids,\n            )\n            .map((row) => [row.conversation_id, row.owner_read_through_sequence]),\n        ),\n    );\n  }\n  has_delivered_prompt(conversation_id: string): boolean {\n    return this.database.read(\n      (sql) =>\n        sql.get(\n          \"SELECT 1 FROM conversation_events WHERE conversation_id=? AND kind='prompt' LIMIT 1\",\n          [conversation_id],\n        ) !== undefined,\n    );\n  }\n  update_session_in_transaction(\n    tx: TransactionSql,\n    conversation_id: string,\n    update: SessionUpdate,\n  ): void {\n    if (update.vendor_session_cursor != null) {\n      tx.run('UPDATE conversations SET vendor_session_cursor=? WHERE conversation_id=?', [\n        update.vendor_session_cursor,\n        conversation_id,\n      ]);\n    }\n    if (update.composer_catalog != null) {\n      tx.run('UPDATE conversations SET composer_catalog=? WHERE conversation_id=?', [\n        composer_catalog_to_json(update.composer_catalog),\n        conversation_id,\n      ]);\n    }\n  }\n}\n\ninterface WriteResult<T> {\n  readonly value: T;\n  readonly payloads: readonly ConversationEventPayload[];\n  readonly always_announce?: boolean;\n}\ninterface InsertOptions {\n  readonly lifecycle?: readonly LifecycleFact[];\n  readonly recording_receipt?: NativeMessageOperation | null;\n  readonly extra_recording_receipts?: readonly NativeMessageOperation[];\n  readonly native_message_admission?: NativeMessageAdmission | null;\n}\nfunction synchronously<T>(operation: () => T): T {\n  const result = operation();\n  if (\n    result !== null &&\n    (typeof result === 'object' || typeof result === 'function') &&\n    typeof (result as { then?: unknown }).then === 'function'\n  ) {\n    if (result instanceof Promise) {\n      void result.catch(() => {});\n    }\n    throw new TypeError('conversation transaction participants must be synchronous');\n  }\n  return result;\n}\n\n/** The record owns every append. The core publishes returned rows after this call commits.\n * Each synchronous method attempts one transaction. The async core uses settle_recording\n * around complete writes for Python's contention and retained-save retry behavior.\n */\nexport class ConversationStore\n  extends ConversationStorePrimitives\n  implements ConversationRecordStore\n{\n  readonly #participants: ConversationStoreOptions;\n  readonly #settlement = new RecordSettlement();\n\n  constructor(database: Database, options: ConversationStoreOptions = {}) {\n    super(database, options);\n    this.#participants = options;\n  }\n\n  settle_recording<T>(\n    conversation_id: string,\n    operation: () => T | Promise<T>,\n    options: RecordingSettlementOptions = {},\n  ): Promise<T> {\n    return this.#settlement.settle_recording(conversation_id, operation, options);\n  }\n\n  finish_writes(): Promise<void> {\n    return this.#settlement.finish_writes();\n  }\n\n  get database_unusable_error(): unknown {\n    return this.#settlement.database_unusable_error;\n  }\n\n  readonly #startup_source_proofs = new Map<\n    string,\n    { row: LocalChildCustodyRow; ticket_worker: boolean }\n  >();\n  readonly #settled_recorded_turns = new Map<string, TurnToken>();\n  #reconciliation_prepared = false;\n\n  async record_child_custody(\n    conversation_id: string,\n    generation: string,\n    identity: LocalChildIdentity | null = null,\n    options: { retired?: boolean } = {},\n  ): Promise<void> {\n    return this.#settlement.retain_recording(\n      (async () => {\n        const current =\n          !options.retired && identity === null\n            ? await this.#participants.local_child_custody?.host_boot_identity()\n            : null;\n        if (!options.retired && identity === null && (!current?.host || !current.boot))\n          throw new BackendSpawnFailed(\n            'Cannot establish the host and boot identity before agent startup',\n          );\n        await this.#settlement.write_recording(() =>\n          this.#write_custody((tx) => {\n            if (options.retired) custody.write_retired(tx, conversation_id, generation);\n            else if (identity === null)\n              custody.write_pending(tx, conversation_id, generation, current!);\n            else {\n              custody.write_started(tx, conversation_id, generation, identity);\n              const recorded = custody.read(tx, conversation_id);\n              if (\n                recorded === undefined ||\n                recorded.generation !== generation ||\n                recorded.state !== 'started' ||\n                recorded.pid !== identity.pid ||\n                recorded.birth !== identity.birth ||\n                recorded.boot !== identity.boot ||\n                recorded.unit !== identity.unit ||\n                recorded.supervision_record !== identity.supervision_record\n              )\n                throw new BackendSpawnFailed('The agent process identity could not be saved');\n            }\n          }),\n        );\n      })(),\n    );\n  }\n  async record_child_supervision(\n    conversation_id: string,\n    generation: string,\n    path: string,\n  ): Promise<void> {\n    return this.#settlement.retain_recording(\n      (async () => {\n        const record = await supervision_records.read(path);\n        if (record.conversation_id !== conversation_id)\n          throw new Error('Worker supervision record does not own this conversation');\n        await this.#settlement.write_recording(() =>\n          this.#write_custody((tx) =>\n            custody.write_supervision(tx, conversation_id, generation, path),\n          ),\n        );\n      })(),\n    );\n  }\n  local_child_supervision_record(conversation_id: string, generation: string): string | null {\n    return this.database.read((sql) => {\n      const row = custody.read(sql, conversation_id);\n      return row?.generation === generation ? row.supervision_record : null;\n    });\n  }\n  async has_recorded_source(conversation_id: string): Promise<boolean> {\n    return this.database.read((sql) => custody.read(sql, conversation_id) !== undefined);\n  }\n  async recorded_source_retirement_proven(conversation_id: string): Promise<boolean> {\n    return this.database.read((sql) => {\n      const row = custody.read(sql, conversation_id);\n      const proof = this.#startup_source_proofs.get(conversation_id);\n      return (\n        row !== undefined &&\n        (row.state === 'retired' ||\n          (proof !== undefined &&\n            custody.same(row, proof.row) &&\n            custody.is_ticket_conversation(sql, conversation_id) === proof.ticket_worker))\n      );\n    });\n  }\n  async check_local_child_started(\n    conversation_id: string,\n    generation: string,\n    turn_number: number,\n  ): Promise<boolean> {\n    return this.database.read(\n      (sql) =>\n        sql.get(\n          \"SELECT 1 FROM conversation_child_custody c JOIN conversation_turn_occurrences o ON o.conversation_id=c.conversation_id AND o.occurrence_id=c.occurrence_id AND o.runtime_epoch=c.runtime_epoch WHERE c.conversation_id=? AND c.generation=? AND c.state='started' AND c.host IS NOT NULL AND c.host!='' AND c.pid>0 AND c.birth IS NOT NULL AND c.birth!='' AND c.boot IS NOT NULL AND c.boot!='' AND o.turn_number=?\",\n          [conversation_id, generation, turn_number],\n        ) !== undefined,\n    );\n  }\n  async recorded_source_block_reason(conversation_id: string): Promise<string> {\n    // A marked pending row without a record never spawned, so no reboot is needed for it.\n    const needs_reboot = this.database.read((sql) => {\n      const row = custody.read(sql, conversation_id);\n      return (\n        row?.state === 'launch_pending' &&\n        row.supervision_record === null &&\n        !row.generation.startsWith(SUPERVISED_CHILD_GENERATION_PREFIX)\n      );\n    });\n    return needs_reboot\n      ? \"The home stopped before it saved the agent's process identity. Your conversation is safe: a second agent cannot start. Reboot this same host, reopen Headroom, select Stop, then send your message again. A restart of Headroom alone does not clear this block.\"\n      : 'The home stopped during agent startup. A second agent cannot start. Select Stop to end the previous agent before another can start. If Stop fails, the previous process still needs cleanup.';\n  }\n  settled_recorded_turn(conversation_id: string): TurnToken | null {\n    return this.#settled_recorded_turns.get(conversation_id) ?? null;\n  }\n  async workspace_conversation_ids(\n    ticket_id: string,\n    identity: WorkspaceIdentity,\n  ): Promise<readonly string[]> {\n    return this.database.read((sql) =>\n      sql\n        .all<{ conversation_id: string }>(\n          'SELECT conversation_id FROM ticket_workspace_conversations WHERE ticket_id=? AND machine_id=? AND workspace_id=?',\n          [ticket_id, identity.machine_id, identity.workspace_id],\n        )\n        .map((row) => row.conversation_id),\n    );\n  }\n  async retire_idle_recorded_source(\n    conversation_id: string,\n    options: { inspect_only?: boolean; deadline?: number } = {},\n  ): Promise<boolean> {\n    return this.#settlement.retain_recording(\n      (async () => {\n        const { source, ticket_worker } = this.database.read((sql) => ({\n          source: custody.read(sql, conversation_id),\n          ticket_worker: custody.is_ticket_conversation(sql, conversation_id),\n        }));\n        const stop = options.deadline === undefined ? undefined : { deadline: options.deadline };\n        const inspector = this.#participants.local_child_custody;\n        if (source === undefined) return false;\n        let proven =\n          source.state === 'retired' ||\n          (await inspector?.retirement_row_proven(source, stop, ticket_worker)) === true;\n        const identity = custody.identity(source);\n        if (!proven && !options.inspect_only && source.state === 'started' && identity !== null)\n          proven =\n            (await inspector?.stop_recorded_child(identity, source.host, stop, ticket_worker)) ===\n            true;\n        if (!proven) return false;\n        return this.#settlement.write_recording(() =>\n          this.#write_custody((tx) => {\n            if (\n              !custody.same(custody.read(tx, conversation_id), source) ||\n              custody.is_ticket_conversation(tx, conversation_id) !== ticket_worker ||\n              tx.get(\n                \"SELECT 1 FROM conversation_lifecycle_facts WHERE conversation_id=? AND ((kind='turn' AND status IN ('intent','running','unknown')) OR (kind='attempt' AND status IN ('intent','unknown')) OR (kind='request' AND status IN ('pending','answering'))) LIMIT 1\",\n                [conversation_id],\n              ) !== undefined\n            )\n              return false;\n            custody.write_retired(tx, conversation_id, source.generation);\n            return true;\n          }),\n        );\n      })(),\n    );\n  }\n  async settle_recorded_source(\n    conversation_id: string,\n    options: { inspect_only?: boolean; deadline?: number } = {},\n  ): Promise<RecordedSourceSettlement | null> {\n    return this.#settlement.retain_recording(\n      (async () => {\n        const { source, ticket_worker } = this.database.read((sql) => ({\n          source: custody.read(sql, conversation_id),\n          ticket_worker: custody.is_ticket_conversation(sql, conversation_id),\n        }));\n        const stop = options.deadline === undefined ? undefined : { deadline: options.deadline };\n        if (source === undefined) return null;\n        const inspector = this.#participants.local_child_custody;\n        let result: RecordedSourceSettlement;\n        if (source.state === 'launch_pending') {\n          const proven =\n            source.supervision_record !== null\n              ? options.inspect_only\n                ? await inspector?.inspect_supervision(source.supervision_record, undefined, stop)\n                : await inspector?.stop_supervision(source.supervision_record, undefined, stop)\n              : await inspector?.retirement_row_proven(source, stop, ticket_worker);\n          if (proven !== true) return null;\n          result = 'undelivered';\n        } else if (source.state === 'retired') result = 'retired';\n        else {\n          const identity = custody.identity(source);\n          if (identity === null) return null;\n          const proven = options.inspect_only\n            ? await inspector?.retirement_row_proven(source, stop, ticket_worker)\n            : await inspector?.stop_recorded_child(identity, source.host, stop, ticket_worker);\n          if (proven !== true) return null;\n          result = 'retired';\n        }\n        const token = await this.#settlement.write_recording(() =>\n          this.#write_custody((tx) => {\n            if (\n              !custody.same(custody.read(tx, conversation_id), source) ||\n              custody.is_ticket_conversation(tx, conversation_id) !== ticket_worker\n            )\n              return null;\n            const occurrence = tx.get<{ turn_number: number }>(\n              'SELECT turn_number FROM conversation_turn_occurrences WHERE conversation_id=? AND occurrence_id=? AND runtime_epoch=?',\n              [conversation_id, source.occurrence_id, source.runtime_epoch],\n            );\n            if (occurrence === undefined) return null;\n            const number = occurrence.turn_number;\n            const facts = read_facts(tx, conversation_id);\n            let settled: readonly LifecycleFact[];\n            if (result === 'undelivered') {\n              const turn = facts.find((f) => f.kind === K.turn && f.turn_number === number);\n              const prompt = facts.find(\n                (f) => f.kind === K.attempt && f.identity === `prompt:${number}`,\n              );\n              if (\n                turn === undefined ||\n                prompt === undefined ||\n                (turn.status !== S.intent && turn.status !== S.unavailable) ||\n                (prompt.status !== S.intent && prompt.status !== S.suppressed)\n              )\n                return null;\n              settled = [\n                { ...turn, status: S.unavailable },\n                { ...prompt, status: S.suppressed },\n              ];\n            } else {\n              custody.write_retired(tx, conversation_id, source.generation);\n              settled = facts_after_restart(facts, null);\n            }\n            apply_facts(tx, conversation_id, [\n              ...settled,\n              {\n                kind: K.attempt,\n                identity: `cancel:recorded:${number}:${source.generation}`,\n                turn_number: number,\n                operation: O.cancel,\n                status: S.accepted,\n                provider_identity: null,\n              },\n            ]);\n            this.#participate(tx, conversation_id, []);\n            tx.run(\n              'DELETE FROM automatic_start_bindings WHERE conversation_id=? AND turn_number=?',\n              [conversation_id, number],\n            );\n            return { conversation_id, turn_number: number };\n          }),\n        );\n        if (token === null) return null;\n        this.#settled_recorded_turns.set(conversation_id, token);\n        this.blocked_local_conversations.delete(conversation_id);\n        return result;\n      })(),\n    );\n  }\n  async prepare_reconciliation(open_runs: ReadonlyMap<string, OpenRunTurn>): Promise<void> {\n    return this.#settlement.retain_recording(\n      (async () => {\n        this.#startup_source_proofs.clear();\n        const candidates = this.database.read((sql) =>\n          read_unresolved_turns(sql, { include_custody_unavailable: true }),\n        );\n        for (const turn of candidates) {\n          if (open_runs.has(turn.conversation_id)) continue;\n          const { source, ticket_worker } = this.database.read((sql) => ({\n            source: custody.read(sql, turn.conversation_id),\n            ticket_worker: custody.is_ticket_conversation(sql, turn.conversation_id),\n          }));\n          if (\n            source !== undefined &&\n            (source.state === 'retired' ||\n              (await this.#participants.local_child_custody?.retirement_row_proven(\n                source,\n                undefined,\n                ticket_worker,\n              )) === true)\n          )\n            this.#startup_source_proofs.set(turn.conversation_id, { row: source, ticket_worker });\n        }\n        this.#reconciliation_prepared = true;\n      })(),\n    );\n  }\n\n  #write_custody<T>(operation: (tx: TransactionSql) => T): T {\n    return this.database.write(operation, { changeSignal: 'silent' });\n  }\n\n  bind_interruption_delivery(\n    conversation_id: string,\n    turn_number: number,\n    references: readonly DeploymentRecoveryReference[] | null = null,\n    recovery_sender_message_ids: ReadonlyMap<string, string> | null = null,\n  ): string | null {\n    return this.#write((tx) => {\n      const bind = this.#participants.bind_interruption_delivery;\n      const value =\n        bind === undefined\n          ? null\n          : synchronously(() =>\n              bind(tx, conversation_id, turn_number, references, recovery_sender_message_ids),\n            );\n      return { value, payloads: [] };\n    });\n  }\n\n  fail_recovery_claims(conversation_id: string, turn_number: number): void {\n    this.#write((tx) => {\n      const revisions = this.#claim_revisions(tx, conversation_id);\n      const fail = this.#participants.fail_recovery_claims;\n      if (fail !== undefined)\n        synchronously(() => fail(tx, conversation_id, turn_number, this.integer_now()));\n      return {\n        value: undefined,\n        payloads: [],\n        always_announce: revisions !== this.#claim_revisions(tx, conversation_id),\n      };\n    });\n  }\n\n  #write<T>(operation: (tx: TransactionSql) => WriteResult<T>): T {\n    const options: WriteOptions = { changeSignal: 'silent' };\n    return this.database.write((tx) => {\n      const result = operation(tx);\n      if (\n        result.always_announce ||\n        conversation_event_kinds_need_the_change_signal(\n          result.payloads.map((payload) => payload.kind),\n        )\n      ) {\n        options.changeSignal = 'emit';\n      }\n      return result.value;\n    }, options);\n  }\n\n  #require_record(\n    tx: ReadSql,\n    conversation_id: string,\n  ): { latest_sequence: number; owner_read_through_sequence: number } {\n    const row = tx.get<{ latest_sequence: number; owner_read_through_sequence: number }>(\n      'SELECT latest_sequence,owner_read_through_sequence FROM conversations WHERE conversation_id=?',\n      [conversation_id],\n    );\n    if (row === undefined) {\n      throw new ConversationRecordMissing(conversation_id);\n    }\n    return row;\n  }\n\n  #prepare_attention(tx: TransactionSql, conversation_id: string): PreparedAttention | null {\n    const prepare = this.#participants.prepare_attention;\n    return prepare === undefined ? null : synchronously(() => prepare(tx, conversation_id));\n  }\n\n  #finish_attention(\n    tx: TransactionSql,\n    conversation_id: string,\n    prepared: PreparedAttention | null,\n    written: readonly StoredConversationEvent[],\n    occurred_at: number,\n  ): void {\n    if (prepared !== null) {\n      const current = this.#require_record(tx, conversation_id);\n      synchronously(() =>\n        prepared(tx, {\n          written,\n          owner_read_through_sequence: current.owner_read_through_sequence,\n          occurred_at,\n        }),\n      );\n    }\n  }\n\n  #participate(\n    tx: TransactionSql,\n    conversation_id: string,\n    written: readonly StoredConversationEvent[],\n  ): void {\n    participate(tx, this.transaction_participant, {\n      conversation_id,\n      facts: read_facts(tx, conversation_id),\n      receipt_sequences: written.map((event) => event.sequence),\n      contract_version: LIFECYCLE_CONTRACT_VERSION,\n    });\n  }\n\n  #claim_revisions(sql: ReadSql, conversation_id: string): string {\n    const read = this.#participants.recovery_claim_revisions;\n    return JSON.stringify(\n      read === undefined ? [] : synchronously(() => read(sql, conversation_id)),\n    );\n  }\n\n  #settle_delivery(\n    tx: TransactionSql,\n    conversation_id: string,\n    facts: readonly LifecycleFact[],\n    composed_content_delivered?: boolean,\n  ): void {\n    const settle = this.#participants.settle_delivery;\n    if (settle !== undefined) {\n      synchronously(() =>\n        settle(tx, conversation_id, {\n          facts,\n          now: this.integer_now(),\n          ...(composed_content_delivered === undefined ? {} : { composed_content_delivered }),\n        }),\n      );\n    }\n  }\n\n  #insert_rows(\n    tx: TransactionSql,\n    conversation_id: string,\n    payloads: readonly ConversationEventPayload[],\n    options: InsertOptions = {},\n  ): readonly StoredConversationEvent[] {\n    const expand = this.#participants.event_participant;\n    const all_payloads =\n      expand === undefined\n        ? payloads\n        : [...payloads, ...synchronously(() => expand(tx, conversation_id, payloads))];\n    const created_at = this.integer_now();\n    const latest = this.#require_record(tx, conversation_id).latest_sequence;\n    const operations = [\n      ...(options.recording_receipt == null ? [] : [options.recording_receipt]),\n      ...(options.extra_recording_receipts ?? []),\n    ];\n    const written = all_payloads.map((payload, offset): StoredConversationEvent => {\n      const sequence = latest + offset + 1;\n      tx.run(\n        'INSERT INTO conversation_events (conversation_id,sequence,kind,payload,created_at) VALUES (?,?,?,?,?)',\n        [\n          conversation_id,\n          sequence,\n          payload.kind,\n          conversation_event_payload_to_canonical_json(payload),\n          created_at,\n        ],\n      );\n      for (const operation of operations) {\n        if (\n          'sender_message_id' in payload &&\n          payload.sender_message_id === operation.submission_id &&\n          operation.in_commit != null\n        ) {\n          synchronously(() =>\n            operation.in_commit!(\n              tx,\n              conversation_id,\n              payload,\n              options.native_message_admission ?? null,\n            ),\n          );\n        }\n      }\n      return { conversation_id, sequence, kind: payload.kind, payload, created_at };\n    });\n    tx.run('UPDATE conversations SET latest_sequence=? WHERE conversation_id=?', [\n      latest + all_payloads.length,\n      conversation_id,\n    ]);\n    const lifecycle = options.lifecycle ?? [];\n    apply_facts(tx, conversation_id, lifecycle);\n    this.#settle_delivery(\n      tx,\n      conversation_id,\n      lifecycle.filter(\n        (fact) =>\n          fact.status === S.refused || fact.status === S.unknown || fact.status === S.suppressed,\n      ),\n    );\n    append_projection(tx, written);\n    return written;\n  }\n\n  append_in_transaction(\n    tx: TransactionSql,\n    conversation_id: string,\n    payloads: readonly ConversationEventPayload[],\n    options: AppendOptions = {},\n  ): readonly StoredConversationEvent[] {\n    if (payloads.length === 0 && (options.lifecycle?.length ?? 0) === 0) {\n      return [];\n    }\n    const prepared = this.#prepare_attention(tx, conversation_id);\n    const written = this.#insert_rows(tx, conversation_id, payloads, options);\n    if (written.length === 0) {\n      this.#participate(tx, conversation_id, written);\n      return written;\n    }\n    const last = written[written.length - 1];\n    if (options.agent_activity) {\n      tx.run(\n        'UPDATE conversations SET latest_agent_activity_at=?,latest_agent_activity_sequence=? WHERE conversation_id=?',\n        [last.created_at, last.sequence, conversation_id],\n      );\n    }\n    if (options.automatic_compaction_confirmed) {\n      tx.run(\n        'UPDATE conversations SET automatic_compaction_attempted_through_sequence=latest_agent_activity_sequence WHERE conversation_id=?',\n        [conversation_id],\n      );\n      const compaction = written.findLast((event) => event.kind === 'context_compacted');\n      if (compaction !== undefined) {\n        tx.run(\n          'UPDATE conversations SET automatically_compacted_through_sequence=? WHERE conversation_id=?',\n          [compaction.sequence, conversation_id],\n        );\n        if (options.working_turn_compaction_confirmed)\n          tx.run(\n            'UPDATE conversations SET working_turn_compacted_through_sequence=? WHERE conversation_id=?',\n            [compaction.sequence, conversation_id],\n          );\n      }\n    } else if (options.automatic_compaction_result === 'not_compacted') {\n      tx.run(\n        'UPDATE conversations SET automatic_compaction_attempted_through_sequence=latest_agent_activity_sequence ' +\n          'WHERE conversation_id=?',\n        [conversation_id],\n      );\n    }\n    const failure_notice = this.#participants.failure_notice;\n    if (options.create_failure_notice && failure_notice !== undefined) {\n      const error_summary =\n        'error_summary' in last.payload && last.payload.error_summary !== null\n          ? last.payload.error_summary\n          : 'None';\n      synchronously(() =>\n        failure_notice(tx, {\n          conversation_id,\n          event_sequence: last.sequence,\n          error_summary,\n          now: last.created_at,\n        }),\n      );\n    }\n    if (options.owner_read_through_sequence != null) {\n      tx.run(\n        'UPDATE conversations SET owner_read_through_sequence=MAX(owner_read_through_sequence,?) WHERE conversation_id=?',\n        [options.owner_read_through_sequence, conversation_id],\n      );\n    }\n    this.#finish_attention(tx, conversation_id, prepared, written, last.created_at);\n    this.#participate(tx, conversation_id, written);\n    return written;\n  }\n\n  append_events(\n    conversation_id: string,\n    payloads: readonly ConversationEventPayload[],\n    options: AppendOptions = {},\n  ): readonly StoredConversationEvent[] {\n    return this.#write((tx) => ({\n      value: this.append_in_transaction(tx, conversation_id, payloads, options),\n      payloads,\n    }));\n  }\n\n  append_event(\n    conversation_id: string,\n    payload: ConversationEventPayload,\n    options: AppendOptions = {},\n  ): StoredConversationEvent {\n    return this.append_events(conversation_id, [payload], options)[0];\n  }\n\n  append_turn_ending(\n    conversation_id: string,\n    payloads: readonly ConversationEventPayload[],\n    options: AppendOptions,\n  ): readonly StoredConversationEvent[] {\n    return this.append_events(conversation_id, payloads, options);\n  }\n\n  transact_events<T>(\n    conversation_id: string,\n    work: (tx: TransactionSql) => EventMutation<T>,\n  ): EventTransactionResult<T> {\n    return this.#write((tx) => {\n      this.#require_record(tx, conversation_id);\n      const result = synchronously(() => work(tx));\n      const written = this.append_in_transaction(tx, conversation_id, result.payloads);\n      return {\n        value: { value: result.value, written },\n        payloads: written.map((row) => row.payload),\n      };\n    });\n  }\n\n  append_delivered_prompt(\n    conversation_id: string,\n    options: DeliveredPromptOptions,\n  ): readonly StoredConversationEvent[] {\n    const prompts = [options.prompt, ...(options.extra_prompts ?? [])];\n    const payloads = options.model_change === null ? prompts : [options.model_change, ...prompts];\n    return this.#write((tx) => {\n      const prepared = this.#prepare_attention(tx, conversation_id);\n      const written = this.#insert_rows(tx, conversation_id, payloads, {\n        lifecycle: options.lifecycle,\n        recording_receipt: options.recording_receipt,\n        extra_recording_receipts: options.extra_recording_receipts,\n        native_message_admission: { fate: new PromptDeliveryStarted() },\n      });\n      this.#settle_delivery(\n        tx,\n        conversation_id,\n        options.lifecycle ?? [],\n        options.composed_content_delivered ?? true,\n      );\n      if (options.model_change !== null) {\n        tx.run('UPDATE conversations SET model=?,reasoning_effort=? WHERE conversation_id=?', [\n          options.model_change.model,\n          options.model_change.reasoning_effort,\n          conversation_id,\n        ]);\n      }\n      const owner_sequences = written\n        .filter((row) => row.payload.kind === 'prompt' && row.payload.sender?.kind === 'owner')\n        .map((row) => row.sequence);\n      if (owner_sequences.length > 0) {\n        const through = options.owner_read_through_sequence ?? Math.max(...owner_sequences);\n        tx.run(\n          'UPDATE conversations SET owner_read_through_sequence=MAX(owner_read_through_sequence,?) WHERE conversation_id=?',\n          [through, conversation_id],\n        );\n      }\n      this.#finish_attention(\n        tx,\n        conversation_id,\n        prepared,\n        written,\n        written[written.length - 1].created_at,\n      );\n      this.#participate(tx, conversation_id, written);\n      return { value: written, payloads };\n    });\n  }\n\n  transition_lifecycle(conversation_id: string, facts: readonly LifecycleFact[]): void {\n    this.#write((tx) => {\n      const revisions = this.#claim_revisions(tx, conversation_id);\n      apply_