 === 'goal')\n    parent = [value.holder_kind, value.holder_kind === 'manager' ? value.holder_id : 'chief'];\n  const knowledge = kind === 'conversation' ? value.attention : attention(sql, conversation_id);\n  return {\n    kind,\n    id,\n    content_hash,\n    conversation_id,\n    parent_kind: parent[0],\n    parent_id: parent[1],\n    owner_kind: value.owner_kind ?? null,\n    owner_id: value.owner_id ?? null,\n    project_id: value.project_id ?? null,\n    working: Number(!!knowledge?.current?.signal.working),\n    out_claim: Number(!!value.worker_step_claim_out),\n    review: Number(\n      kind === 'ticket' && !('integrity_error' in value) && eligibleForOwnerReview(value),\n    ),\n    unread: Number(\n      kind === 'address' &&\n        !!knowledge?.durable.message_for_owner &&\n        record(sql, [value.owner_kind, value.owner_id]) !== null,\n    ),\n    settled: Number(!!value.settled),\n  };\n}\nfunction members(sql: ReadSql, key: Key, value: Fact, metadata: ProjectionMetadata): Membership[] {\n  const [kind, id] = key;\n  const result = new Map<string, Membership>();\n  const parent: Key = [String(metadata.parent_kind), String(metadata.parent_id)];\n  const knowledge = attention(sql, value.conversation_id);\n  const messages = kind === 'ticket' ? reviewMessageItems(sql, id) : [];\n  const signal = knowledge?.current ?? null;\n  for (const locale of VIEW_CONFIG.locales) {\n    const title = sortKey(String(value.title ?? ''), 'base');\n    const identityKey = sortKey(id, 'variant');\n    function add(\n      section: string,\n      owner: Key | null,\n      grouping = 'all',\n      childFilter = 'all',\n      rank = 0,\n      title_key = title,\n      id_key = identityKey,\n    ): void {\n      const row: Membership = {\n        section_key: sectionKey(section, owner, grouping, childFilter),\n        profile: 'current',\n        locale,\n        kind: kind as RecordKind,\n        id,\n        rank,\n        title_key,\n        id_key,\n      };\n      result.set(memberIdentity(row), row);\n    }\n    if (kind === 'goal' && value.active) {\n      add('goals', parent, 'all', 'all', Number(value.created_at), sortKey('', 'binary'));\n    } else if (kind === 'manager') {\n      add(\n        value.settled ? 'settled' : 'rail_parents',\n        null,\n        'all',\n        'all',\n        value.settled ? -Number(value.updated_at) : Number(value.created_at),\n        sortKey('', 'binary'),\n      );\n    } else if (kind === 'ticket') {\n      const broken = 'integrity_error' in value;\n      const childFilter = broken\n        ? 'active'\n        : value.stage === 'done'\n          ? 'done'\n          : value.is_backlogged\n            ? 'backlogged'\n            : 'active';\n      const childGroup = group(value, signal, true);\n      const rank = parent[0] === 'chief' ? Number(value.created_at) : -Number(value.updated_at);\n      const childTitle = parent[0] === 'chief' ? sortKey('', 'binary') : title;\n      const childId = parent[0] === 'chief' ? sortKey(id, 'binary') : identityKey;\n      if (broken || parent[0] !== 'chief' || childFilter === 'done' || !value.terminal) {\n        for (const filtering of ['all', childFilter])\n          for (const grouping of ['all', childGroup]) {\n            const grouped = parent[0] !== 'chief' && filtering === 'active' && grouping === 'all';\n            add(\n              'children',\n              parent,\n              grouping,\n              filtering,\n              grouped ? GROUPS.indexOf(childGroup as (typeof GROUPS)[number]) : rank,\n              grouped\n                ? sortKey(String(value.title ?? ''), 'base', -Number(value.updated_at))\n                : childTitle,\n              childId,\n            );\n          }\n      }\n      const parentValue = record(sql, parent);\n      const eligible =\n        broken ||\n        (!value.is_backlogged &&\n          !value.blocked &&\n          value.ticket_status !== 'blocked' &&\n          value.stage !== 'done' &&\n          !parentValue?.settled);\n      if (eligible) {\n        const railGroup = group(value, signal, true);\n        for (const grouping of ['all', railGroup]) {\n          add(\n            'rail_tickets',\n            parent,\n            grouping,\n            'all',\n            grouping === 'all' ? GROUPS.indexOf(railGroup as (typeof GROUPS)[number]) : 0,\n            sortKey(String(value.title ?? ''), 'base', -Number(value.updated_at)),\n          );\n        }\n      }\n      if (metadata.review || messages.length) {\n        const waiting = messages.map((message) => Number(message.waiting_since));\n        if (metadata.review) waiting.push(Number(value.proposal_created_at));\n        add(\n          'review',\n          null,\n          'all',\n          'all',\n          Math.min(...waiting),\n          sortKey('ticket', 'binary'),\n          sortKey(id, 'binary'),\n        );\n      }\n    } else if (kind === 'address' && metadata.unread) {\n      const conversationId = String(value.conversation_id);\n      const ownerValue = record(sql, [value.owner_kind, value.owner_id]);\n      if (\n        ownerValue &&\n        value.owner_kind !== 'ticket' &&\n        messageOwnerIsLive(value.owner_kind, ownerValue) &&\n        canonicalReviewAddress(sql, conversationId) === id\n      ) {\n        const conversation = record(sql, ['conversation', conversationId]);\n        if (!conversation) throw new Error('unread navigation conversation is absent');\n        add(\n          'review',\n          null,\n          'all',\n          'all',\n          Number(conversation.first_unread_owner_message_at),\n          sortKey('message', 'binary'),\n          sortKey(conversationId, 'binary'),\n        );\n      }\n      add('unread', null, 'all', 'all', -Number(!!value.current), sortKey('', 'binary'));\n      const owner: Key = [value.owner_kind, value.owner_id];\n      if (owner[0] === 'ticket')\n        add('unread', owner, 'all', 'all', -Number(!!value.current), sortKey('', 'binary'));\n      const ownerRecord = record(sql, owner);\n      if (\n        value.parent_kind != null &&\n        keyString(parent) !== keyString(owner) &&\n        !ownerRecord?.is_backlogged\n      ) {\n        add('unread', parent, 'all', 'all', -Number(!!value.current), sortKey('', 'binary'));\n      }\n    }\n  }\n  return [...result.values()];\n}\nfunction memberIdentity(row: Membership): string {\n  return compact([\n    row.section_key,\n    row.profile,\n    row.locale,\n    row.kind,\n    row.id,\n    row.rank,\n    row.title_key.toString('hex'),\n    row.id_key.toString('hex'),\n  ]);\n}\nfunction globalDelta(tx: TransactionSql, name: string, amount: number): void {\n  if (!amount) return;\n  if (amount > 0)\n    tx.run(\n      'INSERT INTO navigation_view_globals(name,value) VALUES(?,?) ON CONFLICT(name) DO UPDATE SET value=value+excluded.value',\n      [name, amount],\n    );\n  else tx.run('UPDATE navigation_view_globals SET value=value+? WHERE name=?', [amount, name]);\n}\nfunction countDelta(tx: TransactionSql, row: Membership, amount: number): void {\n  if (amount > 0)\n    tx.run(\n      'INSERT INTO navigation_view_counts(section_key,profile,locale,value) VALUES(?,?,?,?) ON CONFLICT(section_key,profile,locale) DO UPDATE SET value=value+excluded.value',\n      [row.section_key, row.profile, row.locale, amount],\n    );\n  else\n    tx.run(\n      'UPDATE navigation_view_counts SET value=value+? WHERE section_key=? AND profile=? AND locale=?',\n      [amount, row.section_key, row.profile, row.locale],\n    );\n}\nfunction prepared(sql: ReadSql): boolean {\n  return !!sql.get(\"SELECT 1 FROM sqlite_master WHERE name='navigation_view_meta'\");\n}\nexport function updateProjection(\n  tx: TransactionSql,\n  upserts: readonly NavigationRecord[],\n  deletes: readonly Pick<RecordKey, 'kind' | 'id'>[],\n  initializing = false,\n): void {\n  if (!prepared(tx)) return;\n  const continuity = tx.get<{ epoch: string; revision: number }>(\n    'SELECT epoch,revision FROM navigation_meta',\n  )!;\n  const meta = tx.get<{ epoch: string; ordering_generation: string }>(\n    'SELECT epoch,ordering_generation FROM navigation_view_meta',\n  );\n  if (\n    !initializing &&\n    (!meta || meta.epoch !== continuity.epoch || meta.ordering_generation !== ORDERING_GENERATION)\n  )\n    return;\n  const changed = new Map<string, Key>();\n  for (const item of deletes)\n    if (item.kind !== 'totals') changed.set(keyString([item.kind, item.id]), [item.kind, item.id]);\n  for (const item of upserts) {\n    if (item.kind === 'totals') continue;\n    const old = tx.get<{ content_hash: string }>(\n      'SELECT content_hash FROM navigation_view_index WHERE kind=? AND id=?',\n      [item.kind, item.id],\n    );\n    if (!old || old.content_hash !== digest(project(item)))\n      changed.set(keyString([item.kind, item.id]), [item.kind, item.id]);\n  }\n  const affected = new Map(changed);\n  function affect(rows: { kind: string; id: string }[]): void {\n    for (const row of rows) affected.set(keyString([row.kind, row.id]), [row.kind, row.id]);\n  }\n  for (const [kind, id] of changed.values()) {\n    if (kind === 'conversation')\n      affect(\n        tx.all(\n          'SELECT kind,id FROM navigation_view_index WHERE conversation_id=? ORDER BY kind,id',\n          [id],\n        ),\n      );\n    if (['ticket', 'manager', 'chief'].includes(kind))\n      affect(\n        tx.all(\n          'SELECT kind,id FROM navigation_view_index WHERE owner_kind=? AND owner_id=? ORDER BY kind,id',\n          [kind, id],\n        ),\n      );\n    if (kind === 'manager')\n      affect(\n        tx.all(\n          \"SELECT kind,id FROM navigation_view_index WHERE parent_kind='manager' AND parent_id=? ORDER BY kind,id\",\n          [id],\n        ),\n      );\n  }\n  const addressConversations = new Set<string>();\n  for (const key of affected.values()) {\n    if (key[0] !== 'address') continue;\n    const value = record(tx, key);\n    const old = tx.get<{ conversation_id: string | null }>(\n      'SELECT conversation_id FROM navigation_view_index WHERE kind=? AND id=?',\n      [...key],\n    );\n    if (value) addressConversations.add(String(value.conversation_id));\n    if (old?.conversation_id) addressConversations.add(old.conversation_id);\n  }\n  for (const id of addressConversations) {\n    affect(\n      tx.all<{ kind: string; id: string }>(\n        \"SELECT kind,id FROM navigation_records WHERE kind='address' AND json_extract(value,'$.conversation_id')=? ORDER BY id\",\n        [id],\n      ),\n    );\n  }\n  for (const key of [...affected.values()]) {\n    if (key[0] !== 'address') continue;\n    const value = record(tx, key);\n    const old = tx.get<{ owner_kind: string | null; owner_id: string | null }>(\n      'SELECT owner_kind,owner_id FROM navigation_view_index WHERE kind=? AND id=?',\n      [...key],\n    );\n    if (old?.owner_kind === 'ticket' && old.owner_id)\n      affected.set(keyString(['ticket', old.owner_id]), ['ticket', old.owner_id]);\n    if (value?.owner_kind === 'ticket')\n      affected.set(keyString(['ticket', value.owner_id]), ['ticket', value.owner_id]);\n  }\n  const sections = new Set<string>();\n  const orderedGroups = new Map<string, OrderedGroup>();\n  function reorder(row: Membership): void {\n    const group: OrderedGroup = [row.section_key, row.profile, row.locale];\n    orderedGroups.set(compact(group), group);\n  }\n  const pointerIds = new Set(\n    [...changed.values()].filter(([kind]) => kind === 'conversation').map(([, id]) => id),\n  );\n  let globalsChanged = false;\n  const sorted = [...affected.values()].sort(\n    ([ak, ai], [bk, bi]) => binaryCompare(ak, bk) || binaryCompare(ai, bi),\n  );\n  for (const key of sorted) {\n    const old =\n      tx.get<ProjectionMetadata>('SELECT * FROM navigation_view_index WHERE kind=? AND id=?', [\n        ...key,\n      ]) ?? null;\n    const value = record(tx, key);\n    const fresh =\n      value === null\n        ? null\n        : metadata(\n            tx,\n            key,\n            value,\n            digest(project({ kind: key[0], id: key[1], value } as NavigationRecord)),\n          );\n    for (const candidate of [old, fresh])\n      if (\n        candidate &&\n        ['ticket', 'manager', 'chief', 'goal', 'address'].includes(candidate.kind) &&\n        candidate.conversation_id\n      )\n        pointerIds.add(candidate.conversation_id);\n    const oldMembers = new Map(\n      tx\n        .all<Membership>(\n          'SELECT * FROM navigation_view_memberships WHERE kind=? AND id=? ORDER BY section_key,profile,locale',\n          [...key],\n        )\n        .map((row) => [memberIdentity(row), row]),\n    );\n    const newMembers = new Map(\n      (fresh && value ? members(tx, key, value, fresh) : []).map((row) => [\n        memberIdentity(row),\n        row,\n      ]),\n    );\n    const reviewSection = sectionKey('review', null);\n    if (\n      [...oldMembers.values(), ...newMembers.values()].some(\n        (row) => row.section_key === reviewSection,\n      )\n    )\n      sections.add(reviewSection);\n    for (const [identity, row] of oldMembers)\n      if (!newMembers.has(identity)) {\n        tx.run(\n          'DELETE FROM navigation_view_memberships WHERE section_key=? AND profile=? AND locale=? AND kind=? AND id=?',\n          [row.section_key, row.profile, row.locale, row.kind, row.id],\n        );\n        countDelta(tx, row, -1);\n        sections.add(row.section_key);\n        reorder(row);\n      }\n    for (const [identity, row] of newMembers)\n      if (!oldMembers.has(identity)) {\n        tx.run('INSERT OR REPLACE INTO navigation_view_memberships VALUES(?,?,?,?,?,?,?,?)', [\n          row.section_key,\n          row.profile,\n          row.locale,\n          row.kind,\n          row.id,\n          row.rank,\n          row.title_key,\n          row.id_key,\n        ]);\n        countDelta(tx, row, 1);\n        sections.add(row.section_key);\n        reorder(row);\n      }\n    for (const [name, field] of [\n      ['out_claims', 'out_claim'],\n      ['settled', 'settled'],\n    ] as const) {\n      const difference = (fresh?.[field] ?? 0) - (old?.[field] ?? 0);\n      globalDelta(tx, name, difference);\n      globalsChanged ||= difference !== 0;\n    }\n    if (fresh)\n      tx.run('INSERT OR REPLACE INTO navigation_view_index VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)', [\n        fresh.kind,\n        fresh.id,\n        fresh.content_hash,\n        fresh.conversation_id,\n        fresh.parent_kind,\n        fresh.parent_id,\n        fresh.owner_kind,\n        fresh.owner_id,\n        fresh.project_id,\n        fresh.working,\n        fresh.out_claim,\n        fresh.review,\n        fresh.unread,\n        fresh.settled,\n      ]);\n    else tx.run('DELETE FROM navigation_view_index WHERE kind=? AND id=?', [...key]);\n  }\n  for (const group of orderedGroups.values()) reorderGroup(tx, group);\n  for (const id of pointerIds) {\n    const oldUnread = tx.get<{ reference_count: number }>(\n      'SELECT reference_count FROM navigation_view_unread_conversations WHERE conversation_id=?',\n      [id],\n    );\n    const unread = tx.get<{ count: number }>(\n      \"SELECT count(*) AS count FROM navigation_view_index WHERE conversation_id=? AND kind='address' AND unread=1\",\n      [id],\n    )!.count;\n    const unreadDelta = Number(!!unread) - Number(!!oldUnread);\n    globalDelta(tx, 'unread', unreadDelta);\n    globalsChanged ||= unreadDelta !== 0;\n    if (unread)\n      tx.run('INSERT OR REPLACE INTO navigation_view_unread_conversations VALUES(?,?)', [\n        id,\n        unread,\n      ]);\n    else tx.run('DELETE FROM navigation_view_unread_conversations WHERE conversation_id=?', [id]);\n    const old = tx.get<{ reference_count: number; working: number }>(\n      'SELECT reference_count,working FROM navigation_view_current_conversations WHERE conversation_id=?',\n      [id],\n    );\n    const references = tx.get<{ count: number }>(\n      \"SELECT count(*) AS count FROM navigation_view_index WHERE conversation_id=? AND kind IN ('chief','ticket','manager','goal')\",\n      [id],\n    )!.count;\n    const current = tx.get<{ working: number }>(\n      \"SELECT working FROM navigation_view_index WHERE kind='conversation' AND id=?\",\n      [id],\n    );\n    const working = Number(!!current?.working);\n    const difference = (references ? working : 0) - (old?.working ?? 0);\n    globalDelta(tx, 'running_conversations', difference);\n    globalsChanged ||= difference !== 0;\n    if (references)\n      tx.run('INSERT OR REPLACE INTO navigation_view_current_conversations VALUES(?,?,?)', [\n        id,\n        references,\n        working,\n      ]);\n    else tx.run('DELETE FROM navigation_view_current_conversations WHERE conversation_id=?', [id]);\n  }\n  const review =\n    tx.get<{ value: number }>(\n      \"SELECT value FROM navigation_view_counts WHERE section_key=? AND profile='current' AND locale=?\",\n      [sectionKey('review', null), VIEW_CONFIG.locales[0]],\n    )?.value ?? 0;\n  const oldReview = tx.get<{ value: number }>(\n    \"SELECT value FROM navigation_view_globals WHERE name='review'\",\n  );\n  globalsChanged ||= oldReview === undefined || oldReview.value !== review;\n  tx.run(\"INSERT OR REPLACE INTO navigation_view_globals VALUES('review',?)\", [review]);\n  tx.run('INSERT OR REPLACE INTO navigation_view_changes VALUES(?,?)', [\n    continuity.revision,\n    compact({\n      keys: [...changed.values()].sort(\n        ([ak, ai], [bk, bi]) => binaryCompare(ak, bk) || binaryCompare(ai, bi),\n      ),\n      sections: [...sections].sort(binaryCompare),\n      globals: globalsChanged,\n    }),\n  ]);\n  tx.run('DELETE FROM navigation_view_changes WHERE revision<?', [\n    Math.max(0, continuity.revision - VIEW_CONFIG.retained_revisions),\n  ]);\n  tx.run('INSERT OR REPLACE INTO navigation_view_meta VALUES(1,1,?,?,?)', [\n    continuity.epoch,\n    continuity.revision,\n    ORDERING_GENERATION,\n  ]);\n}\nexport function rebuildProjection(tx: TransactionSql): void {\n  if (\n    !prepared(tx) ||\n    tx.get<{ schema_version: number }>('SELECT schema_version FROM navigation_meta')\n      ?.schema_version !== SCHEMA_VERSION\n  )\n    return;\n  tx.run('DELETE FROM navigation_view_ordered');\n  for (const suffix of [\n    'meta',\n    'index',\n    'memberships',\n    'counts',\n    'current_conversations',\n    'unread_conversations',\n    'globals',\n    'changes',\n  ])\n    tx.run(`DELETE FROM navigation_view_${suffix}`);\n  for (const name of ['running_conversations', 'out_claims', 'review', 'unread', 'settled'])\n    tx.run('INSERT INTO navigation_view_globals VALUES(?,0)', [name]);\n  const records = tx\n    .all<{ kind: string; id: string; value: string }>(\n      \"SELECT kind,id,value FROM navigation_records WHERE kind!='totals' ORDER BY kind,id\",\n    )\n    .map(\n      (row) => ({ kind: row.kind, id: row.id, value: JSON.parse(row.value) }) as NavigationRecord,\n    );\n  updateProjection(tx, records, [], true);\n}\n"],"file":"/server/navigation/views/projection.ts"}