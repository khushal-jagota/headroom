e(conversation_id,projection_version) VALUES (?,?)',\n    [conversation_id, VIEW_PROJECTION_VERSION],\n  );\n  const previous_summaries = rest_references(tx, conversation_id);\n  const effect = event_effect(payload);\n  let [turn_key, group_key] = state(tx, conversation_id);\n  const removed: number[] = [];\n  if (effect.sender_message_id !== null) {\n    const previous = tx.get<{\n      source_sequence: number;\n    }>(\n      \"SELECT source_sequence FROM conversation_view_lookups WHERE conversation_id=? AND lookup_kind='sender_message' AND lookup_id=?\",\n      [conversation_id, effect.sender_message_id],\n    );\n    if (previous !== undefined) {\n      removed.push(previous.source_sequence);\n    }\n    lookup(tx, conversation_id, 'sender_message', effect.sender_message_id, sequence, turn_key);\n  }\n  if (effect.reconciles_sequence !== null && effect.reconciles_sequence < sequence) {\n    const previous = tx.get<{\n      sequence: number;\n    }>(\n      \"SELECT sequence FROM conversation_view_rows WHERE conversation_id=? AND sequence=? AND row_kind='prompt_uncertain'\",\n      [conversation_id, effect.reconciles_sequence],\n    );\n    if (previous !== undefined) {\n      removed.push(previous.sequence);\n    }\n  }\n  for (const previous_sequence of new Set(removed)) {\n    tx.run(\n      'UPDATE conversation_view_rows SET removed=1,changed_sequence=? WHERE conversation_id=? AND sequence=?',\n      [sequence, conversation_id, previous_sequence],\n    );\n  }\n  let matched:\n    | {\n        source_sequence: number;\n      }\n    | undefined;\n  if (effect.settlement && effect.lookup_kind !== null) {\n    matched = tx.get<{\n      source_sequence: number;\n    }>(\n      'SELECT source_sequence FROM conversation_view_lookups WHERE conversation_id=? AND lookup_kind=? AND lookup_id=?',\n      [conversation_id, effect.lookup_kind, effect.lookup_id],\n    );\n    if (matched !== undefined) {\n      tx.run(\n        'UPDATE conversation_view_rows SET settlement_sequence=?,changed_sequence=? WHERE conversation_id=? AND sequence=?',\n        [sequence, sequence, conversation_id, matched.source_sequence],\n      );\n      if (effect.lookup_kind === 'user_input') {\n        tx.run(\n          'DELETE FROM conversation_view_lookups WHERE conversation_id=? AND lookup_kind=? AND lookup_id=?',\n          [conversation_id, effect.lookup_kind, effect.lookup_id],\n        );\n      }\n    }\n  }\n  if (\n    (payload.kind === 'permission_answered' || payload.kind === 'user_input_answered') &&\n    payload.fate === 'saved' &&\n    payload.answer_id &&\n    matched !== undefined\n  ) {\n    lookup(\n      tx,\n      conversation_id,\n      'saved_answer',\n      payload.answer_id,\n      matched.source_sequence,\n      turn_key,\n    );\n  }\n  if (payload.kind === 'answer_applied') {\n    const original = tx.get<{\n      source_sequence: number;\n    }>(\n      \"SELECT source_sequence FROM conversation_view_lookups WHERE conversation_id=? AND lookup_kind='saved_answer' AND lookup_id=?\",\n      [conversation_id, payload.answer_id],\n    );\n    if (original !== undefined) {\n      tx.run(\n        'UPDATE conversation_view_rows SET changed_sequence=? WHERE conversation_id=? AND sequence=?',\n        [sequence, conversation_id, original.source_sequence],\n      );\n      lookup(tx, conversation_id, 'applied_answer', payload.answer_id, sequence, turn_key);\n    }\n  }\n  if (effect.row_kind !== null && matched === undefined) {\n    tx.run(\n      'INSERT INTO conversation_view_rows(conversation_id,sequence,row_kind,created_at,changed_sequence,focus_visible,sender_message_id) VALUES (?,?,?,?,?,?,?)',\n      [\n        conversation_id,\n        sequence,\n        effect.row_kind,\n        created_at,\n        sequence,\n        Number(effect.focus_visible),\n        effect.sender_message_id,\n      ],\n    );\n    [turn_key, group_key] = layout_row(\n      tx,\n      conversation_id,\n      sequence,\n      created_at,\n      payload,\n      effect.row_kind,\n      effect.focus_visible,\n      turn_key,\n      group_key,\n      sequence,\n    );\n    if (\n      effect.lookup_kind !== null &&\n      (!effect.settlement || effect.lookup_kind === 'credential_request')\n    ) {\n      lookup(tx, conversation_id, effect.lookup_kind, effect.lookup_id, sequence, turn_key);\n    }\n  }\n  if (effect.row_kind !== null || matched !== undefined) {\n    const summary_sequence = matched?.source_sequence ?? sequence;\n    previous_summaries.add(summary_sequence);\n    const summary = rest_summary(tx, conversation_id, summary_sequence, payload);\n    const permission_title =\n      payload.kind === 'permission_asked'\n        ? excerpt(payload.title) || excerpt(payload.detail ?? '')\n        : null;\n    tx.run(\n      'UPDATE conversation_view_rows SET rest_summary=?,permission_title_excerpt=COALESCE(?,permission_title_excerpt) WHERE conversation_id=? AND sequence=?',\n      [summary, permission_title, conversation_id, summary_sequence],\n    );\n  }\n  if (event_has_rest_text(payload)) {\n    const happened_sequence = matched?.source_sequence ?? sequence;\n    tx.run(\n      'UPDATE conversation_view_state SET latest_full_happened_sequence=MAX(COALESCE(latest_full_happened_sequence,0),?),' +\n        'latest_focus_happened_sequence=CASE WHEN ? THEN MAX(COALESCE(latest_focus_happened_sequence,0),?) ELSE latest_focus_happened_sequence END WHERE conversation_id=?',\n      [happened_sequence, Number(effect.focus_visible), happened_sequence, conversation_id],\n    );\n  }\n  if (payload.kind === 'plan_updated') {\n    const current = payload.entries.findIndex((entry) => entry.status === 'in_progress');\n    const summary = {\n      total_count: payload.entries.length,\n      completed_count: payload.entries.filter((entry) => entry.status === 'completed').length,\n      current_position: current < 0 ? null : current + 1,\n      current_text_excerpt: current < 0 ? null : excerpt(payload.entries[current].text),\n      has_unfinished_entry: payload.entries.some((entry) => entry.status !== 'completed'),\n    };\n    const body = encode_wire({\n      entries: payload.entries.map((entry) => ({ text: entry.text, status: entry.status })),\n    });\n    tx.run(\n      'UPDATE conversation_view_state SET plan_sequence=?,plan_summary=?,plan_body_bytes=? WHERE conversation_id=?',\n      [sequence, plan_summary_json(summary), Buffer.byteLength(body, 'utf8'), conversation_id],\n    );\n  }\n  if (effect.closes_turn) {\n    tx.run(\n      \"DELETE FROM conversation_view_lookups WHERE conversation_id=? AND lookup_kind IN ('permission','user_input')\",\n      [conversation_id],\n    );\n  }\n  tx.run(\n    'UPDATE conversation_view_state SET through_sequence=?,current_turn_key=?,current_group_key=? WHERE conversation_id=?',\n    [sequence, turn_key, group_key, conversation_id],\n  );\n  if (removed.length > 0) {\n    repair_removed_boundaries(tx, conversation_id, Math.min(...removed), sequence);\n    repair_rest_pointer(tx, conversation_id);\n  }\n  const keep_summaries = rest_references(tx, conversation_id);\n  for (const obsolete of previous_summaries) {\n    if (!keep_summaries.has(obsolete)) {\n      tx.run(\n        'UPDATE conversation_view_rows SET rest_summary=NULL WHERE conversation_id=? AND sequence=?',\n        [conversation_id, obsolete],\n      );\n    }\n  }\n  for (const referenced of keep_summaries) {\n    const summary = tx.get<{\n      rest_summary: string | null;\n    }>('SELECT rest_summary FROM conversation_view_rows WHERE conversation_id=? AND sequence=?', [\n      conversation_id,\n      referenced,\n    ]);\n    if (\n      summary !== undefined &&\n      (summary.rest_summary === null || effect.closes_turn || removed.length > 0)\n    ) {\n      const projected = rest_summary(\n        tx,\n        conversation_id,\n        referenced,\n        source(tx, conversation_id, referenced),\n      );\n      if (projected !== null) {\n        tx.run(\n          'UPDATE conversation_view_rows SET rest_summary=? WHERE conversation_id=? AND sequence=?',\n          [projected, conversation_id, referenced],\n        );\n      }\n    }\n  }\n}\nfunction lookup(\n  tx: TransactionSql,\n  conversation_id: string,\n  kind: string,\n  identity: string | null,\n  sequence: number,\n  turn_key: string | null,\n): void {\n  if (identity === null) {\n    return;\n  }\n  tx.run(\n    'INSERT INTO conversation_view_lookups VALUES (?,?,?,?,?) ON CONFLICT(conversation_id,lookup_kind,lookup_id) DO UPDATE SET source_sequence=excluded.source_sequence,turn_key=excluded.turn_key',\n    [conversation_id, kind, identity, sequence, turn_key],\n  );\n}\nfunction layout_row(\n  tx: TransactionSql,\n  conversation_id: string,\n  sequence: number,\n  created_at: number,\n  payload: ConversationEventPayload,\n  row_kind: string,\n  focus_visible: boolean,\n  turn_key: string | null,\n  group_key: string | null,\n  changed_sequence: number,\n): [string | null, string | null] {\n  let row_group: string | null = null;\n  if (row_kind === 'tool_call') {\n    if (group_key === null) {\n      group_key = `work:e${sequence}`;\n      tx.run(\n        'INSERT INTO conversation_view_groups(conversation_id,group_key,source_sequence,turn_key,entry_count,latest_entry_sequence,changed_sequence) VALUES (?,?,?,?,?,?,?)',\n        [conversation_id, group_key, sequence, turn_key, 0, sequence, changed_sequence],\n      );\n    }\n    row_group = group_key;\n    tx.run(\n      'UPDATE conversation_view_groups SET entry_count=entry_count+1,latest_entry_sequence=?,changed_sequence=? WHERE conversation_id=? AND group_key=?',\n      [sequence, changed_sequence, conversation_id, group_key],\n    );\n    if (turn_key !== null) {\n      tx.run(\n        'UPDATE conversation_view_turns SET tool_call_count=tool_call_count+1,changed_sequence=? WHERE conversation_id=? AND turn_key=?',\n        [changed_sequence, conversation_id, turn_key],\n      );\n    }\n  } else if (row_kind !== 'token_usage') {\n    group_key = null;\n  }\n  tx.run(\n    'UPDATE conversation_view_rows SET turn_key=?,work_group_key=?,changed_sequence=? WHERE conversation_id=? AND sequence=?',\n    [turn_key, row_group, changed_sequence, conversation_id, sequence],\n  );\n  if (row_kind === 'agent_message' && turn_key !== null) {\n    tx.run(\n      'UPDATE conversation_view_turns SET full_message_count=full_message_count+1,latest_full_message_sequence=?,focus_message_count=focus_message_count+?,' +\n        'latest_focus_message_sequence=CASE WHEN ? THEN ? ELSE latest_focus_message_sequence END,changed_sequence=? WHERE conversation_id=? AND turn_key=?',\n      [\n        sequence,\n        Number(focus_visible),\n        Number(focus_visible),\n        sequence,\n        changed_sequence,\n        conversation_id,\n        turn_key,\n      ],\n    );\n  }\n  if (payload.kind === 'prompt' && event_effect(payload).opens_turn && turn_key === null) {\n    turn_key = `turn:e${sequence}`;\n    tx.run(\n      'INSERT INTO conversation_view_turns(conversation_id,turn_key,source_sequence,created_at,started_at_milliseconds,focus_head,changed_sequence) VALUES (?,?,?,?,?,?,?)',\n      [\n        conversation_id,\n        turn_key,\n        sequence,\n        created_at,\n        sent_at_milliseconds(payload, created_at),\n        1,\n        changed_sequence,\n      ],\n    );\n    tx.run('UPDATE conversation_view_state SET segment_start_sequence=? WHERE conversation_id=?', [\n      sequence,\n      conversation_id,\n    ]);\n    group_key = null;\n  } else if (payload.kind === 'turn_ended') {\n    const segment = tx.get<{\n      segment_start_sequence: number;\n    }>('SELECT segment_start_sequence FROM conversation_view_state WHERE conversation_id=?', [\n      conversation_id,\n    ])!.segment_start_sequence;\n    tx.run(\n      'UPDATE conversation_view_groups SET ending_sequence=?,changed_sequence=? WHERE conversation_id=? AND source_sequence>? AND ending_sequence IS NULL',\n      [sequence, changed_sequence, conversation_id, segment],\n    );\n    tx.run('UPDATE conversation_view_state SET segment_start_sequence=? WHERE conversation_id=?', [\n      sequence,\n      conversation_id,\n    ]);\n    if (turn_key !== null) {\n      tx.run(\n        'UPDATE conversation_view_turns SET ending_sequence=?,ending=?,ended_at=?,focus_head=(focus_message_count>0 OR EXISTS(SELECT 1 FROM conversation_view_rows r ' +\n          'WHERE r.conversation_id=conversation_view_turns.conversation_id AND r.sequence=conversation_view_turns.source_sequence AND r.focus_visible=1 AND r.removed=0)),' +\n          'changed_sequence=? WHERE conversation_id=? AND turn_key=?',\n        [sequence, payload.ending, created_at, changed_sequence, conversation_id, turn_key],\n      );\n    }\n    tx.run(\n      \"UPDATE conversation_view_rows SET changed_sequence=? WHERE conversation_id=? AND sequence IN (SELECT source_sequence FROM conversation_view_lookups WHERE conversation_id=? AND lookup_kind='saved_answer' AND turn_key=?)\",\n      [changed_sequence, conversation_id, conversation_id, turn_key],\n    );\n    turn_key = null;\n    group_key = null;\n  }\n  return [turn_key, group_key];\n}\nfunction repair_removed_boundaries(\n  tx: TransactionSql,\n  conversation_id: string,\n  first_removed: number,\n  changed_sequence: number,\n): void {\n  const previous_end = tx.get<{\n    value: number | null;\n  }>(\n    \"SELECT MAX(sequence) AS value FROM conversation_view_rows WHERE conversation_id=? AND row_kind='turn_ended' AND sequence<?\",\n    [conversation_id, first_removed],\n  )!.value;\n  const first = (previous_end ?? 0) + 1;\n  const next_end = tx.get<{\n    value: number | null;\n  }>(\n    \"SELECT MIN(sequence) AS value FROM conversation_view_rows WHERE conversation_id=? AND row_kind='turn_ended' AND sequence>=?\",\n    [conversation_id, first_removed],\n  )!.value;\n  const last = next_end ?? changed_sequence;\n  tx.run(\n    'DELETE FROM conversation_view_groups WHERE conversation_id=? AND source_sequence BETWEEN ? AND ?',\n    [conversation_id, first, last],\n  );\n  tx.run(\n    'DELETE FROM conversation_view_turns WHERE conversation_id=? AND source_sequence BETWEEN ? AND ?',\n    [conversation_id, first, last],\n  );\n  const original_segment = tx.get<{\n    segment_start_sequence: number;\n  }>('SELECT segment_start_sequence FROM conversation_view_state WHERE conversation_id=?', [\n    conversation_id,\n  ])!.segment_start_sequence;\n  tx.run('UPDATE conversation_view_state SET segment_start_sequence=? WHERE conversation_id=?', [\n    first - 1,\n    conversation_id,\n  ]);\n  let after = first - 1;\n  let turn_key: string | null = null;\n  let group_key: string | null = null;\n  while (true) {\n    const rows = tx.all<{\n      sequence: number;\n      row_kind: string;\n      created_at: number;\n      focus_visible: number;\n    }>(\n      'SELECT sequence,row_kind,created_at,focus_visible FROM conversation_view_rows WHERE conversation_id=? AND sequence>? AND sequence<=? AND removed=0 ORDER BY sequence LIMIT ?',\n      [conversation_id, after, last, PROJECTION_BACKFILL_BATCH],\n    );\n    if (rows.length === 0) {\n      break;\n    }\n    for (const row of rows) {\n      [turn_key, group_key] = layout_row(\n        tx,\n        conversation_id,\n        row.sequence,\n        row.created_at,\n        source(tx, conversation_id, row.sequence),\n        row.row_kind,\n        Boolean(row.focus_visible),\n        turn_key,\n        group_key,\n        changed_sequence,\n      );\n      after = row.sequence;\n    }\n  }\n  if (next_end === null) {\n    tx.run(\n      'UPDATE conversation_view_state SET current_turn_key=?,current_group_key=? WHERE conversation_id=?',\n      [turn_key, group_key, conversation_id],\n    );\n  } else {\n    tx.run('UPDATE conversation_view_state SET segment_start_sequence=? WHERE conversation_id=?', [\n      original_segment,\n      conversation_id,\n    ]);\n  }\n}\nexport function rebuild_conversation_view(tx: TransactionSql, conversation_id: string): void {\n  for (const table of ['lookups', 'groups', 'turns', 'rows', 'state']) {\n    tx.run(`DELETE FROM conversation_view_${table} WHERE conversation_id=?`, [conversation_id]);\n  }\n  append_events_after(tx, conversation_id, 0);\n}\nexport function append_events_after(\n  tx: TransactionSql,\n  conversation_id: string,\n  after: number,\n): void {\n  while (true) {\n    const rows = tx.all<{\n      sequence: number;\n      created_at: number;\n      kind: ConversationEventKind;\n      payload: string;\n    }>(\n      'SELECT sequence,created_at,kind,payload FROM conversation_events WHERE conversation_id=? AND sequence>? ORDER BY sequence LIMIT ?',\n      [conversation_id, after, PROJECTION_BACKFILL_BATCH],\n    );\n    if (rows.length === 0) {\n      break;\n    }\n    for (const row of rows) {\n      append(\n        tx,\n        conversation_id,\n        row.sequence,\n        row.created_at,\n        conversation_event_payload_from_canonical_json(row.kind, row.payload),\n      );\n      after = row.sequence;\n    }\n  }\n}\nexport function repair_rest_line_after_deleting_rows(\n  tx: TransactionSql,\n  conversation_id: string,\n): void {\n  repair_rest_pointer(tx, conversation_id);\n  for (const referenced of rest_references(tx, conversation_id)) {\n    if (\n      tx.get(\n        'SELECT 1 FROM conversation_view_rows WHERE conversation_id=? AND sequence=? AND rest_summary IS NULL',\n        [conversation_id, referenced],\n      ) !== undefined\n    ) {\n      tx.run(\n        'UPDATE conversation_view_rows SET rest_summary=? WHERE conversation_id=? AND sequence=?',\n        [\n          rest_summary(tx, conversation_id, referenced, source(tx, conversation_id, referenced)),\n          conversation_id,\n          referenced,\n        ],\n      );\n    }\n  }\n}\nfunction repair_rest_pointer(tx: TransactionSql, conversation_id: string): void {\n  for (const lens of ['full', 'focus']) {\n    const column = `latest_${lens}_happened_sequence`;\n    const current = tx.get<{\n      value: number | null;\n    }>(`SELECT ${column} AS value FROM conversation_view_state WHERE conversation_id=?`, [\n      conversation_id,\n    ])!.value;\n    if (\n      current === null ||\n      tx.get(\n        'SELECT 1 FROM conversation_view_rows WHERE conversation_id=? AND sequence=? AND removed=0',\n        [conversation_id, current],\n      ) !== undefined\n    ) {\n      continue;\n    }\n    let found: number | null = null;\n    // The scoped SQL interface has no cursor. Keep the Python scan bounded in batches.\n    let before: number | null = null;\n    while (found === null) {\n      const rows: {\n        sequence: number;\n      }[] = tx.all<{\n        sequence: number;\n      }>(\n        'SELECT sequence FROM conversation_view_rows WHERE conversation_id=? AND removed=0 ' +\n          (lens === 'focus' ? 'AND focus_visible=1 ' : '') +\n          (before === null ? '' : 'AND sequence<? ') +\n          'ORDER BY sequence DESC LIMIT ?',\n        before === null\n          ? [conversation_id, PROJECTION_BACKFILL_BATCH]\n          : [conversation_id, before, PROJECTION_BACKFILL_BATCH],\n      );\n      if (rows.length === 0) {\n        break;\n      }\n      for (const row of rows) {\n        before = row.sequence;\n        if (event_has_rest_text(source(tx, conversation_id, row.sequence))) {\n          found = row.sequence;\n          break;\n        }\n      }\n    }\n    tx.run(`UPDATE conversation_view_state SET ${column}=? WHERE conversation_id=?`, [\n      found,\n      conversation_id,\n    ]);\n  }\n}\n"],"file":"/server/conversation/views/data/writer.ts"}