/** One application stop: graceful work, hard phase, then the external supervisor. */
const SHUTDOWN_GRACE_SECONDS = 30;
const SHUTDOWN_HARD_SECONDS = 45;
const SUPERVISOR_APP_STOP_SECONDS = 60;
const MAX_CONTROL_MESSAGE_BYTES = 4096;
const CONTROL_EXCHANGE_SECONDS = 10;
const STOP_INTENT_SECONDS = 5;
const CAPABILITY_FILENAME = "stop-capability.json";
const monotonic_seconds = () => performance.now() / 1e3;
/** One control exchange, APP fallback, then an exchange interval for cleanup. */
const MANAGED_STOP_CLIENT_SECONDS = SUPERVISOR_APP_STOP_SECONDS + 2 * CONTROL_EXCHANGE_SECONDS;
/** systemd applies this per phase. It is not a total-stop bound. */
const UNIT_TIMEOUT_STOP_SECONDS = SUPERVISOR_APP_STOP_SECONDS + SHUTDOWN_GRACE_SECONDS;
/** An owned child's stop: SIGTERM grace, then the wait after SIGKILL. */
const OWNED_PROCESS_STOP_GRACE_SECONDS = 2;
const OWNED_PROCESS_KILL_WAIT_SECONDS = 2;

