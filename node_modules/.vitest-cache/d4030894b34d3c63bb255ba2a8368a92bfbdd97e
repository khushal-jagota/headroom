rget, o.principal, d);\n}\nfunction require_field(d: WorkflowDefinition, field: string): void {\n  if (!d.fields.some((f) => f.id === field))\n    throw new PlannerError('validation', 'unknown ticket field', { field });\n}\nexport function decide_edit_settled_field(\n  ticket: Ticket,\n  o: Definition & {\n    field: string;\n    new_body: string;\n  },\n): Decision {\n  admission.validate_body(o.new_body, 'field value');\n  require_field(o.worker_type_definition, o.field);\n  if (ticket.field_values[o.field] === undefined)\n    throw new PlannerError(\n      'validation',\n      'field has no settled value to edit; a Stage still waiting for its answer is completed, not edited',\n      { field: o.field },\n    );\n  if (!machine.field_is_passed(o.field, ticket.stage, o))\n    throw new PlannerError('validation', 'field is not yet passed', { field: o.field });\n  const approvals = { ...ticket.field_approvals };\n  if (ticket.field_values[o.field] !== o.new_body) delete approvals[o.field];\n  return {\n    ...from_ticket(ticket),\n    field_values: { ...ticket.field_values, [o.field]: o.new_body },\n    field_approvals: approvals,\n  };\n}\nexport function decide_reject(\n  ticket: Ticket,\n  o: Definition & {\n    principal: Principal;\n    has_guidance: boolean;\n  },\n): Decision {\n  if (ticket.worker_step_claim === 'out')\n    throw new PlannerError(\n      'already_running',\n      'the ticket worker is already revising this proposal',\n    );\n  if (machine.stage_definition(o.worker_type_definition, ticket.stage).is_terminal)\n    throw new PlannerError('validation', 'terminal tickets cannot be rejected');\n  if (o.has_guidance && ticket.conversation_id === null)\n    throw new PlannerError('validation', 'ticket has no existing worker session');\n  const field = machine.gating_field(o.worker_type_definition, ticket.stage);\n  if (field === null) throw new PlannerError('validation', 'ticket has no approval item to reject');\n  pending(ticket, field, o.worker_typ