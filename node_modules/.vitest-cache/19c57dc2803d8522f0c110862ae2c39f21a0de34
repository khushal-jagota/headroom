const STOP_OBSERVATION_BATCH_SECONDS = .05;
const RECORD_ROOT_ENV = "PLAN_WORKER_PROCESS_ROOT";
/** The environment entry that points a launch at the canonical Worker process root. */
function worker_process_root_environment(root) {
