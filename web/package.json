{
  "name": "planner-web",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "../scripts/dev check-node web && ./node_modules/.bin/svelte-check --tsconfig ./tsconfig.json",
    "build": "../scripts/dev check-node web && ./node_modules/.bin/vite build",
    "preview": "../scripts/dev check-node web && ./node_modules/.bin/vite preview --host 127.0.0.1",
    "test:vitest": "../scripts/dev check-node web && ./node_modules/.bin/vitest run --typecheck",
    "test:legacy": "../scripts/dev npm --prefix web run test:browser",
    "test": "../scripts/dev npm --prefix web run test:vitest && ../scripts/dev npm --prefix web run test:browser",
    "test:browser": "../scripts/dev check-node web && node tests/browser/run.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tanstack/db": "0.15.0",
    "@tanstack/svelte-db": "0.5.10",
    "@tanstack/svelte-query": "6.1.38",
    "chart.js": "^4.5.1",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-remark": "10.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "svelte": "5.56.4",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "vite": "^6.1.0",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vitest": "4.1.10"
  }
}
