     1	"""Standalone resolution of the Hermes interpreter, source root, and planner
     2	home, plus a boot smoke-check. Deliberately independent of planner.core.config
     3	(this wave is additive; wiring into the core Config is a later wave).
     4	Nothing calls boot_smoke_check this wave; it is unit-tested via the fake
     5	spawn hook only — never with a real child inside pytest."""
     6	
     7	from __future__ import annotations
     8	
     9	import os
    10	from collections.abc import Mapping
    11	from pathlib import Path
    12	from typing import Final
    13	
    14	from planner.minds.gateway import READY_TIMEOUT_DEFAULT, GatewayChild, SpawnFn, spawn_popen
    15	
    16	DEFAULT_HERMES_PYTHON: Final = "~/.hermes/hermes-agent/venv/bin/python"
    17	DEFAULT_PLANNER_HOME: Final = "data/hermes-home"
    18	
    19	ENV_HERMES_PYTHON: Final = "PLAN_HERMES_PYTHON"
    20	ENV_PLANNER_HOME: Final = "PLAN_HERMES_HOME"
    21	
    22	
    23	def resolve_hermes_python(
    24	    value: str | None = None, env: Mapping[str, str] | None = None
    25	) -> Path:
    26	    """Resolve the Hermes interpreter: explicit value → env → default; then expanduser."""
    27	    source = env if env is not None else os.environ
    28	    chosen = value or source.get(ENV_HERMES_PYTHON) or DEFAULT_HERMES_PYTHON
    29	    return Path(chosen).expanduser()
    30	
    31	
    32	def hermes_src_root(hermes_python: Path | str) -> Path:
    33	    """~/.hermes/hermes-agent/venv/bin/python → ~/.hermes/hermes-agent.
    34	
    35	    Assumes the standard venv layout (parents[2]); a path too shallow for that
    36	    degrades to .parent. The result only feeds the HERMES_PYTHON_SRC_ROOT
    37	    sys.path hint (entry.py:4-12), so a weird path degrades gracefully.
    38	    """
    39	    path = Path(hermes_python).expanduser()
    40	    try:
    41	        return path.parents[2]
    42	    except IndexError:
    43	        return path.parent
    44	
    45	
    46	def resolve_planner_home(
    47	    value: str | None = None, env: Mapping[str, str] | None = None
    48	) -> Path:
    49	    """Resolve the planner home: explicit value → env → default; then expanduser."""
    50	    source = env if env is not None else os.environ
    51	    chosen = value or source.get(ENV_PLANNER_HOME) or DEFAULT_PLANNER_HOME
    52	    return Path(chosen).expanduser()
    53	
    54	
    55	def boot_smoke_check(
    56	    hermes_python: Path | None = None,
    57	    *,
    58	    spawn: SpawnFn = spawn_popen,
    59	    ready_timeout: float = READY_TIMEOUT_DEFAULT,
    60	    env: Mapping[str, str] | None = None,
    61	) -> None:
    62	    """Spawn → gateway.ready → clean exit. Raises GatewayError on any failure."""
    63	    python = hermes_python if hermes_python is not None else resolve_hermes_python()
    64	    base = dict(env if env is not None else os.environ)
    65	    base["HERMES_PYTHON_SRC_ROOT"] = str(hermes_src_root(python))
    66	    child = GatewayChild(str(python), base, spawn=spawn)
    67	    try:
    68	        child.wait_ready(ready_timeout)
    69	    finally:
    70	        child.shutdown()

