    89	def test_gateway_routes_response_and_events_independently() -> None:
    90	    fake = FakeGateway(
    91	        {
    92	            "ping": [
    93	                Reply(
    94	                    result={"pong": True},
    95	                    events_before=(ev("message.delta", LIVE_SID, {"text": "x"}),),
    96	                )
    97	            ]
    98	        }
    99	    )
   100	    child = gw(fake)
   101	    child.wait_ready(5.0)
   102	    resp = child.request("ping", timeout=5.0)
   103	    assert resp == {"pong": True}
   104	    evt = child.next_event(timeout=5.0)
   105	    assert evt == {"type": "message.delta", "session_id": LIVE_SID, "payload": {"text": "x"}}
   106	    child.shutdown()
