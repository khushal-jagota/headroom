   120	    def read_stdout(self) -> str | None:
   121	        item = self._out.get()
   122	        if item is None:
   123	            self._out.put(None)
   124	            return None
   125	        return item
   126	
   127	    def read_stderr(self) -> str | None:
   128	        item = self._err.get()
   129	        if item is None:
   130	            self._err.put(None)
   131	            return None
   132	        return item
   133	
   134	    def close_stdin(self) -> None:
   135	        self.closed = True
   136	        if not self._dead.is_set():
   137	            self._die()  # real gateway exits on stdin EOF (entry.py:344)
   138	
   139	    def kill(self) -> None:
   140	        self.closed = True
   141	        self._die()
   142	
   143	    def wait(self, timeout: float | None = None) -> int | None:
   144	        return 0 if self._exited.wait(timeout) else None
   145	
   146	    # --- internal ----------------------------------------------------------
   147	
   148	    def _die(self) -> None:
   149	        if self._dead.is_set():
   150	            return
   151	        self._dead.set()
   152	        self._exited.set()
   153	        self._err.put(None)
   154	        self._out.put(None)
   155	
   156	    # --- assertion helpers -------------------------------------------------
   157	
   158	    def sent_methods(self) -> list[str]:
   159	        return [str(frame.get("method")) for frame in self.sent]
   160	
   161	    def wait_sent(self, count: int, timeout: float = 5.0) -> bool:
   162	        with self._sent_cond:
   163	            return self._sent_cond.wait_for(lambda: len(self.sent) >= count, timeout)

