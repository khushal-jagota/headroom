   434	# --- queue (5 tests) -------------------------------------------------------
   435	
   436	
   437	class Job:
   438	    def __init__(self, name: str, hold: bool = False) -> None:
   439	        self.name = name
   440	        self.started = threading.Event()
   441	        self.release = threading.Event()
   442	        if not hold:
   443	            self.release.set()
   444	
   445	
   446	class Recorder:
   447	    def __init__(self) -> None:
   448	        self.lock = threading.Lock()
   449	        self.order: list[str] = []
   450	        self.inflight = 0
   451	        self.max_inflight = 0
   452	        self.errors: list[str] = []
   453	
   454	    def run(self, key: str, job: Job) -> None:
   455	        with self.lock:
   456	            self.inflight += 1
   457	            self.max_inflight = max(self.max_inflight, self.inflight)
   458	            self.order.append(job.name)
   459	        job.started.set()
   460	        if not job.release.wait(5.0):
   461	            with self.lock:
   462	                self.errors.append(f"{job.name}: release timeout")
   463	        with self.lock:
   464	            self.inflight -= 1
   465	
   466	
   467	def test_queue_same_key_serializes_fifo() -> None:
   468	    rec = Recorder()
   469	    q = MindQueue(rec.run)
   470	    key = "20260706_120000_aaaaaa"
   471	    a = Job("a", hold=True)
   472	    b = Job("b")
   473	    q.submit(key, a)
   474	    q.submit(key, b)
   475	    assert a.started.wait(5.0)
   476	    assert not b.started.is_set()  # b not started while a is held
   477	    a.release.set()
   478	    assert q.wait_idle(5.0)
   479	    assert rec.order == ["a", "b"]
   480	    assert rec.max_inflight == 1  # never two in flight for the same key
   481	    assert rec.errors == []
   482	
   483	
   484	def test_queue_different_keys_overlap() -> None:
   485	    rec = Recorder()
   486	    barrier = threading.Barrier(2)
   487	    errors: list[str] = []
   488	
   489	    def overlap_run(key: str, job: Job) -> None:
   490	        with rec.lock:
   491	            rec.inflight += 1
   492	            rec.max_inflight = max(rec.max_inflight, rec.inflight)
   493	            rec.order.append(job.name)
   494	        try:
   495	            barrier.wait(timeout=5.0)
   496	        except threading.BrokenBarrierError:
   497	            errors.append(f"{job.name}: barrier broke")
   498	        with rec.lock:
   499	            rec.inflight -= 1
   500	
   501	    q = MindQueue(overlap_run)
   502	    q.submit("20260706_120000_aaaaaa", Job("j1"))
   503	    q.submit("20260706_120000_bbbbbb", Job("j2"))
   504	    assert q.wait_idle(5.0)
   505	    assert errors == []  # the barrier passing proves both ran simultaneously
   506	    assert rec.max_inflight == 2
   507	
   508	
   509	def test_queue_fifo_order_many_and_key_reuse_after_drain() -> None:
   510	    rec = Recorder()
   511	    q = MindQueue(rec.run)
   512	    key = "20260706_120000_cccccc"
   513	    for name in ("a", "b", "c", "d"):
   514	        q.submit(key, Job(name))
   515	    assert q.wait_idle(5.0)
   516	    assert rec.order == ["a", "b", "c", "d"]
   517	    assert rec.max_inflight == 1
   518	    q.submit(key, Job("e"))  # a retired key spawns a fresh worker
   519	    assert q.wait_idle(5.0)
   520	    assert rec.order[-1] == "e"
   521	
   522	
   523	def test_queue_run_exception_does_not_stall_key() -> None:
   524	    rec = Recorder()
   525	
   526	    def flaky_run(key: str, job: Job) -> None:
   527	        if job.name == "boom":
   528	            raise RuntimeError("boom")
   529	        rec.run(key, job)
   530	
   531	    q = MindQueue(flaky_run)
   532	    key = "20260706_120000_dddddd"
   533	    q.submit(key, Job("boom"))
   534	    q.submit(key, Job("after"))
   535	    assert q.wait_idle(5.0)
   536	    assert "after" in rec.order  # the key survived the poisoned item
   537	
   538	
