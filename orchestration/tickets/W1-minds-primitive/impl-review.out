    26	HERMES_PY = "/x/hermes-agent/venv/bin/python"  # hermes_src_root -> /x/hermes-agent
    27	
    28	
    29	def create_reply(sid: str = LIVE_SID, key: str = STORED_KEY) -> Reply:
    30	    return Reply(
    31	        result={
    32	            "session_id": sid,
    33	            "stored_session_id": key,
    34	            "message_count": 0,
    35	            "messages": [],
    36	            "info": {"model": "fake"},
    37	        }
    38	    )
    39	
    40	
    41	def complete_ev(
    42	    sid: str = LIVE_SID, text: str = "hello", status: str = "complete"
    43	) -> dict[str, Any]:
    44	    return ev(
    45	        "message.complete",
    46	        sid,
    47	        {"text": text, "usage": {"input": 1, "output": 2}, "status": status},
    48	    )
    49	
    50	
    51	def submit_reply(
    52	    *events_after: dict[str, Any], events_before: tuple[dict[str, Any], ...] = ()
    53	) -> Reply:
    54	    return Reply(
    55	        result={"status": "streaming"},
    56	        events_before=events_before,
    57	        events_after=tuple(events_after),
    58	    )
    59	
    60	
    61	def gw(fake: FakeGateway) -> GatewayChild:
    62	    return GatewayChild(HERMES_PY, {}, spawn=fake.spawn)
    63	
    64	
    65	def run(
    66	    fake: FakeGateway,
    67	    session_key: str | None = None,
    68	    *,
    69	    role: str = "planner-worker",
    70	    on_event: Any = None,
    71	    **kw: Any,
    72	) -> RunResult:
    73	    return run_step(
    74	        session_key,
    75	        role,
    76	        "do the step",
    77	        on_event,
    78	        home="/tmp/planner-home",
    79	        hermes_python=HERMES_PY,
    80	        spawn=fake.spawn,
    81	        base_env={},
    82	        **kw,
    83	    )
    84	
