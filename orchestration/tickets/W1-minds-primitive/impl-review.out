   109	def test_gateway_out_of_order_responses_resolve_by_id() -> None:
   110	    fake = FakeGateway(
   111	        {
   112	            "first": [Reply()],  # neither result nor error -> NO response written
   113	            "second": [
   114	                Reply(
   115	                    frames=(
   116	                        {"jsonrpc": "2.0", "id": 2, "result": {"which": "second"}},
   117	                        {"jsonrpc": "2.0", "id": 1, "result": {"which": "first"}},
   118	                    )
   119	                )
   120	            ],
   121	        }
   122	    )
   123	    child = gw(fake)
   124	    child.wait_ready(5.0)
   125	    results: dict[str, dict[str, Any]] = {}
   126	
   127	    def call_first() -> None:
   128	        results["first"] = child.request("first", timeout=10.0)
   129	
   130	    t = threading.Thread(target=call_first)
   131	    t.start()
   132	    assert fake.wait_sent(1, 5.0)  # request 1 is on the wire before request 2
   133	    resp2 = child.request("second", timeout=10.0)
   134	    assert resp2 == {"which": "second"}
   135	    t.join(10.0)
   136	    assert not t.is_alive()
   137	    assert results["first"] == {"which": "first"}
   138	    child.shutdown()
   139	
