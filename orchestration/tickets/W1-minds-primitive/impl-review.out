 succeeded in 0ms:
     1	"""Per-mind serialized run queue: at most ONE in-flight run per key; different
     2	keys run concurrently; FIFO within a key. This is load-bearing correctness —
     3	the gateway's 4009 busy-guard is per-process only and cannot protect two
     4	child-per-run processes resuming the same stored session (notes.md:99-106).
     5	
     6	The key is the mind's durable Hermes ``session_key`` (its ``stored_session_id``).
     7	The queue guarantees at most one in-flight run per ``session_key``, FIFO within
     8	a key, and concurrency across keys. It is generic over the item type ``T`` and
     9	prescribes nothing about item contents; the run callable is injected.
    10	
    11	Step-0 runs (no ``session_key`` yet) are NOT routed through this queue in W1 —
    12	nothing invokes the queue this wave. Wave 3's wiring must serialize kickoff
    13	itself and should resolve the mind's current stored ``session_key`` at
    14	execution time (not capture it at enqueue), so queued step-0 work converges on
    15	the first created key.
    16	
    17	Module name note: ``planner.minds.queue`` cannot shadow the stdlib ``queue`` —
    18	Python 3 imports are absolute, so ``import queue`` anywhere (including in this
    19	package) resolves to the stdlib; this module is only reachable as
    20	``planner.minds.queue``.
    21	"""
    22	
    23	from __future__ import annotations
    24	
    25	import logging
    26	import threading
    27	from collections import deque
    28	from collections.abc import Callable
    29	
    30	_log = logging.getLogger(__name__)
    31	
    32	
    33	class MindQueue[T]:
    34	    """FIFO-per-key serialized runner: one worker thread per active key."""
    35	
    36	    def __init__(self, run: Callable[[str, T], None]) -> None:
    37	        self._run = run
    38	        self._lock = threading.Lock()
    39	        self._idle = threading.Condition(self._lock)
    40	        self._pending: dict[str, deque[T]] = {}
    41	        self._active: set[str] = set()
    42	
    43	    def submit(self, key: str, item: T) -> None:
    44	        if not key:
    45	            raise ValueError("queue key must be a non-empty string")
    46	        with self._lock:
    47	            self._pending.setdefault(key, deque()).append(item)
    48	            if key in self._active:
    49	                return
    50	            self._active.add(key)
    51	        threading.Thread(
    52	            target=self._drain, args=(key,), name=f"mind-queue-{key}", daemon=True
    53	        ).start()
    54	
    55	    def _drain(self, key: str) -> None:
    56	        while True:
    57	            with self._lock:
    58	                dq = self._pending.get(key)
    59	                if not dq:
    60	                    self._pending.pop(key, None)
    61	                    self._active.discard(key)
    62	                    self._idle.notify_all()
    63	                    return
    64	                item = dq.popleft()
    65	            try:
    66	                self._run(key, item)
    67	            except Exception:
    68	                _log.exception("mind run failed (key=%s)", key)
    69	
    70	    def wait_idle(self, timeout: float | None = None) -> bool:
    71	        with self._lock:
    72	            return self._idle.wait_for(lambda: not self._active, timeout)

