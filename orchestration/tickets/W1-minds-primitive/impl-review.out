    93	                    {
    94	                        "jsonrpc": "2.0",
    95	                        "id": rid,
    96	                        "error": {"code": -32601, "message": f"unknown method: {method}"},
    97	                    }
    98	                )
    99	            )
   100	            return
   101	        reply = replies.popleft()
   102	        for frame_before in reply.events_before:
   103	            self._out.put(json.dumps(frame_before))
   104	        if reply.result is not None:
   105	            self._out.put(json.dumps({"jsonrpc": "2.0", "id": rid, "result": reply.result}))
   106	        elif reply.error is not None:
   107	            code, message = reply.error
   108	            self._out.put(
   109	                json.dumps(
   110	                    {"jsonrpc": "2.0", "id": rid, "error": {"code": code, "message": message}}
   111	                )
   112	            )
   113	        for frame_after in reply.events_after:
   114	            self._out.put(json.dumps(frame_after))
