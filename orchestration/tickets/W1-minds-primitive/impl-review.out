   183	def test_gateway_child_death_fails_pending_and_wakes_events() -> None:
   184	    fake = FakeGateway({"boom": [Reply(die=True)]}, stderr_lines=("traceback: kaboom",))
   185	    child = gw(fake)
   186	    child.wait_ready(5.0)
   187	    with pytest.raises(GatewayError, match="died"):
   188	        child.request("boom", timeout=5.0)
   189	    assert child.next_event(timeout=5.0) is None
   190	    assert child.next_event(timeout=5.0) is None  # sentinel re-armed
   191	    child.shutdown()
   192	    assert child.stderr_tail() == ["traceback: kaboom"]
   193	    assert child.alive is False
