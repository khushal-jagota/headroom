  4493	@method("session.most_recent")
  4494	def _(rid, params: dict) -> dict:
  4495	    """Return the most recent human-facing session id, or ``None``.
  4496	
  4497	    Mirrors ``session.list``'s deny-list behaviour (drops ``tool``
  4498	    sub-agent rows).  Used by TUI auto-resume when
  4499	    ``display.tui_auto_resume_recent`` is on; the field is also handy
  4500	    for any CLI tooling that wants "latest session" without paginating
  4501	    the full list.
  4502	
  4503	    Contract: a ``{"session_id": null}`` result means "no eligible
  4504	    session found right now".  Errors are also folded into that
  4505	    null-result shape (and logged) so callers don't have to special-
  4506	    case JSON-RPC error envelopes for what is a normal "no answer".
  4507	    """
  4508	    db = _get_db()
  4509	    if db is None:
  4510	        return _ok(rid, {"session_id": None})
  4511	    try:
  4512	        deny = frozenset({"tool"})
  4513	        # Over-fetch by a generous bounded amount so heavy sub-agent
  4514	        # users (lots of recent ``tool`` rows) don't get a false
  4515	        # "no eligible session" answer.  ``session.list`` uses a
  4516	        # similar over-fetch strategy.
  4517	        rows = db.list_sessions_rich(source=None, limit=200)
  4518	        for row in rows:
  4519	            src = (row.get("source") or "").strip().lower()
  4520	            if src in deny:
  4521	                continue
  4522	            return _ok(
  4523	                rid,
  4524	                {
  4525	                    "session_id": row.get("id"),
  4526	                    "title": row.get("title") or "",
  4527	                    "started_at": row.get("started_at") or 0,
  4528	                    "source": row.get("source") or "",
  4529	                },
  4530	            )
  4531	        return _ok(rid, {"session_id": None})
  4532	    except Exception:
  4533	        logger.exception("session.most_recent failed")
  4534	        return _ok(rid, {"session_id": None})
