   400	## 4 · File: `src/planner/minds/fake.py`
   401	
   402	### Purpose
   403	
   404	A scriptable stand-in for the *process only*. It implements `ChildProcess`, so GatewayChild's
   405	real reader/router/pending machinery runs unchanged — the fake merely decides which frames appear
   406	on "stdout" in response to each request line. No subprocess, no model calls.
   407	
   408	### Public API (exact)
   409	
   410	```python
   411	"""Scriptable fake gateway child (test double). Implements the ChildProcess
   412	protocol so runner/queue/gateway tests exercise the real frame router with
   413	no subprocess and no model calls."""
   414	
   415	from __future__ import annotations
   416	
   417	import json
   418	import queue
   419	import threading
   420	from collections import deque
   421	from collections.abc import Mapping, Sequence
   422	from dataclasses import dataclass
   423	
   424	from planner.minds.gateway import ChildProcess, JsonDict
   425	
   426	
   427	def ev(type_: str, session_id: str | None = None, payload: JsonDict | None = None) -> JsonDict:
   428	    """Build an event frame exactly as server.py _emit does (server.py:803-807):
   429	    the payload key is OMITTED when payload is None; session_id omitted when None
   430	    (gateway.ready is the only such event — entry.py:316-322)."""
   431	
   432	
   433	@dataclass(frozen=True)
   434	class Reply:
   435	    result: JsonDict | None = None            # -> {"jsonrpc":"2.0","id":<rid>,"result":...}
   436	    error: tuple[int, str] | None = None      # -> {"jsonrpc":"2.0","id":<rid>,"error":{...}}
   437	    events_before: tuple[JsonDict, ...] = ()  # event frames written BEFORE the response
   438	    events_after: tuple[JsonDict, ...] = ()   # event frames written AFTER the response
   439	    frames: tuple[JsonDict | str, ...] = ()   # raw frames (dict) or raw lines (str), written last
   440	    die: bool = False                          # then: stdout EOF (child death)
   441	
   442	    def __post_init__(self) -> None: ...       # ValueError if both result and error given
   443	
   444	
   445	class FakeGateway:
   446	    def __init__(
   447	        self,
   448	        script: Mapping[str, Sequence[Reply]],
   449	        *,
   450	        ready: bool = True,
   451	        stderr_lines: Sequence[str] = (),
   452	    ) -> None: ...
   453	
   454	    # the spawn hook to inject: GatewayChild(..., spawn=fake.spawn)
   455	    def spawn(self, argv: list[str], env: dict[str, str]) -> ChildProcess: ...
   456	
   457	    # ChildProcess protocol
   458	    def send(self, line: str) -> None: ...
   459	    def read_stdout(self) -> str | None: ...
   460	    def read_stderr(self) -> str | None: ...
   461	    def close_stdin(self) -> None: ...
   462	    def kill(self) -> None: ...
   463	    def wait(self, timeout: float | None = None) -> int | None: ...
   464	
   465	    # assertion surface
   466	    sent: list[JsonDict]                # every parsed request frame, in arrival order
   467	    argv: list[str] | None              # recorded by spawn()
   468	    env: dict[str, str] | None          # recorded by spawn()
   469	    closed: bool                        # close_stdin() or kill() was called
   470	    def sent_methods(self) -> list[str]: ...
   471	    def wait_sent(self, count: int, timeout: float = 5.0) -> bool: ...
   472	```
   473	
   474	### Mechanics
   475	
   476	- `__init__`: copy the script into `dict[str, deque[Reply]]`; create `_out: queue.Queue[str | None]`
   477	  and `_err: queue.Queue[str | None]`; preload `_err` with `stderr_lines`; if `ready`, put the
   478	  `gateway.ready` line — `json.dumps(ev("gateway.ready", None, {"skin": "fake"}))` — onto `_out`.
   479	  `_sent_cond = threading.Condition()`; `_exited = threading.Event()`.
   480	- `spawn(argv, env)`: record `argv`/`env` (assertion surface for role/home/context env), return
   481	  `self`. One FakeGateway = one child; a test that needs two children builds two fakes (the queue
   482	  tests don't use fakes at all, and run_step spawns exactly one child).
   483	- `send(line)`: if stdin closed or dead → `raise BrokenPipeError("fake stdin closed")` (mirrors a
   484	  real dead pipe, keeps shutdown-then-request loud). Parse the line; under `_sent_cond`: append to
   485	  `sent`, `notify_all()`. Look up `script[method]` and `popleft()`; if the method is unscripted or
   486	  exhausted → auto-respond `{"error": {"code": -32601, "message": f"unknown method: {method}"}}`
   487	  (mirrors server.py:910 — unscripted calls fail loud but structured, never hang). For a `Reply`:
   488	  write `events_before` lines → the response line (with the request's own `id`; skipped when
   489	  neither `result` nor `error` is set) → `events_after` lines → `frames` entries (dict →
   490	  `json.dumps`, str → verbatim line) → if `die`: `_die()`.
   491	- `_die()`: set dead flag; `_exited.set()`; put `None` on `_err`; put `None` on `_out`.
   492	- `close_stdin()`: `closed = True`; if not already dead → `_die()` (the real gateway exits on
   493	  stdin EOF, entry.py:344 — so the fake's reader threads also wind down and `wait` returns 0).
   494	- `kill()`: `closed = True`; `_die()`.
   495	- `read_stdout()`: `item = self._out.get()`; if `None` → re-put and return `None`; else return it.
   496	  Same for `read_stderr()`.
   497	- `wait(timeout)`: return `0` if `_exited.wait(timeout)` else `None`.
   498	- `wait_sent(count, timeout)`: `with self._sent_cond: return self._sent_cond.wait_for(lambda: len(self.sent) >= count, timeout)`.
   499	
   500	Note for the implementer: `send()` runs on the requester's thread and only *enqueues* stdout
   501	lines; GatewayChild's reader thread consumes them. Cross-thread routing is therefore genuinely
   502	exercised even though the fake itself is synchronous and deterministic.
   503	
   504	---
