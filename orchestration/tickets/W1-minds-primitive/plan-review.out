   920	## 9 · File: `tests/unit/test_minds.py`
   921	
   922	Standalone: uses NO conftest fixture (do not touch `tests/unit/conftest.py`), no DB, no
   923	subprocess, no real gateway, no network. Deterministic threading only: `threading.Event` /
   924	`Condition.wait_for` / `Barrier` / `join` with generous timeouts (5s) — **no `time.sleep` as
   925	synchronization anywhere**. Every test has real assertions (the verify skip-scan fails the build
   926	on skip/xfail/empty/commented tests — scripts/verify_lib.py:24-101).
   927	
   928	Module header + shared helpers:
   929	
   930	```python
   931	"""W1 minds primitive: gateway frame routing, run_step status mapping, the
   932	per-mind serialized queue, and config resolution — all against the fake
   933	gateway double (no subprocess, no model calls)."""
   934	
   935	from __future__ import annotations
   936	
   937	import threading
   938	from pathlib import Path
   939	from typing import Any
   940	
   941	import pytest
   942	
   943	from planner.minds.config import (
   944	    boot_smoke_check, hermes_src_root, resolve_hermes_python, resolve_planner_home,
   945	)
   946	from planner.minds.fake import FakeGateway, Reply, ev
   947	from planner.minds.gateway import GatewayChild, GatewayError, GatewayRpcError
   948	from planner.minds.queue import MindQueue
   949	from planner.minds.runner import RunResult, run_step
   950	
   951	LIVE_SID = "ab12cd34"
   952	STORED_KEY = "20260706_120000_abcdef"
   953	HERMES_PY = "/x/hermes-agent/venv/bin/python"   # hermes_src_root -> /x/hermes-agent
   954	
   955	
   956	def create_reply(sid: str = LIVE_SID, key: str = STORED_KEY) -> Reply:
   957	    return Reply(result={
   958	        "session_id": sid, "stored_session_id": key,
   959	        "message_count": 0, "messages": [], "info": {"model": "fake"},
   960	    })
   961	
   962	def complete_ev(sid: str = LIVE_SID, text: str = "hello", status: str = "complete") -> dict[str, Any]:
   963	    return ev("message.complete", sid, {"text": text, "usage": {"input": 1, "output": 2}, "status": status})
   964	
   965	def submit_reply(*events_after: dict[str, Any], events_before: tuple[dict[str, Any], ...] = ()) -> Reply:
   966	    return Reply(result={"status": "streaming"}, events_before=events_before, events_after=tuple(events_after))
   967	
   968	def gw(fake: FakeGateway) -> GatewayChild:
   969	    return GatewayChild(HERMES_PY, {}, spawn=fake.spawn)
   970	
   971	def run(fake: FakeGateway, session_key: str | None = None, *, role: str = "planner-worker",
   972	        on_event=None, **kw: Any) -> RunResult:
   973	    return run_step(session_key, role, "do the step", on_event,
   974	                    home="/tmp/planner-home", hermes_python=HERMES_PY,
   975	                    spawn=fake.spawn, base_env={}, **kw)
   976	```
   977	
   978	(Tests are outside mypy scope — `files=["src"]` — so helper annotations are style, not gate.)
   979	
   980	### Gateway routing (6 tests)
