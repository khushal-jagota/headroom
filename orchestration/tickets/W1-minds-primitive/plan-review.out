  4634	        # A lazy watch session never owns a run loop, so its payload's running
  4635	        # flag is always False — overlay the child-run registry so a reconnecting
  4636	        # watch window keeps its busy indicator while the child is still mid-run.
  4637	        if session.get("agent") is None and _child_run_active(target):
  4638	            payload["running"] = True
  4639	            payload["status"] = "streaming"
  4640	        return payload

