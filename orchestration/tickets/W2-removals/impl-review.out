   294	@router.patch("/sprints/{sprint_id}")
   295	async def patch_sprint(sprint_id: str, body: dict[str, Any], conn: DbConn, ctx: Ctx,
   296	                       clk: Clk) -> JsonDict:
   297	    reject_agents(ctx)  # §8: agents get `sprint show` only — no sprint edit surface.
   298	    recognized = set(_SPRINT_TEXT_FIELDS) | {"date_start", "date_end"}
   299	    for key in body:
   300	        if key not in recognized:
   301	            raise PlannerError(ErrorCode.validation, "unknown sprint field", {"field": key})
   302	    # Marshal each field to a string, mirroring the Day PATCH: a null or non-string
   303	    # value raises the validation envelope instead of hitting the NOT NULL constraint
   304	    # or a raw SQLite binding error. A null is treated as absent (skipped).
   305	    edits: dict[str, str] = {}
   306	    for field in _SPRINT_TEXT_FIELDS:
   307	        value = body_opt_str(body, field)
   308	        if value is not None:
   309	            edits[field] = value
   310	    setting_dates = "date_start" in body or "date_end" in body
   311	    if not edits and not setting_dates:
   312	        raise PlannerError(ErrorCode.validation, "no sprint fields to update", {})
   313	    for field, value in edits.items():
   314	        sprints_data.update_sprint_field(conn, sprint_id, field, value, clock=clk)
   315	    if setting_dates:
   316	        _set_sprint_dates(
   317	            conn, sprint_id,
   318	            date_start=body_opt_str(body, "date_start"),
   319	            date_end=body_opt_str(body, "date_end"),
   320	            clock=clk,
   321	        )
   322	    return sprints_views.sprint_json(sprints_data.read_sprint(conn, sprint_id))
