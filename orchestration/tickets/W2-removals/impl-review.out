    83	def _create_idea(conn: sqlite3.Connection, *, title: str, body: str, project: Project | None,
    84	                 now: int) -> JsonDict:
    85	    if not title:
    86	        raise PlannerError(ErrorCode.validation, "idea title is required", {})
    87	    idea_id = new_id(ID_PREFIXES["idea"])
    88	    with txn(conn):
    89	        conn.execute(
    90	            "INSERT INTO ideas (id, title, body, project, created_at, updated_at) "
    91	            "VALUES (?, ?, ?, ?, ?, ?)",
    92	            (idea_id, title, body, project.value if project is not None else None, now, now),
    93	        )
    94	        append_event(conn, idea_id, EventKind.idea_created, {"title": title, "source": "api"}, now)
    95	    row = conn.execute("SELECT * FROM ideas WHERE id = ?", (idea_id,)).fetchone()
    96	    assert row is not None
    97	    return sprints_views.idea_json(row)
