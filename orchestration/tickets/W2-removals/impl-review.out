   194	
   195	    supersede_events = _events(tmp_db, item.id, "proposal_superseded")
   196	    assert supersede_events == [
   197	        {
   198	            "field": "status",
   199	            "replaced_body": {
   200	                "to_status": "done",
   201	                "note": "d1",
   202	                "proposed_by": "agent-x",
   203	                "created_at": fake_clock.now_unix(),
   204	            },
   205	        },
   206	    ]
   207	
   208	    assert superseded.status is ItemStatus.active
   209	    assert superseded.status_proposal is not None
   210	    assert superseded.status_proposal.to_status is ItemStatus.deferred_next_sprint
   211	
   212	    # Accept the surviving proposal -> deferred_next_sprint, proposal cleared.
   213	    accepted = accept_item_status(tmp_db, item.id, clock=fake_clock)
   214	    assert accepted.status is ItemStatus.deferred_next_sprint
   215	    assert accepted.status_proposal is None
