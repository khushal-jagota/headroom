   110	  from_id TEXT NOT NULL,
   111	  to_id   TEXT NOT NULL,
   112	  kind    TEXT NOT NULL CHECK (kind IN ('belongs_to','parent_child','blocks','relates')),
   113	  PRIMARY KEY (from_id, to_id, kind),
