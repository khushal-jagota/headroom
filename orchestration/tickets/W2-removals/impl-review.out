   176	# --- supplementary sprints-domain tests (no fence anchor) -------------------------
   177	
   178	
   179	def test_x06_item_proposal_supersedes_prior(tmp_db, fake_clock) -> None:
   180	    item = create_item(tmp_db, title="x", project=Project.Vylo, clock=fake_clock)
   181	    transition_item_status(tmp_db, item.id, ItemStatus.active, clock=fake_clock)
