    19	
    20	@dataclass
    21	class FakeSpawnAdapter:
    22	    calls: list[SpawnRequest] = field(default_factory=list)
    23	    results: list[SpawnResult] = field(default_factory=list)  # scripted, popped FIFO
    24	    next_pid: int = _FIRST_FAKE_PID
    25	
    26	    def spawn(self, request: SpawnRequest) -> SpawnResult:
    27	        self.calls.append(request)
    28	        if self.results:
    29	            return self.results.pop(0)
    30	        pid = self.next_pid
    31	        self.next_pid += 1
    32	        return SpawnResult(ok=True, pid=pid)
    33	
    34	    def is_pid_alive(self, _pid: int) -> bool:
    35	        # Fakes never spawn a real process, so a fake pid is always "alive". The
    36	        # dispatcher's test-mode path uses _pid_alive_always regardless (§7.4); this
    37	        # only exists so the fake satisfies the SpawnAdapter protocol.
    38	        return True
    39	
    40	    def reap_finished_children(self) -> None:
    41	        # Nothing was ever really spawned, so there is nothing to reap.
    42	        return None
