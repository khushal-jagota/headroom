    30	def _mk_ticket(
    31	    conn: Connection,
    32	    ticket_id: str,
    33	    *,
    34	    state: str,
    35	    title: str,
    36	    priority: str = "P3",
    37	    deadline: str | None = None,
    38	) -> None:
    39	    """Insert the minimal NOT-NULL columns of a ticket; other columns use their
    40	    schema defaults."""
    41	    conn.execute(
    42	        "INSERT INTO tickets (id, title, state, priority, deadline, project, "
    43	        "created_at, updated_at) VALUES (?, ?, ?, ?, ?, 'Vylo', 0, 0)",
    44	        (ticket_id, title, state, priority, deadline),
    45	    )
    46	
    47	
    48	@dataclass
    49	class RecordingBoundaryAdapter:
    50	    """A recording fake (no OS/network): records method names AND the received
    51	    BoundaryInputs, and fills the four overview fields keyed off the planning date
    52	    exactly like the shared FakeBoundaryAdapter."""
    53	
    54	    calls: list[str] = field(default_factory=list)
    55	    received: list[BoundaryInputs] = field(default_factory=list)
    56	
    57	    def judgment(self, inputs: BoundaryInputs) -> BoundaryJudgment:
    58	        self.calls.append("judgment")
    59	        self.received.append(inputs)
    60	        return BoundaryJudgment(
    61	            focus=f"Focus for {inputs.planning_date}",
    62	            brief_take=f"Take for {inputs.planning_date}",
    63	            watchout=f"Watch for {inputs.planning_date}",
    64	            if_today_lands=f"Lands for {inputs.planning_date}",
    65	        )
    66	
