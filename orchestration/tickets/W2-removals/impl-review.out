   210	@router.patch("/items/{item_id}")
   211	async def patch_item(item_id: str, body: dict[str, Any], conn: DbConn, ctx: Ctx,
   212	                     clk: Clk) -> JsonDict:
   213	    recognized = set(_ITEM_PLAIN_FIELDS) | {"sprint_id", "status", "blocked_by"}
   214	    for key in body:
   215	        if key not in recognized:
   216	            raise PlannerError(ErrorCode.validation, "unknown item field", {"field": key})
   217	    if not body:
   218	        raise PlannerError(ErrorCode.validation, "no item fields to update", {})
   219	    if "blocked_by" in body and "status" not in body:
   220	        raise PlannerError(ErrorCode.validation, "blocked_by requires status", {})
   221	    # §3.2/§8: an agent's only item write surface is the status transition (todo↔active,
   222	    # blocked); plain fields and sprint moves are human-only.
   223	    reject_agent_fields(ctx, body, set(_ITEM_PLAIN_FIELDS) | {"sprint_id"})
   224	    for field in _ITEM_PLAIN_FIELDS:
   225	        if field in body:
   226	            if field == "deadline":
   227	                _marshal_item_deadline(body["deadline"])
   228	            sprints_data.update_item_field(conn, item_id, field, body[field], clock=clk)
   229	    if "sprint_id" in body:
   230	        sprints_data.assign_item_sprint(conn, item_id, body["sprint_id"], clock=clk)
   231	    if "status" in body:
   232	        to_status = parse_enum(ItemStatus, body["status"], "status")
   233	        sprints_data.transition_item_status(
   234	            conn, item_id, to_status, clock=clk, by_agent=not ctx.is_human,
   235	            blocked_by=body.get("blocked_by"),
   236	        )
   237	    return sprints_views.item_detail(conn, item_id)
   238	
