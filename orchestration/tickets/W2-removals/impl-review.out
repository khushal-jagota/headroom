     1	"""The boundary job (§6.2). Runs once per planning date, guarded by whether the
     2	new day is already materialized. Deterministic pass (materialize the day,
     3	carryover, overdue, approvals, close yesterday) then one adapter judgment call
     4	wrapped in a caller-owned timeout. On failure/timeout the day survives with an
     5	empty overview. Judgment is skipped entirely when the human already planned the
     6	day."""
     7	
     8	from __future__ import annotations
     9	
    10	import json
    11	import sqlite3
    12	from concurrent.futures import ThreadPoolExecutor
    13	from concurrent.futures import TimeoutError as FuturesTimeout
    14	from datetime import timedelta
    15	from typing import Any
    16	
    17	from planner.core.adapters.base import BoundaryAdapter, BoundaryInputs, BoundaryJudgment
    18	from planner.core.clock import Clock
    19	from planner.core.config import Config
    20	from planner.core.contracts import EventKind
    21	from planner.core.events import append_event
    22	from planner.core.ids import day_id
    23	from planner.days.data import materialize_day, store_judgment
    24	from planner.days.logic.carryover import (
    25	    approvals_digest,
    26	    carryover_candidates,
    27	    day_ticket_counts,
    28	    overdue_list,
    29	)
    30	from planner.days.logic.dates import planning_date
    31	
    32	
    33	def run_boundary(
    34	    conn: sqlite3.Connection, clock: Clock, config: Config, adapter: BoundaryAdapter
    35	) -> str | None:
    36	    """One boundary tick. Idempotent per planning date via the next-day-materialized
    37	    guard, so the stage-4 scheduler may call it every tick — only the first tick that
    38	    finds the new day absent does work (planning_date only becomes the new date
    39	    at/after boundary_hour, satisfying §6.2 'first tick at/after the boundary hour').
    40	
    41	    Returns the outcome: None on a guarded skip (the next day is already
    42	    materialized), "skipped" when a human already planned the day, "failed" on
    43	    judgment failure/timeout, "ok" on success."""
    44	    pd = planning_date(clock.now(), config.boundary_hour)
    45	    piso = pd.isoformat()
    46	    ndid = day_id(pd)
    47	    if _next_day_materialized(conn, ndid):
    48	        return None
    49	
    50	    now = clock.now_unix()
    51	    yid = day_id(pd - timedelta(days=1))
    52	
    53	    # Deterministic pass — always runs on a first tick.
    54	    materialize_day(conn, ndid, now)
    55	    yts = _read_yesterday_tickets(conn, yid)
    56	    carry = carryover_candidates(yts)
    57	    overdue_tickets, overdue_items = _read_overdue_candidates(conn)
    58	    overdue = overdue_list(overdue_tickets, overdue_items, piso)
    59	    approval_tickets, approval_items = _read_approval_candidates(conn)
    60	    approvals = approvals_digest(approval_tickets, approval_items)
    61	    done, not_done = day_ticket_counts(yts)
    62	    append_event(
    63	        conn,
    64	        yid,
    65	        EventKind.day_closed,
    66	        {"done_count": done, "not_done_count": not_done},
    67	        now,
    68	    )
    69	
    70	    # Skip check (§6.2 last paragraph): a human already planned this day.
    71	    if _human_planned(conn, ndid):
    72	        return "skipped"
    73	
    74	    # Judgment pass — one adapter call under a caller-owned timeout.
    75	    inputs = BoundaryInputs(
    76	        planning_date=piso, carryover=carry, overdue=overdue, approvals_digest=approvals
    77	    )
    78	    timeout_s = config.boundary_timeout_seconds
    79	    try:
    80	        judgment = _judgment_with_timeout(adapter, inputs, timeout_s)
    81	    except Exception as exc:  # timeout OR any adapter raise; day survives empty
    82	        append_event(
    83	            conn, ndid, EventKind.boundary_failed, {"error": _error_text(exc, timeout_s)}, now
    84	        )
    85	        return "failed"
    86	
    87	    store_judgment(
    88	        conn, ndid, judgment.focus, judgment.brief_take, judgment.watchout,
    89	        judgment.if_today_lands, now,
    90	    )
    91	    # The overview was authored — one day_updated so an open Day page refetches.
    92	    append_event(
    93	        conn, ndid, EventKind.day_updated, {"field": "overview", "cause": "boundary"}, now
    94	    )
    95	    return "ok"
    96	
    97	
    98	def _next_day_materialized(conn: sqlite3.Connection, new_day_id: str) -> bool:
    99	    """True iff the new planning day's row already exists. Replaces the boundary_runs
   100	    dedup guard: the deterministic pass materializes the day as its first step, so a
   101	    present day means the boundary already ran for this date — once-per-date
   102	    idempotence without a side table."""
   103	    return conn.execute(
   104	        "SELECT 1 FROM days WHERE id = ?", (new_day_id,)
   105	    ).fetchone() is not None
   106	
   107	
   108	def _read_yesterday_tickets(conn: sqlite3.Connection, yesterday_id: str) -> list[dict[str, Any]]:
   109	    rows = conn.execute(
   110	        "SELECT t.id AS id, t.title AS title, t.state AS state, t.priority AS priority "
   111	        "FROM day_tickets dt JOIN tickets t ON t.id = dt.ticket_id "
   112	        "WHERE dt.day_id = ? ORDER BY dt.position",
   113	        (yesterday_id,),
   114	    ).fetchall()
   115	    return [
   116	        {"id": r["id"], "title": r["title"], "state": r["state"], "priority": r["priority"]}
   117	        for r in rows
   118	    ]
   119	
   120	
   121	def _read_overdue_candidates(
   122	    conn: sqlite3.Connection,
   123	) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
   124	    tickets: list[dict[str, Any]] = [
   125	        {
   126	            "id": r["id"],
   127	            "title": r["title"],
   128	            "state": r["state"],
   129	            "priority": r["priority"],
   130	            "deadline": r["deadline"],
   131	        }
   132	        for r in conn.execute(
   133	            "SELECT id, title, state, priority, deadline FROM tickets"
   134	        ).fetchall()
   135	    ]
   136	    items: list[dict[str, Any]] = [
   137	        {
   138	            "id": r["id"],
   139	            "title": r["title"],
   140	            "status": r["status"],
   141	            "priority": r["priority"],
   142	            "deadline": r["deadline"],
   143	        }
   144	        for r in conn.execute(
   145	            "SELECT id, title, status, priority, deadline FROM sprint_items"
   146	        ).fetchall()
   147	    ]
   148	    return tickets, items
   149	
   150	
   151	def _read_approval_candidates(
   152	    conn: sqlite3.Connection,
   153	) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
   154	    tickets: list[dict[str, Any]] = [
   155	        {
   156	            "id": r["id"],
   157	            "state": r["state"],
   158	            "fields": json.loads(r["fields"]),
   159	            "updated_at": r["updated_at"],
   160	        }
   161	        for r in conn.execute("SELECT id, state, fields, updated_at FROM tickets").fetchall()
   162	    ]
   163	    items: list[dict[str, Any]] = []
   164	    for r in conn.execute("SELECT id, status_proposal FROM sprint_items").fetchall():
   165	        raw = r["status_proposal"]
   166	        items.append(
   167	            {"id": r["id"], "status_proposal": json.loads(raw) if raw is not None else None}
   168	        )
   169	    return tickets, items
   170	
   171	
   172	def _human_planned(conn: sqlite3.Connection, new_day_id: str) -> bool:
   173	    """True iff a day-ticket already sits on the new day (§6.2: a human-placed
   174	    day-ticket skips the judgment pass). NOTE: adding a day-ticket also materializes
   175	    its day, so the _next_day_materialized top guard trips first in that case (the
   176	    accepted edge, removal-plan §14.4); this stays as the documented skip check."""
   177	    return conn.execute(
   178	        "SELECT 1 FROM day_tickets WHERE day_id = ? LIMIT 1", (new_day_id,)
   179	    ).fetchone() is not None
   180	
   181	
   182	def _judgment_with_timeout(
   183	    adapter: BoundaryAdapter, inputs: BoundaryInputs, timeout_s: int
   184	) -> BoundaryJudgment:
   185	    """Run adapter.judgment in a worker thread; the CALLER owns the timeout
   186	    (base.py). result(timeout=...) raises FuturesTimeout on timeout and re-raises
   187	    any adapter exception — both are caught by run_boundary. shutdown(wait=False)
   188	    so a hung adapter cannot block run_boundary past the configured timeout; the
   189	    abandoned worker thread is left to finish on its own."""
   190	    executor = ThreadPoolExecutor(max_workers=1)
   191	    try:
   192	        return executor.submit(adapter.judgment, inputs).result(timeout=timeout_s)
   193	    finally:
   194	        executor.shutdown(wait=False, cancel_futures=True)
   195	
   196	
   197	def _error_text(exc: Exception, timeout_s: int) -> str:
   198	    if isinstance(exc, FuturesTimeout):
   199	        return f"boundary judgment timed out after {timeout_s}s"
   200	    return str(exc) or exc.__class__.__name__

