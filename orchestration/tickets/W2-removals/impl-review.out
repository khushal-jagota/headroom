    68	def test_a01_planning_date(cfg: Config) -> None:
    69	    # 04:59 belongs to the previous planning date; 05:00 to the new one.
    70	    assert planning_date(datetime(2026, 7, 5, 4, 59), cfg.boundary_hour) == date(2026, 7, 4)
    71	    assert planning_date(datetime(2026, 7, 5, 5, 0), cfg.boundary_hour) == date(2026, 7, 5)
    72	    # Boundary hour honored from config.
    73	    assert cfg.boundary_hour == 5
    74	    # Same instant, three hours → three results ⇒ the hour is load-bearing.
    75	    assert planning_date(datetime(2026, 7, 5, 5, 0), 6) == date(2026, 7, 4)
    76	    assert planning_date(datetime(2026, 7, 5, 5, 0), 0) == date(2026, 7, 5)
    77	
