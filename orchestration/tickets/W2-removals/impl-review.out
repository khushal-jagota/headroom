   101	def item_tickets(conn: sqlite3.Connection, item_id: str) -> list[JsonDict]:
   102	    """Per-item ticket rows for the tracking-page disclosure: id/title/state/priority,
   103	    ordered created_at, id (matching the loose-ticket ordering). A light projection —
   104	    not full ticket_json — since the disclosure only lists rows that link to the ticket."""
   105	    rows = conn.execute(
   106	        "SELECT id, title, state, priority FROM tickets WHERE sprint_item_id = ? "
   107	        "ORDER BY created_at, id",
   108	        (item_id,),
   109	    ).fetchall()
   110	    return [
   111	        {
   112	            "id": str(r["id"]),
   113	            "title": str(r["title"]),
   114	            "state": str(r["state"]),
   115	            "priority": str(r["priority"]),
   116	        }
   117	        for r in rows
   118	    ]
