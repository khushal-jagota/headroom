    90	def item_rollup(conn: sqlite3.Connection, item_id: str) -> dict[str, int]:
    91	    rollup: dict[str, int] = {s.value: 0 for s in TicketState}
    92	    rows = conn.execute(
    93	        "SELECT state, COUNT(*) AS n FROM tickets WHERE sprint_item_id = ? GROUP BY state",
    94	        (item_id,),
    95	    ).fetchall()
    96	    for r in rows:
    97	        rollup[str(r["state"])] = int(r["n"])
    98	    return rollup
