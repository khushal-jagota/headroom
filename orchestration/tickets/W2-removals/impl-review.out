     1	"""The day data layer. Materializes a day on first read/write (no "missing day"
     2	state), owns the ordered day-ticket list (contiguous positions from 0), and the
     3	overview-field/notes writes. Every state transition here appends exactly one
     4	canonical event. No FastAPI/pydantic; times come in as unix-second ints from the
     5	caller's clock."""
     6	
     7	from __future__ import annotations
     8	
     9	import sqlite3
    10	
    11	from planner.core.contracts import EventKind
    12	from planner.core.events import append_event
    13	from planner.days.contracts import Day, DayTicket
    14	
    15	
    16	def materialize_day(conn: sqlite3.Connection, day_id: str, now_unix: int) -> None:
    17	    """§3.4: create the day row if absent (all overview fields + notes = '',
    18	    chat_session_key=NULL, created_at=updated_at=now_unix) and append a
    19	    day_created event. Idempotent: a present day → no write, no event."""
    20	    if conn.execute("SELECT 1 FROM days WHERE id = ?", (day_id,)).fetchone() is not None:
    21	        return
    22	    conn.execute(
    23	        "INSERT INTO days (id, focus, brief_take, watchout, if_today_lands, notes, "
    24	        "chat_session_key, created_at, updated_at) "
    25	        "VALUES (?, '', '', '', '', '', NULL, ?, ?)",
    26	        (day_id, now_unix, now_unix),
    27	    )
    28	    append_event(conn, day_id, EventKind.day_created, {}, now_unix)
    29	
    30	
    31	def read_day(conn: sqlite3.Connection, day_id: str, now_unix: int) -> Day:
    32	    """§3.4 'reading a nonexistent day materializes it empty'. Materializes, then
    33	    SELECTs the row and builds a Day."""
    34	    materialize_day(conn, day_id, now_unix)
    35	    row = conn.execute(
    36	        "SELECT id, focus, brief_take, watchout, if_today_lands, notes, "
    37	        "chat_session_key, created_at, updated_at "
    38	        "FROM days WHERE id = ?",
    39	        (day_id,),
    40	    ).fetchone()
    41	    assert row is not None
    42	    return Day(
    43	        id=row["id"],
    44	        focus=row["focus"],
    45	        brief_take=row["brief_take"],
    46	        watchout=row["watchout"],
    47	        if_today_lands=row["if_today_lands"],
    48	        notes=row["notes"],
    49	        chat_session_key=row["chat_session_key"],
    50	        created_at=row["created_at"],
    51	        updated_at=row["updated_at"],
    52	    )
    53	
    54	
    55	def list_day_tickets(conn: sqlite3.Connection, day_id: str) -> list[DayTicket]:
    56	    """day_tickets for the day, ordered by position (contiguous from 0)."""
    57	    rows = conn.execute(
    58	        "SELECT day_id, ticket_id, position FROM day_tickets WHERE day_id = ? ORDER BY position",
    59	        (day_id,),
    60	    ).fetchall()
    61	    return [
    62	        DayTicket(day_id=row["day_id"], ticket_id=row["ticket_id"], position=row["position"])
    63	        for row in rows
    64	    ]
    65	
    66	
    67	def store_judgment(
    68	    conn: sqlite3.Connection,
    69	    day_id: str,
    70	    focus: str,
    71	    brief_take: str,
    72	    watchout: str,
    73	    if_today_lands: str,
    74	    now_unix: int,
    75	) -> None:
    76	    """Boundary success path: write the four overview fields the boundary filled +
    77	    updated_at in one UPDATE. No event; run_boundary emits the day_updated signal."""
    78	    conn.execute(
    79	        "UPDATE days SET focus = ?, brief_take = ?, watchout = ?, if_today_lands = ?, "
    80	        "updated_at = ? WHERE id = ?",
    81	        (focus, brief_take, watchout, if_today_lands, now_unix, day_id),
    82	    )
    83	
    84	
    85	def add_day_ticket(
    86	    conn: sqlite3.Connection, day_id: str, ticket_id: str, now_unix: int, cause: str = "manual"
    87	) -> bool:
    88	    """§3.4: append at end with the next contiguous position (= current count).
    89	    Idempotent: if (day_id, ticket_id) already present → return False, no event.
    90	    On add → INSERT, append day_ticket_added {ticket_id, position, cause}, bump
    91	    updated_at, return True. Materializes the day first (write path)."""
    92	    materialize_day(conn, day_id, now_unix)
    93	    present = conn.execute(
    94	        "SELECT 1 FROM day_tickets WHERE day_id = ? AND ticket_id = ?",
    95	        (day_id, ticket_id),
    96	    ).fetchone()
    97	    if present is not None:
    98	        return False
    99	    position = conn.execute(
   100	        "SELECT COUNT(*) AS n FROM day_tickets WHERE day_id = ?", (day_id,)
   101	    ).fetchone()["n"]
   102	    conn.execute(
   103	        "INSERT INTO day_tickets (day_id, ticket_id, position) VALUES (?, ?, ?)",
   104	        (day_id, ticket_id, position),
   105	    )
   106	    append_event(
   107	        conn,
   108	        day_id,
   109	        EventKind.day_ticket_added,
   110	        {"ticket_id": ticket_id, "position": position, "cause": cause},
   111	        now_unix,
   112	    )
   113	    conn.execute("UPDATE days SET updated_at = ? WHERE id = ?", (now_unix, day_id))
   114	    return True
   115	
   116	
   117	def remove_day_ticket(
   118	    conn: sqlite3.Connection, day_id: str, ticket_id: str, now_unix: int
   119	) -> None:
   120	    """§3.4: delete the association only (ticket state untouched). If nothing was
   121	    deleted (rowcount 0) → no-op, no event, no re-pack. Else re-pack remaining
   122	    positions to 0..n-1 in existing position order, append day_ticket_removed
   123	    {ticket_id}, bump updated_at."""
   124	    cursor = conn.execute(
   125	        "DELETE FROM day_tickets WHERE day_id = ? AND ticket_id = ?",
   126	        (day_id, ticket_id),
   127	    )
   128	    if cursor.rowcount == 0:
   129	        return
   130	    survivors = conn.execute(
   131	        "SELECT ticket_id FROM day_tickets WHERE day_id = ? ORDER BY position",
   132	        (day_id,),
   133	    ).fetchall()
   134	    for new_position, row in enumerate(survivors):
   135	        conn.execute(
   136	            "UPDATE day_tickets SET position = ? WHERE day_id = ? AND ticket_id = ?",
   137	            (new_position, day_id, row["ticket_id"]),
   138	        )
   139	    append_event(conn, day_id, EventKind.day_ticket_removed, {"ticket_id": ticket_id}, now_unix)
   140	    conn.execute("UPDATE days SET updated_at = ? WHERE id = ?", (now_unix, day_id))
   141	
   142	
   143	# The human-editable day text fields (the four overview fields + notes). The api
   144	# validates the field name against this set before calling set_day_field, so the
   145	# column name is safe to interpolate.
   146	DAY_TEXT_FIELDS = ("focus", "brief_take", "watchout", "if_today_lands", "notes")
   147	
   148	
   149	def set_day_field(
   150	    conn: sqlite3.Connection, day_id: str, field: str, value: str, now_unix: int
   151	) -> None:
   152	    """Manual per-field edit of one day text field (§3.4): materialize, UPDATE that
   153	    column + updated_at, append day_updated {field}. `field` must be one of
   154	    DAY_TEXT_FIELDS (api-validated) — the guard keeps the interpolated column safe."""
   155	    if field not in DAY_TEXT_FIELDS:
   156	        raise ValueError(f"not a day text field: {field}")
   157	    materialize_day(conn, day_id, now_unix)
   158	    conn.execute(
   159	        f"UPDATE days SET {field} = ?, updated_at = ? WHERE id = ?", (value, now_unix, day_id)
   160	    )
   161	    append_event(conn, day_id, EventKind.day_updated, {"field": field}, now_unix)

