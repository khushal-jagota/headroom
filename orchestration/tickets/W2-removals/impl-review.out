 succeeded in 0ms:
     1	"""Acceptance items 10 and 20 for the sprints domain.
     2	
     3	The §18.3 fence is 1:1 — one named test per item — so test_a10_* and test_a20_*
     4	each exist exactly once and assert their item's full statement. Supplementary
     5	coverage (supersede mechanics, empty-blockers rejection, current-sprint
     6	selection) runs under the unanchored test_x06_* names.
     7	
     8	Item 10 — sprint-item permissions: agent todo->active succeeds; agent direct
     9	active->done write rejected; done via proposal + accept succeeds; blocked_by
    10	stored and blockers_cleared computed when all blockers done.
    11	
    12	Item 20 — sprint overlap: freeze and weekly_addenda are retired (rev6), so every
    13	sprint text field is always-editable and nothing latches; the remaining rule is
    14	sprint overlap rejection (inclusive ranges).
    15	"""
    16	
    17	from __future__ import annotations
    18	
    19	import inspect
    20	
    21	import pytest
    22	
    23	from planner.core.contracts import Project
    24	from planner.core.errors import ErrorCode, PlannerError
    25	from planner.core.events import read_events_since
    26	from planner.sprints.contracts import ItemStatus
    27	from planner.sprints.data import (
    28	    accept_item_status,
    29	    create_item,
    30	    create_sprint,
    31	    propose_item_status,
    32	    read_item,
    33	    read_sprint,
    34	    transition_item_status,
    35	)
    36	from planner.sprints.logic import DateRange, current_sprint_id
    37	
    38	
    39	def _insert_ticket(conn, ticket_id: str, state: str) -> None:
    40	    # T04 owns ticket writers; a direct INSERT is the sanctioned test-fixture
    41	    # shortcut for setting blocker ticket-states (only NOT-NULL non-defaulted
    42	    # columns are supplied; project may stay NULL under its CHECK).
    43	    conn.execute(
    44	        "INSERT INTO tickets (id, title, state, created_at, updated_at) VALUES (?, ?, ?, 0, 0)",
    45	        (ticket_id, "blk", state),
    46	    )
    47	
    48	
    49	def _set_ticket_state(conn, ticket_id: str, state: str) -> None:
    50	    # Same sanction as _insert_ticket: blocker ticket-states are test fixtures here,
    51	    # not exercises of T04's writers.
    52	    conn.execute("UPDATE tickets SET state = ? WHERE id = ?", (state, ticket_id))
    53	
    54	
    55	def _events(conn, entity_id: str, kind: str) -> list[dict]:
    56	    return [
    57	        e.payload
    58	        for e in read_events_since(conn, 0, 100_000)
    59	        if e.entity_id == entity_id and e.kind == kind
    60	    ]
    61	
    62	
    63	# --- item 10: sprint-item permissions (single anchored test) ----------------------
    64	
    65	
    66	def test_a10_sprint_item_permissions(tmp_db, fake_clock) -> None:
    67	    # Leg 1 — agent todo -> active succeeds, with one exact {from, to, cause} event.
    68	    item1 = create_item(tmp_db, title="ship it", project=Project.Vylo, clock=fake_clock)
    69	    assert item1.status is ItemStatus.todo
    70	    moved = transition_item_status(tmp_db, item1.id, ItemStatus.active, clock=fake_clock)
    71	    assert moved.status is ItemStatus.active
    72	    assert _events(tmp_db, item1.id, "item_status_changed") == [
    73	        {"from": "todo", "to": "active", "cause": "agent"},
    74	    ]
    75	
    76	    # Leg 2 — agent direct active -> done write rejected (and deferred_next_sprint
    77	    # equally, per PROPOSAL_ONLY_STATUSES); status and event log unchanged.
    78	    item2 = create_item(tmp_db, title="x", project=Project.Vylo, clock=fake_clock)
    79	    transition_item_status(tmp_db, item2.id, ItemStatus.active, clock=fake_clock)
    80	    with pytest.raises(PlannerError) as ei:
    81	        transition_item_status(tmp_db, item2.id, ItemStatus.done, clock=fake_clock)
    82	    assert ei.value.code == ErrorCode.item_transition_forbidden
    83	    with pytest.raises(PlannerError) as ei2:
    84	        transition_item_status(
    85	            tmp_db, item2.id, ItemStatus.deferred_next_sprint, clock=fake_clock
    86	        )
    87	    assert ei2.value.code == ErrorCode.item_transition_forbidden
    88	    assert read_item(tmp_db, item2.id).item.status is ItemStatus.active
    89	    changes = _events(tmp_db, item2.id, "item_status_changed")
    90	    assert all(c["to"] != "done" for c in changes)
    91	    assert all(c["to"] != "deferred_next_sprint" for c in changes)
    92	
    93	    # Leg 3 — done via proposal + human accept succeeds; proposal cleared; exact
    94	    # proposal_filed / proposal_accepted / item_status_changed payloads.
    95	    item3 = create_item(tmp_db, title="y", project=Project.Vylo, clock=fake_clock)
    96	    transition_item_status(tmp_db, item3.id, ItemStatus.active, clock=fake_clock)
    97	    proposed = propose_item_status(
    98	        tmp_db, item3.id, ItemStatus.done, note="ready", proposed_by="agent-x", clock=fake_clock
    99	    )
   100	    assert proposed.status is ItemStatus.active
   101	    assert proposed.status_proposal is not None
   102	    assert proposed.status_proposal.to_status is ItemStatus.done
   103	    assert _events(tmp_db, item3.id, "proposal_filed") == [
   104	        {
   105	            "field": "status",
   106	            "body": {"to_status": "done", "note": "ready"},
   107	            "proposed_by": "agent-x",
   108	        },
   109	    ]
   110	    accepted = accept_item_status(tmp_db, item3.id, clock=fake_clock)
   111	    assert accepted.status is ItemStatus.done
   112	    assert accepted.status_proposal is None
   113	    assert _events(tmp_db, item3.id, "proposal_accepted") == [
   114	        {
   115	            "field": "status",
   116	            "body": {"to_status": "done"},
   117	            "resolved_by": "human",
   118	            "edited": False,
   119	        },
   120	    ]
   121	    assert {"from": "active", "to": "done", "cause": "accept"} in _events(
   122	        tmp_db, item3.id, "item_status_changed"
   123	    )
   124	    # §4.4.7 guard: item accepts carry no onward-grant pair.
   125	    params = inspect.signature(accept_item_status).parameters
   126	    assert "next_ceiling" not in params
   127	    assert "at_cap" not in params
   128	
   129	    # Leg 4 — blocked_by stored; blockers_cleared computed on read, flipping True
   130	    # only when every blocker ticket reaches state done.
   131	    _insert_ticket(tmp_db, "t_a", "in_progress")
   132	    _insert_ticket(tmp_db, "t_b", "done")
   133	    item4 = create_item(tmp_db, title="z", project=Project.Vylo, clock=fake_clock)
   134	    blocked = transition_item_status(
   135	        tmp_db, item4.id, ItemStatus.blocked, clock=fake_clock, blocked_by=["t_a", "t_b"]
   136	    )
   137	    assert blocked.status is ItemStatus.blocked
   138	    assert blocked.blocked_by == ["t_a", "t_b"]
   139	    assert _events(tmp_db, item4.id, "item_status_changed") == [
   140	        {"from": "todo", "to": "blocked", "cause": "agent"},
   141	    ]
   142	    assert read_item(tmp_db, item4.id).blockers_cleared is False
   143	    _set_ticket_state(tmp_db, "t_a", "done")
   144	    assert read_item(tmp_db, item4.id).blockers_cleared is True
   145	
   146	
   147	# --- item 20: sprint overlap (single anchored test) -------------------------------
   148	
   149	
   150	def test_a20_sprint_overlap(tmp_db, fake_clock) -> None:
   151	    # Freeze + weekly_addenda are retired (rev6): every sprint text field is
   152	    # always-editable and nothing latches, so the only rule left to assert is sprint
   153	    # overlap rejection — interior overlap, inclusive boundary (candidate start ==
   154	    # existing end), and the adjacent day succeeds.
   155	    sp = create_sprint(
   156	        tmp_db, name="S", date_start="2026-07-01", date_end="2026-07-14", clock=fake_clock
   157	    )
   158	    with pytest.raises(PlannerError) as ei3:
   159	        create_sprint(
   160	            tmp_db, name="B", date_start="2026-07-10", date_end="2026-07-20", clock=fake_clock
   161	        )
   162	    assert ei3.value.code == ErrorCode.sprint_overlap
   163	    assert ei3.value.detail["conflict_id"] == sp.id
   164	    with pytest.raises(PlannerError) as ei4:
   165	        create_sprint(
   166	            tmp_db, name="C", date_start="2026-07-14", date_end="2026-07-21", clock=fake_clock
   167	        )
   168	    assert ei4.value.code == ErrorCode.sprint_overlap
   169	    assert ei4.value.detail["conflict_id"] == sp.id
   170	    d = create_sprint(
   171	        tmp_db, name="D", date_start="2026-07-15", date_end="2026-07-21", clock=fake_clock
   172	    )
   173	    assert read_sprint(tmp_db, d.id).id == d.id
   174	
