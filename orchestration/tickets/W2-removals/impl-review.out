   155	def _marshal_item_deadline(raw: object) -> None:
   156	    if raw is None:
   157	        return
   158	    if not isinstance(raw, str):
   159	        raise PlannerError(ErrorCode.validation, "invalid deadline", {"deadline": raw})
   160	    try:
   161	        date.fromisoformat(raw)
   162	    except ValueError as exc:
   163	        raise PlannerError(
   164	            ErrorCode.validation, "invalid deadline", {"deadline": raw}
   165	        ) from exc
