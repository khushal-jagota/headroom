    56	def _parse_bool(raw: object, key: str) -> bool:
    57	    if isinstance(raw, bool):
    58	        return raw
    59	    text = str(raw).strip().lower()
    60	    if text in _TRUE:
    61	        return True
    62	    if text in _FALSE:
    63	        return False
    64	    raise PlannerError(ErrorCode.validation, f"invalid boolean for {key}: {raw!r}")
    65	
    66	
    67	def _parse_int(raw: object, key: str) -> int:
    68	    if isinstance(raw, bool):
    69	        raise PlannerError(ErrorCode.validation, f"invalid integer for {key}: {raw!r}")
    70	    if isinstance(raw, int):
    71	        return raw
    72	    if isinstance(raw, str):
    73	        try:
    74	            return int(raw.strip())
    75	        except ValueError as exc:
    76	            raise PlannerError(ErrorCode.validation, f"invalid integer for {key}: {raw!r}") from exc
    77	    raise PlannerError(ErrorCode.validation, f"invalid integer for {key}: {raw!r}")
