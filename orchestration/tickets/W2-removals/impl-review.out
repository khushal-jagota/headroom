    99	
   100	def _set_sprint_dates(conn: sqlite3.Connection, sprint_id: str, *, date_start: str | None,
   101	                      date_end: str | None, clock: Clock) -> None:
   102	    sprint = sprints_data.read_sprint(conn, sprint_id)
   103	    new_start = date_start if date_start is not None else sprint.date_start
   104	    new_end = date_end if date_end is not None else sprint.date_end
   105	    for label, value in (("date_start", new_start), ("date_end", new_end)):
   106	        try:
   107	            date.fromisoformat(value)
   108	        except ValueError as exc:
   109	            raise PlannerError(
   110	                ErrorCode.validation, f"invalid {label}", {label: value}
   111	            ) from exc
   112	    if new_start > new_end:
   113	        raise PlannerError(
   114	            ErrorCode.validation,
   115	            "date_start must not be after date_end",
   116	            {"date_start": new_start, "date_end": new_end},
   117	        )
   118	    others = [
   119	        DateRange(id=str(r["id"]), date_start=str(r["date_start"]), date_end=str(r["date_end"]))
   120	        for r in conn.execute(
   121	            "SELECT id, date_start, date_end FROM sprints WHERE id != ?", (sprint_id,)
   122	        ).fetchall()
   123	    ]
   124	    conflict = find_overlap(new_start, new_end, others)
   125	    if conflict is not None:
   126	        raise PlannerError(
   127	            ErrorCode.sprint_overlap,
   128	            "sprint dates overlap",
   129	            {"conflict_id": conflict, "date_start": new_start, "date_end": new_end},
   130	        )
   131	    now = clock.now_unix()
   132	    with txn(conn):
   133	        conn.execute(
   134	            "UPDATE sprints SET date_start = ?, date_end = ?, updated_at = ? WHERE id = ?",
   135	            (new_start, new_end, now, sprint_id),
   136	        )
   137	        if new_start != sprint.date_start:
   138	            append_event(
   139	                conn,
   140	                sprint_id,
   141	                EventKind.sprint_updated,
   142	                {"field": "date_start", "from": sprint.date_start, "to": new_start},
   143	                now,
   144	            )
   145	        if new_end != sprint.date_end:
   146	            append_event(
   147	                conn,
   148	                sprint_id,
   149	                EventKind.sprint_updated,
   150	                {"field": "date_end", "from": sprint.date_end, "to": new_end},
   151	                now,
   152	            )
   153	
