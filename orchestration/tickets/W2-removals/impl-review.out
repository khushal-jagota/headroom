   114	    title_too_long = "title_too_long"              # §3.3 > title_max_chars
   115	    sprint_overlap = "sprint_overlap"              # §3.1 overlapping date ranges
   116	    link_cycle = "link_cycle"                      # §3.6 blocks/parent_child transitive cycle
   117	    link_invalid = "link_invalid"                  # self-link, second belongs_to, bad endpoints
   118	    sprint_derived = "sprint_derived"              # §3.3 sprint_id write on a parented ticket
   119	    item_transition_forbidden = "item_transition_forbidden"  # §3.2 agent direct done/deferred
   120	    agent_forbidden = "agent_forbidden"            # claim/agent request hits a human-only action
   121	    gateway_offline = "gateway_offline"            # §11
   122	    not_found = "not_found"
   123	    validation = "validation"                      # generic input validation
   124	
   125	
   126	class PlannerError(Exception):
   127	    def __init__(self, code: ErrorCode, message: str, detail: JsonDict | None = None) -> None:
   128	        super().__init__(message)
   129	        self.code = code
   130	        self.message = message
   131	        self.detail: JsonDict = detail if detail is not None else {}
   132	
   133	    def to_payload(self) -> JsonDict:
   134	        return {"error": {"code": self.code.value, "message": self.message, "detail": self.detail}}

