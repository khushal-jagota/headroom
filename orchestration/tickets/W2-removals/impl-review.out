   139	);
   140	CREATE INDEX IF NOT EXISTS idx_runs_ticket ON runs(ticket_id, started_at);
   141	"""
   142	
   143	
   144	def connect(db_path: str, busy_timeout_ms: int = 5000) -> sqlite3.Connection:
   145	    conn = sqlite3.connect(db_path, isolation_level=None)
   146	    conn.row_factory = sqlite3.Row
   147	    conn.execute("PRAGMA journal_mode=WAL")
   148	    conn.execute("PRAGMA foreign_keys=ON")
   149	    conn.execute(f"PRAGMA busy_timeout={int(busy_timeout_ms)}")
   150	    return conn
   151	
   152	
   153	def create_schema(conn: sqlite3.Connection) -> None:
   154	    conn.executescript(DDL)
   155	    conn.execute(f"PRAGMA user_version={SCHEMA_VERSION}")

