   284	def update_item_field(
   285	    conn: sqlite3.Connection, item_id: str, field: str, value: str | None, *, clock: Clock
   286	) -> SprintItem:
   287	    if field not in _ITEM_PLAIN_FIELDS:
   288	        raise PlannerError(
   289	            ErrorCode.validation, "field is not an editable item field", {"field": field}
   290	        )
   291	    item = _load_item(conn, item_id)
   292	    prev = getattr(item, field)
   293	    stored: str | None = value
   294	    if field == "priority":
   295	        if value is None:
   296	            raise PlannerError(ErrorCode.validation, "invalid priority", {"value": value})
   297	        try:
   298	            stored = Priority(value).value
   299	        except ValueError as exc:
   300	            raise PlannerError(ErrorCode.validation, "invalid priority", {"value": value}) from exc
   301	    elif field == "project":
   302	        if value is None:
   303	            raise PlannerError(ErrorCode.validation, "invalid project", {"value": value})
   304	        try:
   305	            stored = Project(value).value
   306	        except ValueError as exc:
   307	            raise PlannerError(ErrorCode.validation, "invalid project", {"value": value}) from exc
   308	    now = clock.now_unix()
   309	    with _tx(conn):
   310	        conn.execute(
   311	            f"UPDATE sprint_items SET {field} = ?, updated_at = ? WHERE id = ?",
   312	            (stored, now, item_id),
   313	        )
   314	        append_event(
   315	            conn,
   316	            item_id,
   317	            EventKind.item_updated,
   318	            {"field": field, "from": prev, "to": stored},
   319	            now,
   320	        )
   321	    return _load_item(conn, item_id)
   322	
   323	
   324	def transition_item_status(
   325	    conn: sqlite3.Connection,
   326	    item_id: str,
   327	    to_status: ItemStatus,
   328	    *,
   329	    clock: Clock,
   330	    by_agent: bool = True,
   331	    blocked_by: Sequence[str] | None = None,
   332	) -> SprintItem:
   333	    item = _load_item(conn, item_id)
   334	    from_status = item.status
   335	    intended: list[str] = list(blocked_by or []) if to_status is ItemStatus.blocked else []
   336	    verdict = (
   337	        classify_agent_transition(from_status, to_status, intended)
   338	        if by_agent
   339	        else classify_human_transition(from_status, to_status, intended)
   340	    )
   341	    if verdict is TransitionVerdict.forbidden:
   342	        raise PlannerError(
   343	            ErrorCode.item_transition_forbidden,
   344	            "transition not permitted",
   345	            {"from": from_status.value, "to": to_status.value},
   346	        )
   347	    if verdict is TransitionVerdict.missing_blockers:
   348	        raise PlannerError(
   349	            ErrorCode.validation,
   350	            "blocked requires a non-empty blocked_by",
   351	            {"to": "blocked"},
   352	        )
   353	    new_blocked_by = intended if to_status is ItemStatus.blocked else []
   354	    cause = "agent" if by_agent else "human"
   355	    now = clock.now_unix()
   356	    with _tx(conn):
   357	        conn.execute(
   358	            "UPDATE sprint_items SET status = ?, blocked_by = ?, updated_at = ? WHERE id = ?",
   359	            (to_status.value, json.dumps(new_blocked_by), now, item_id),
   360	        )

