    79	def test_a12_day_ticket_removal(tmp_db: Connection) -> None:
    80	    conn = tmp_db
    81	    _mk_ticket(conn, "t0", state="needs_success", title="T0")
    82	    _mk_ticket(conn, "t1", state="in_progress", title="T1")
    83	    _mk_ticket(conn, "t2", state="needs_success", title="T2")
