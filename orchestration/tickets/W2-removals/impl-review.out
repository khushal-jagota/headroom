   593	def test_real_spawn_reaps_exited_child_and_detects_dead_within_a_tick(
   594	    cfg: Config, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
   595	) -> None:
   596	    """§7.1/§7.3 dead-worker detection. No real process is spawned: subprocess.Popen is
   597	    a controllable stub (§7.4/§14). The adapter retains each child handle; is_pid_alive
   598	    reaps an exited child via poll() and reports it dead within one tick, reaps other
   599	    finished children on the same pass (no zombie/handle buildup), and falls back to the
   600	    signal-0 probe for a pid it never spawned."""
   601	
   602	    class FakePopen:
   603	        def __init__(self, pid: int) -> None:
   604	            self.pid = pid
   605	            self.returncode: int | None = None  # None == still running
   606	
   607	        def poll(self) -> int | None:
   608	            return self.returncode
   609	
   610	    created: list[FakePopen] = []
   611	
   612	    def fake_popen(command: list[str], **kwargs: object) -> FakePopen:
   613	        proc = FakePopen(pid=51000 + len(created))
   614	        created.append(proc)
   615	        return proc
   616	
   617	    monkeypatch.setattr("planner.core.adapters.real.subprocess.Popen", fake_popen)
   618	
   619	    (tmp_path / "logs").mkdir()
   620	    adapter = RealSpawnAdapter(cfg)
   621	
   622	    def _spawn(run_id: str) -> int:
   623	        result = adapter.spawn(
   624	            SpawnRequest(
   625	                ticket_id="t_reap",
   626	                run_id=run_id,
   627	                claim="claim_x",
   628	                server_url="http://127.0.0.1:8767",
   629	                log_path=str(tmp_path / "logs" / f"{run_id}.log"),
   630	                hermes_bin="hermes",
   631	                profile=cfg.hermes_profile,
   632	                skill=cfg.worker_skill,
   633	            )
   634	        )
   635	        assert result.ok is True
   636	        assert result.pid is not None
   637	        return result.pid
   638	
   639	    pid_a = _spawn("run_a")
   640	    pid_b = _spawn("run_b")
   641	    child_a, child_b = created[0], created[1]
   642	
   643	    # is_pid_alive is the per-pid reclaim probe. Tracked + running -> alive (no signal).
   644	    assert adapter.is_pid_alive(pid_a) is True
   645	
   646	    # child_a exits: poll() reaps it and is_pid_alive reports dead THIS call — one tick,
   647	    # not TTL — dropping the handle without signalling a possibly-recycled pid.
   648	    child_a.returncode = 1
   649	    assert adapter.is_pid_alive(pid_a) is False
   650	    assert pid_a not in adapter._children
   651	
   652	    # child_b's run closes by another path (done/blocked/crashed); the sweep never probes
   653	    # its pid, so reap_finished_children is what drops its handle — no zombie left behind.
   654	    child_b.returncode = 0
   655	    assert pid_b in adapter._children
   656	    adapter.reap_finished_children()
   657	    assert pid_b not in adapter._children
