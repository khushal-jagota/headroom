    80	def _read_yaml(path: str | None) -> dict[str, object]:
    81	    resolved = Path(path) if path is not None else Path(DEFAULT_CONFIG_PATH)
    82	    if not resolved.exists():
    83	        return {}
    84	    loaded = yaml.safe_load(resolved.read_text())
    85	    if loaded is None:
    86	        return {}
    87	    if not isinstance(loaded, dict):
    88	        raise PlannerError(ErrorCode.validation, f"config root must be a mapping: {resolved}")
    89	    return loaded
