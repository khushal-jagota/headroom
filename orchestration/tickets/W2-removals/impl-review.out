   116	def test_a18_boundary_job(tmp_db: Connection, fake_clock: TestClock, cfg: Config) -> None:
   117	    conn = tmp_db
   118	
   119	    # Part 1 — first tick ≥ 05:00 creates the day + carryover + overdue + close.
   120	    _mk_ticket(conn, "t_done", state="done", title="Done one")
   121	    _mk_ticket(
   122	        conn, "t_prog", state="in_progress", title="Prog one", priority="P1",
   123	        deadline="2026-07-01",
   124	    )
   125	    add_day_ticket(conn, "day_2026-07-04", "t_done", 100)
   126	    add_day_ticket(conn, "day_2026-07-04", "t_prog", 100)
   127	    fake_clock.set(datetime(2026, 7, 5, 5, 1).astimezone())
   128	    adapter1 = RecordingBoundaryAdapter()
   129	    assert run_boundary(conn, fake_clock, cfg, adapter1) == "ok"
   130	
   131	    assert conn.execute("SELECT 1 FROM days WHERE id = 'day_2026-07-05'").fetchone() is not None
   132	    events = read_events_since(conn, 0, 1000)
   133	    created = [
   134	        e
   135	        for e in events
   136	        if e.kind == EventKind.day_created.value and e.entity_id == "day_2026-07-05"
   137	    ]
   138	    assert len(created) == 1
   139	    # Carryover excludes t_done (done); keeps t_prog.
   140	    assert adapter1.received[0].carryover == [
   141	        {"id": "t_prog", "title": "Prog one", "state": "in_progress", "priority": "P1"}
   142	    ]
   143	    # Overdue: t_prog (deadline 2026-07-01 < 2026-07-05, not terminal); t_done excluded.
   144	    assert adapter1.received[0].overdue == [
   145	        {"id": "t_prog", "title": "Prog one", "state": "in_progress", "priority": "P1"}
   146	    ]
   147	    # day_closed on YESTERDAY with the done/not-done split.
   148	    closed = [
   149	        e
   150	        for e in events
   151	        if e.kind == EventKind.day_closed.value and e.entity_id == "day_2026-07-04"
   152	    ]
   153	    assert len(closed) == 1
   154	    assert closed[0].payload == {"done_count": 1, "not_done_count": 1}
   155	    # The four overview fields the boundary filled are stored on the new day.
   156	    day05 = read_day(conn, "day_2026-07-05", 1)
   157	    assert day05.focus == "Focus for 2026-07-05"
   158	    assert day05.brief_take == "Take for 2026-07-05"
   159	    assert day05.watchout == "Watch for 2026-07-05"
   160	    assert day05.if_today_lands == "Lands for 2026-07-05"
   161	    # The overview write emits exactly one day_updated {field: "overview"} as the WS
   162	    # refetch signal.
   163	    overview = [
   164	        e
   165	        for e in events
   166	        if e.kind == EventKind.day_updated.value and e.entity_id == "day_2026-07-05"
   167	    ]
   168	    assert len(overview) == 1
   169	    assert overview[0].payload == {"field": "overview", "cause": "boundary"}
   170	    assert adapter1.calls == ["judgment"]
   171	
   172	    # Part 2 — second tick same date is a guarded no-op: the next day is already
   173	    # materialized, so run_boundary returns None and appends no events.
   174	    n_events = conn.execute("SELECT COUNT(*) AS n FROM events").fetchone()["n"]
   175	    assert run_boundary(conn, fake_clock, cfg, adapter1) is None
   176	    assert conn.execute("SELECT COUNT(*) AS n FROM events").fetchone()["n"] == n_events
   177	    assert adapter1.calls == ["judgment"]
   178	
   179	    # Part 3 — a human-placed day-ticket materializes the new day, so the next tick
   180	    # hits the materialization guard first (removal-plan §14.4): run_boundary returns
   181	    # None and never calls judgment. day_2026-07-05 is not re-closed.
   182	    fake_clock.set(datetime(2026, 7, 6, 5, 1).astimezone())
