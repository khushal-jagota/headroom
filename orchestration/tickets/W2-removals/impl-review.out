    24	if TYPE_CHECKING:
    25	    from planner.core.config import Config
    26	
    27	BOUNDARY_SKILL: Final = "planning-boundary"     # §17 skill; §13 names no config key (RD-3)
    28	_GATEWAY_MODULE: Final = "tui_gateway.ws"
    29	
    30	
    31	def _parse_json_object(text: str) -> dict[str, Any]:
    32	    """Slice the first ``{`` to the last ``}`` inclusive and parse. All failures
    33	    raise; the caller event-logs them (RD-16)."""
    34	    start = text.find("{")
    35	    end = text.rfind("}")
    36	    if start == -1 or end == -1 or end < start:
    37	        raise ValueError("no JSON object in hermes output")
    38	    parsed = json.loads(text[start : end + 1])
    39	    if not isinstance(parsed, dict):
    40	        raise ValueError("hermes output is not a JSON object")
    41	    result: dict[str, Any] = parsed
    42	    return result
    43	
    44	
    45	class RealSpawnAdapter:
    46	    def __init__(self, config: Config) -> None:
    47	        self._config = config
    48	        # pid -> the live Popen of a child WE spawned. Retaining the handle lets the
    49	        # server (the Popen parent) reap its own children via poll(); otherwise an
    50	        # exited child lingers as a zombie and os.kill(pid, 0) reports it alive until
    51	        # claim-TTL expiry (§7.1/§7.3 dead-worker detection).
    52	        self._children: dict[int, subprocess.Popen[bytes]] = {}
    53	
    54	    def spawn(self, request: SpawnRequest) -> SpawnResult:
    55	        env = dict(os.environ)
    56	        env["PLAN_SERVER_URL"] = request.server_url
    57	        env["PLAN_TICKET_ID"] = request.ticket_id
    58	        env["PLAN_RUN_ID"] = request.run_id
    59	        env["PLAN_CLAIM"] = request.claim
    60	        command = [
    61	            request.hermes_bin,
    62	            "-p",
    63	            request.profile,
    64	            "--skills",
    65	            request.skill,
    66	            "chat",
    67	            "-q",
    68	            f"work planning ticket {request.ticket_id}",
    69	        ]
    70	        try:
    71	            with open(request.log_path, "wb") as log_file:  # parent fd closed after Popen
    72	                process = subprocess.Popen(
    73	                    command,
    74	                    start_new_session=True,
    75	                    stdin=subprocess.DEVNULL,
    76	                    stdout=log_file,
    77	                    stderr=subprocess.STDOUT,
    78	                    env=env,
    79	                )
    80	        except OSError as exc:
    81	            return SpawnResult(ok=False, error=str(exc))
    82	        self._children[process.pid] = process
    83	        return SpawnResult(ok=True, pid=process.pid)
    84	
    85	    def is_pid_alive(self, pid: int) -> bool:
    86	        """Per-pid dead-worker probe for the reclaim sweep (§7.1/§7.3). A pid we spawned
    87	        is probed with Popen.poll(): None => still running (alive); a returncode => it has
    88	        exited and poll() has just reaped it, so we drop the handle and report dead —
    89	        detected within one tick, not at TTL. An untracked pid (e.g. a claim carried across
    90	        a server restart, whose Popen this process never owned) falls back to the signal-0
    91	        probe."""
    92	        process = self._children.get(pid)
    93	        if process is None:
    94	            # Local import: real <- runtime would close the runtime -> registry -> real
    95	            # import cycle at module load. _pid_alive is the single fallback impl.
    96	            from planner.dispatch.runtime import _pid_alive
    97	
    98	            return _pid_alive(pid)
    99	        if process.poll() is None:
   100	            return True
   101	        del self._children[pid]
   102	        return False
   103	
   104	    def reap_finished_children(self) -> None:
   105	        """Reap and drop every tracked child that has exited (Popen.poll() reaps it). The
   106	        dispatcher calls this once per tick, so children of runs that closed by any path —
   107	        which the reclaim sweep never probes by pid — are not left as zombies or retained
   108	        handles. is_pid_alive only reaps the single pid it is asked about."""
   109	        for done_pid in [p for p, proc in self._children.items() if proc.poll() is not None]:
   110	            del self._children[done_pid]
   111	
   112	
   113	class RealBoundaryAdapter:
   114	    def __init__(self, config: Config) -> None:
   115	        self._config = config
   116	
   117	    def _invoke(self, prompt: str) -> str:
   118	        """Run hermes non-interactively. The CALLER owns the timeout (no subprocess
   119	        timeout here); a non-zero exit raises."""
   120	        result = subprocess.run(
   121	            [
   122	                self._config.hermes_bin,
   123	                "-p",
   124	                self._config.hermes_profile,
   125	                "--skills",
   126	                BOUNDARY_SKILL,
   127	                "chat",
   128	                "-q",
   129	                prompt,
   130	            ],
   131	            capture_output=True,
   132	            text=True,
   133	            check=False,
   134	        )
   135	        if result.returncode != 0:
   136	            tail = result.stderr.strip()[-500:]
   137	            raise RuntimeError(f"hermes exited {result.returncode}: {tail}")
   138	        return result.stdout
   139	
   140	    def judgment(self, inputs: BoundaryInputs) -> BoundaryJudgment:
   141	        prompt = (
   142	            "You are the planning boundary judgment. Reply with exactly one JSON "
   143	            'object {"focus": string, "brief_take": string, "watchout": string, '
   144	            '"if_today_lands": string} and nothing else. Inputs: '
   145	            + json.dumps(asdict(inputs))
   146	        )
   147	        payload = _parse_json_object(self._invoke(prompt))
   148	        return BoundaryJudgment(
   149	            focus=str(payload["focus"]),
   150	            brief_take=str(payload["brief_take"]),
   151	            watchout=str(payload["watchout"]),
   152	            if_today_lands=str(payload["if_today_lands"]),
   153	        )
   154	
   155	
   156	class RealGatewayAdapter:
   157	    def __init__(self, config: Config) -> None:
   158	        self._config = config
   159	
   160	    def status(self) -> GatewayStatus:
   161	        try:
   162	            importlib.import_module(_GATEWAY_MODULE)
   163	        except ImportError as exc:
   164	            return GatewayStatus(available=False, detail=str(exc))
   165	        return GatewayStatus(available=True)
   166	
   167	    def send(self, session_key: str | None, entity_id: str, text: str) -> ChatSendResult:
   168	        try:
   169	            module = importlib.import_module(_GATEWAY_MODULE)
   170	        except ImportError as exc:
   171	            raise PlannerError(
   172	                ErrorCode.gateway_offline, "chat gateway unavailable", {"detail": str(exc)}
   173	            ) from exc
   174	        try:
   175	            raw = module.send_message(
   176	                session_key=session_key, entity_id=entity_id, text=text
   177	            )
   178	            return ChatSendResult(
   179	                reply_text=str(raw["reply_text"]), session_key=str(raw["session_key"])
   180	            )

