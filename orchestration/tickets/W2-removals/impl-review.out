 succeeded in 0ms:
     1	"""Standalone seed entrypoint for the one-time cutover migration.
     2	
     3	Run as: python -m planner.seed --source <dir> [--db-path <path>] [--json]
     4	
     5	Imports a markdown planning directory into a SQLite database. This is the cutover
     6	script (§12): the /api/seed route and the `plan seed` CLI verb were removed in the
     7	runtime redesign, but the importer (seed_from_source + the parsers) is retained and
     8	driven here. Self-contained — it does not import planner.cli.main."""
     9	
    10	from __future__ import annotations
    11	
    12	import argparse
    13	import json
    14	import sys
    15	from dataclasses import asdict
    16	from typing import Any
    17	
    18	from planner.core.clock import build_clock
    19	from planner.core.config import load_config
    20	from planner.core.db import connect, create_schema
    21	from planner.seed.importer import seed_from_source
    22	
    23	
    24	def _format_report(data: dict[str, Any]) -> str:
    25	    lines = [
    26	        f"seed: {data['sprints']} sprint(s), {data['sprint_items']} item(s), "
    27	        f"{data['deferred_items']} deferred, {data['tickets']} ticket(s), "
    28	        f"{data['ideas']} idea(s), {data['links']} link(s), "
    29	        f"{data['duplicates_skipped']} duplicate(s)"
    30	    ]
    31	    skipped = data["skipped"]
    32	    if skipped:
    33	        lines.append(f"skipped: {len(skipped)}")
    34	        for s in skipped:
    35	            lines.append(f"  - {s['source_file']} [{s['heading']}]: {s['reason']}")
    36	    return "\n".join(lines)
    37	
    38	
    39	def main(argv: list[str] | None = None) -> int:
    40	    parser = argparse.ArgumentParser(
    41	        prog="python -m planner.seed",
    42	        description="Import a markdown planning directory into a planner database.",
    43	    )
    44	    parser.add_argument("--source", required=True, help="Path to a markdown planning directory.")
    45	    parser.add_argument(
    46	        "--db-path", default=None, help="Target SQLite path (defaults to the configured db_path)."
    47	    )
    48	    parser.add_argument("--json", action="store_true", help="Emit the report as JSON.")
    49	    args = parser.parse_args(argv)
    50	
    51	    config = load_config()
    52	    db_path: str = args.db_path if args.db_path is not None else config.db_path
    53	    conn = connect(db_path, config.db_busy_timeout_ms)
    54	    try:
    55	        create_schema(conn)
    56	        now = build_clock(config).now_unix()
    57	        report = seed_from_source(conn, args.source, now)
    58	    finally:
    59	        conn.close()
    60	
    61	    data = asdict(report)
    62	    print(json.dumps(data) if args.json else _format_report(data))
    63	    return 0
    64	
    65	
    66	if __name__ == "__main__":
    67	    sys.exit(main())

