   208	def update_sprint_field(
   209	    conn: sqlite3.Connection, sprint_id: str, field: str, value: str, *, clock: Clock
   210	) -> Sprint:
   211	    if field not in _SPRINT_TEXT_FIELDS:
   212	        raise PlannerError(
   213	            ErrorCode.validation,
   214	            "field is not an editable sprint text field",
   215	            {"field": field},
   216	        )
   217	    # Freeze retired (rev6): nothing in a sprint locks, so every text field
   218	    # (kickoff / mid-sprint / review / name) is always editable. No admissibility gate.
   219	    sprint = _load_sprint(conn, sprint_id)
   220	    now = clock.now_unix()
   221	    prev = getattr(sprint, field)
   222	    with _tx(conn):
   223	        conn.execute(
   224	            f"UPDATE sprints SET {field} = ?, updated_at = ? WHERE id = ?",
   225	            (value, now, sprint_id),
   226	        )
   227	        append_event(
   228	            conn,
   229	            sprint_id,
   230	            EventKind.sprint_updated,
   231	            {"field": field, "from": prev, "to": value},
   232	            now,
   233	        )
   234	    return _load_sprint(conn, sprint_id)
