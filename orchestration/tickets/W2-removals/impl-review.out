     1	"""The boundary scheduler tick (§6.2). One tick runs the idempotent boundary job
     2	for the current planning date; a simple module lock serializes ticks so the
     3	materialize-guard read-then-work stays TOCTOU-safe (the prod boundary loop is its
     4	one live caller)."""
     5	
     6	from __future__ import annotations
     7	
     8	import sqlite3
     9	import threading
    10	from collections.abc import Callable
    11	
    12	from planner.core.adapters.registry import Adapters
    13	from planner.core.clock import Clock
    14	from planner.core.config import Config
    15	from planner.core.contracts import JsonDict
    16	from planner.days.boundary import run_boundary
    17	from planner.days.logic.dates import planning_date
    18	
    19	# Serializes run_boundary_tick so the materialize-guard read-then-work stays
    20	# TOCTOU-safe. The prod boundary loop is the one live caller.
    21	_TICK_MUTEX = threading.Lock()
    22	
    23	
    24	def run_boundary_tick(
    25	    conn_factory: Callable[[], sqlite3.Connection],
    26	    config: Config,
    27	    clock: Clock,
    28	    adapters: Adapters,
    29	) -> JsonDict:
    30	    """One boundary tick. Runs the idempotent boundary job for the snapshot planning
    31	    date (A6). Returns {planning_date, ran, judgment}: `ran` is True iff the job did
    32	    work (the next day was not already materialized), and `judgment` is the boundary
    33	    outcome ("ok" / "skipped" / "failed") or None on a guarded skip."""
    34	    with _TICK_MUTEX:
    35	        piso = planning_date(clock.now(), config.boundary_hour).isoformat()
    36	        conn = conn_factory()
    37	        try:
    38	            outcome = run_boundary(conn, clock, config, adapters.boundary)
    39	        finally:
    40	            conn.close()
    41	        return {"planning_date": piso, "ran": outcome is not None, "judgment": outcome}

