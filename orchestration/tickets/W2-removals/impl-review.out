   145	def create_sprint(
   146	    conn: sqlite3.Connection,
   147	    *,
   148	    name: str,
   149	    date_start: str,
   150	    date_end: str,
   151	    limiting_factor: str = "",
   152	    primary_bet: str = "",
   153	    supports: str = "",
   154	    premortem: str = "",
   155	    clock: Clock,
   156	) -> Sprint:
   157	    if not name:
   158	        raise PlannerError(ErrorCode.validation, "sprint name is required", {})
   159	    if date_start > date_end:
   160	        raise PlannerError(
   161	            ErrorCode.validation,
   162	            "date_start must not be after date_end",
   163	            {"date_start": date_start, "date_end": date_end},
   164	        )
   165	    now = clock.now_unix()
   166	    sprint_id = new_id(ID_PREFIXES["sprint"])
   167	    with _tx(conn):
   168	        existing = [
   169	            DateRange(id=r["id"], date_start=r["date_start"], date_end=r["date_end"])
   170	            for r in conn.execute("SELECT id, date_start, date_end FROM sprints")
   171	        ]
   172	        conflict = find_overlap(date_start, date_end, existing)
   173	        if conflict is not None:
   174	            raise PlannerError(
   175	                ErrorCode.sprint_overlap,
   176	                "sprint dates overlap",
   177	                {"conflict_id": conflict, "date_start": date_start, "date_end": date_end},
   178	            )
   179	        conn.execute(
   180	            "INSERT INTO sprints ("
   181	            "id, name, date_start, date_end, limiting_factor, primary_bet, supports, "
   182	            "premortem, outcomes, solo_reflection, joint_discussion, updates_to_thinking, "
   183	            "carry_forward, created_at, updated_at) "
   184	            "VALUES (?, ?, ?, ?, ?, ?, ?, ?, '', '', '', '', '', ?, ?)",
