   243	    body = ProposeStatusBody(to=body_str(raw, "to"), note=body_opt_str(raw, "note"))
   244	    to_status = parse_enum(ItemStatus, body["to"], "status")
   245	    sprints_data.propose_item_status(
   246	        conn, item_id, to_status, note=body["note"], proposed_by=ctx.actor, clock=clk
   247	    )
