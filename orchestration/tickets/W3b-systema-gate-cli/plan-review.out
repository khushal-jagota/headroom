    38	
    39	class MindQueue[T]:
    40	    """FIFO-per-key serialized runner: one worker thread per active key.
    41	
    42	    ``on_idle(key)`` (optional) fires once a key's queue has fully drained and the key
    43	    has been removed from ``_active`` — the moment that mind is free again. It runs
    44	    OUTSIDE the lock, so a callback that re-submits (or pokes a poller that will) cannot
    45	    deadlock. This is the fast-path seam W3b's System A registers so a finished step
    46	    immediately drives the next one instead of waiting a full tick."""
    47	
    48	    def __init__(
    49	        self, run: Callable[[str, T], None], *, on_idle: Callable[[str], None] | None = None
    50	    ) -> None:
    51	        self._run = run
    52	        self._on_idle = on_idle
    53	        self._lock = threading.Lock()
    54	        self._idle = threading.Condition(self._lock)
    55	        self._pending: dict[str, deque[T]] = {}
    56	        self._active: set[str] = set()
    57	
    58	    def submit(self, key: str, item: T) -> None:
    59	        if not key:
    60	            raise ValueError("queue key must be a non-empty string")
    61	        with self._lock:
    62	            self._pending.setdefault(key, deque()).append(item)
    63	            if key in self._active:
    64	                return
    65	            self._active.add(key)
    66	        threading.Thread(
    67	            target=self._drain, args=(key,), name=f"mind-queue-{key}", daemon=True
    68	        ).start()
    69	
    70	    def is_active(self, key: str) -> bool:
    71	        """Whether a run is enqueued or in-flight for this key. ``submit`` adds the key
    72	        to ``_active`` synchronously before returning, so a caller that just submitted
    73	        sees True — this closes the enqueue->start-write window a status-only readiness
    74	        check would miss (W3b System A's has_inflight guard)."""
    75	        with self._lock:
    76	            return key in self._active
    77	
    78	    def _drain(self, key: str) -> None:
    79	        while True:
    80	            item: T | None = None  # None is the idle sentinel; no caller ever enqueues None
    81	            with self._lock:
    82	                dq = self._pending.get(key)
    83	                if not dq:
    84	                    self._pending.pop(key, None)
    85	                    self._active.discard(key)
    86	                    self._idle.notify_all()
    87	                else:
    88	                    item = dq.popleft()
    89	            if item is None:
    90	                if self._on_idle is not None:
    91	                    try:
    92	                        self._on_idle(key)  # key already free; safe to re-submit from here
    93	                    except Exception:
    94	                        _log.exception("mind on_idle failed (key=%s)", key)
    95	                return
    96	            try:
    97	                self._run(key, item)
    98	            except Exception:
    99	                _log.exception("mind run failed (key=%s)", key)
   100	
   101	    def wait_idle(self, timeout: float | None = None) -> bool:
   102	        with self._lock:
   103	            return self._idle.wait_for(lambda: not self._active, timeout)

