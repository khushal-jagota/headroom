   208	
   209	# --- queues (§4.5) -------------------------------------------------------------
   210	
   211	
   212	def _entity_type(entity_id: str) -> str:
   213	    return "ticket" if entity_id.split("_", 1)[0] == "t" else "item"
   214	
   215	
   216	def _approvals(conn: sqlite3.Connection, item_approval_rows: list[JsonDict]) -> list[JsonDict]:
   217	    ticket_rows = conn.execute(
   218	        "SELECT id, title, state, fields, updated_at FROM tickets "
   219	        "WHERE state NOT IN ('done','dropped') ORDER BY id"
   220	    ).fetchall()
   221	    ticket_digest: list[dict[str, object]] = []
   222	    ticket_title: dict[str, str] = {}
   223	    ticket_updated: dict[str, int] = {}
   224	    for r in ticket_rows:
   225	        tid = str(r["id"])
   226	        ticket_digest.append(
   227	            {
   228	                "id": tid,
   229	                "state": str(r["state"]),
   230	                "fields": json.loads(str(r["fields"])),
   231	                "updated_at": int(r["updated_at"]),
   232	            }
   233	        )
   234	        ticket_title[tid] = str(r["title"])
   235	        ticket_updated[tid] = int(r["updated_at"])
   236	    item_digest: list[dict[str, object]] = []
   237	    item_title: dict[str, str] = {}
   238	    for r in item_approval_rows:
   239	        iid = str(r["id"])
   240	        item_digest.append({"id": iid, "status_proposal": r["status_proposal"]})
   241	        item_title[iid] = str(r["title"])
   242	    digest = approvals_digest(ticket_digest, item_digest)
   243	    # A5: review entries use the last state_changed->needs_review event time, not the
   244	    # updated_at proxy; the boundary digest keeps its documented proxy.
   245	    for entry in digest:
   246	        if entry["kind"] == "review":
   247	            tid = str(entry["entity_id"])
   248	            row = conn.execute(
   249	                "SELECT created_at FROM events WHERE entity_id = ? AND kind = 'state_changed' "
   250	                "AND json_extract(payload, '$.to') = 'needs_review' ORDER BY id DESC LIMIT 1",
   251	                (tid,),
   252	            ).fetchone()
   253	            entry["waiting_since"] = (
   254	                int(row["created_at"]) if row is not None
   255	                else ticket_updated.get(tid, entry["waiting_since"])
   256	            )
   257	    digest.sort(key=lambda e: e["waiting_since"])
   258	    result: list[JsonDict] = []
   259	    for entry in digest:
   260	        eid = str(entry["entity_id"])
   261	        etype = _entity_type(eid)
   262	        title = ticket_title.get(eid) if etype == "ticket" else item_title.get(eid)
   263	        result.append(
   264	            {
   265	                "entity_id": eid,
   266	                "entity_type": etype,
   267	                "kind": entry["kind"],
   268	                "title": title,
   269	                "waiting_since": entry["waiting_since"],
   270	            }
   271	        )
   272	    return result
   273	
   274	
   275	def _pickup(conn: sqlite3.Connection, now: int) -> list[JsonDict]:
   276	    # Readiness (which tickets are ready to be worked) is System A — W3b. The old
   277	    # claim/eligibility candidate scan is removed with the dispatcher; until System A
   278	    # lands, the pickup section is empty (the board's per-ticket status shows what is
   279	    # running). The key is kept so /api/queues + `queue pickup` keep their shape.
   280	    return []
   281	
   282	
   283	def _overdue(
   284	    conn: sqlite3.Connection, today_iso: str, item_overdue_rows: list[JsonDict]
   285	) -> list[JsonDict]:
   286	    ticket_rows = conn.execute(
   287	        "SELECT id, title, state, priority, deadline FROM tickets WHERE deadline IS NOT NULL "
   288	        "ORDER BY deadline ASC, id"
   289	    ).fetchall()
   290	    ticket_dicts: list[dict[str, object]] = [
   291	        {
   292	            "id": str(r["id"]),
   293	            "title": str(r["title"]),
   294	            "state": str(r["state"]),
   295	            "priority": str(r["priority"]),
   296	            "deadline": str(r["deadline"]) if r["deadline"] is not None else None,
   297	        }
   298	        for r in ticket_rows
   299	    ]
   300	    item_dicts: list[dict[str, object]] = [dict(r) for r in item_overdue_rows]
   301	    digest = overdue_list(ticket_dicts, item_dicts, today_iso)
   302	    ticket_deadline = {str(d["id"]): d["deadline"] for d in ticket_dicts}
   303	    item_deadline = {str(d["id"]): d["deadline"] for d in item_dicts}
   304	    result: list[JsonDict] = []
   305	    for entry in digest:
   306	        eid = str(entry["id"])
   307	        etype = _entity_type(eid)
   308	        deadline = ticket_deadline.get(eid) if etype == "ticket" else item_deadline.get(eid)
   309	        result.append(
   310	            {
   311	                "id": eid,
   312	                "entity_type": etype,
   313	                "title": entry["title"],
   314	                "state": entry["state"],
   315	                "priority": entry["priority"],
   316	                "deadline": deadline,
   317	            }
   318	        )
   319	    return result
   320	
   321	
   322	def queues_view(
   323	    conn: sqlite3.Connection,
   324	    now: int,
   325	    today_iso: str,
   326	    item_approval_rows: list[JsonDict],
   327	    item_overdue_rows: list[JsonDict],
   328	) -> JsonDict:
   329	    return {
   330	        "approvals": _approvals(conn, item_approval_rows),
   331	        "pickup": _pickup(conn, now),
   332	        "overdue": _overdue(conn, today_iso, item_overdue_rows),
   333	    }

