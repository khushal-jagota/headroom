   122	  kind       TEXT NOT NULL,
   123	  payload    TEXT NOT NULL DEFAULT '{}',             -- JSON
   124	  created_at INTEGER NOT NULL
   125	);
   126	CREATE INDEX IF NOT EXISTS idx_events_entity ON events(entity_id, id);
   127	"""
   128	
   129	
   130	def connect(db_path: str, busy_timeout_ms: int = 5000) -> sqlite3.Connection:
   131	    conn = sqlite3.connect(db_path, isolation_level=None)
   132	    conn.row_factory = sqlite3.Row
   133	    conn.execute("PRAGMA journal_mode=WAL")
