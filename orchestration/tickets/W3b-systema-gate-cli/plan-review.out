     1	"""State-machine math for §4.2/§4.3/§4.4: linear order indexing, gating and
     2	advance tables, the auto-accept condition, ceiling comparison, and onward-grant
     3	resolution. Pure: contracts + fields_codec only."""
     4	
     5	from __future__ import annotations
     6	
     7	from typing import Final
     8	
     9	from planner.core.contracts import ErrorCode, PlannerError
    10	from planner.tickets.contracts import (
    11	    ADVANCE_TARGET,
    12	    GATING_FIELD,
    13	    NO_FURTHER,
    14	    STATE_ORDER,
    15	    AtCap,
    16	    FieldName,
    17	    GrantPair,
    18	    NextCeiling,
    19	    TicketFields,
    20	    TicketState,
    21	)
    22	from planner.tickets.logic import fields_codec
    23	
    24	# §4.2 inverse of GATING_FIELD: the state each field gates. A field is "passed"
    25	# once the ticket has advanced strictly beyond the state that field gates.
    26	FIELD_GATES: Final[dict[FieldName, TicketState]] = {
    27	    FieldName.success: TicketState.needs_success,
    28	    FieldName.approach: TicketState.needs_approach,
    29	    FieldName.plan: TicketState.needs_plan,
    30	    FieldName.result: TicketState.in_progress,
    31	}
    32	
    33	
    34	def state_index(state: TicketState) -> int:
    35	    try:
    36	        return STATE_ORDER.index(state)
    37	    except ValueError as exc:
    38	        raise PlannerError(
    39	            ErrorCode.validation, "state outside the linear order", {"state": state.value}
    40	        ) from exc
    41	
    42	
    43	def is_terminal(state: TicketState) -> bool:
    44	    return state in (TicketState.done, TicketState.dropped)
    45	
    46	
    47	def gating_field(state: TicketState) -> FieldName | None:
    48	    return GATING_FIELD.get(state)
    49	
    50	
    51	def field_is_passed(field: FieldName, state: TicketState) -> bool:
    52	    """A field is *passed* iff the state it gates strictly precedes the current
    53	    state in STATE_ORDER. dropped is not in STATE_ORDER, so state_index(dropped)
    54	    raises validation; the decide_edit_value check order rejects dropped explicitly
    55	    before this is reached."""
    56	    return state_index(state) > state_index(FIELD_GATES[field])
    57	
    58	
    59	def advance_target(state: TicketState, ceiling: TicketState) -> TicketState:
    60	    if state is TicketState.in_progress and ceiling is TicketState.done:
    61	        return TicketState.done
    62	    target = ADVANCE_TARGET.get(state)
    63	    if target is None:
    64	        raise PlannerError(
    65	            ErrorCode.validation, "state has no advance target", {"state": state.value}
    66	        )
    67	    return target
    68	
    69	
    70	def auto_accept_target(
    71	    state: TicketState, ceiling: TicketState, field: FieldName
    72	) -> TicketState | None:
    73	    if is_terminal(state):
    74	        return None
    75	    if field is not gating_field(state):
    76	        return None
    77	    target = advance_target(state, ceiling)
    78	    if state_index(target) > state_index(ceiling):
    79	        return None
    80	    return target
    81	
    82	
    83	def at_or_beyond_ceiling(state: TicketState, ceiling: TicketState) -> bool:
    84	    return state_index(state) >= state_index(ceiling)
    85	
    86	
    87	def validate_ceiling(ceiling: TicketState) -> None:
    88	    if ceiling not in STATE_ORDER:
    89	        raise PlannerError(
    90	            ErrorCode.grant_invalid, "ceiling must be a linear state", {"ceiling": ceiling.value}
    91	        )
    92	
    93	
    94	def resolve_grant(
    95	    new_state: TicketState, next_ceiling: NextCeiling | None, at_cap: AtCap | None
    96	) -> GrantPair:
    97	    if next_ceiling is None or at_cap is None:
    98	        missing: list[str] = []
    99	        if next_ceiling is None:
   100	            missing.append("next_ceiling")
   101	        if at_cap is None:
   102	            missing.append("at_cap")
   103	        raise PlannerError(
   104	            ErrorCode.grant_missing, "accept requires the onward grant pair", {"missing": missing}
   105	        )
   106	    if next_ceiling == NO_FURTHER:
   107	        # the ceiling becomes exactly the newly entered state
   108	        return GrantPair(next_ceiling=new_state, at_cap=at_cap)
   109	    if not isinstance(next_ceiling, TicketState):
   110	        raise PlannerError(
   111	            ErrorCode.grant_invalid, "unknown next_ceiling", {"next_ceiling": str(next_ceiling)}
   112	        )
   113	    if next_ceiling not in STATE_ORDER or state_index(next_ceiling) < state_index(new_state):
   114	        raise PlannerError(
   115	            ErrorCode.grant_invalid,
   116	            "next_ceiling must be at or beyond the new state",
   117	            {"next_ceiling": next_ceiling.value, "new_state": new_state.value},
   118	        )
   119	    return GrantPair(next_ceiling=next_ceiling, at_cap=at_cap)
   120	
   121	
   122	def has_pending_gating_proposal(state: TicketState, fields: TicketFields) -> bool:
   123	    field = gating_field(state)
   124	    if field is None:
   125	        return False
   126	    return fields_codec.get_slot(fields, field).proposal is not None

