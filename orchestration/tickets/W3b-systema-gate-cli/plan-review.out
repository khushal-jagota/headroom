   277	@router.patch("/tickets/{ticket_id}")
   278	async def patch_ticket(ticket_id: str, body: dict[str, Any], conn: DbConn, ctx: Ctx,
   279	                       cfg: Cfg, clk: Clk) -> JsonDict:
   280	    recognized = ("title", "priority", "deadline", "project", "sprint_id")
   281	    for key in body:
   282	        if key not in recognized:
   283	            raise PlannerError(ErrorCode.validation, "unknown ticket field", {"field": key})
   284	    if not body:
   285	        raise PlannerError(ErrorCode.validation, "no ticket fields to update", {})
   286	    reject_agent_fields(ctx, body, _TICKET_HUMAN_ONLY_FIELDS)
   287	    now = clk.now_unix()
   288	    if "title" in body:
   289	        _set_title(conn, ticket_id, body["title"], title_max_chars=TITLE_MAX_CHARS, now=now)
   290	    if "priority" in body:
   291	        priority = parse_enum(Priority, body["priority"], "priority")
   292	        tickets_data.set_priority(conn, ticket_id, priority=priority, actor=ctx.actor, now=now)
   293	    if "deadline" in body:
   294	        tickets_data.set_deadline(conn, ticket_id, deadline=body["deadline"], actor=ctx.actor,
   295	                                  now=now)
   296	    if "project" in body:
   297	        project = parse_enum(Project, body["project"], "project") \
   298	            if body["project"] is not None else None
   299	        _set_project(conn, ticket_id, project, now=now)
   300	    if "sprint_id" in body:
   301	        tickets_data.set_sprint(conn, ticket_id, sprint_id=body["sprint_id"], actor=ctx.actor,
   302	                                now=now)
   303	    return tickets_views.ticket_json(tickets_data.read_ticket(conn, ticket_id), now)
