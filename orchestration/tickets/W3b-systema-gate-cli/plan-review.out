    69	
    70	# --- shared plumbing (imported by the other api modules) -----------------------
    71	
    72	
    73	def get_config(request: Request) -> Config:
    74	    return cast(Config, request.app.state.config)
    75	
    76	
    77	def get_clock(request: Request) -> Clock:
    78	    return cast(Clock, request.app.state.clock)
