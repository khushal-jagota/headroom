    24	
    25	_LOGGER = logging.getLogger(__name__)
    26	
    27	ConnFactory = Callable[[], sqlite3.Connection]
    28	
    29	
    30	async def _loop_forever(name: str, tick: Callable[[], JsonDict], interval: int) -> None:
    31	    """One background loop: tick first (the first dispatcher iteration performs the
    32	    once-per-process lock acquisition), then sleep. A4: shield the in-flight tick
    33	    thread so cancellation waits it out — the lock is never released under a running
    34	    tick. Catch Exception only so CancelledError propagates."""
    35	    while True:
    36	        thread_task = asyncio.ensure_future(asyncio.to_thread(tick))
    37	        try:
    38	            await asyncio.shield(thread_task)
    39	        except asyncio.CancelledError:
    40	            with contextlib.suppress(BaseException):
    41	                await thread_task
    42	            raise
    43	        except Exception:
    44	            _LOGGER.exception("background %s tick failed", name)
    45	        await asyncio.sleep(interval)
    46	
    47	
    48	class BackgroundLoops:
    49	    def __init__(self, tasks: list[asyncio.Task[None]]) -> None:
    50	        self._tasks = tasks
    51	        self._stopped = False
    52	
    53	    async def stop(self) -> None:
    54	        """Cancel the tasks and wait them out (which also waits out any in-flight tick
    55	        thread). Idempotent: a re-stopped handle is a no-op."""
    56	        global _active
    57	        if self._stopped:
    58	            return
    59	        self._stopped = True
    60	        for task in self._tasks:
    61	            task.cancel()
    62	        await asyncio.gather(*self._tasks, return_exceptions=True)
    63	        if _active is self:
    64	            _active = None
    65	
    66	
    67	_active: BackgroundLoops | None = None
    68	
    69	
    70	def start_background_loops(
    71	    config: Config, clock: Clock, adapters: Adapters, conn_factory: ConnFactory
    72	) -> BackgroundLoops:
    73	    """Start the boundary loop on the running event loop. At most one live instance
    74	    per process."""
    75	    global _active
    76	    if _active is not None:
    77	        raise RuntimeError("background loops already running")
    78	    boundary = asyncio.create_task(
    79	        _loop_forever(
    80	            "boundary",
    81	            partial(run_boundary_tick, conn_factory, config, clock, adapters),
    82	            config.tick_seconds,
    83	        )
    84	    )
    85	    loops = BackgroundLoops([boundary])
    86	    _active = loops
    87	    return loops

