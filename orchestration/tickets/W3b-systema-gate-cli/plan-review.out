    58	  priority             TEXT NOT NULL DEFAULT 'P3' CHECK (priority IN ('P0','P1','P2','P3')),
    59	  deadline             TEXT,
    60	  project              TEXT CHECK (project IN ('Vylo','Tribe','Learning','Other')),  -- NULL when parented
    61	  sprint_item_id       TEXT REFERENCES sprint_items(id),
    62	  sprint_id            TEXT REFERENCES sprints(id),  -- writable only when sprint_item_id IS NULL
    63	  recap                TEXT NOT NULL DEFAULT '',
    64	  ceiling              TEXT NOT NULL DEFAULT 'needs_success'
    65	                       CHECK (ceiling IN ('needs_success','needs_approach','needs_plan',
    66	                                          'in_progress','needs_review','done')),
    67	  at_cap               TEXT NOT NULL DEFAULT 'propose' CHECK (at_cap IN ('stop','propose')),
