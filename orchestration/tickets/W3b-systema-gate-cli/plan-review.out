    18	
    19	class TicketState(StrEnum):        # §4.1, exact order
    20	    needs_success = "needs_success"
    21	    needs_approach = "needs_approach"
    22	    needs_plan = "needs_plan"
    23	    in_progress = "in_progress"
    24	    needs_review = "needs_review"
    25	    done = "done"
    26	    dropped = "dropped"            # terminal, human-only, outside the linear order
    27	
    28	
    29	# Linear pipeline order (dropped excluded). Index comparison implements "<= ceiling".
    30	# ceiling and next_ceiling values are restricted to members of this tuple (never dropped).
    31	STATE_ORDER: Final[tuple[TicketState, ...]] = (
    32	    TicketState.needs_success, TicketState.needs_approach, TicketState.needs_plan,
    33	    TicketState.in_progress, TicketState.needs_review, TicketState.done,
    34	)
    35	
    36	
    37	class FieldName(StrEnum):          # §4.2 — the exactly-four field keys
    38	    success = "success"
    39	    approach = "approach"
    40	    plan = "plan"
    41	    result = "result"
    42	
    43	
    44	class AtCap(StrEnum):              # §4.3
    45	    stop = "stop"
    46	    propose = "propose"
    47	
    48	
    49	class TicketStatus(StrEnum):       # code-owned run status (the reframed "lock"); System B writes it
    50	    empty = "empty"                # nothing started
    51	    agent_working = "agent_working"
    52	    awaiting_approval = "awaiting_approval"
    53	    errored = "errored"
