    28	# --- serializers ---------------------------------------------------------------
    29	
    30	
    31	def ticket_json(ticket: Ticket, now: int) -> JsonDict:
    32	    """§3.3 ticket. The code-owned run status/worker are the reframed "lock": the UI
    33	    reads this one field (System B is the sole writer)."""
    34	    return {
    35	        "id": ticket.id,
    36	        "title": ticket.title,
    37	        "state": ticket.state.value,
    38	        "priority": ticket.priority.value,
    39	        "deadline": ticket.deadline,
    40	        "project": ticket.project.value if ticket.project is not None else None,
    41	        "sprint_item_id": ticket.sprint_item_id,
    42	        "sprint_id": ticket.sprint_id,
    43	        "recap": ticket.recap,
    44	        "ceiling": ticket.ceiling.value,
    45	        "at_cap": ticket.at_cap.value,
    46	        "status": ticket.status.value,
    47	        "worker": ticket.worker,
    48	        "chat_session_key": ticket.chat_session_key,
    49	        "alias": ticket.alias,
    50	        "fields": json.loads(fields_codec.fields_to_json(ticket.fields)),
    51	        "created_at": ticket.created_at,
    52	        "updated_at": ticket.updated_at,
    53	    }
    54	
    55	
    56	def event_json(row: sqlite3.Row) -> JsonDict:
    57	    return {
    58	        "id": int(row["id"]),
    59	        "entity_id": str(row["entity_id"]),
    60	        "kind": str(row["kind"]),
    61	        "payload": json.loads(str(row["payload"])),
    62	        "created_at": int(row["created_at"]),
    63	    }
    64	
    65	
    66	# --- ticket reads --------------------------------------------------------------
    67	
    68	
    69	def list_tickets(
    70	    conn: sqlite3.Connection,
    71	    now: int,
    72	    *,
    73	    state: TicketState | None,
    74	    project: Project | None,
    75	    sprint_id: str | None,
    76	    sprint_item_id: str | None,
    77	) -> list[JsonDict]:
    78	    clauses: list[str] = []
    79	    params: list[str] = []
    80	    if state is not None:
    81	        clauses.append("state = ?")
    82	        params.append(state.value)
    83	    if project is not None:
    84	        clauses.append("project = ?")
    85	        params.append(project.value)
    86	    if sprint_id is not None:
    87	        clauses.append("sprint_id = ?")
    88	        params.append(sprint_id)
    89	    if sprint_item_id is not None:
    90	        clauses.append("sprint_item_id = ?")
    91	        params.append(sprint_item_id)
    92	    where = (" WHERE " + " AND ".join(clauses)) if clauses else ""
    93	    rows = conn.execute(
    94	        "SELECT id FROM tickets" + where + " ORDER BY created_at ASC, id", tuple(params)
    95	    ).fetchall()
    96	    return [ticket_json(tickets_data.read_ticket(conn, str(row["id"])), now) for row in rows]
    97	
    98	
    99	def ticket_detail(conn: sqlite3.Connection, ticket_id: str, now: int) -> JsonDict:
   100	    ticket = tickets_data.read_ticket(conn, ticket_id)
   101	    detail = ticket_json(ticket, now)
   102	    link_rows = conn.execute(
   103	        "SELECT from_id, to_id, kind FROM links WHERE from_id = ? OR to_id = ? "
   104	        "ORDER BY kind, from_id, to_id",
   105	        (ticket_id, ticket_id),
   106	    ).fetchall()
   107	    day_rows = conn.execute(
   108	        "SELECT day_id FROM day_tickets WHERE ticket_id = ? ORDER BY day_id ASC", (ticket_id,)
   109	    ).fetchall()
   110	    detail.update(
   111	        {
   112	            "blocked": core_links.is_blocked(conn, ticket_id),
   113	            "effective_sprint_id": tickets_data.get_effective_sprint_id(conn, ticket_id),
   114	            "links": [
   115	                {"from_id": str(r["from_id"]), "to_id": str(r["to_id"]), "kind": str(r["kind"])}
   116	                for r in link_rows
   117	            ],
   118	            "day_ids": [str(r["day_id"]) for r in day_rows],
   119	        }
   120	    )
   121	    return detail
   122	
   123	
   124	def list_events_for_entity(conn: sqlite3.Connection, entity_id: str, limit: int) -> list[JsonDict]:
   125	    rows = conn.execute(
   126	        "SELECT id, entity_id, kind, payload, created_at FROM events WHERE entity_id = ? "
   127	        "ORDER BY id ASC LIMIT ?",
   128	        (entity_id, limit),
   129	    ).fetchall()
   130	    return [event_json(r) for r in rows]
   131	
   132	
   133	def copy_text(conn: sqlite3.Connection, ticket_id: str) -> str:
   134	    ticket = tickets_data.read_ticket(conn, ticket_id)
   135	    fields = ticket.fields
   136	
   137	    def show(value: str | None) -> str:
   138	        return value if value else "(none)"
   139	
   140	    link_rows = conn.execute(
   141	        "SELECT from_id, to_id, kind FROM links WHERE from_id = ? OR to_id = ? "
   142	        "ORDER BY kind, from_id, to_id",
   143	        (ticket_id, ticket_id),
   144	    ).fetchall()
   145	    if link_rows:
   146	        links_block = "\n".join(
   147	            f"- {str(r['kind'])}: {str(r['from_id'])} -> {str(r['to_id'])}" for r in link_rows
   148	        )
   149	    else:
   150	        links_block = "(none)"
   151	    return (
   152	        f"{ticket.title}\n"
   153	        f"state: {ticket.state.value}\n"
   154	        f"priority: {ticket.priority.value}\n"
   155	        f"\n"
   156	        f"success:\n{show(fields.success.value)}\n"
   157	        f"\n"
   158	        f"approach:\n{show(fields.approach.value)}\n"
   159	        f"\n"
   160	        f"plan:\n{show(fields.plan.value)}\n"
   161	        f"\n"
   162	        f"result:\n{show(fields.result.value)}\n"
   163	        f"\n"
   164	        f"recap:\n{show(ticket.recap)}\n"
   165	        f"\n"
   166	        f"links:\n{links_block}\n"
   167	    )
