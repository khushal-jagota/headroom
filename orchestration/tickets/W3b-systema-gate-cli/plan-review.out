     1	"""Day routes (§9). The {date} path segment accepts the literal `today` (resolved
     2	via the planning date) or any ISO date. Thin HTTP shells over the day data layer;
     3	materialize-on-read is spec'd (§3.4)."""
     4	
     5	from __future__ import annotations
     6	
     7	import sqlite3
     8	from datetime import date
     9	from typing import Any
    10	
    11	from fastapi import APIRouter
    12	
    13	from planner.core import ids
    14	from planner.core.authctx import reject_agents
    15	from planner.core.clock import Clock
    16	from planner.core.config import Config
    17	from planner.core.contracts import JsonDict
    18	from planner.core.errors import ErrorCode, PlannerError
    19	from planner.days import data as days_data
    20	from planner.days.contracts import AddDayTicketBody
    21	from planner.days.logic.dates import planning_date
    22	from planner.tickets.api import Cfg, Clk, Ctx, DbConn, body_opt_str, body_str, txn
    23	from planner.tickets.data import read_ticket
    24	from planner.tickets.views import ticket_json
    25	
    26	router = APIRouter()
    27	
    28	
    29	# --- shared day helpers --------------------------------------------------------
    30	
    31	
    32	def resolve_day_id(date_seg: str, clock: Clock, config: Config) -> str:
    33	    """Amendment 10: `today` resolves through the planning date. A6: the ISO branch
    34	    parses then re-formats via ids.day_id, so compact forms ('20260704') still yield
    35	    canonical day_2026-07-04 ids — the raw segment is never string-formatted."""
    36	    if date_seg == "today":
    37	        return ids.day_id(planning_date(clock.now(), config.boundary_hour))
    38	    try:
    39	        parsed = date.fromisoformat(date_seg)
    40	    except ValueError:
    41	        raise PlannerError(ErrorCode.validation, "invalid date", {"date": date_seg}) from None
    42	    return ids.day_id(parsed)
    43	
    44	
    45	def _day_view(conn: sqlite3.Connection, did: str, now: int) -> JsonDict:
    46	    # A2: read_day materializes an absent day (INSERT + event, multi-statement) on an
    47	    # autocommit connection, so this one read is wrapped; the rest run bare.
    48	    with txn(conn):
    49	        day = days_data.read_day(conn, did, now)
    50	    dts = days_data.list_day_tickets(conn, did)
    51	    return {
    52	        "id": day.id,
    53	        "focus": day.focus,
    54	        "brief_take": day.brief_take,
    55	        "watchout": day.watchout,
    56	        "if_today_lands": day.if_today_lands,
    57	        "notes": day.notes,
    58	        "chat_session_key": day.chat_session_key,
    59	        "created_at": day.created_at,
    60	        "updated_at": day.updated_at,
    61	        "tickets": [ticket_json(read_ticket(conn, dt.ticket_id), now) for dt in dts],
    62	    }
    63	
    64	
    65	# --- day routes ----------------------------------------------------------------
    66	
    67	
    68	@router.get("/day/{date}")
    69	async def get_day(date: str, conn: DbConn, cfg: Cfg, clk: Clk) -> JsonDict:
    70	    did = resolve_day_id(date, clk, cfg)
    71	    return _day_view(conn, did, clk.now_unix())
    72	
    73	
    74	@router.patch("/day/{date}")
    75	async def patch_day(date: str, raw: dict[str, Any], conn: DbConn, ctx: Ctx, cfg: Cfg,
    76	                    clk: Clk) -> JsonDict:
    77	    reject_agents(ctx)  # §8: overview fields + notes are human-only; the boundary writes its own
    78	    did = resolve_day_id(date, clk, cfg)
    79	    now = clk.now_unix()
    80	    # Each overview field (and notes) edits on its own — no whole-blob re-serialize.
    81	    edits: dict[str, str] = {}
    82	    for field in days_data.DAY_TEXT_FIELDS:
    83	        value = body_opt_str(raw, field)
    84	        if value is not None:
    85	            edits[field] = value
    86	    if not edits:
    87	        raise PlannerError(ErrorCode.validation, "no day fields to update", {})
    88	    for field, value in edits.items():
    89	        with txn(conn):
    90	            days_data.set_day_field(conn, did, field, value, now)
    91	    return _day_view(conn, did, now)
    92	
    93	
    94	@router.post("/day/{date}/tickets")
    95	async def add_day_ticket(date: str, raw: dict[str, Any], conn: DbConn,
    96	                         cfg: Cfg, clk: Clk) -> JsonDict:
    97	    body = AddDayTicketBody(ticket_id=body_str(raw, "ticket_id"))
    98	    did = resolve_day_id(date, clk, cfg)
    99	    now = clk.now_unix()
   100	    read_ticket(conn, body["ticket_id"])  # existence guard (avoids a raw FK 500)
   101	    with txn(conn):
   102	        days_data.add_day_ticket(conn, did, body["ticket_id"], now)
   103	    return _day_view(conn, did, now)
   104	
   105	
   106	@router.delete("/day/{date}/tickets/{ticket_id}")
   107	async def remove_day_ticket(date: str, ticket_id: str, conn: DbConn, cfg: Cfg,
   108	                            clk: Clk) -> JsonDict:
   109	    did = resolve_day_id(date, clk, cfg)
   110	    now = clk.now_unix()
   111	    with txn(conn):
   112	        days_data.remove_day_ticket(conn, did, ticket_id, now)
   113	    return _day_view(conn, did, now)

