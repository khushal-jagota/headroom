 succeeded in 0ms:
     1	"""Machine-wide advisory lock, relocated intact from the removed dispatch runtime
     2	(notes.md "DECIDED KEEP · dispatcher machine-lock"). Nothing in W3a consumes it —
     3	it is preserved here for W3b's System A, which needs a singleton machine guard so
     4	only one readiness poll drives the board per machine.
     5	
     6	The lock is acquired once per path and then held by the process (released only on
     7	process exit or an explicit release). One cached OS fd per lock path."""
     8	
     9	from __future__ import annotations
    10	
    11	import fcntl
    12	import os
    13	from pathlib import Path
    14	from typing import Final
    15	
    16	_LOCK_FDS: Final[dict[str, int]] = {}
    17	
    18	
    19	def ensure_machine_lock(lock_path: str) -> bool:
    20	    """Acquire (once) the machine-wide advisory lock; True when this process holds it."""
    21	    if lock_path in _LOCK_FDS:
    22	        return True
    23	    Path(lock_path).parent.mkdir(parents=True, exist_ok=True)
    24	    fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o644)
    25	    try:
    26	        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    27	    except BlockingIOError:
    28	        os.close(fd)
    29	        return False
    30	    _LOCK_FDS[lock_path] = fd
    31	    return True
    32	
    33	
    34	def release_machine_lock(lock_path: str) -> None:
    35	    """Explicit release used by loop shutdown and tests. Safe no-op when not held."""
    36	    fd = _LOCK_FDS.pop(lock_path, None)
    37	    if fd is not None:
    38	        fcntl.flock(fd, fcntl.LOCK_UN)
    39	        os.close(fd)

