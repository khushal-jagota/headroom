    20	# §7.2 priority band: P0 first. The board reuses the same triple the dispatcher orders by.
    21	_PRIORITY_RANK = ("P0", "P1", "P2", "P3")
    22	
    23	
    24	def _prio_rank(priority: str) -> int:
    25	    return _PRIORITY_RANK.index(priority)
