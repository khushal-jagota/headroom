    65	# §8: agents drive priority/deadline/day/sprint via `ticket set`; title and project are
    66	# human-only, so an agent-classified PATCH touching them is agent_forbidden (§14).
    67	_TICKET_HUMAN_ONLY_FIELDS = ("title", "project")
