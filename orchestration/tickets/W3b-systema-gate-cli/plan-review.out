    27	CAUSE_REVIEW_APPROVE: Final[str] = "review_approve"
    28	CAUSE_HUMAN_STATE_JUMP: Final[str] = "human_state_jump"
    29	CAUSE_DROP: Final[str] = "drop"
    30	CAUSE_ONWARD_GRANT: Final[str] = "onward_grant"
    31	CAUSE_HUMAN_GRANT: Final[str] = "human_grant"
    32	RESOLVED_BY_AUTO: Final[str] = "auto"
    33	RESOLVED_BY_HUMAN: Final[str] = "human"
    34	
    35	
    36	def _state_change(old: TicketState, new: TicketState, cause: str) -> EventSpec:
    37	    return EventSpec(EventKind.state_changed, {"from": old.value, "to": new.value, "cause": cause})
    38	
    39	
    40	def _accept_gating_proposal(
    41	    ticket: Ticket,
    42	    field: FieldName,
    43	    stored_body: str,
    44	    resolved_by: str,
    45	    edited: bool,
    46	    grant: GrantPair | None,
    47	    cause: str,
    48	    superseded_body: str | None = None,
    49	) -> Decision:
    50	    slot = fields_codec.get_slot(ticket.fields, field)
    51	    new_slot = FieldSlot(value=stored_body, proposal=None, notes=slot.notes)
    52	    new_fields = fields_codec.with_slot(ticket.fields, field, new_slot)
    53	    new_state = machine.advance_target(ticket.state, ticket.ceiling)
    54	    events: list[EventSpec] = []
    55	    if superseded_body is not None:
    56	        events.append(
    57	            EventSpec(
    58	                EventKind.proposal_superseded,
    59	                {"field": field.value, "replaced_body": superseded_body},
    60	            )
    61	        )
    62	    events.append(
    63	        EventSpec(
    64	            EventKind.proposal_accepted,
    65	            {
    66	                "field": field.value,
    67	                "body": stored_body,
    68	                "resolved_by": resolved_by,
    69	                "edited": edited,
    70	            },
    71	        )
    72	    )
    73	    events.append(_state_change(ticket.state, new_state, cause))
    74	    new_ceiling: TicketState | None = None
    75	    new_at_cap: AtCap | None = None
    76	    if grant is not None:
    77	        ceiling = grant.next_ceiling
    78	        assert isinstance(ceiling, TicketState)  # resolve_grant always yields a concrete state
    79	        new_ceiling = ceiling
    80	        new_at_cap = grant.at_cap
    81	        events.append(
    82	            EventSpec(
    83	                EventKind.grant_changed,
    84	                {
    85	                    "ceiling": ceiling.value,
    86	                    "at_cap": grant.at_cap.value,
    87	                    "cause": CAUSE_ONWARD_GRANT,
    88	                },
    89	            )
    90	        )
    91	    return Decision(
    92	        events=tuple(events),
    93	        new_fields=new_fields,
    94	        new_state=new_state,
    95	        new_ceiling=new_ceiling,
    96	        new_at_cap=new_at_cap,
    97	    )
    98	
    99	
   100	def decide_file_proposal(
   101	    ticket: Ticket, field: FieldName, body: str, actor: str, now: int
   102	) -> Decision:
   103	    admission.validate_body(body, "proposal body")
   104	    admission.check_agent_proposal(ticket.state, ticket.ceiling, ticket.at_cap, field)
   105	    slot = fields_codec.get_slot(ticket.fields, field)
   106	    superseded_body = slot.proposal.body if slot.proposal is not None else None
   107	    if machine.auto_accept_target(ticket.state, ticket.ceiling, field) is not None:
   108	        return _accept_gating_proposal(
   109	            ticket,
   110	            field,
   111	            stored_body=body,
   112	            resolved_by=RESOLVED_BY_AUTO,
   113	            edited=False,
   114	            grant=None,
   115	            cause=CAUSE_AUTO_ACCEPT,
   116	            superseded_body=superseded_body,
   117	        )
   118	    new_slot = FieldSlot(
   119	        value=slot.value,
   120	        proposal=Proposal(body=body, proposed_by=actor, created_at=now),
   121	        notes=slot.notes,
   122	    )
   123	    new_fields = fields_codec.with_slot(ticket.fields, field, new_slot)
   124	    events: list[EventSpec] = []
   125	    if superseded_body is not None:
   126	        events.append(
   127	            EventSpec(
   128	                EventKind.proposal_superseded,
   129	                {"field": field.value, "replaced_body": superseded_body},
   130	            )
   131	        )
   132	    events.append(
   133	        EventSpec(
   134	            EventKind.proposal_filed,
   135	            {"field": field.value, "body": body, "proposed_by": actor},
   136	        )
   137	    )
   138	    return Decision(events=tuple(events), new_fields=new_fields)
   139	
   140	
   141	def decide_accept(
   142	    ticket: Ticket,
   143	    field: FieldName,
   144	    actor: str,
   145	    edited_body: str | None,
   146	    next_ceiling: NextCeiling | None,
   147	    at_cap: AtCap | None,
   148	) -> Decision:
   149	    admission.require_human(actor, "accept_proposal")
   150	    if edited_body is not None:
   151	        admission.validate_body(edited_body, "edit-accept text")
   152	    edited = edited_body is not None
   153	    if ticket.state is TicketState.dropped:
   154	        raise PlannerError(
   155	            ErrorCode.validation, "dropped tickets cannot be accepted", {"state": "dropped"}
   156	        )
   157	    slot = fields_codec.get_slot(ticket.fields, field)
   158	    if slot.proposal is None:
   159	        raise PlannerError(
   160	            ErrorCode.not_found,
   161	            "no pending proposal on field",
   162	            {"ticket_id": ticket.id, "field": field.value},
   163	        )
   164	    stored_body = edited_body if edited_body is not None else slot.proposal.body
   165	    if field is machine.gating_field(ticket.state):
   166	        new_state = machine.advance_target(ticket.state, ticket.ceiling)
   167	        grant = machine.resolve_grant(new_state, next_ceiling, at_cap)
   168	        return _accept_gating_proposal(
   169	            ticket,
   170	            field,
   171	            stored_body=stored_body,
   172	            resolved_by=RESOLVED_BY_HUMAN,
   173	            edited=edited,
   174	            grant=grant,
   175	            cause=CAUSE_HUMAN_ACCEPT,
   176	        )
   177	    new_slot = FieldSlot(value=stored_body, proposal=None, notes=slot.notes)
   178	    new_fields = fields_codec.with_slot(ticket.fields, field, new_slot)
   179	    events = (
   180	        EventSpec(
   181	            EventKind.proposal_accepted,
   182	            {
   183	                "field": field.value,
   184	                "body": stored_body,
   185	                "resolved_by": RESOLVED_BY_HUMAN,
   186	                "edited": edited,
   187	            },
   188	        ),
   189	    )
   190	    return Decision(events=events, new_fields=new_fields)
   191	
   192	
   193	def decide_edit_value(
   194	    ticket: Ticket, field: FieldName, new_body: str, actor: str
   195	) -> Decision:
   196	    """§4.2 human edit of an already-*passed* settled value. The value stays written
   197	    solely by the resolution engine; this is a tightly-guarded human write path that
   198	    never touches state/ceiling. It rejects dropped tickets, an unset value, a field
   199	    carrying a live proposal, and the current gating or any future field."""
   200	    admission.require_human(actor, "edit_field_value")
   201	    admission.validate_body(new_body, "field value")
   202	    if ticket.state is TicketState.dropped:
   203	        raise PlannerError(
   204	            ErrorCode.validation, "dropped tickets cannot be edited", {"state": "dropped"}
   205	        )
   206	    slot = fields_codec.get_slot(ticket.fields, field)
   207	    if slot.value is None:
   208	        raise PlannerError(
   209	            ErrorCode.validation, "field has no settled value to edit", {"field": field.value}
   210	        )
   211	    if slot.proposal is not None:
   212	        raise PlannerError(
   213	            ErrorCode.validation, "field has a pending proposal", {"field": field.value}
   214	        )
   215	    if not machine.field_is_passed(field, ticket.state):
   216	        raise PlannerError(
   217	            ErrorCode.validation,
   218	            "field is not yet passed",
   219	            {"field": field.value, "state": ticket.state.value},
   220	        )
   221	    new_slot = FieldSlot(value=new_body, proposal=None, notes=slot.notes)
   222	    new_fields = fields_codec.with_slot(ticket.fields, field, new_slot)
   223	    return Decision(
   224	        events=(
   225	            EventSpec(EventKind.field_value_edited, {"field": field.value, "body": new_body}),
   226	        ),
   227	        new_fields=new_fields,
   228	    )
   229	
   230	
   231	def decide_approve(ticket: Ticket, actor: str) -> Decision:
   232	    admission.require_human(actor, "approve_review")
   233	    if ticket.state is not TicketState.needs_review:
   234	        raise PlannerError(
   235	            ErrorCode.validation,
   236	            "approve requires state needs_review",
   237	            {"state": ticket.state.value},
   238	        )
   239	    events = (_state_change(ticket.state, TicketState.done, CAUSE_REVIEW_APPROVE),)
   240	    return Decision(events=events, new_state=TicketState.done)
   241	
   242	
   243	def decide_state_jump(ticket: Ticket, new_state: TicketState, actor: str) -> Decision:
   244	    admission.require_human(actor, "set_state")
   245	    if new_state is TicketState.dropped:
   246	        raise PlannerError(ErrorCode.validation, "use the drop action")
   247	    if ticket.state is TicketState.dropped:
   248	        raise PlannerError(ErrorCode.validation, "dropped is terminal")
   249	    if new_state is ticket.state:
   250	        raise PlannerError(ErrorCode.validation, "ticket already in that state")
   251	    events = (_state_change(ticket.state, new_state, CAUSE_HUMAN_STATE_JUMP),)
   252	    return Decision(events=events, new_state=new_state)
   253	
   254	
   255	def decide_drop(ticket: Ticket, actor: str) -> Decision:
   256	    admission.require_human(actor, "drop_ticket")
   257	    if ticket.state is TicketState.done:
   258	        raise PlannerError(
   259	            ErrorCode.validation, "done tickets cannot be dropped", {"state": "done"}
   260	        )
   261	    if ticket.state is TicketState.dropped:
   262	        raise PlannerError(
   263	            ErrorCode.validation, "ticket is already dropped", {"state": "dropped"}
   264	        )
   265	    events = (_state_change(ticket.state, TicketState.dropped, CAUSE_DROP),)
   266	    return Decision(events=events, new_state=TicketState.dropped)
   267	
   268	
   269	def decide_grant_change(
   270	    ticket: Ticket, ceiling: TicketState, at_cap: AtCap, actor: str
   271	) -> Decision:
   272	    admission.require_human(actor, "change_grant")
   273	    machine.validate_ceiling(ceiling)
   274	    events = (
   275	        EventSpec(
   276	            EventKind.grant_changed,
   277	            {"ceiling": ceiling.value, "at_cap": at_cap.value, "cause": CAUSE_HUMAN_GRANT},
   278	        ),
   279	    )
   280	    return Decision(events=events, new_ceiling=ceiling, new_at_cap=at_cap)

