   190	def set_run_status(
   191	    conn: sqlite3.Connection,
   192	    ticket_id: str,
   193	    *,
   194	    status: TicketStatus,
   195	    worker: str | None,
   196	    session_key: str | None | _Unset = _UNSET,
   197	    error: str | None = None,
   198	    now: int,
   199	) -> Ticket:
   200	    """The single door for the ticket's code-owned run status (System B is the only caller).
   201	    Writes status + worker together in ONE atomic UPDATE — dissolving the runless orphan (there is
   202	    no second write to crash between) — optionally advancing the mind's durable chat_session_key,
   203	    then appends one ticket_status_changed event. Passing session_key=None clears the key; leaving
   204	    it as the _UNSET sentinel leaves the stored key untouched. `error` is surfaced in the event
   205	    payload only (it never affects the row), so an errored run's reason lands in the debug log."""
   206	    with _txn(conn):
   207	        _load_ticket(conn, ticket_id)  # existence guard -> not_found
   208	        if isinstance(session_key, _Unset):
   209	            conn.execute(
   210	                "UPDATE tickets SET status = ?, worker = ?, updated_at = ? WHERE id = ?",
   211	                (status.value, worker, now, ticket_id),
   212	            )
   213	        else:
   214	            conn.execute(
   215	                "UPDATE tickets SET status = ?, worker = ?, chat_session_key = ?, updated_at = ? "
   216	                "WHERE id = ?",
   217	                (status.value, worker, session_key, now, ticket_id),
   218	            )
   219	        payload: dict[str, object] = {"status": status.value, "worker": worker}
   220	        if error is not None:
   221	            payload["error"] = error
   222	        append_event(conn, ticket_id, EventKind.ticket_status_changed, payload, now)
   223	        return _load_ticket(conn, ticket_id)
