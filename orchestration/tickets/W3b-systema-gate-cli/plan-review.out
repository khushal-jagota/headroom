     4	
     5	Every verb supports --json (machine output; exit codes 0 success, 1
     6	validation/domain error, 2 connection error). Long text arrives via
     7	`--body-file <path>` where `-` reads stdin — body text is never an inline
     8	argument. Every handler speaks HTTP through planner.cli.http, which owns all
     9	output and exit-code decisions; a handler only builds a route + body."""
    10	
    11	from __future__ import annotations
    12	
    13	import os
    14	import sqlite3
    15	import sys
    16	from collections.abc import Callable
    17	from pathlib import Path
    18	from typing import Any
    19	
    20	import click
    21	from click.core import ParameterSource
    22	
    23	from planner.cli import http
    24	
    25	_PRIORITIES = ["P0", "P1", "P2", "P3"]
    26	_FIELDS = ["success", "approach", "plan", "result"]
    27	_LINK_KINDS = ["belongs_to", "parent_child", "blocks", "relates"]
    28	_TICKET_ID_ENV = "PLAN_TICKET_ID"
    29	
    30	
    31	# --- body input, id resolution, and render helpers (amendment 6) ---------------
    32	
    33	
    34	def _read_source(spec: str, as_json: bool) -> str:
    35	    """`-` -> stdin; else read the file. Unreadable file -> validation exit 1."""
    36	    if spec == "-":
    37	        return sys.stdin.read()
    38	    try:
    39	        return Path(spec).read_text(encoding="utf-8")
    40	    except OSError:
    41	        http.fail_validation(f"cannot read body file: {spec}", as_json)
    42	
    43	
    44	def _positional_is_stdin_marker(positional: str | None) -> bool:
    45	    """True only for a '-' the caller actually typed. click fills the positional from
    46	    PLAN_TICKET_ID too, and an env value of '-' is a bogus ticket id, not a stdin
    47	    request (amendment 6: body sources are explicit only)."""
    48	    if positional != "-":
    49	        return False
    50	    source = click.get_current_context().get_parameter_source("ticket_id")
    51	    return source == ParameterSource.COMMANDLINE
    52	
    53	
    54	def read_body(positional_ticket_id: str | None, body_file: str | None, as_json: bool) -> str:
    55	    """Required-body verbs. Body source is explicit only: --body-file PATH (or -), or a
    56	    trailing positional that is literally '-' (the stdin marker, not a ticket id).
    57	    Whitespace-only body -> validation exit 1. Returns the original unstripped text."""
    58	    if body_file is not None:
    59	        text = _read_source(body_file, as_json)
    60	    elif _positional_is_stdin_marker(positional_ticket_id):
    61	        text = sys.stdin.read()
    62	    else:
    63	        http.fail_validation("body required: pass '-' for stdin or --body-file PATH", as_json)
    64	    if not text.strip():
    65	        http.fail_validation("empty body", as_json)
    66	    return text
    67	
    68	
    69	def read_optional_body(body_file: str | None, as_json: bool) -> str | None:
    70	    """Optional-body verbs. Body comes only from --body-file (which may be '-');
    71	    absent flag -> None."""
    72	    if body_file is None:
    73	        return None
    74	    return _read_source(body_file, as_json)
    75	
    76	
    77	def resolve_ticket_id(positional: str | None, as_json: bool) -> str:
    78	    """Effective ticket id. A real positional wins; a None or '-' positional falls back
    79	    to PLAN_TICKET_ID (re-read here since click's envvar fallback does not fire when the
    80	    positional is the '-' stdin marker). Missing -> validation exit 1."""
    81	    if positional is not None and positional != "-":
    82	        return positional
    83	    env = os.environ.get(_TICKET_ID_ENV, "").strip()
    84	    if env and env != "-":  # '-' is the stdin marker, never a ticket id
    85	        return env
    86	    http.fail_validation("ticket id required: pass it or set PLAN_TICKET_ID", as_json)
    87	
    88	
    89	def _drop_none(d: dict[str, Any]) -> dict[str, Any]:
    90	    return {k: v for k, v in d.items() if v is not None}
    91	
    92	
    93	def _lines(rows: list[Any], fmt: Callable[[Any], str]) -> str:
    94	    return "\n".join(fmt(r) for r in rows) if rows else "(none)"
    95	
    96	
    97	def json_option(func: Callable[..., Any]) -> Callable[..., Any]:
    98	    return click.option(
    99	        "--json",
   100	        "as_json",
   101	        is_flag=True,
   102	        default=False,
   103	        help="Emit machine-readable JSON (errors as JSON on stderr).",
   104	    )(func)
   105	
   106	
   107	@click.group()
   108	def main() -> None:
   109	    """plan — the planner CLI for agents and developer debugging."""
   110	
   111	
   112	# --- serve (the one handler that actually works in T01) ---
   113	
   114	
   115	@main.command("serve")
   116	@json_option
   117	def serve(as_json: bool) -> None:
   118	    """Run the server (foreground)."""
   119	    import os
   120	
   121	    import uvicorn
   122	
   123	    from planner.core.adapters.registry import build_adapters
   124	    from planner.core.clock import build_clock
   125	    from planner.core.config import HOST, load_config
   126	    from planner.core.db import connect, create_schema
   127	    from planner.core.server import create_app
   128	
   129	    config = load_config()
   130	    os.makedirs(os.path.dirname(config.db_path) or ".", exist_ok=True)
   131	    os.makedirs(config.logs_dir, exist_ok=True)
   132	    with connect(config.db_path, config.db_busy_timeout_ms) as bootstrap:
   133	        create_schema(bootstrap)
   134	
   135	    clock = build_clock(config)
   136	    adapters = build_adapters(config)
   137	
   138	    def conn_factory() -> sqlite3.Connection:
   139	        return connect(config.db_path, config.db_busy_timeout_ms)
   140	
   141	    app = create_app(config, clock, adapters, conn_factory)
   142	    uvicorn.run(app, host=HOST, port=config.port)
   143	
   144	
   145	# --- top-level proposal/recap/note verbs ---
   146	
   147	
   148	@main.command("propose")
   149	@click.argument("field", type=click.Choice(_FIELDS))
   150	@click.argument("ticket_id", required=False, envvar=_TICKET_ID_ENV)
   151	@click.option("--body-file", default=None, help="Path to the body, or - for stdin.")
   152	@json_option
   153	def propose(field: str, ticket_id: str | None, body_file: str | None, as_json: bool) -> None:
   154	    """File or replace a proposal on a field (agent path)."""
   155	    body = read_body(ticket_id, body_file, as_json)
   156	    tid = resolve_ticket_id(ticket_id, as_json)
   157	    data = http.send(
   158	        "POST", f"/api/tickets/{tid}/propose/{field}", as_json=as_json, json_body={"body": body}
   159	    )
   160	    http.emit(data, as_json, f"proposed {field} on {data['id']}")
   161	
   162	
   163	@main.command("recap")
   164	@click.argument("ticket_id", required=False, envvar=_TICKET_ID_ENV)
   165	@click.option("--body-file", default=None, help="Path to the body, or - for stdin.")
   166	@json_option
   167	def recap(ticket_id: str | None, body_file: str | None, as_json: bool) -> None:
   168	    """Write a ticket recap (rejected before needs_approach)."""
   169	    body = read_body(ticket_id, body_file, as_json)
   170	    tid = resolve_ticket_id(ticket_id, as_json)
   171	    data = http.send("PUT", f"/api/tickets/{tid}/recap", as_json=as_json, json_body={"body": body})
   172	    http.emit(data, as_json, f"recap written on {data['id']}")
   173	
   174	
   175	@main.command("note")
   176	@click.argument("field", type=click.Choice(_FIELDS))
   177	@click.argument("ticket_id", required=False, envvar=_TICKET_ID_ENV)
   178	@click.option("--body-file", default=None, help="Path to the body, or - for stdin.")
   179	@json_option
   180	def note(field: str, ticket_id: str | None, body_file: str | None, as_json: bool) -> None:
   181	    """Write a field's notes slot (human or agent, any time)."""
   182	    body = read_body(ticket_id, body_file, as_json)
   183	    tid = resolve_ticket_id(ticket_id, as_json)
   184	    data = http.send(
   185	        "PUT", f"/api/tickets/{tid}/notes/{field}", as_json=as_json, json_body={"note": body}
   186	    )
   187	    http.emit(data, as_json, f"note {field} written on {data['id']}")
   188	
   189	
   190	# --- ticket group ---
   191	
   192	
   193	@main.group("ticket")
   194	def ticket() -> None:
   195	    """Ticket verbs."""
   196	
   197	
   198	@ticket.command("create")
   199	@click.option("--title", required=True, help="Ticket title (<= 200 chars).")
   200	@click.option("--priority", type=click.Choice(_PRIORITIES), default=None)
   201	@click.option("--deadline", default=None, help="ISO date.")
   202	@click.option("--project", default=None, help="Vylo | Tribe | Learning | Other.")
   203	@click.option("--sprint", default=None, help="Sprint id (standalone tickets only).")
   204	@click.option("--item", default=None, help="Sprint item id to parent under.")
   205	@json_option
   206	def ticket_create(
   207	    title: str,
   208	    priority: str | None,
   209	    deadline: str | None,
   210	    project: str | None,
   211	    sprint: str | None,
   212	    item: str | None,
   213	    as_json: bool,
   214	) -> None:
   215	    """Create a ticket."""
   216	    body: dict[str, Any] = {"title": title}
   217	    if priority is not None:
   218	        body["priority"] = priority
   219	    if deadline is not None:
   220	        body["deadline"] = deadline
   221	    if project is not None:
   222	        body["project"] = project
   223	    if sprint is not None:
   224	        body["sprint_id"] = sprint       # --sprint -> sprint_id
   225	    if item is not None:
   226	        body["sprint_item_id"] = item    # --item   -> sprint_item_id
   227	    data = http.send("POST", "/api/tickets", as_json=as_json, json_body=body)
   228	    http.emit(data, as_json, f"{data['id']} {data['state']}")
   229	
   230	
   231	@ticket.command("show")
   232	@click.argument("ticket_id", required=False, envvar=_TICKET_ID_ENV)
   233	@json_option
   234	def ticket_show(ticket_id: str | None, as_json: bool) -> None:
   235	    """Show a ticket (defaults to $PLAN_TICKET_ID)."""
   236	    tid = resolve_ticket_id(ticket_id, as_json)
   237	    data = http.send("GET", f"/api/tickets/{tid}", as_json=as_json)
   238	    http.emit(data, as_json, f"{data['id']} {data['state']} {data['priority']} {data['title']}")
   239	
   240	
   241	@ticket.command("list")
   242	@click.option("--state", default=None)
   243	@click.option("--project", default=None)
   244	@click.option("--sprint", default=None)
   245	@json_option
   246	def ticket_list(state: str | None, project: str | None, sprint: str | None, as_json: bool) -> None:
   247	    """List tickets."""
   248	    params = _drop_none({"state": state, "project": project, "sprint_id": sprint})
   249	    data = http.send("GET", "/api/tickets", as_json=as_json, params=params)
   250	    http.emit(
   251	        data,
   252	        as_json,
   253	        _lines(data["tickets"], lambda t: f"{t['id']} {t['state']} {t['priority']} {t['title']}"),
   254	    )
   255	
   256	
   257	@ticket.command("set")
   258	@click.argument("ticket_id", required=False, envvar=_TICKET_ID_ENV)
   259	@click.option("--priority", type=click.Choice(_PRIORITIES), default=None)
   260	@click.option("--deadline", default=None, help="ISO date, or 'none' to clear.")
   261	@click.option("--day", default=None, help="ISO date or 'today' to assign to a day.")
   262	@click.option("--sprint", default=None, help="Sprint id, or 'none' to clear.")
   263	@json_option
   264	def ticket_set(
   265	    ticket_id: str | None,
   266	    priority: str | None,
   267	    deadline: str | None,
   268	    day: str | None,
   269	    sprint: str | None,
   270	    as_json: bool,
   271	) -> None:
   272	    """Set priority / deadline / day / sprint (no ceiling or at_cap — grants are human)."""
   273	    tid = resolve_ticket_id(ticket_id, as_json)
   274	    patch: dict[str, Any] = {}
   275	    if priority is not None:
   276	        patch["priority"] = priority
   277	    if deadline is not None:
   278	        patch["deadline"] = None if deadline == "none" else deadline
   279	    if sprint is not None:
   280	        patch["sprint_id"] = None if sprint == "none" else sprint
   281	    if not patch and day is None:
   282	        http.fail_validation("nothing to set: pass --priority/--deadline/--sprint/--day", as_json)
   283	    data: Any = None
   284	    if patch:
   285	        data = http.send("PATCH", f"/api/tickets/{tid}", as_json=as_json, json_body=patch)
   286	    if day is not None:
   287	        data = http.send(
   288	            "POST", f"/api/day/{day}/tickets", as_json=as_json, json_body={"ticket_id": tid}
   289	        )
   290	    # `data` is the LAST successful response: ticket_json if only PATCH, day view if --day.
   291	    human = (
   292	        f"day {data['id']}: {len(data['tickets'])} ticket(s)"
   293	        if "tickets" in data
   294	        else f"{data['id']} {data['state']}"
   295	    )
   296	    http.emit(data, as_json, human)
   297	
   298	
   299	# --- item group ---
   300	
   301	
   302	@main.group("item")
   303	def item() -> None:
   304	    """Sprint-item verbs."""
   305	
   306	
   307	@item.command("create")
   308	@click.option("--title", required=True)
   309	@click.option("--project", required=True, help="Vylo | Tribe | Learning | Other.")
   310	@click.option("--priority", type=click.Choice(_PRIORITIES), default=None)
   311	@click.option("--deadline", default=None, help="ISO date.")
   312	@click.option("--sprint", default=None, help="Sprint id.")
   313	@json_option
   314	def item_create(
   315	    title: str,
   316	    project: str,
   317	    priority: str | None,
   318	    deadline: str | None,
   319	    sprint: str | None,
   320	    as_json: bool,
   321	) -> None:
   322	    """Create a sprint item."""
   323	    body: dict[str, Any] = {"title": title, "project": project}
   324	    if priority is not None:
   325	        body["priority"] = priority
   326	    if deadline is not None:
   327	        body["deadline"] = deadline
   328	    if sprint is not None:
   329	        body["sprint_id"] = sprint
   330	    data = http.send("POST", "/api/items", as_json=as_json, json_body=body)
   331	    http.emit(data, as_json, f"{data['id']} {data['status']}")
   332	
   333	
   334	@item.command("show")
   335	@click.argument("item_id")
   336	@json_option
   337	def item_show(item_id: str, as_json: bool) -> None:
   338	    """Show a sprint item."""
   339	    data = http.send("GET", f"/api/items/{item_id}", as_json=as_json)
   340	    http.emit(data, as_json, f"{data['id']} {data['status']} {data['priority']} {data['title']}")
   341	
   342	
   343	@item.command("list")
   344	@click.option("--status", default=None)
   345	@click.option("--project", default=None)
   346	@click.option("--backlog", is_flag=True, default=False, help="Items with no sprint (backlog).")
   347	@json_option
   348	def item_list(status: str | None, project: str | None, backlog: bool, as_json: bool) -> None:
   349	    """List sprint items."""
   350	    params = _drop_none({"status": status, "project": project})
   351	    if backlog:
   352	        params["sprint_id"] = "null"        # views.list_items maps "null" -> IS NULL
   353	    data = http.send("GET", "/api/items", as_json=as_json, params=params)
   354	    http.emit(
   355	        data,
   356	        as_json,
   357	        _lines(data["items"], lambda i: f"{i['id']} {i['status']} {i['priority']} {i['title']}"),
   358	    )
   359	
   360	
   361	@item.command("set")
   362	@click.argument("item_id")
   363	@click.option("--status", type=click.Choice(["todo", "active", "blocked"]), default=None)
   364	@click.option("--blocked-by", default=None, help="Comma-separated blocker ticket ids.")
   365	@json_option
   366	def item_set(item_id: str, status: str | None, blocked_by: str | None, as_json: bool) -> None:
   367	    """Set an agent-permitted item transition (§3.2)."""
   368	    body: dict[str, Any] = {}
   369	    if status is not None:
   370	        body["status"] = status
   371	    if blocked_by is not None:
   372	        body["blocked_by"] = [s for s in (x.strip() for x in blocked_by.split(",")) if s]
   373	    if not body:
   374	        http.fail_validation("nothing to set: pass --status/--blocked-by", as_json)
   375	    data = http.send("PATCH", f"/api/items/{item_id}", as_json=as_json, json_body=body)
   376	    http.emit(data, as_json, f"{data['id']} {data['status']}")
   377	
   378	
   379	@item.command("propose-status")
   380	@click.argument("item_id")
   381	@click.option(
   382	    "--to", "to_status", type=click.Choice(["done", "deferred_next_sprint"]), required=True
   383	)
   384	@click.option("--body-file", default=None, help="Optional rationale body, or - for stdin.")
   385	@json_option
   386	def item_propose_status(item_id: str, to_status: str, body_file: str | None, as_json: bool) -> None:
   387	    """Propose a done / deferred_next_sprint status for human acceptance."""
   388	    note = read_optional_body(body_file, as_json)
   389	    data = http.send(
   390	        "POST", f"/api/items/{item_id}/propose-status",
   391	        as_json=as_json, json_body={"to": to_status, "note": note},
   392	    )
   393	    http.emit(data, as_json, f"{data['id']} status proposal {to_status}")
   394	
   395	
   396	# --- sprint group ---
   397	
   398	
   399	@main.group("sprint")
   400	def sprint() -> None:
   401	    """Sprint verbs."""
   402	
   403	
   404	@sprint.command("show")
   405	@json_option
   406	def sprint_show(as_json: bool) -> None:
   407	    """Show the current sprint view."""
   408	    data = http.send("GET", "/api/sprint/current", as_json=as_json)
   409	    s = data["sprint"]
   410	    human = (
   411	        "no current sprint"
   412	        if s is None
   413	        else f"sprint {s['name']} {s['date_start']}..{s['date_end']}"
   414	    )
   415	    http.emit(data, as_json, human)
   416	
   417	
   418	# --- idea group ---
   419	
   420	
   421	@main.group("idea")
   422	def idea() -> None:
   423	    """Idea verbs."""
   424	
   425	
   426	@idea.command("create")
   427	@click.option("--title", required=True)
   428	@click.option("--project", default=None, help="Vylo | Tribe | Learning | Other.")
   429	@click.option("--body-file", default=None, help="Optional body, or - for stdin.")
   430	@json_option
   431	def idea_create(title: str, project: str | None, body_file: str | None, as_json: bool) -> None:
   432	    """Create an idea."""
   433	    body: dict[str, Any] = {"title": title, "body": read_optional_body(body_file, as_json) or ""}
   434	    if project is not None:
   435	        body["project"] = project
   436	    data = http.send("POST", "/api/ideas", as_json=as_json, json_body=body)
   437	    http.emit(data, as_json, f"{data['id']} {data['title']}")
   438	
   439	
   440	@idea.command("list")
   441	@json_option
   442	def idea_list(as_json: bool) -> None:
   443	    """List ideas."""
   444	    data = http.send("GET", "/api/ideas", as_json=as_json)
   445	    http.emit(data, as_json, _lines(data["ideas"], lambda i: f"{i['id']} {i['title']}"))
   446	
   447	
   448	# --- day group ---
   449	
   450	
   451	@main.group("day")
   452	def day() -> None:
   453	    """Day verbs."""
   454	
   455	
   456	@day.command("show")
   457	@click.argument("date", required=False)
   458	@json_option
   459	def day_show(date: str | None, as_json: bool) -> None:
   460	    """Show a day (defaults to the current planning date; accepts 'today')."""
   461	    seg = date or "today"
   462	    data = http.send("GET", f"/api/day/{seg}", as_json=as_json)
   463	    http.emit(data, as_json, f"day {data['id']}: {len(data['tickets'])} ticket(s)")
   464	
   465	
   466	@day.command("add-ticket")
   467	@click.argument("ticket_id")
   468	@click.argument("date", required=False)
   469	@json_option
   470	def day_add_ticket(ticket_id: str, date: str | None, as_json: bool) -> None:
   471	    """Add a ticket to a day (accepts 'today')."""
   472	    seg = date or "today"
   473	    data = http.send(
   474	        "POST", f"/api/day/{seg}/tickets", as_json=as_json, json_body={"ticket_id": ticket_id}
   475	    )
   476	    http.emit(data, as_json, f"day {data['id']}: {len(data['tickets'])} ticket(s)")
   477	
   478	
   479	@day.command("remove-ticket")
   480	@click.argument("ticket_id")
   481	@click.argument("date", required=False)
   482	@json_option
   483	def day_remove_ticket(ticket_id: str, date: str | None, as_json: bool) -> None:
   484	    """Remove a ticket from a day (deferring; ticket state untouched)."""
   485	    seg = date or "today"
   486	    data = http.send("DELETE", f"/api/day/{seg}/tickets/{ticket_id}", as_json=as_json)
   487	    http.emit(data, as_json, f"day {data['id']}: {len(data['tickets'])} ticket(s)")
   488	
   489	
   490	# --- link group ---
   491	
   492	
   493	@main.group("link")
   494	def link() -> None:
   495	    """Link verbs."""
   496	
   497	
   498	@link.command("add")
   499	@click.argument("from_id")
   500	@click.argument("to_id")
   501	@click.option("--kind", type=click.Choice(_LINK_KINDS), required=True)
   502	@json_option
   503	def link_add(from_id: str, to_id: str, kind: str, as_json: bool) -> None:
   504	    """Add a link."""
   505	    data = http.send(
   506	        "POST", "/api/links", as_json=as_json,
   507	        json_body={"from_id": from_id, "to_id": to_id, "kind": kind},
   508	    )
