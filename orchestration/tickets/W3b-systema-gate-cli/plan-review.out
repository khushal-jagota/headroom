   118	                raw = event.get("payload")
   119	                payload = raw if isinstance(raw, dict) else {}
   120	                return RunResult(
   121	                    "errored",
   122	                    "",
   123	                    None,
   124	                    resolved_key,
   125	                    str(payload.get("message") or "gateway error event"),
   126	                )
   127	            if etype == "message.complete":
   128	                raw = event.get("payload")
   129	                payload = raw if isinstance(raw, dict) else {}
   130	                text = str(payload.get("text") or "")
   131	                usage_raw = payload.get("usage")
   132	                usage = usage_raw if isinstance(usage_raw, dict) else None
   133	                gw_status = str(payload.get("status") or "complete")
   134	                if gw_status == "complete":
   135	                    return RunResult("complete", text, usage, resolved_key, None)
   136	                if gw_status == "interrupted":
   137	                    return RunResult("interrupted", text, usage, resolved_key, None)
   138	                return RunResult(
   139	                    "errored",
   140	                    text,
   141	                    usage,
   142	                    resolved_key,
   143	                    text or "run ended with status=error",
   144	                )
   145	            # any other event type: forwarded above, otherwise ignored — keep draining
   146	    except GatewayRpcError as exc:
   147	        return RunResult("errored", "", None, resolved_key, str(exc))
   148	    except GatewayError as exc:
   149	        return RunResult("errored", "", None, resolved_key, str(exc))
   150	    finally:
   151	        child.shutdown()  # child ALWAYS reaped

