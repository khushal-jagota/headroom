   170	# --- board (§10.3) -------------------------------------------------------------
   171	
   172	
   173	def board_view(conn: sqlite3.Connection, now: int) -> JsonDict:
   174	    rows = conn.execute(
   175	        "SELECT id, title, state, priority, deadline, project, fields, status, "
   176	        "created_at FROM tickets WHERE state != 'dropped'"
   177	    ).fetchall()
   178	    by_state: dict[str, list[tuple[tuple[int, int, str, int], JsonDict]]] = {
   179	        s.value: [] for s in STATE_ORDER
   180	    }
   181	    for row in rows:
   182	        state = str(row["state"])
   183	        priority = str(row["priority"])
   184	        deadline = str(row["deadline"]) if row["deadline"] is not None else None
   185	        fields = fields_codec.fields_from_json(str(row["fields"]))
   186	        card: JsonDict = {
   187	            "id": str(row["id"]),
   188	            "title": str(row["title"]),
   189	            "priority": priority,
   190	            "deadline": deadline,
   191	            "project": str(row["project"]) if row["project"] is not None else None,
   192	            "has_pending_proposal": machine.has_pending_gating_proposal(TicketState(state), fields),
   193	            "status": str(row["status"]),
   194	        }
   195	        sort_key = (
   196	            _prio_rank(priority),
   197	            0 if deadline is not None else 1,
   198	            deadline or "",
   199	            int(row["created_at"]),
   200	        )
   201	        by_state[state].append((sort_key, card))
   202	    columns: list[JsonDict] = []
   203	    for s in STATE_ORDER:
   204	        cards = [card for _, card in sorted(by_state[s.value], key=lambda item: item[0])]
   205	        columns.append({"state": s.value, "cards": cards})
   206	    return {"columns": columns}
