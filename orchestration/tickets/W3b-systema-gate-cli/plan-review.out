   382	@router.post("/tickets/{ticket_id}/grant")
   383	async def grant_ticket(ticket_id: str, raw: dict[str, Any], conn: DbConn, ctx: Ctx,
   384	                       clk: Clk) -> JsonDict:
   385	    body = GrantBody(ceiling=body_opt_str(raw, "ceiling"), at_cap=body_opt_str(raw, "at_cap"))
   386	    reject_agents(ctx)
   387	    now = clk.now_unix()
   388	    ceiling_raw = body["ceiling"]
   389	    at_cap_raw = body["at_cap"]
   390	    if ceiling_raw is None or at_cap_raw is None:
   391	        missing = [name for name, value in (("ceiling", ceiling_raw), ("at_cap", at_cap_raw))
   392	                   if value is None]
   393	        raise PlannerError(
   394	            ErrorCode.grant_missing, "grant requires ceiling and at_cap", {"missing": missing}
   395	        )
   396	    try:
   397	        ceiling = TicketState(ceiling_raw)
   398	    except ValueError:
   399	        raise PlannerError(
   400	            ErrorCode.grant_invalid, "unknown ceiling", {"ceiling": ceiling_raw}
   401	        ) from None
   402	    try:
   403	        at_cap = AtCap(at_cap_raw)
   404	    except ValueError:
   405	        raise PlannerError(
   406	            ErrorCode.grant_invalid, "unknown at_cap", {"at_cap": at_cap_raw}
   407	        ) from None
   408	    ticket = tickets_data.change_grant(
   409	        conn, ticket_id, ceiling=ceiling, at_cap=at_cap, actor=ctx.actor, now=now
   410	    )
   411	    return tickets_views.ticket_json(ticket, now)
