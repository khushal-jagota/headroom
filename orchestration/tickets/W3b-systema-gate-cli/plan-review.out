    54	
    55	class SystemB:
    56	    """Set-off primitive + the sole writer of ticket run-status."""
    57	
    58	    def __init__(
    59	        self,
    60	        db_path: str,
    61	        clock: Clock,
    62	        *,
    63	        home: str | Path,
    64	        hermes_python: str | Path,
    65	        spawn: SpawnFn = spawn_popen,
    66	        busy_timeout_ms: int = 5000,
    67	    ) -> None:
    68	        self._db_path = db_path
    69	        self._clock = clock
    70	        self._home = home
    71	        self._python = hermes_python
    72	        self._spawn = spawn
    73	        self._busy_timeout_ms = busy_timeout_ms
    74	        self._queue: MindQueue[_Item] = MindQueue(self._run_item)
    75	
    76	    # --- public API ---------------------------------------------------------
    77	
    78	    def set_off(self, ticket_id: str, role: str, prompt: str) -> None:
    79	        """Set off step N of a ticket. Serialized per ticket through the MindQueue;
    80	        the run resolves the mind's current session_key at execution time."""
    81	        self._queue.submit(ticket_id, _Item(ticket_id, role, prompt))
    82	
    83	    def wait_idle(self, timeout: float | None = None) -> bool:
    84	        """Block until every set-off has fully settled (test helper)."""
    85	        return self._queue.wait_idle(timeout)
    86	
    87	    # --- the serialized run -------------------------------------------------
    88	
    89	    def _run_item(self, _key: str, item: _Item) -> None:
    90	        # _key is the queue key (== ticket_id); resolve the CURRENT session_key from the
    91	        # DB here, at execution time, so a rotated key from the prior run is picked up.
    92	        session_key = self._read_session_key(item.ticket_id)
    93	        self._run(item.ticket_id, session_key, item.role, item.prompt)
    94	
    95	    def _read_session_key(self, ticket_id: str) -> str | None:
    96	        conn = connect(self._db_path, self._busy_timeout_ms)
    97	        try:
    98	            row = conn.execute(
    99	                "SELECT chat_session_key FROM tickets WHERE id = ?", (ticket_id,)
   100	            ).fetchone()
   101	            if row is None:
   102	                return None
   103	            value = row["chat_session_key"]
   104	            return str(value) if value is not None else None
   105	        finally:
   106	            conn.close()
   107	
   108	    def _run(self, ticket_id: str, key: str | None, role: str, prompt: str) -> None:
   109	        """One step: agent_working (start write) -> run_step -> proposal-present
   110	        invariant -> awaiting_approval/errored (end write). Both writes go through the
   111	        single-door tickets_data.set_run_status; System B is the only caller. The end
   112	        write ALWAYS fires (even if the run or a read raises) so a ticket is never left
   113	        stuck at agent_working."""
   114	        conn = connect(self._db_path, self._busy_timeout_ms)
   115	        try:
   116	            now = self._clock.now_unix()
   117	            # (1) start write: agent_working + worker, single atomic UPDATE.
   118	            tickets_data.set_run_status(
   119	                conn, ticket_id, status=TicketStatus.agent_working, worker=role, now=now
   120	            )
   121	            # (2..4) run + map. Any failure between the writes maps to errored so the end
   122	            # write below is unconditional.
   123	            end_status = TicketStatus.errored
   124	            end_error: str | None = None
   125	            session_key_out = key
   126	            try:
   127	                pre = tickets_data.read_ticket(conn, ticket_id)  # the step the code asked for
   128	                pre_state = pre.state
   129	                pre_gating = machine.gating_field(pre_state)
   130	                result = run_step(  # kickoff creates step 0; continuing resumes `key`
   131	                    key, role, prompt, None, home=self._home, hermes_python=self._python,
   132	                    spawn=self._spawn,
   133	                )
   134	                session_key_out = result.session_key
   135	                end_error = result.error
   136	                if result.status == "complete":
   137	                    post = tickets_data.read_ticket(conn, ticket_id)
   138	                    advanced = post.state != pre_state  # agent step only auto-accepts forward
   139	                    parked = (
   140	                        pre_gating is not None
   141	                        and fields_codec.get_slot(post.fields, pre_gating).proposal is not None
   142	                    )
   143	                    if advanced or parked:
   144	                        end_status = TicketStatus.awaiting_approval
   145	                        end_error = None
   146	                    else:
   147	                        end_error = "agent left no proposal — you haven't done your job"
   148	            except Exception as exc:  # never leave the ticket at agent_working
   149	                _log.exception("system B run crashed (ticket=%s)", ticket_id)
   150	                end_status = TicketStatus.errored
   151	                end_error = f"system B run crashed: {exc}"
   152	
   153	            # (5) end write: status + cleared worker + resolved durable key, one UPDATE.
   154	            tickets_data.set_run_status(
   155	                conn,
   156	                ticket_id,
   157	                status=end_status,
   158	                worker=None,
   159	                session_key=session_key_out,
   160	                error=end_error if end_status == TicketStatus.errored else None,
   161	                now=now,
   162	            )
   163	        finally:
   164	            conn.close()

