    80	
    81	async def db_conn(request: Request) -> AsyncIterator[sqlite3.Connection]:
    82	    conn = cast(Callable[[], sqlite3.Connection], request.app.state.conn_factory)()
    83	    try:
    84	        yield conn
    85	    finally:
    86	        conn.close()
    87	
    88	
    89	DbConn = Annotated[sqlite3.Connection, Depends(db_conn)]
    90	Ctx = Annotated[RequestContext, Depends(request_context)]
    91	Cfg = Annotated[Config, Depends(get_config)]
    92	Clk = Annotated[Clock, Depends(get_clock)]
    93	
    94	
    95	@contextmanager
    96	def txn(conn: sqlite3.Connection) -> Iterator[None]:
    97	    """Wrap a NON-self-transacting writer (days/dispatch/links) so a mid-sequence
    98	    PlannerError rolls back cleanly. Never wrap a ticket/sprint writer — those open
    99	    their own BEGIN IMMEDIATE and would raise 'transaction within a transaction'."""
   100	    conn.execute("BEGIN IMMEDIATE")
   101	    try:
   102	        yield
   103	    except BaseException:
   104	        conn.execute("ROLLBACK")
   105	        raise
   106	    else:
   107	        conn.execute("COMMIT")
   108	
   109	
   110	def parse_enum[E: StrEnum](enum_cls: type[E], raw: str, what: str) -> E:
   111	    try:
   112	        return enum_cls(raw)
   113	    except ValueError:
   114	        raise PlannerError(ErrorCode.validation, f"invalid {what}", {what: raw}) from None
   115	
   116	
   117	def body_str(body: JsonDict, key: str, default: str = "") -> str:
   118	    """Marshal an optional string body key: absent -> default; null or non-string ->
   119	    the validation envelope. Unknown keys are ignored by the callers, matching the
   120	    §14 body shapes."""
   121	    raw = body.get(key, default)
   122	    if not isinstance(raw, str):
   123	        raise PlannerError(ErrorCode.validation, f"invalid {key}", {key: raw})
   124	    return raw
   125	
   126	
   127	def body_opt_str(body: JsonDict, key: str) -> str | None:
   128	    raw = body.get(key)
   129	    if raw is None:
   130	        return None
   131	    if not isinstance(raw, str):
   132	        raise PlannerError(ErrorCode.validation, f"invalid {key}", {key: raw})
   133	    return raw
