     1	"""System B (W3a): the set-off / run primitive + the sole writer of ticket run-status.
     2	All hermetic against minds/fake.py — no subprocess, no model calls; the gateway child is
     3	injected through the spawn seam. A fresh FakeGateway is handed out per spawn (one child
     4	is closed after one run_step), and the "agent files a proposal during its run" is
     5	simulated by driving the REAL tickets_data.file_proposal writer on prompt.submit — so an
     6	auto-accept below ceiling is exercised through the production resolution engine, not a
     7	masking direct write."""
     8	
     9	from __future__ import annotations
    10	
    11	import json
    12	import threading
    13	from collections.abc import Callable
    14	from pathlib import Path
    15	from typing import Any
    16	
    17	from planner.core.clock import RealClock
    18	from planner.core.contracts import EventKind
    19	from planner.core.db import connect, create_schema
    20	from planner.core.events import read_events_since
    21	from planner.minds.fake import FakeGateway, Reply, ev
    22	from planner.minds.gateway import ChildProcess
    23	from planner.runtime.system_b import SystemB
    24	from planner.tickets import data as tickets_data
    25	from planner.tickets.contracts import AtCap, FieldName, TicketState, TicketStatus
    26	
    27	HOME = "/tmp/planner-home"
    28	HERMES_PY = "/x/hermes-agent/venv/bin/python"
    29	LIVE_SID = "live-sid"
    30	STORED_KEY = "stored-key-1"
    31	ROLE = "planning-worker"
    32	
    33	
    34	# --- fake-gateway scripting ---------------------------------------------------
    35	
    36	
    37	def _create_reply(sid: str = LIVE_SID, key: str = STORED_KEY) -> Reply:
    38	    return Reply(result={"session_id": sid, "stored_session_id": key})
    39	
    40	
    41	def _resume_reply(sid: str = LIVE_SID, key: str = STORED_KEY) -> Reply:
    42	    return Reply(result={"session_id": sid, "resumed": key})
    43	
    44	
    45	def _complete_ev(sid: str = LIVE_SID, status: str = "complete") -> dict[str, Any]:
    46	    return ev("message.complete", sid, {"text": "ok", "usage": {}, "status": status})
    47	
    48	
    49	def _submit_reply(*events_after: dict[str, Any]) -> Reply:
    50	    return Reply(result={"status": "streaming"}, events_after=tuple(events_after))
    51	
    52	
    53	def _create_script(*after: dict[str, Any]) -> dict[str, list[Reply]]:
    54	    return {"session.create": [_create_reply()], "prompt.submit": [_submit_reply(*after)]}
    55	
    56	
    57	def _resume_script(key: str = STORED_KEY, *after: dict[str, Any]) -> dict[str, list[Reply]]:
    58	    return {"session.resume": [_resume_reply(key=key)], "prompt.submit": [_submit_reply(*after)]}
    59	
    60	
    61	class _ProposingFake(FakeGateway):
    62	    """A fake child that files a real proposal (via the production writer) the moment it
    63	    receives prompt.submit — simulating the agent doing its step mid-run."""
    64	
    65	    def __init__(
    66	        self, script: dict[str, list[Reply]], *, on_submit: Callable[[], None] | None = None
    67	    ) -> None:
    68	        super().__init__(script)
    69	        self._on_submit = on_submit
    70	
    71	    def send(self, line: str) -> None:
    72	        frame = json.loads(line)
    73	        if frame.get("method") == "prompt.submit" and self._on_submit is not None:
    74	            self._on_submit()
    75	        super().send(line)
    76	
    77	
    78	class _Spawner:
    79	    """Hands out a fresh FakeGateway per spawn (a child is single-use)."""
    80	
    81	    def __init__(self, children: list[FakeGateway]) -> None:
    82	        self._children = children
    83	        self._i = 0
    84	        self._lock = threading.Lock()
    85	
    86	    def spawn(self, argv: list[str], env: dict[str, str]) -> ChildProcess:
    87	        with self._lock:
    88	            child = self._children[self._i]
    89	            self._i += 1
    90	        return child.spawn(argv, env)
    91	
    92	
    93	# --- DB helpers ---------------------------------------------------------------
    94	
    95	
    96	def _db(tmp_path: Path) -> str:
    97	    db_path = tmp_path / "planning-test.db"
    98	    conn = connect(str(db_path))
    99	    create_schema(conn)
   100	    conn.close()
   101	    return str(db_path)
   102	
   103	
   104	def _new_ticket(db_path: str, *, ceiling: TicketState | None = None) -> str:
   105	    conn = connect(db_path)
   106	    try:
   107	        ticket = tickets_data.create_ticket(
   108	            conn, title="T", actor="human", now=0, title_max_chars=200
   109	        )
   110	        if ceiling is not None:
   111	            tickets_data.change_grant(
   112	                conn, ticket.id, ceiling=ceiling, at_cap=AtCap.propose, actor="human", now=0
   113	            )
   114	        return ticket.id
   115	    finally:
   116	        conn.close()
   117	
   118	
   119	def _read(db_path: str, ticket_id: str) -> Any:
   120	    conn = connect(db_path)
   121	    try:
   122	        return tickets_data.read_ticket(conn, ticket_id)
   123	    finally:
   124	        conn.close()
   125	
   126	
   127	def _file_proposal(db_path: str, ticket_id: str, field: str, body: str) -> None:
   128	    conn = connect(db_path)
   129	    try:
   130	        tickets_data.file_proposal(
   131	            conn, ticket_id, field=FieldName(field), body=body, actor="agent", now=0
   132	        )
   133	    finally:
   134	        conn.close()
   135	
   136	
   137	def _set_key(db_path: str, ticket_id: str, key: str) -> None:
   138	    conn = connect(db_path)
   139	    try:
   140	        tickets_data.set_run_status(
   141	            conn, ticket_id, status=TicketStatus.empty, worker=None, session_key=key, now=0
   142	        )
   143	    finally:
   144	        conn.close()
   145	
   146	
   147	def _status_events(db_path: str, ticket_id: str) -> list[dict[str, Any]]:
   148	    conn = connect(db_path)
   149	    try:
   150	        rows = read_events_since(conn, 0, 1000)
   151	    finally:
   152	        conn.close()
   153	    return [
   154	        r.payload
   155	        for r in rows
   156	        if r.entity_id == ticket_id and r.kind == EventKind.ticket_status_changed.value
   157	    ]
   158	
   159	
   160	def _system_b(db_path: str, spawner: _Spawner) -> SystemB:
   161	    return SystemB(
   162	        db_path, RealClock(), home=HOME, hermes_python=HERMES_PY, spawn=spawner.spawn
   163	    )
   164	
   165	
   166	# --- tests --------------------------------------------------------------------
   167	
   168	
   169	def test_kickoff_parked_proposal_awaits_approval(tmp_path: Path) -> None:
   170	    # Fresh ticket at needs_success with the default ceiling (needs_success): a success
   171	    # proposal PARKS at the ceiling. empty -> agent_working -> awaiting_approval.
   172	    db = _db(tmp_path)
   173	    tid = _new_ticket(db)
   174	    assert _read(db, tid).status == TicketStatus.empty  # starts empty
   175	
   176	    fake = _ProposingFake(
   177	        _create_script(_complete_ev()),
   178	        on_submit=lambda: _file_proposal(db, tid, "success", "the success body"),
   179	    )
   180	    sb = _system_b(db, _Spawner([fake]))
   181	    sb.set_off(tid, ROLE, "do step 0")
   182	    assert sb.wait_idle(10.0)
   183	
   184	    ticket = _read(db, tid)
   185	    assert ticket.status == TicketStatus.awaiting_approval
   186	    assert ticket.worker is None
   187	    assert ticket.chat_session_key == STORED_KEY          # kickoff stored the created key
   188	    assert ticket.fields.success.proposal is not None      # parked at ceiling
   189	    # kickoff went through session.create, never resume.
   190	    assert "session.create" in fake.sent_methods()
   191	    assert "session.resume" not in fake.sent_methods()
   192	    # the four-transition trail: agent_working (worker set) -> awaiting_approval (cleared).
   193	    evs = _status_events(db, tid)
   194	    assert [e["status"] for e in evs] == ["agent_working", "awaiting_approval"]
   195	    assert evs[0]["worker"] == ROLE
   196	    assert evs[1]["worker"] is None
   197	
   198	
   199	def test_auto_accepted_proposal_awaits_approval(tmp_path: Path) -> None:
   200	    # Ceiling raised above needs_success: the success proposal AUTO-ACCEPTS (state
   201	    # advances, proposal cleared). System B's `advanced` disjunct still yields
   202	    # awaiting_approval — the F1 regression a naive present-only check would miss.
   203	    db = _db(tmp_path)
   204	    tid = _new_ticket(db, ceiling=TicketState.needs_plan)
   205	
   206	    fake = _ProposingFake(
   207	        _create_script(_complete_ev()),
   208	        on_submit=lambda: _file_proposal(db, tid, "success", "the success body"),
   209	    )
   210	    sb = _system_b(db, _Spawner([fake]))
   211	    sb.set_off(tid, ROLE, "do step 0")
   212	    assert sb.wait_idle(10.0)
   213	
   214	    ticket = _read(db, tid)
   215	    assert ticket.state == TicketState.needs_approach          # auto-accepted + advanced
   216	    assert ticket.fields.success.value == "the success body"
   217	    assert ticket.fields.success.proposal is None             # cleared by the auto-accept
   218	    assert ticket.status == TicketStatus.awaiting_approval     # advanced disjunct
   219	
   220	
   221	def test_no_proposal_errors(tmp_path: Path) -> None:
   222	    # The run completes but the agent files nothing: no advance, no proposal -> errored.
   223	    db = _db(tmp_path)
   224	    tid = _new_ticket(db)
   225	
   226	    fake = FakeGateway(_create_script(_complete_ev()))
   227	    sb = _system_b(db, _Spawner([fake]))
   228	    sb.set_off(tid, ROLE, "do step 0")
   229	    assert sb.wait_idle(10.0)
   230	
   231	    ticket = _read(db, tid)
   232	    assert ticket.status == TicketStatus.errored
   233	    assert ticket.chat_session_key == STORED_KEY   # the created key still persists for retry
   234	    evs = _status_events(db, tid)
   235	    assert evs[-1]["status"] == "errored"
   236	    assert "haven't done your job" in evs[-1]["error"]
   237	
   238	
   239	def test_gateway_error_event_errors(tmp_path: Path) -> None:
   240	    # A gateway error event during the run -> run_step errored -> ticket errored, reason
   241	    # surfaced in the event; no proposal check on that path.
   242	    db = _db(tmp_path)
   243	    tid = _new_ticket(db)
   244	
   245	    fake = FakeGateway(_create_script(ev("error", LIVE_SID, {"message": "boom"})))
   246	    sb = _system_b(db, _Spawner([fake]))
   247	    sb.set_off(tid, ROLE, "do step 0")
   248	    assert sb.wait_idle(10.0)
   249	
   250	    ticket = _read(db, tid)
   251	    assert ticket.status == TicketStatus.errored
   252	    evs = _status_events(db, tid)
   253	    assert evs[-1]["status"] == "errored"
   254	    assert evs[-1]["error"] == "boom"
   255	
   256	
   257	def test_kickoff_serialization_one_create(tmp_path: Path) -> None:
   258	    # Two set_offs on the same fresh ticket: the per-ticket kickoff lock forces exactly
   259	    # ONE session.create; the second resolves the now-stored key and resumes.
   260	    db = _db(tmp_path)
   261	    tid = _new_ticket(db)
   262	
   263	    fake1 = _ProposingFake(
   264	        _create_script(_complete_ev()),
   265	        on_submit=lambda: _file_proposal(db, tid, "success", "b1"),
   266	    )
   267	    fake2 = FakeGateway(_resume_script(STORED_KEY, _complete_ev()))
   268	    sb = _system_b(db, _Spawner([fake1, fake2]))
   269	    sb.set_off(tid, ROLE, "step")
   270	    sb.set_off(tid, ROLE, "step")
   271	    assert sb.wait_idle(10.0)
   272	
   273	    methods = fake1.sent_methods() + fake2.sent_methods()
   274	    assert methods.count("session.create") == 1
   275	    assert methods.count("session.resume") == 1
   276	    assert "session.create" in fake1.sent_methods()   # first spawn = kickoff
   277	    assert "session.resume" in fake2.sent_methods()    # second spawn = continuing
   278	
   279	
   280	def test_current_key_resolved_at_execution_and_rotated(tmp_path: Path) -> None:
   281	    # A ticket that already has a stored key: set_off resolves it (resume, not create),
   282	    # and a rotated resume tip is persisted back.
   283	    db = _db(tmp_path)
   284	    tid = _new_ticket(db)
   285	    _set_key(db, tid, STORED_KEY)
   286	
   287	    fake = _ProposingFake(
   288	        _resume_script("rotated-key", _complete_ev()),
   289	        on_submit=lambda: _file_proposal(db, tid, "success", "b"),
   290	    )
   291	    sb = _system_b(db, _Spawner([fake]))
   292	    sb.set_off(tid, ROLE, "step")
   293	    assert sb.wait_idle(10.0)
   294	
   295	    assert "session.resume" in fake.sent_methods()
   296	    assert "session.create" not in fake.sent_methods()
   297	    resume_frame = next(f for f in fake.sent if f.get("method") == "session.resume")
   298	    assert resume_frame["params"]["session_id"] == STORED_KEY   # resolved from the DB
   299	    assert _read(db, tid).chat_session_key == "rotated-key"      # rotated tip persisted
   300	
   301	
   302	def test_continuing_runs_follow_key_rotation(tmp_path: Path) -> None:
   303	    # Hermetic proof that the resume key is resolved at EXECUTION time, not captured at
   304	    # enqueue. Run A resumes STORED_KEY and blocks mid-run (before persisting its rotated
   305	    # tip). While A is blocked — the ticket's stored key is STILL STORED_KEY — B is
   306	    # enqueued (an enqueue-capturing impl would capture STORED_KEY here). A then unblocks
   307	    # and rotates the key to "rotated-key"; B, serialized behind A under the ticket_id
   308	    # key, runs next and MUST resume "rotated-key". A stale STORED_KEY on B would fail.
   309	    db = _db(tmp_path)
   310	    tid = _new_ticket(db)
   311	    _set_key(db, tid, STORED_KEY)
   312	
   313	    reached = threading.Event()
   314	    release = threading.Event()
   315	
   316	    class _BlockingFake(FakeGateway):
   317	        def send(self, line: str) -> None:
   318	            if json.loads(line).get("method") == "prompt.submit":
   319	                reached.set()          # A is now mid-run, before its end write
   320	                release.wait(10.0)     # hold until the test has enqueued B
   321	            super().send(line)
   322	
   323	    fake_a = _BlockingFake(_resume_script("rotated-key", _complete_ev()))
   324	    fake_b = FakeGateway(_resume_script("rotated-key", _complete_ev()))
   325	    sb = _system_b(db, _Spawner([fake_a, fake_b]))
   326	
   327	    sb.set_off(tid, ROLE, "step 1")
   328	    assert reached.wait(10.0)                                   # A blocked; key still STORED_KEY
   329	    assert _read(db, tid).chat_session_key == STORED_KEY
   330	    sb.set_off(tid, ROLE, "step 2")                            # B enqueued behind A
   331	    release.set()                                              # let A finish + rotate the key
   332	    assert sb.wait_idle(10.0)
   333	
   334	    frame_a = next(f for f in fake_a.sent if f.get("method") == "session.resume")
   335	    frame_b = next(f for f in fake_b.sent if f.get("method") == "session.resume")
   336	    assert frame_a["params"]["session_id"] == STORED_KEY        # A resumed the stored key
   337	    assert frame_b["params"]["session_id"] == "rotated-key"     # B resolved the rotated key at exec
   338	    assert _read(db, tid).chat_session_key == "rotated-key"
   339	
   340	
   341	def test_spawn_crash_errors_never_stuck_working(tmp_path: Path) -> None:
   342	    # A spawn that raises a non-gateway exception escapes run_step's GatewayError guard;
   343	    # System B's own guard maps it to errored, so the ticket is never left at agent_working.
   344	    db = _db(tmp_path)
   345	    tid = _new_ticket(db)
   346	
   347	    def _boom(argv: list[str], env: dict[str, str]) -> Any:
   348	        raise RuntimeError("spawn boom")
   349	
   350	    sb = SystemB(db, RealClock(), home=HOME, hermes_python=HERMES_PY, spawn=_boom)
   351	    sb.set_off(tid, ROLE, "step")
   352	    assert sb.wait_idle(10.0)
   353	
   354	    ticket = _read(db, tid)
   355	    assert ticket.status == TicketStatus.errored
   356	    assert ticket.worker is None
   357	    # started (agent_working) then errored — the end write always fires.
   358	    assert [e["status"] for e in _status_events(db, tid)] == ["agent_working", "errored"]

