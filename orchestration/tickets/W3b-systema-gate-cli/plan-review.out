   161	def _parse_next_ceiling(raw: str | None) -> NextCeiling | None:
   162	    if raw is None:
   163	        return None
   164	    if raw == NO_FURTHER:
   165	        return NO_FURTHER
   166	    try:
   167	        return TicketState(raw)
   168	    except ValueError:
   169	        raise PlannerError(
   170	            ErrorCode.grant_invalid, "unknown next_ceiling", {"next_ceiling": raw}
   171	        ) from None
   172	
   173	
   174	def _parse_grant_at_cap(raw: str | None) -> AtCap | None:
   175	    if raw is None:
   176	        return None
   177	    try:
   178	        return AtCap(raw)
   179	    except ValueError:
   180	        raise PlannerError(ErrorCode.grant_invalid, "unknown at_cap", {"at_cap": raw}) from None
   181	
   182	
   183	# --- private gap-fill writers (D2; A1: writer-shaped for relocation) ------------
   184	
   185	
   186	def _set_title(conn: sqlite3.Connection, ticket_id: str, title: str, *,
   187	               title_max_chars: int, now: int) -> Ticket:
   188	    admission.validate_title(title, title_max_chars)
   189	    with txn(conn):
   190	        ticket = tickets_data.read_ticket(conn, ticket_id)
   191	        prev = ticket.title
   192	        conn.execute(
   193	            "UPDATE tickets SET title = ?, updated_at = ? WHERE id = ?", (title, now, ticket_id)
   194	        )
   195	        append_event(
   196	            conn,
   197	            ticket_id,
   198	            EventKind.ticket_updated,
   199	            {"field": "title", "from": prev, "to": title},
   200	            now,
   201	        )
   202	        return tickets_data.read_ticket(conn, ticket_id)
   203	
   204	
   205	def _set_project(conn: sqlite3.Connection, ticket_id: str, project: Project | None, *,
   206	                 now: int) -> Ticket:
   207	    with txn(conn):
   208	        ticket = tickets_data.read_ticket(conn, ticket_id)
   209	        if ticket.sprint_item_id is not None:
   210	            raise PlannerError(ErrorCode.validation, "project is derived when parented")
   211	        prev = ticket.project.value if ticket.project is not None else None
   212	        new_value = project.value if project is not None else None
   213	        conn.execute(
   214	            "UPDATE tickets SET project = ?, updated_at = ? WHERE id = ?",
   215	            (new_value, now, ticket_id),
   216	        )
   217	        append_event(
   218	            conn,
   219	            ticket_id,
   220	            EventKind.ticket_updated,
   221	            {"field": "project", "from": prev, "to": new_value},
   222	            now,
   223	        )
   224	        return tickets_data.read_ticket(conn, ticket_id)
   225	
