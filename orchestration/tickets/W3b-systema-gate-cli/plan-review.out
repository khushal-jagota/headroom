     1	"""Production background loops: the boundary tick every tick_seconds via
     2	asyncio.to_thread. An iteration's exception is logged and never kills the loop. Test
     3	mode never starts these — that gating lives in the lifespan; this module stays
     4	directly callable for tests.
     5	
     6	The dispatcher loop + its machine-wide flock were removed with the old scheduling
     7	machinery. System A (the readiness poll that will drive System B) lands in W3b and
     8	re-adds its own loop plus the relocated runtime.lock singleton guard."""
     9	
    10	from __future__ import annotations
    11	
    12	import asyncio
    13	import contextlib
    14	import logging
    15	import sqlite3
    16	from collections.abc import Callable
    17	from functools import partial
    18	
    19	from planner.core.adapters.registry import Adapters
    20	from planner.core.clock import Clock
