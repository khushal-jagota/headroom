   192	
   193	def decide_edit_value(
   194	    ticket: Ticket, field: FieldName, new_body: str, actor: str
   195	) -> Decision:
   196	    """§4.2 human edit of an already-*passed* settled value. The value stays written
   197	    solely by the resolution engine; this is a tightly-guarded human write path that
   198	    never touches state/ceiling. It rejects dropped tickets, an unset value, a field
   199	    carrying a live proposal, and the current gating or any future field."""
   200	    admission.require_human(actor, "edit_field_value")
   201	    admission.validate_body(new_body, "field value")
   202	    if ticket.state is TicketState.dropped:
   203	        raise PlannerError(
   204	            ErrorCode.validation, "dropped tickets cannot be edited", {"state": "dropped"}
   205	        )
   206	    slot = fields_codec.get_slot(ticket.fields, field)
   207	    if slot.value is None:
   208	        raise PlannerError(
   209	            ErrorCode.validation, "field has no settled value to edit", {"field": field.value}
   210	        )
   211	    if slot.proposal is not None:
   212	        raise PlannerError(
   213	            ErrorCode.validation, "field has a pending proposal", {"field": field.value}
   214	        )
   215	    if not machine.field_is_passed(field, ticket.state):
   216	        raise PlannerError(
   217	            ErrorCode.validation,
   218	            "field is not yet passed",
   219	            {"field": field.value, "state": ticket.state.value},
   220	        )
   221	    new_slot = FieldSlot(value=new_body, proposal=None, notes=slot.notes)
   222	    new_fields = fields_codec.with_slot(ticket.fields, field, new_slot)
   223	    return Decision(
   224	        events=(
   225	            EventSpec(EventKind.field_value_edited, {"field": field.value, "body": new_body}),
   226	        ),
   227	        new_fields=new_fields,
   228	    )
   229	
   230	
   231	def decide_approve(ticket: Ticket, actor: str) -> Decision:
   232	    admission.require_human(actor, "approve_review")
   233	    if ticket.state is not TicketState.needs_review:
   234	        raise PlannerError(
   235	            ErrorCode.validation,
   236	            "approve requires state needs_review",
   237	            {"state": ticket.state.value},
   238	        )
   239	    events = (_state_change(ticket.state, TicketState.done, CAUSE_REVIEW_APPROVE),)
   240	    return Decision(events=events, new_state=TicketState.done)
   241	
   242	
   243	def decide_state_jump(ticket: Ticket, new_state: TicketState, actor: str) -> Decision:
   244	    admission.require_human(actor, "set_state")
   245	    if new_state is TicketState.dropped:
   246	        raise PlannerError(ErrorCode.validation, "use the drop action")
   247	    if ticket.state is TicketState.dropped:
   248	        raise PlannerError(ErrorCode.validation, "dropped is terminal")
   249	    if new_state is ticket.state:
   250	        raise PlannerError(ErrorCode.validation, "ticket already in that state")
   251	    events = (_state_change(ticket.state, new_state, CAUSE_HUMAN_STATE_JUMP),)
   252	    return Decision(events=events, new_state=new_state)
   253	
   254	
   255	def decide_drop(ticket: Ticket, actor: str) -> Decision:
   256	    admission.require_human(actor, "drop_ticket")
   257	    if ticket.state is TicketState.done:
   258	        raise PlannerError(
   259	            ErrorCode.validation, "done tickets cannot be dropped", {"state": "done"}
   260	        )
   261	    if ticket.state is TicketState.dropped:
   262	        raise PlannerError(
   263	            ErrorCode.validation, "ticket is already dropped", {"state": "dropped"}
   264	        )
   265	    events = (_state_change(ticket.state, TicketState.dropped, CAUSE_DROP),)
   266	    return Decision(events=events, new_state=TicketState.dropped)
   267	
   268	
   269	def decide_grant_change(
   270	    ticket: Ticket, ceiling: TicketState, at_cap: AtCap, actor: str
   271	) -> Decision:
   272	    admission.require_human(actor, "change_grant")
   273	    machine.validate_ceiling(ceiling)
   274	    events = (
   275	        EventSpec(
   276	            EventKind.grant_changed,
   277	            {"ceiling": ceiling.value, "at_cap": at_cap.value, "cause": CAUSE_HUMAN_GRANT},
   278	        ),
   279	    )
   280	    return Decision(events=events, new_ceiling=ceiling, new_at_cap=at_cap)

