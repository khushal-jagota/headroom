    66	# §8: agents drive priority/deadline/day/sprint via `ticket set`; title and project are
    67	# human-only, so an agent-classified PATCH touching them is agent_forbidden (§14).
    68	_TICKET_HUMAN_ONLY_FIELDS = ("title", "project")
