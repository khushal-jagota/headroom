   244	
   245	
   246	@router.post("/tickets")
   247	async def create_ticket(raw: dict[str, Any], conn: DbConn, ctx: Ctx, cfg: Cfg,
   248	                        clk: Clk, sa: Sa) -> JsonDict:
   249	    body = _marshal_create_ticket(raw)
   250	    now = clk.now_unix()
   251	    priority = parse_enum(Priority, body["priority"], "priority") \
   252	        if body["priority"] is not None else Priority.P3
   253	    project = parse_enum(Project, body["project"], "project") \
   254	        if body["project"] is not None else None
   255	    ticket = tickets_data.create_ticket(
   256	        conn,
   257	        title=body["title"],
   258	        actor=ctx.actor,
   259	        now=now,
   260	        title_max_chars=TITLE_MAX_CHARS,
   261	        project=project,
   262	        priority=priority,
   263	        deadline=body["deadline"],
   264	        sprint_id=body["sprint_id"],
   265	        sprint_item_id=body["sprint_item_id"],
   266	    )
   267	    _poke(sa)  # a fresh empty ticket may be ready at once — don't wait a poll tick
   268	    return tickets_views.ticket_json(ticket, now)
   269	
   270	
   271	@router.get("/tickets")
   272	async def list_tickets(conn: DbConn, cfg: Cfg, clk: Clk, state: str | None = None,
   273	                       project: str | None = None, sprint_id: str | None = None,
   274	                       sprint_item_id: str | None = None, day: str | None = None) -> JsonDict:
   275	    state_enum = parse_enum(TicketState, state, "state") if state is not None else None
   276	    project_enum = parse_enum(Project, project, "project") if project is not None else None
   277	    # `day` ('today' | ISO) scopes the list to one day's board via the day_tickets join.
   278	    day_id = resolve_day_id(day, clk.now(), cfg.boundary_hour) if day is not None else None
   279	    return {
   280	        "tickets": tickets_views.list_tickets(
   281	            conn,
   282	            clk.now_unix(),
   283	            state=state_enum,
   284	            project=project_enum,
   285	            sprint_id=sprint_id,
   286	            sprint_item_id=sprint_item_id,
   287	            day_id=day_id,
   288	        )
   289	    }
