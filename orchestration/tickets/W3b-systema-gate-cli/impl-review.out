    82	    conn_factory: Callable[[], sqlite3.Connection],
    83	) -> FastAPI:
    84	    @asynccontextmanager
    85	    async def _lifespan(app_: FastAPI) -> AsyncIterator[None]:
    86	        Path(config.db_path).parent.mkdir(parents=True, exist_ok=True)
    87	        Path(config.logs_dir).mkdir(parents=True, exist_ok=True)
    88	        loops: Any = None
