   483	@router.delete("/links")
   484	async def remove_link(conn: DbConn, ctx: Ctx, clk: Clk, sa: Sa, from_id: str, to_id: str,
   485	                      kind: str) -> JsonDict:
   486	    kind_enum = parse_enum(LinkKind, kind, "kind")
   487	    now = clk.now_unix()
   488	    with txn(conn):
   489	        core_links.remove_link(conn, from_id, to_id, kind_enum, now)
   490	    _poke(sa)  # removing a blocks link can make the target ready (unblock -> poke)
   491	    return {"ok": True}
