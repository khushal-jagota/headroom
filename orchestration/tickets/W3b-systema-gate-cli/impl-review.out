 succeeded in 0ms:
     1	"""System A — the readiness poll + fast path. Decides which tickets are READY to be worked
     2	and drives ``SystemB.set_off`` for each. It never touches the model and NEVER writes
     3	``tickets.status`` (System B is the sole writer — notes.md Principles).
     4	
     5	Readiness = a candidate-only query on the run status (``empty`` / ``awaiting_approval``,
     6	non-terminal) refined by the pure ``runtime.readiness.is_runnable`` predicate AND the ticket
     7	not already in-flight (``system_b.has_inflight``). The SAME ``is_runnable`` is handed to
     8	``set_off`` as its execution-time guard, so a ticket that stops being runnable between the
     9	poll and the run is skipped — one predicate gates both the poll and the run.
    10	
    11	Fast path: an approval / unblock (from the API) or a finished step (the MindQueue idle
    12	callback) pokes the poll immediately; the ``tick_seconds`` timer is the backstop. One poll
    13	thread; a machine-wide lock (acquired by ``loops.py``) keeps a single poller per machine."""
    14	
    15	from __future__ import annotations
    16	
    17	import logging
    18	import threading
    19	
    20	from planner.core.clock import Clock
    21	from planner.core.db import connect
    22	from planner.runtime import readiness
    23	from planner.runtime.system_b import SystemB
    24	from planner.tickets import data as tickets_data
    25	from planner.tickets.contracts import Ticket
    26	from planner.tickets.logic import machine
    27	
    28	_log = logging.getLogger(__name__)
    29	
    30	# The candidate set: run statuses that MIGHT need the next step set off, non-terminal. This
    31	# excludes agent_working (running) and errored (stopped + surfaced; no auto-retry) at the SQL
    32	# level — a candidate-only result set, not a per-tick full-table unpack.
    33	_CANDIDATE_SQL = (
    34	    "SELECT id FROM tickets "
    35	    "WHERE status IN ('empty','awaiting_approval') AND state NOT IN ('done','dropped')"
    36	)
    37	
    38	
    39	def _next_step_prompt(ticket: Ticket) -> str:
    40	    """The next-step prompt handed to the mind. Minimal on purpose — the "how to work a
    41	    ticket" intelligence lives in the worker role skill (loaded at kickoff), not here. Never
    42	    carries approval machinery (notes.md Principles: approval is invisible to the model)."""
    43	    gating = machine.gating_field(ticket.state)
    44	    field = gating.value if gating is not None else "the next step"
    45	    return (
    46	        f"Work ticket {ticket.id} — {ticket.title}. It is in state '{ticket.state.value}'; "
    47	        f"take the next step and propose the '{field}' field for approval."
    48	    )
    49	
    50	
    51	class SystemA:
    52	    """Readiness poll + fast path. Drives System B; never writes state."""
    53	
    54	    def __init__(
    55	        self,
    56	        db_path: str,
    57	        clock: Clock,
    58	        system_b: SystemB,
    59	        *,
    60	        role: str,
    61	        busy_timeout_ms: int = 5000,
    62	    ) -> None:
    63	        self._db_path = db_path
    64	        self._clock = clock
    65	        self._system_b = system_b
    66	        self._role = role
    67	        self._busy_timeout_ms = busy_timeout_ms
    68	        self._wake = threading.Event()
    69	        self._stop = threading.Event()
    70	        self._thread: threading.Thread | None = None
    71	
    72	    # --- fast path ----------------------------------------------------------
    73	
    74	    def poke(self, _key: str | None = None) -> None:
    75	        """Wake the poll loop now (fast path). ``_key`` is accepted and ignored so this can
    76	        be registered directly as the MindQueue idle callback (called with the ticket_id) and
    77	        also called arg-less from the API poke path."""
