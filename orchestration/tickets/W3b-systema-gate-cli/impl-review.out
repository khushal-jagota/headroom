   198	            # (5) end write: status + cleared worker + resolved durable key, one UPDATE.
   199	            tickets_data.set_run_status(
   200	                conn,
   201	                ticket_id,
   202	                status=end_status,
   203	                worker=None,
   204	                session_key=session_key_out,
   205	                error=end_error if end_status == TicketStatus.errored else None,
   206	                now=now,
   207	            )
   208	        finally:
   209	            conn.close()

