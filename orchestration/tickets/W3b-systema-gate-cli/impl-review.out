    34	_LOGGER = logging.getLogger(__name__)
    35	
    36	ConnFactory = Callable[[], sqlite3.Connection]
    37	
    38	
    39	async def _loop_forever(name: str, tick: Callable[[], JsonDict], interval: int) -> None:
    40	    """One background loop: tick first, then sleep. A4: shield the in-flight tick thread so
    41	    cancellation waits it out. Catch Exception only so CancelledError propagates."""
    42	    while True:
    43	        thread_task = asyncio.ensure_future(asyncio.to_thread(tick))
    44	        try:
    45	            await asyncio.shield(thread_task)
    46	        except asyncio.CancelledError:
    47	            with contextlib.suppress(BaseException):
    48	                await thread_task
    49	            raise
    50	        except Exception:
    51	            _LOGGER.exception("background %s tick failed", name)
    52	        await asyncio.sleep(interval)
    53	
    54	
    55	class BackgroundLoops:
    56	    def __init__(
    57	        self,
    58	        tasks: list[asyncio.Task[None]],
    59	        system_a: SystemA | None = None,
    60	        lock_path: str | None = None,
    61	    ) -> None:
    62	        self._tasks = tasks
    63	        self.system_a = system_a  # read by the lifespan -> app.state.system_a (API poke seam)
    64	        self._lock_path = lock_path
    65	        self._stopped = False
    66	
    67	    async def stop(self) -> None:
    68	        """Stop System A (join its poll thread — no new set-offs after this), release the
    69	        machine lock, then cancel the boundary task and wait out any in-flight tick thread.
    70	        Idempotent: a re-stopped handle is a no-op."""
    71	        global _active
    72	        if self._stopped:
    73	            return
    74	        self._stopped = True
    75	        if self.system_a is not None:
    76	            await asyncio.to_thread(self.system_a.stop)
    77	        if self._lock_path is not None:
    78	            release_machine_lock(self._lock_path)
    79	        for task in self._tasks:
    80	            task.cancel()
    81	        await asyncio.gather(*self._tasks, return_exceptions=True)
    82	        if _active is self:
    83	            _active = None
    84	
    85	
    86	_active: BackgroundLoops | None = None
    87	
    88	
    89	def _start_system_a(config: Config, clock: Clock) -> SystemA | None:
    90	    """Construct + start System A when enabled and this process wins the machine lock. Any
    91	    construction failure logs, releases the lock, and degrades to boundary-only (never kills
    92	    the server)."""
    93	    if not config.dispatch_enabled:
    94	        _LOGGER.info("System A disabled (dispatch_enabled=false)")
    95	        return None
    96	    if not ensure_machine_lock(config.dispatcher_lock_path):
    97	        _LOGGER.info("System A not started: another process holds the machine lock")
    98	        return None
    99	    try:
   100	        system_b = SystemB(
   101	            config.db_path,
   102	            clock,
   103	            home=resolve_planner_home(),
   104	            hermes_python=resolve_hermes_python(),
   105	            spawn=spawn_popen,
   106	        )
   107	        system_a = SystemA(config.db_path, clock, system_b, role=config.worker_skill)
   108	        system_b.set_idle_callback(system_a.poke)  # finished step -> poll next step (fast path)
   109	        system_a.start(config.tick_seconds)
   110	        return system_a
   111	    except Exception:
   112	        _LOGGER.exception("System A failed to start; running boundary-only")
   113	        release_machine_lock(config.dispatcher_lock_path)
   114	        return None
   115	
   116	
   117	def start_background_loops(
   118	    config: Config, clock: Clock, adapters: Adapters, conn_factory: ConnFactory
   119	) -> BackgroundLoops:
   120	    """Start the boundary loop + (when enabled) System A. At most one live instance per
   121	    process."""
   122	    global _active
   123	    if _active is not None:
   124	        raise RuntimeError("background loops already running")
   125	    boundary = asyncio.create_task(
   126	        _loop_forever(
   127	            "boundary",
   128	            partial(run_boundary_tick, conn_factory, config, clock, adapters),
   129	            config.tick_seconds,
   130	        )
   131	    )
   132	    system_a = _start_system_a(config, clock)
   133	    lock_path = config.dispatcher_lock_path if system_a is not None else None
   134	    loops = BackgroundLoops([boundary], system_a, lock_path)
   135	    _active = loops
   136	    return loops
