   404	@router.post("/tickets/{ticket_id}/grant")
   405	async def grant_ticket(ticket_id: str, raw: dict[str, Any], conn: DbConn, ctx: Ctx,
   406	                       clk: Clk, sa: Sa) -> JsonDict:
   407	    body = GrantBody(ceiling=body_opt_str(raw, "ceiling"), at_cap=body_opt_str(raw, "at_cap"))
   408	    reject_agents(ctx)
   409	    now = clk.now_unix()
   410	    ceiling_raw = body["ceiling"]
   411	    at_cap_raw = body["at_cap"]
   412	    if ceiling_raw is None or at_cap_raw is None:
   413	        missing = [name for name, value in (("ceiling", ceiling_raw), ("at_cap", at_cap_raw))
   414	                   if value is None]
   415	        raise PlannerError(
   416	            ErrorCode.grant_missing, "grant requires ceiling and at_cap", {"missing": missing}
   417	        )
   418	    try:
   419	        ceiling = TicketState(ceiling_raw)
   420	    except ValueError:
   421	        raise PlannerError(
   422	            ErrorCode.grant_invalid, "unknown ceiling", {"ceiling": ceiling_raw}
   423	        ) from None
   424	    try:
   425	        at_cap = AtCap(at_cap_raw)
   426	    except ValueError:
   427	        raise PlannerError(
   428	            ErrorCode.grant_invalid, "unknown at_cap", {"at_cap": at_cap_raw}
   429	        ) from None
   430	    ticket = tickets_data.change_grant(
   431	        conn, ticket_id, ceiling=ceiling, at_cap=at_cap, actor=ctx.actor, now=now
   432	    )
   433	    _poke(sa)  # a raised ceiling may unblock the next auto-advance
   434	    return tickets_views.ticket_json(ticket, now)
