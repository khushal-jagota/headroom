    86	    # --- public API ---------------------------------------------------------
    87	
    88	    def set_off(
    89	        self, ticket_id: str, role: str, prompt: str, *, guard: RunGuard | None = None
    90	    ) -> None:
    91	        """Set off step N of a ticket. Serialized per ticket through the MindQueue; the run
    92	        resolves the mind's current session_key at execution time. ``guard`` (System A's
    93	        ``is_runnable``) is re-checked at execution time before anything is written, so a
    94	        ticket that stopped being runnable in the read→run gap is skipped, not run."""
    95	        self._queue.submit(ticket_id, _Item(ticket_id, role, prompt, guard))
    96	
    97	    def has_inflight(self, ticket_id: str) -> bool:
    98	        """Whether a run is enqueued or in-flight for this ticket's mind. System A's
    99	        readiness guard against re-setting-off a ticket whose ``agent_working`` start
   100	        write hasn't landed yet (the enqueue happens before the queue thread writes it)."""
   101	        return self._queue.is_active(ticket_id)
   102	
   103	    def set_idle_callback(self, cb: Callable[[str], None]) -> None:
   104	        """Register a callback fired when a ticket's queue drains — the mind is free
   105	        again. W3b's System A registers its ``poke`` here so a finished step drives the
   106	        next one immediately (fast path) rather than waiting a full poll tick."""
   107	        self._idle_cb = cb
   108	
   109	    def _on_idle(self, ticket_id: str) -> None:
   110	        cb = self._idle_cb
   111	        if cb is not None:
   112	            cb(ticket_id)
   113	
   114	    def wait_idle(self, timeout: float | None = None) -> bool:
   115	        """Block until every set-off has fully settled (test helper)."""
   116	        return self._queue.wait_idle(timeout)
   117	
   118	    # --- the serialized run -------------------------------------------------
   119	
   120	    def _run_item(self, _key: str, item: _Item) -> None:
   121	        # _key is the queue key (== ticket_id); resolve the CURRENT session_key from the
   122	        # DB here, at execution time, so a rotated key from the prior run is picked up.
   123	        session_key = self._read_session_key(item.ticket_id)
   124	        self._run(item.ticket_id, session_key, item.role, item.prompt, item.guard)
   125	
   126	    def _read_session_key(self, ticket_id: str) -> str | None:
   127	        conn = connect(self._db_path, self._busy_timeout_ms)
   128	        try:
   129	            row = conn.execute(
   130	                "SELECT chat_session_key FROM tickets WHERE id = ?", (ticket_id,)
   131	            ).fetchone()
   132	            if row is None:
   133	                return None
   134	            value = row["chat_session_key"]
   135	            return str(value) if value is not None else None
   136	        finally:
   137	            conn.close()
   138	
   139	    def _run(
   140	        self,
   141	        ticket_id: str,
   142	        key: str | None,
   143	        role: str,
   144	        prompt: str,
   145	        guard: RunGuard | None,
   146	    ) -> None:
   147	        """One step: agent_working (start write) -> run_step -> proposal-present
   148	        invariant -> awaiting_approval/errored (end write). Both writes go through the
   149	        single-door tickets_data.set_run_status; System B is the only caller. The end
   150	        write ALWAYS fires (even if the run or a read raises) so a ticket is never left
   151	        stuck at agent_working."""
   152	        conn = connect(self._db_path, self._busy_timeout_ms)
   153	        try:
   154	            now = self._clock.now_unix()
   155	            # (0) execution-time readiness re-check: the poll read and this run are not
   156	            # atomic. If the ticket stopped being runnable in the gap (human drop / grant
   157	            # stop / a now-parked proposal / a new block), skip cleanly — write nothing,
   158	            # leave the ticket's status untouched. Absent guard (W3a bare set_off) = no skip.
   159	            if guard is not None and not guard(conn, tickets_data.read_ticket(conn, ticket_id)):
   160	                _log.info("system B skipped a no-longer-runnable ticket (ticket=%s)", ticket_id)
   161	                return
   162	            # (1) start write: agent_working + worker, single atomic UPDATE.
   163	            tickets_data.set_run_status(
   164	                conn, ticket_id, status=TicketStatus.agent_working, worker=role, now=now
   165	            )
   166	            # (2..4) run + map. Any failure between the writes maps to errored so the end
   167	            # write below is unconditional.
   168	            end_status = TicketStatus.errored
   169	            end_error: str | None = None
   170	            session_key_out = key
   171	            try:
   172	                pre = tickets_data.read_ticket(conn, ticket_id)  # the step the code asked for
   173	                pre_state = pre.state
   174	                pre_gating = machine.gating_field(pre_state)
   175	                result = run_step(  # kickoff creates step 0; continuing resumes `key`
   176	                    key, role, prompt, None, home=self._home, hermes_python=self._python,
   177	                    spawn=self._spawn,
   178	                )
   179	                session_key_out = result.session_key
   180	                end_error = result.error
   181	                if result.status == "complete":
   182	                    post = tickets_data.read_ticket(conn, ticket_id)
   183	                    advanced = post.state != pre_state  # agent step only auto-accepts forward
   184	                    parked = (
   185	                        pre_gating is not None
   186	                        and fields_codec.get_slot(post.fields, pre_gating).proposal is not None
   187	                    )
   188	                    if advanced or parked:
   189	                        end_status = TicketStatus.awaiting_approval
   190	                        end_error = None
   191	                    else:
   192	                        end_error = "agent left no proposal — you haven't done your job"
   193	            except Exception as exc:  # never leave the ticket at agent_working
   194	                _log.exception("system B run crashed (ticket=%s)", ticket_id)
   195	                end_status = TicketStatus.errored
   196	                end_error = f"system B run crashed: {exc}"
