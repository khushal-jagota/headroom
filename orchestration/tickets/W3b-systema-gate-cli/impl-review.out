   340	def test_fast_path_poke_sets_off_before_the_timer(tmp_path: Path) -> None:
   341	    db = _db(tmp_path)
   342	    tid_box: list[str] = []
   343	    fake = _ProposingFake(
   344	        _create_script(_complete_ev()),
   345	        on_submit=lambda: _file_proposal(db, tid_box[0], "success", "b"),
   346	    )
   347	    sb = _system_b(db, _Spawner([fake]))
   348	    sa = _system_a(db, sb)
   349	    sa.start(60)  # long interval: only a poke (not the timer) can drive it inside the budget
   350	    try:
   351	        time.sleep(0.3)               # let the first (empty) poll run and enter the wait
   352	        tid = _new_ticket(db)
   353	        tid_box.append(tid)
   354	        sa.poke()
   355	        # the poke drove the set_off well under 60s (wait on the effect, not wait_idle, which
   356	        # would race ahead of the loop thread's async poll+submit).
   357	        assert _wait_until(lambda: _read(db, tid).status == TicketStatus.awaiting_approval, 10.0)
   358	    finally:
   359	        sa.stop()
   360	
   361	
   362	def test_on_idle_drives_the_auto_advance_chain(tmp_path: Path) -> None:
   363	    # ceiling=needs_approach: step 0 (success) auto-accepts and the finished-step on_idle poke
   364	    # drives step 1 (approach) automatically, which parks at the ceiling and stops the chain.
   365	    db = _db(tmp_path)
   366	    tid = _new_ticket(db, ceiling=TicketState.needs_approach)
   367	    fake0 = _ProposingFake(
   368	        _create_script(_complete_ev()),
   369	        on_submit=lambda: _file_proposal(db, tid, "success", "s"),
   370	    )
   371	    fake1 = _ProposingFake(
   372	        _resume_script(STORED_KEY, _complete_ev()),
   373	        on_submit=lambda: _file_proposal(db, tid, "approach", "a"),
   374	    )
   375	    sb = _system_b(db, _Spawner([fake0, fake1]))
   376	    sa = _system_a(db, sb)
   377	    sb.set_idle_callback(sa.poke)  # loops.py wires this in production
   378	    sa.start(30)  # long interval: the on_idle poke, not the timer, advances the chain
   379	    try:
   380	        assert _wait_until(lambda: _read(db, tid).fields.approach.proposal is not None, 10.0)
   381	    finally:
   382	        sa.stop()
   383	
   384	    ticket = _read(db, tid)
   385	    assert ticket.state is TicketState.needs_approach       # step 0 auto-accepted + advanced
   386	    assert ticket.fields.success.value == "s"                # step 0 value settled
   387	    assert ticket.fields.approach.proposal is not None        # step 1 parked at the ceiling
   388	    assert ticket.status == TicketStatus.awaiting_approval
   389	    assert "session.create" in fake0.sent_methods()           # step 0 = create
   390	    assert "session.resume" in fake1.sent_methods()           # step 1 = resume

