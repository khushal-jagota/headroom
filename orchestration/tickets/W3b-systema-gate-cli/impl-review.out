   213	# --- queues (§4.5) -------------------------------------------------------------
   214	
   215	
   216	def _entity_type(entity_id: str) -> str:
   217	    return "ticket" if entity_id.split("_", 1)[0] == "t" else "item"
   218	
   219	
   220	def _approvals(conn: sqlite3.Connection, item_approval_rows: list[JsonDict]) -> list[JsonDict]:
   221	    ticket_rows = conn.execute(
   222	        "SELECT id, title, state, fields, updated_at FROM tickets "
   223	        "WHERE state NOT IN ('done','dropped') ORDER BY id"
   224	    ).fetchall()
   225	    ticket_digest: list[dict[str, object]] = []
   226	    ticket_title: dict[str, str] = {}
   227	    ticket_updated: dict[str, int] = {}
   228	    for r in ticket_rows:
   229	        tid = str(r["id"])
   230	        ticket_digest.append(
   231	            {
   232	                "id": tid,
   233	                "state": str(r["state"]),
   234	                "fields": json.loads(str(r["fields"])),
   235	                "updated_at": int(r["updated_at"]),
   236	            }
   237	        )
   238	        ticket_title[tid] = str(r["title"])
   239	        ticket_updated[tid] = int(r["updated_at"])
   240	    item_digest: list[dict[str, object]] = []
   241	    item_title: dict[str, str] = {}
   242	    for r in item_approval_rows:
   243	        iid = str(r["id"])
   244	        item_digest.append({"id": iid, "status_proposal": r["status_proposal"]})
   245	        item_title[iid] = str(r["title"])
   246	    digest = approvals_digest(ticket_digest, item_digest)
   247	    # A5: review entries use the last state_changed->needs_review event time, not the
   248	    # updated_at proxy; the boundary digest keeps its documented proxy.
   249	    for entry in digest:
   250	        if entry["kind"] == "review":
   251	            tid = str(entry["entity_id"])
   252	            row = conn.execute(
   253	                "SELECT created_at FROM events WHERE entity_id = ? AND kind = 'state_changed' "
   254	                "AND json_extract(payload, '$.to') = 'needs_review' ORDER BY id DESC LIMIT 1",
   255	                (tid,),
   256	            ).fetchone()
   257	            entry["waiting_since"] = (
   258	                int(row["created_at"]) if row is not None
   259	                else ticket_updated.get(tid, entry["waiting_since"])
   260	            )
   261	    digest.sort(key=lambda e: e["waiting_since"])
   262	    result: list[JsonDict] = []
   263	    for entry in digest:
   264	        eid = str(entry["entity_id"])
   265	        etype = _entity_type(eid)
   266	        title = ticket_title.get(eid) if etype == "ticket" else item_title.get(eid)
   267	        result.append(
   268	            {
   269	                "entity_id": eid,
   270	                "entity_type": etype,
   271	                "kind": entry["kind"],
   272	                "title": title,
   273	                "waiting_since": entry["waiting_since"],
   274	            }
   275	        )
   276	    return result
   277	
   278	
   279	def _overdue(
   280	    conn: sqlite3.Connection, today_iso: str, item_overdue_rows: list[JsonDict]
   281	) -> list[JsonDict]:
   282	    ticket_rows = conn.execute(
   283	        "SELECT id, title, state, priority, deadline FROM tickets WHERE deadline IS NOT NULL "
   284	        "ORDER BY deadline ASC, id"
   285	    ).fetchall()
   286	    ticket_dicts: list[dict[str, object]] = [
   287	        {
   288	            "id": str(r["id"]),
   289	            "title": str(r["title"]),
   290	            "state": str(r["state"]),
   291	            "priority": str(r["priority"]),
   292	            "deadline": str(r["deadline"]) if r["deadline"] is not None else None,
   293	        }
   294	        for r in ticket_rows
   295	    ]
   296	    item_dicts: list[dict[str, object]] = [dict(r) for r in item_overdue_rows]
   297	    digest = overdue_list(ticket_dicts, item_dicts, today_iso)
   298	    ticket_deadline = {str(d["id"]): d["deadline"] for d in ticket_dicts}
   299	    item_deadline = {str(d["id"]): d["deadline"] for d in item_dicts}
   300	    result: list[JsonDict] = []
   301	    for entry in digest:
   302	        eid = str(entry["id"])
   303	        etype = _entity_type(eid)
   304	        deadline = ticket_deadline.get(eid) if etype == "ticket" else item_deadline.get(eid)
   305	        result.append(
   306	            {
   307	                "id": eid,
   308	                "entity_type": etype,
   309	                "title": entry["title"],
   310	                "state": entry["state"],
   311	                "priority": entry["priority"],
   312	                "deadline": deadline,
   313	            }
   314	        )
   315	    return result
   316	
   317	
   318	def queues_view(
   319	    conn: sqlite3.Connection,
   320	    now: int,
   321	    today_iso: str,
   322	    item_approval_rows: list[JsonDict],
   323	    item_overdue_rows: list[JsonDict],
   324	) -> JsonDict:
   325	    return {
   326	        "approvals": _approvals(conn, item_approval_rows),
   327	        "overdue": _overdue(conn, today_iso, item_overdue_rows),
   328	    }
     1	"""Planning-date math (§6.1). The calendar date of (now − boundary_hour hours).
     2	Matches the ``PlanningDateFn`` contract named in ``days/contracts.py``. Stdlib
     3	only, plus the leaf ``core.ids`` / ``core.errors`` for the shared day-id resolver."""
     4	
     5	from __future__ import annotations
     6	
     7	from datetime import date, datetime, timedelta
     8	
     9	from planner.core import ids
    10	from planner.core.errors import ErrorCode, PlannerError
    11	
    12	
    13	def planning_date(now: datetime, boundary_hour: int) -> date:
    14	    """§6.1: planning date = calendar date of (now − boundary_hour hours).
    15	
    16	    05:00 belongs to the NEW date (04:59 → previous, 05:00 → current): the shift
    17	    falls straight out of the subtraction, so there is no ``>``/``>=`` branch to
    18	    get wrong. Tz-agnostic — works on an aware local ``now`` or a naive test one.
    19	    """
    20	    return (now - timedelta(hours=boundary_hour)).date()
    21	
    22	
    23	def resolve_day_id(day_seg: str, now: datetime, boundary_hour: int) -> str:
    24	    """A day path/param segment → a canonical ``day_YYYY-MM-DD`` id. ``today`` resolves
    25	    through the planning date; any other value is parsed as an ISO date then re-formatted
    26	    via ``ids.day_id`` (so compact forms like ``20260704`` still canonicalise). An
    27	    unparseable segment raises the validation envelope. Pure: the one home both the day
    28	    routes and the ticket ``--day`` filter share, so neither re-implements the rule."""
    29	    if day_seg == "today":
    30	        return ids.day_id(planning_date(now, boundary_hour))
    31	    try:
    32	        parsed = date.fromisoformat(day_seg)
    33	    except ValueError:
    34	        raise PlannerError(ErrorCode.validation, "invalid date", {"date": day_seg}) from None
    35	    return ids.day_id(parsed)
     1	"""Day routes (§9). The {date} path segment accepts the literal `today` (resolved
     2	via the planning date) or any ISO date. Thin HTTP shells over the day data layer;
     3	materialize-on-read is spec'd (§3.4)."""
     4	
     5	from __future__ import annotations
     6	
     7	import sqlite3
     8	from typing import Any
     9	
    10	from fastapi import APIRouter
    11	
    12	from planner.core.authctx import reject_agents
    13	from planner.core.clock import Clock
    14	from planner.core.config import Config
    15	from planner.core.contracts import JsonDict
    16	from planner.core.errors import ErrorCode, PlannerError
    17	from planner.days import data as days_data
    18	from planner.days.contracts import AddDayTicketBody
    19	from planner.days.logic import dates
    20	from planner.tickets.api import Cfg, Clk, Ctx, DbConn, body_opt_str, body_str, txn
    21	from planner.tickets.data import read_ticket
    22	from planner.tickets.views import ticket_json
    23	
    24	router = APIRouter()
    25	
    26	
    27	# --- shared day helpers --------------------------------------------------------
    28	
    29	
    30	def resolve_day_id(date_seg: str, clock: Clock, config: Config) -> str:
    31	    """`today` resolves through the planning date; any ISO date is parsed then re-formatted
    32	    canonically. Delegates to the shared pure ``dates.resolve_day_id`` (one home, also used by
    33	    the ticket ``--day`` filter) so the rule is not implemented twice."""
    34	    return dates.resolve_day_id(date_seg, clock.now(), config.boundary_hour)
    35	
    36	
    37	def _day_view(conn: sqlite3.Connection, did: str, now: int) -> JsonDict:
    38	    # A2: read_day materializes an absent day (INSERT + event, multi-statement) on an
    39	    # autocommit connection, so this one read is wrapped; the rest run bare.
    40	    with txn(conn):
    41	        day = days_data.read_day(conn, did, now)
    42	    dts = days_data.list_day_tickets(conn, did)
    43	    return {
    44	        "id": day.id,
    45	        "focus": day.focus,
    46	        "brief_take": day.brief_take,
    47	        "watchout": day.watchout,
    48	        "if_today_lands": day.if_today_lands,
    49	        "notes": day.notes,
    50	        "chat_session_key": day.chat_session_key,
    51	        "created_at": day.created_at,
    52	        "updated_at": day.updated_at,
    53	        "tickets": [ticket_json(read_ticket(conn, dt.ticket_id), now) for dt in dts],
    54	    }
    55	
    56	
    57	# --- day routes ----------------------------------------------------------------
    58	
    59	
    60	@router.get("/day/{date}")
    61	async def get_day(date: str, conn: DbConn, cfg: Cfg, clk: Clk) -> JsonDict:
    62	    did = resolve_day_id(date, clk, cfg)
    63	    return _day_view(conn, did, clk.now_unix())
    64	
    65	
    66	@router.patch("/day/{date}")
    67	async def patch_day(date: str, raw: dict[str, Any], conn: DbConn, ctx: Ctx, cfg: Cfg,
    68	                    clk: Clk) -> JsonDict:
    69	    reject_agents(ctx)  # §8: overview fields + notes are human-only; the boundary writes its own
    70	    did = resolve_day_id(date, clk, cfg)
    71	    now = clk.now_unix()
    72	    # Each overview field (and notes) edits on its own — no whole-blob re-serialize.
    73	    edits: dict[str, str] = {}
    74	    for field in days_data.DAY_TEXT_FIELDS:
    75	        value = body_opt_str(raw, field)
    76	        if value is not None:
    77	            edits[field] = value
    78	    if not edits:
    79	        raise PlannerError(ErrorCode.validation, "no day fields to update", {})
    80	    for field, value in edits.items():
    81	        with txn(conn):
    82	            days_data.set_day_field(conn, did, field, value, now)
    83	    return _day_view(conn, did, now)
    84	
    85	
    86	@router.post("/day/{date}/tickets")
    87	async def add_day_ticket(date: str, raw: dict[str, Any], conn: DbConn,
    88	                         cfg: Cfg, clk: Clk) -> JsonDict:
    89	    body = AddDayTicketBody(ticket_id=body_str(raw, "ticket_id"))
    90	    did = resolve_day_id(date, clk, cfg)
    91	    now = clk.now_unix()
    92	    read_ticket(conn, body["ticket_id"])  # existence guard (avoids a raw FK 500)
    93	    with txn(conn):
    94	        days_data.add_day_ticket(conn, did, body["ticket_id"], now)
    95	    return _day_view(conn, did, now)
    96	
    97	
    98	@router.delete("/day/{date}/tickets/{ticket_id}")
    99	async def remove_day_ticket(date: str, ticket_id: str, conn: DbConn, cfg: Cfg,
   100	                            clk: Clk) -> JsonDict:
   101	    did = resolve_day_id(date, clk, cfg)
   102	    now = clk.now_unix()
   103	    with txn(conn):
