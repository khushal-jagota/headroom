   156	class _ProposingFake(FakeGateway):
   157	    """Files a real proposal (production writer) the moment it receives prompt.submit."""
   158	
   159	    def __init__(
   160	        self, script: dict[str, list[Reply]], *, on_submit: Callable[[], None] | None = None
   161	    ) -> None:
   162	        super().__init__(script)
   163	        self._on_submit = on_submit
   164	
   165	    def send(self, line: str) -> None:
   166	        frame = json.loads(line)
   167	        if frame.get("method") == "prompt.submit" and self._on_submit is not None:
   168	            self._on_submit()
   169	        super().send(line)
   170	
   171	
   172	class _Spawner:
   173	    """Hands out a fresh FakeGateway per spawn (a child is single-use)."""
   174	
   175	    def __init__(self, children: list[FakeGateway]) -> None:
   176	        self._children = children
   177	        self._i = 0
   178	        self._lock = threading.Lock()
   179	
   180	    def spawn(self, argv: list[str], env: dict[str, str]) -> ChildProcess:
   181	        with self._lock:
   182	            child = self._children[self._i]
   183	            self._i += 1
   184	        return child.spawn(argv, env)
   185	
