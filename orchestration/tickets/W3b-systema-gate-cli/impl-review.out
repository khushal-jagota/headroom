   176	
   177	def board_view(conn: sqlite3.Connection, now: int) -> JsonDict:
   178	    rows = conn.execute(
   179	        "SELECT id, title, state, priority, deadline, project, fields, status, "
   180	        "created_at FROM tickets WHERE state != 'dropped'"
   181	    ).fetchall()
   182	    by_state: dict[str, list[tuple[tuple[int, int, str, int], JsonDict]]] = {
   183	        s.value: [] for s in STATE_ORDER
   184	    }
   185	    for row in rows:
   186	        state = str(row["state"])
   187	        priority = str(row["priority"])
   188	        deadline = str(row["deadline"]) if row["deadline"] is not None else None
   189	        fields = fields_codec.fields_from_json(str(row["fields"]))
   190	        card: JsonDict = {
   191	            "id": str(row["id"]),
   192	            "title": str(row["title"]),
   193	            "priority": priority,
   194	            "deadline": deadline,
   195	            "project": str(row["project"]) if row["project"] is not None else None,
   196	            "has_pending_proposal": machine.has_pending_gating_proposal(TicketState(state), fields),
   197	            "status": str(row["status"]),
   198	        }
   199	        sort_key = (
   200	            _prio_rank(priority),
   201	            0 if deadline is not None else 1,
   202	            deadline or "",
   203	            int(row["created_at"]),
   204	        )
   205	        by_state[state].append((sort_key, card))
   206	    columns: list[JsonDict] = []
   207	    for s in STATE_ORDER:
   208	        cards = [card for _, card in sorted(by_state[s.value], key=lambda item: item[0])]
   209	        columns.append({"state": s.value, "cards": cards})
   210	    return {"columns": columns}
