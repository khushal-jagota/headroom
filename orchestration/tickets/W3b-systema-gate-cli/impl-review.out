    69	def list_tickets(
    70	    conn: sqlite3.Connection,
    71	    now: int,
    72	    *,
    73	    state: TicketState | None,
    74	    project: Project | None,
    75	    sprint_id: str | None,
    76	    sprint_item_id: str | None,
    77	    day_id: str | None = None,
    78	) -> list[JsonDict]:
    79	    clauses: list[str] = []
    80	    params: list[str] = []
    81	    if state is not None:
    82	        clauses.append("state = ?")
    83	        params.append(state.value)
    84	    if project is not None:
    85	        clauses.append("project = ?")
    86	        params.append(project.value)
    87	    if sprint_id is not None:
    88	        clauses.append("sprint_id = ?")
    89	        params.append(sprint_id)
    90	    if sprint_item_id is not None:
    91	        clauses.append("sprint_item_id = ?")
    92	        params.append(sprint_item_id)
    93	    if day_id is not None:  # scope to one day's board via the day_tickets join
    94	        clauses.append("id IN (SELECT ticket_id FROM day_tickets WHERE day_id = ?)")
    95	        params.append(day_id)
    96	    where = (" WHERE " + " AND ".join(clauses)) if clauses else ""
    97	    rows = conn.execute(
    98	        "SELECT id FROM tickets" + where + " ORDER BY created_at ASC, id", tuple(params)
    99	    ).fetchall()
   100	    return [ticket_json(tickets_data.read_ticket(conn, str(row["id"])), now) for row in rows]
