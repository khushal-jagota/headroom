   195	def _wait_until(predicate: Callable[[], bool], timeout: float = 10.0) -> bool:
   196	    deadline = time.time() + timeout
   197	    while time.time() < deadline:
   198	        if predicate():
   199	            return True
   200	        time.sleep(0.02)
   201	    return False
