    98	DbConn = Annotated[sqlite3.Connection, Depends(db_conn)]
    99	Ctx = Annotated[RequestContext, Depends(request_context)]
   100	Cfg = Annotated[Config, Depends(get_config)]
   101	Clk = Annotated[Clock, Depends(get_clock)]
   102	Sa = Annotated[SystemA | None, Depends(get_system_a)]
   103	
   104	
   105	def _poke(system_a: SystemA | None) -> None:
   106	    """Null-guarded fast-path wake (no-op in test mode where System A never runs)."""
   107	    if system_a is not None:
   108	        system_a.poke()
   109	
   110	
   111	@contextmanager
   112	def txn(conn: sqlite3.Connection) -> Iterator[None]:
   113	    """Wrap a NON-self-transacting writer (days/dispatch/links) so a mid-sequence
   114	    PlannerError rolls back cleanly. Never wrap a ticket/sprint writer — those open
   115	    their own BEGIN IMMEDIATE and would raise 'transaction within a transaction'."""
   116	    conn.execute("BEGIN IMMEDIATE")
   117	    try:
   118	        yield
   119	    except BaseException:
   120	        conn.execute("ROLLBACK")
   121	        raise
   122	    else:
   123	        conn.execute("COMMIT")
   124	
   125	
   126	def parse_enum[E: StrEnum](enum_cls: type[E], raw: str, what: str) -> E:
   127	    try:
   128	        return enum_cls(raw)
   129	    except ValueError:
   130	        raise PlannerError(ErrorCode.validation, f"invalid {what}", {what: raw}) from None
   131	
   132	
   133	def body_str(body: JsonDict, key: str, default: str = "") -> str:
   134	    """Marshal an optional string body key: absent -> default; null or non-string ->
   135	    the validation envelope. Unknown keys are ignored by the callers, matching the
   136	    §14 body shapes."""
   137	    raw = body.get(key, default)
   138	    if not isinstance(raw, str):
   139	        raise PlannerError(ErrorCode.validation, f"invalid {key}", {key: raw})
   140	    return raw
   141	
   142	
   143	def body_opt_str(body: JsonDict, key: str) -> str | None:
   144	    raw = body.get(key)
   145	    if raw is None:
   146	        return None
   147	    if not isinstance(raw, str):
   148	        raise PlannerError(ErrorCode.validation, f"invalid {key}", {key: raw})
   149	    return raw
   150	
