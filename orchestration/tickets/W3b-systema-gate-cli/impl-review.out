   292	@router.get("/tickets/{ticket_id}")
   293	async def get_ticket(ticket_id: str, conn: DbConn, clk: Clk) -> JsonDict:
   294	    return tickets_views.ticket_detail(conn, ticket_id, clk.now_unix())
   295	
   296	
   297	@router.patch("/tickets/{ticket_id}")
   298	async def patch_ticket(ticket_id: str, body: dict[str, Any], conn: DbConn, ctx: Ctx,
   299	                       cfg: Cfg, clk: Clk) -> JsonDict:
   300	    recognized = ("title", "priority", "deadline", "project", "sprint_id")
   301	    for key in body:
   302	        if key not in recognized:
   303	            raise PlannerError(ErrorCode.validation, "unknown ticket field", {"field": key})
   304	    if not body:
   305	        raise PlannerError(ErrorCode.validation, "no ticket fields to update", {})
   306	    reject_agent_fields(ctx, body, _TICKET_HUMAN_ONLY_FIELDS)
   307	    now = clk.now_unix()
   308	    if "title" in body:
   309	        _set_title(conn, ticket_id, body["title"], title_max_chars=TITLE_MAX_CHARS, now=now)
   310	    if "priority" in body:
   311	        priority = parse_enum(Priority, body["priority"], "priority")
   312	        tickets_data.set_priority(conn, ticket_id, priority=priority, actor=ctx.actor, now=now)
   313	    if "deadline" in body:
   314	        tickets_data.set_deadline(conn, ticket_id, deadline=body["deadline"], actor=ctx.actor,
   315	                                  now=now)
   316	    if "project" in body:
   317	        project = parse_enum(Project, body["project"], "project") \
   318	            if body["project"] is not None else None
   319	        _set_project(conn, ticket_id, project, now=now)
   320	    if "sprint_id" in body:
   321	        tickets_data.set_sprint(conn, ticket_id, sprint_id=body["sprint_id"], actor=ctx.actor,
   322	                                now=now)
   323	    return tickets_views.ticket_json(tickets_data.read_ticket(conn, ticket_id), now)
   324	
