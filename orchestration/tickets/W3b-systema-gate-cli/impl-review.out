   103	def ticket_detail(conn: sqlite3.Connection, ticket_id: str, now: int) -> JsonDict:
   104	    ticket = tickets_data.read_ticket(conn, ticket_id)
   105	    detail = ticket_json(ticket, now)
   106	    link_rows = conn.execute(
   107	        "SELECT from_id, to_id, kind FROM links WHERE from_id = ? OR to_id = ? "
   108	        "ORDER BY kind, from_id, to_id",
   109	        (ticket_id, ticket_id),
   110	    ).fetchall()
   111	    day_rows = conn.execute(
   112	        "SELECT day_id FROM day_tickets WHERE ticket_id = ? ORDER BY day_id ASC", (ticket_id,)
   113	    ).fetchall()
   114	    detail.update(
   115	        {
   116	            "blocked": core_links.is_blocked(conn, ticket_id),
   117	            "effective_sprint_id": tickets_data.get_effective_sprint_id(conn, ticket_id),
   118	            "links": [
   119	                {"from_id": str(r["from_id"]), "to_id": str(r["to_id"]), "kind": str(r["kind"])}
   120	                for r in link_rows
   121	            ],
   122	            "day_ids": [str(r["day_id"]) for r in day_rows],
   123	        }
   124	    )
   125	    return detail
