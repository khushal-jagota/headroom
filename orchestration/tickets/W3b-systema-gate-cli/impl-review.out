   152	# --- request-body marshallers (contract shapes in tickets/contracts.py) ---------
   153	
   154	
   155	def _marshal_create_ticket(raw: JsonDict) -> CreateTicketBody:
   156	    return CreateTicketBody(
   157	        title=body_str(raw, "title"),
   158	        priority=body_opt_str(raw, "priority"),
   159	        deadline=body_opt_str(raw, "deadline"),
   160	        project=body_opt_str(raw, "project"),
   161	        sprint_id=body_opt_str(raw, "sprint_id"),
   162	        sprint_item_id=body_opt_str(raw, "sprint_item_id"),
   163	    )
   164	
   165	
   166	def _marshal_accept(raw: JsonDict) -> AcceptBody:
   167	    return AcceptBody(
   168	        edited_body=body_opt_str(raw, "edited_body"),
   169	        next_ceiling=body_opt_str(raw, "next_ceiling"),
   170	        at_cap=body_opt_str(raw, "at_cap"),
   171	    )
   172	
   173	
   174	# --- grant marshallers ---------------------------------------------------------
   175	
   176	
   177	def _parse_next_ceiling(raw: str | None) -> NextCeiling | None:
   178	    if raw is None:
   179	        return None
   180	    if raw == NO_FURTHER:
   181	        return NO_FURTHER
   182	    try:
   183	        return TicketState(raw)
   184	    except ValueError:
   185	        raise PlannerError(
   186	            ErrorCode.grant_invalid, "unknown next_ceiling", {"next_ceiling": raw}
   187	        ) from None
   188	
   189	
   190	def _parse_grant_at_cap(raw: str | None) -> AtCap | None:
   191	    if raw is None:
   192	        return None
   193	    try:
   194	        return AtCap(raw)
   195	    except ValueError:
   196	        raise PlannerError(ErrorCode.grant_invalid, "unknown at_cap", {"at_cap": raw}) from None
   197	
   198	
   199	# --- private gap-fill writers (D2; A1: writer-shaped for relocation) ------------
   200	
   201	
   202	def _set_title(conn: sqlite3.Connection, ticket_id: str, title: str, *,
   203	               title_max_chars: int, now: int) -> Ticket:
   204	    admission.validate_title(title, title_max_chars)
   205	    with txn(conn):
   206	        ticket = tickets_data.read_ticket(conn, ticket_id)
   207	        prev = ticket.title
   208	        conn.execute(
   209	            "UPDATE tickets SET title = ?, updated_at = ? WHERE id = ?", (title, now, ticket_id)
   210	        )
   211	        append_event(
   212	            conn,
   213	            ticket_id,
   214	            EventKind.ticket_updated,
   215	            {"field": "title", "from": prev, "to": title},
   216	            now,
   217	        )
   218	        return tickets_data.read_ticket(conn, ticket_id)
   219	
   220	
   221	def _set_project(conn: sqlite3.Connection, ticket_id: str, project: Project | None, *,
   222	                 now: int) -> Ticket:
   223	    with txn(conn):
   224	        ticket = tickets_data.read_ticket(conn, ticket_id)
   225	        if ticket.sprint_item_id is not None:
   226	            raise PlannerError(ErrorCode.validation, "project is derived when parented")
   227	        prev = ticket.project.value if ticket.project is not None else None
   228	        new_value = project.value if project is not None else None
   229	        conn.execute(
   230	            "UPDATE tickets SET project = ?, updated_at = ? WHERE id = ?",
   231	            (new_value, now, ticket_id),
   232	        )
   233	        append_event(
   234	            conn,
   235	            ticket_id,
   236	            EventKind.ticket_updated,
   237	            {"field": "project", "from": prev, "to": new_value},
   238	            now,
   239	        )
   240	        return tickets_data.read_ticket(conn, ticket_id)
   241	
