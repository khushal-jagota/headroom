   316	def test_poll_excludes_every_non_runnable_ticket(tmp_path: Path) -> None:
   317	    db = _db(tmp_path)
   318	    # status-excluded (candidate query): agent_working, errored
   319	    t_working = _new_ticket(db)
   320	    _set_status(db, t_working, TicketStatus.agent_working, worker="w")
   321	    t_errored = _new_ticket(db)
   322	    _set_status(db, t_errored, TicketStatus.errored)
   323	    # predicate-excluded: dropped, at-ceiling+stop, parked proposal, needs_review, blocked
   324	    t_dropped = _new_ticket(db)
   325	    _drop(db, t_dropped)
   326	    _new_ticket(db, ceiling=TicketState.needs_success, at_cap=AtCap.stop)  # at ceiling + stop
   327	    t_parked = _new_ticket(db)
   328	    _file_proposal(db, t_parked, "success", "b")
   329	    t_review = _new_ticket(db)
   330	    _jump_state(db, t_review, TicketState.needs_review)
   331	    blocker = _new_ticket(db, at_cap=AtCap.stop)  # open (blocks) but itself not runnable
   332	    t_blocked = _new_ticket(db)
   333	    _add_block(db, blocker, t_blocked)
   334	
   335	    sb = _system_b(db, _Spawner([]))  # must never be used
   336	    sa = _system_a(db, sb)
   337	    assert sa.poll_once() == []       # nothing ready -> nothing set off
