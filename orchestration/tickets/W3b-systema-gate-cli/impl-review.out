    71	# --- shared plumbing (imported by the other api modules) -----------------------
    72	
    73	
    74	def get_config(request: Request) -> Config:
    75	    return cast(Config, request.app.state.config)
    76	
    77	
    78	def get_clock(request: Request) -> Clock:
    79	    return cast(Clock, request.app.state.clock)
    80	
    81	
    82	async def db_conn(request: Request) -> AsyncIterator[sqlite3.Connection]:
    83	    conn = cast(Callable[[], sqlite3.Connection], request.app.state.conn_factory)()
    84	    try:
    85	        yield conn
    86	    finally:
    87	        conn.close()
    88	
    89	
    90	def get_system_a(request: Request) -> SystemA | None:
    91	    """The running System A (readiness poll), or None in test mode / before startup. The
    92	    readiness-changing endpoints poke it so an approval / unblock / create drives the next
    93	    step immediately instead of waiting a poll tick."""
    94	    system_a: SystemA | None = getattr(request.app.state, "system_a", None)
    95	    return system_a
