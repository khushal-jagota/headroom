   134	
   135	
   136	def _resume_reply(sid: str = LIVE_SID, key: str = STORED_KEY) -> Reply:
   137	    return Reply(result={"session_id": sid, "resumed": key})
   138	
   139	
   140	def _complete_ev(sid: str = LIVE_SID, status: str = "complete") -> dict[str, Any]:
   141	    return ev("message.complete", sid, {"text": "ok", "usage": {}, "status": status})
   142	
   143	
   144	def _submit_reply(*events_after: dict[str, Any]) -> Reply:
   145	    return Reply(result={"status": "streaming"}, events_after=tuple(events_after))
   146	
   147	
   148	def _create_script(*after: dict[str, Any]) -> dict[str, list[Reply]]:
   149	    return {"session.create": [_create_reply()], "prompt.submit": [_submit_reply(*after)]}
   150	
   151	
   152	def _resume_script(key: str = STORED_KEY, *after: dict[str, Any]) -> dict[str, list[Reply]]:
   153	    return {"session.resume": [_resume_reply(key=key)], "prompt.submit": [_submit_reply(*after)]}
