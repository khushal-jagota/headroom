     1	"""Per-mind serialized run queue: at most ONE in-flight run per key; different
     2	keys run concurrently; FIFO within a key. This is load-bearing correctness —
     3	the gateway's 4009 busy-guard is per-process only and cannot protect two
     4	child-per-run processes resuming the same stored session (notes.md:99-106).
     5	
     6	The key must be a STABLE per-mind identifier. The queue guarantees at most one
     7	in-flight run per key, FIFO within a key, and concurrency across keys; it is
     8	generic over the item type ``T`` and prescribes nothing about item contents (the
     9	run callable is injected). The mind's durable Hermes ``session_key``
    10	(``stored_session_id``) is NOT a stable identifier — the gateway auto-compresses
    11	and ROTATES it mid-run (spike 01) — so keying on the key value would split one
    12	mind across two queue keys and let two children resume it concurrently, defeating
    13	the very busy-guard this queue exists to enforce.
    14	
    15	W3a's System B therefore keys on the STABLE ``ticket_id`` (one mind per ticket)
    16	and resolves the mind's current stored ``session_key`` from the DB at EXECUTION
    17	time inside the run (not at enqueue). This also subsumes kickoff: step-0 (no key
    18	yet) and step-N of the same ticket share the ``ticket_id`` key, so the queue
    19	serializes them — the run resolves ``None`` -> ``session.create`` and stores the
    20	key, and the next run resolves it -> ``session.resume``. Two step-0 runs never
    21	both create.
    22	
    23	Module name note: ``planner.minds.queue`` cannot shadow the stdlib ``queue`` —
    24	Python 3 imports are absolute, so ``import queue`` anywhere (including in this
    25	package) resolves to the stdlib; this module is only reachable as
    26	``planner.minds.queue``.
    27	"""
    28	
    29	from __future__ import annotations
    30	
    31	import logging
    32	import threading
    33	from collections import deque
    34	from collections.abc import Callable
    35	
    36	_log = logging.getLogger(__name__)
    37	
    38	
    39	class MindQueue[T]:
    40	    """FIFO-per-key serialized runner: one worker thread per active key.
    41	
    42	    ``on_idle(key)`` (optional) fires once a key's queue has fully drained and the key
    43	    has been removed from ``_active`` — the moment that mind is free again. It runs
    44	    OUTSIDE the lock, so a callback that re-submits (or pokes a poller that will) cannot
    45	    deadlock. This is the fast-path seam W3b's System A registers so a finished step
    46	    immediately drives the next one instead of waiting a full tick."""
    47	
    48	    def __init__(
    49	        self, run: Callable[[str, T], None], *, on_idle: Callable[[str], None] | None = None
    50	    ) -> None:
    51	        self._run = run
