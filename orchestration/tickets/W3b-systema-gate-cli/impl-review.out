   338	@router.post("/tickets/{ticket_id}/accept/{field}")
   339	async def accept_field(ticket_id: str, field: str, raw: dict[str, Any], conn: DbConn, ctx: Ctx,
   340	                       clk: Clk, sa: Sa) -> JsonDict:
   341	    body = _marshal_accept(raw)
   342	    reject_agents(ctx)
   343	    field_enum = parse_enum(FieldName, field, "field")
   344	    now = clk.now_unix()
   345	    next_ceiling = _parse_next_ceiling(body["next_ceiling"])
   346	    at_cap = _parse_grant_at_cap(body["at_cap"])
   347	    ticket = tickets_data.accept_proposal(
   348	        conn,
   349	        ticket_id,
   350	        field=field_enum,
   351	        actor=ctx.actor,
   352	        now=now,
   353	        edited_body=body["edited_body"],
   354	        next_ceiling=next_ceiling,
   355	        at_cap=at_cap,
   356	    )
   357	    _poke(sa)  # the approve gate: set off the next step (bundled propose->approve)
   358	    return tickets_views.ticket_json(ticket, now)
