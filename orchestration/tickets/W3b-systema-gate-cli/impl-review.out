   476	    kind = parse_enum(LinkKind, body["kind"], "kind")
   477	    now = clk.now_unix()
   478	    with txn(conn):
   479	        core_links.add_link(conn, body["from_id"], body["to_id"], kind, now)
   480	    return {"from_id": body["from_id"], "to_id": body["to_id"], "kind": kind.value}
