 succeeded in 0ms:
     1	"""Ticket readiness — the pure predicate System A polls and System B re-checks at
     2	execution time. ``is_runnable(conn, ticket)`` answers "should the agent run the next step
     3	of this ticket right now?" from ticket state alone; it carries NO run-queue knowledge
     4	(``has_inflight`` is System A's concern, and at execution time the ticket is inflight by
     5	definition — so the execution-time guard must not consult it).
     6	
     7	Kept in its own module so both ``system_a`` and ``system_b`` import it with no cycle — it
     8	reaches only into ``tickets.logic`` + ``core.links``, never into either system."""
     9	
    10	from __future__ import annotations
    11	
    12	import sqlite3
    13	
    14	from planner.core import links as core_links
    15	from planner.tickets.contracts import AtCap, Ticket
    16	from planner.tickets.logic import fields_codec, machine
    17	
    18	
    19	def is_runnable(conn: sqlite3.Connection, ticket: Ticket) -> bool:
    20	    """True iff the ticket's next agent step should run: not terminal; has a gating field
    21	    (``needs_review`` is human-approve-only, no agent step); no proposal already parked on
    22	    the gating field awaiting a human; the grant permits a proposal (not at/beyond the
    23	    ceiling with ``at_cap=stop`` — mirrors ``admission.check_agent_proposal``); and not
    24	    blocked by an open ``blocks`` link."""
    25	    if machine.is_terminal(ticket.state):
    26	        return False
    27	    gating = machine.gating_field(ticket.state)
    28	    if gating is None:  # needs_review — the human approves it to done
    29	        return False
    30	    if fields_codec.get_slot(ticket.fields, gating).proposal is not None:
    31	        return False  # parked awaiting a human decision
    32	    if machine.at_or_beyond_ceiling(ticket.state, ticket.ceiling) and ticket.at_cap is AtCap.stop:
    33	        return False  # the grant says stop here
    34	    if core_links.is_blocked(conn, ticket.id):
    35	        return False
    36	    return True

