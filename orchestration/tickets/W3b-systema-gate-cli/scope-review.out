   120	        if self._thread is not None:
   121	            raise RuntimeError("System A already started")
   122	        self._thread = threading.Thread(
   123	            target=self._run_loop, args=(interval,), name="system-a", daemon=True
   124	        )
   125	        self._thread.start()
   126	
   127	    def stop(self) -> None:
   128	        """Signal the loop to exit and join it (no new set-offs after this returns). In-flight
   129	        MindQueue runs are daemon threads, abandoned on process exit (as in W1/W3a)."""
   130	        self._stop.set()
   131	        self._wake.set()
   132	        thread = self._thread
   133	        if thread is not None:
   134	            thread.join(timeout=10.0)
   135	            self._thread = None
   136	
   137	    def _run_loop(self, interval: int) -> None:
   138	        while not self._stop.is_set():
