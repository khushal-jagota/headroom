    29	_log = logging.getLogger(__name__)
    30	
    31	# The candidate set: tickets ON TODAY'S day (owner ruling — backlog / other-day tickets are not
    32	# auto-started) whose run status MIGHT need the next step set off, non-terminal. The day_tickets
    33	# join scopes it; the status IN (...) excludes agent_working (running) and errored (stopped +
    34	# surfaced; no auto-retry); state NOT IN excludes the two terminals. A candidate-only result set,
    35	# not a per-tick full-table unpack.
    36	_CANDIDATE_SQL = (
    37	    "SELECT t.id FROM tickets t "
    38	    "JOIN day_tickets dt ON dt.ticket_id = t.id "
    39	    "WHERE dt.day_id = ? "
    40	    "AND t.status IN ('empty','awaiting_approval') AND t.state NOT IN ('done','dropped')"
    41	)
    42	
    43	
    44	def _next_step_prompt(ticket: Ticket) -> str:
    45	    """The next-step prompt handed to the mind. Minimal on purpose — the "how to work a
    46	    ticket" intelligence lives in the worker role skill (loaded at kickoff), not here. Never
    47	    carries approval machinery (notes.md Principles: approval is invisible to the model)."""
    48	    gating = machine.gating_field(ticket.state)
    49	    field = gating.value if gating is not None else "the next step"
    50	    return (
    51	        f"Work ticket {ticket.id} — {ticket.title}. It is in state '{ticket.state.value}'; "
    52	        f"take the next step and propose the '{field}' field for approval."
    53	    )
    54	
    55	
    56	class SystemA:
    57	    """Readiness poll + fast path. Drives System B; never writes state."""
    58	
    59	    def __init__(
    60	        self,
    61	        db_path: str,
