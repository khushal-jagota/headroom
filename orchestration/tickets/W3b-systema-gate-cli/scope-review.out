    71	        self._system_b = system_b
    72	        self._role = role
    73	        self._boundary_hour = boundary_hour  # resolves "today" for the day-scoped candidate query
    74	        self._busy_timeout_ms = busy_timeout_ms
    75	        self._wake = threading.Event()
