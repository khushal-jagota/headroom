+        raise AssertionError("guard should have skipped before spawning")
+
+    sb = SystemB(db, RealClock(), home=HOME, hermes_python=HERMES_PY, spawn=_boom)
+    sb.set_off(tid, ROLE, "step", guard=readiness.is_runnable)
