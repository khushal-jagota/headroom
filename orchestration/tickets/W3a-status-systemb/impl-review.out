     1	"""Request context and the agent/human write boundary. Reads the X-Plan-Actor
     2	header, classifies each request as an agent (any actor header) or the human (no
     3	header), and gates human-only actions/fields.
     4	
     5	The old claim mechanism (X-Plan-Run-Id / X-Plan-Claim + per-request claim
     6	validation against a ticket lease) is gone: the ticket's code-owned `status` field
     7	is the lock now, and agents are trusted on this single-user local planner (no hard
     8	claim barrier). What survives is the invisible-approval boundary — agents still may
     9	not perform human-only actions (accept/approve/grant/state/drop, human-only fields).
    10	
    11	FastAPI appears here because this is part of the server shell (the server.py
    12	family), not a logic or data module."""
    13	
    14	from __future__ import annotations
    15	
    16	from collections.abc import Collection, Iterable
    17	from dataclasses import dataclass
    18	from typing import Final
    19	
    20	from fastapi import Request
    21	
    22	from planner.core.errors import ErrorCode, PlannerError
    23	
    24	X_PLAN_ACTOR: Final = "X-Plan-Actor"
    25	_DEFAULT_AGENT_ACTOR: Final = "agent"    # PLAN_ACTOR default "agent"
    26	_HUMAN_ACTOR: Final = "human"
    27	
    28	
    29	@dataclass(frozen=True)
    30	class RequestContext:
    31	    actor: str
    32	    is_human: bool
    33	
    34	
    35	def _normalize(raw: str | None) -> str | None:
    36	    """strip(); an empty or whitespace-only header is an absent header."""
    37	    if raw is None:
    38	        return None
    39	    stripped = raw.strip()
    40	    return stripped or None
    41	
    42	
    43	def _classify(actor: str | None) -> RequestContext:
    44	    """An X-Plan-Actor header ⇒ an agent request; no header ⇒ the human (UI requests
    45	    carry no agent header)."""
    46	    if actor is not None:
    47	        return RequestContext(actor=actor, is_human=False)
    48	    return RequestContext(actor=_HUMAN_ACTOR, is_human=True)
    49	
    50	
    51	def request_context(request: Request) -> RequestContext:
    52	    """FastAPI dependency: reads X-Plan-Actor, normalizes, classifies. No DB, no clock."""
    53	    return _classify(_normalize(request.headers.get(X_PLAN_ACTOR)))
    54	
    55	
    56	def reject_agents(ctx: RequestContext) -> None:
    57	    """(H) routes: any agent-classified request is agent_forbidden."""
    58	    if ctx.is_human:
    59	        return None
    60	    raise PlannerError(
    61	        ErrorCode.agent_forbidden, "human-only action", {"actor": ctx.actor}
    62	    )
    63	
    64	
    65	def reject_agent_fields(
    66	    ctx: RequestContext, body_keys: Iterable[str], human_only_keys: Collection[str]
    67	) -> None:
    68	    """Field-level agent boundary for PATCH routes that expose both agent-permitted and
    69	    human-only keys (§8, §14): an agent-classified request that touches any human-only
    70	    field is agent_forbidden, naming the first offending field. Human requests pass
    71	    through untouched."""
    72	    if ctx.is_human:
    73	        return None
    74	    for key in body_keys:
    75	        if key in human_only_keys:
    76	            raise PlannerError(
    77	                ErrorCode.agent_forbidden,
    78	                "human-only field",
    79	                {"field": key, "actor": ctx.actor},
    80	            )
    81	    return None

