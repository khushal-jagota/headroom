     1	"""System B — the set-off / run primitive. "Run step N of ticket X": assemble the
     2	role env, drive W1's ``run_step`` (spawn a gateway child, create/resume the mind,
     3	submit one prompt, observe the single run-end), run the proposal-present invariant,
     4	and write the ticket's run-status. System B is the SOLE writer of ``tickets.status``
     5	(→ notes.md Principles: "code owns all state stamps; agents propose, one door writes").
     6	
     7	Serialization (W1/W3 binding carry-forwards):
     8	  * Continuing steps (a durable ``session_key`` exists) go through the per-session
     9	    ``MindQueue`` — its correctness property (at most one in-flight resume per
    10	    ``session_key``; the gateway's 4009 busy-guard is per-process only) is written
    11	    against the key.
    12	  * Kickoff / step-0 has no key yet, so the per-session queue cannot serialize two
    13	    step-0 runs. System B owns a per-``ticket_id`` kickoff lock for that case, and
    14	    RESOLVES the current stored key at execution time (not at ``set_off`` time): a
    15	    second same-ticket set_off blocks on the lock until the kickoff stores the key,
    16	    then re-resolves it and takes the continuing path — so two step-0 runs never both
    17	    ``session.create``.
    18	
    19	Kickoff = step 0 through the same ``run_step`` call; System B never special-cases
    20	fresh vs continuing beyond resolving the key. ``errored`` stops and surfaces (no
    21	auto-retry). System B is not wired into the running server in W3a — System A (the
    22	readiness poll that calls ``set_off``) is W3b; this is exercised by unit tests
    23	against ``minds/fake.py``."""
    24	
    25	from __future__ import annotations
    26	
    27	import logging
    28	import threading
    29	from dataclasses import dataclass
    30	from pathlib import Path
    31	
    32	from planner.core.clock import Clock
    33	from planner.core.db import connect
    34	from planner.minds.gateway import SpawnFn, spawn_popen
    35	from planner.minds.queue import MindQueue
    36	from planner.minds.runner import run_step
    37	from planner.tickets import data as tickets_data
    38	from planner.tickets.contracts import TicketStatus
    39	from planner.tickets.logic import fields_codec, machine
    40	
    41	_log = logging.getLogger(__name__)
    42	
    43	
    44	@dataclass
    45	class _Item:
    46	    ticket_id: str
    47	    role: str
    48	    prompt: str
    49	    done: threading.Event
    50	
    51	
    52	class SystemB:
    53	    """Set-off primitive + the sole writer of ticket run-status."""
    54	
    55	    def __init__(
    56	        self,
    57	        db_path: str,
    58	        clock: Clock,
    59	        *,
    60	        home: str | Path,
    61	        hermes_python: str | Path,
    62	        spawn: SpawnFn = spawn_popen,
    63	        busy_timeout_ms: int = 5000,
    64	    ) -> None:
    65	        self._db_path = db_path
    66	        self._clock = clock
    67	        self._home = home
    68	        self._python = hermes_python
    69	        self._spawn = spawn
    70	        self._busy_timeout_ms = busy_timeout_ms
    71	        self._queue: MindQueue[_Item] = MindQueue(self._run_by_key)
    72	        # per-ticket kickoff serialization (System B-owned; NOT folded into the queue)
    73	        self._klock = threading.Lock()
    74	        self._ticket_locks: dict[str, threading.Lock] = {}
    75	        # in-flight tracker so wait_idle covers both kickoff and continuing threads
    76	        self._cv = threading.Condition()
    77	        self._inflight = 0
    78	
    79	    # --- public API ---------------------------------------------------------
    80	
    81	    def set_off(self, ticket_id: str, role: str, prompt: str) -> None:
    82	        """Set off step N of a ticket. Async: spawns a daemon dispatch thread so the
    83	        caller (System A, W3b) never blocks on a multi-minute run."""
    84	        with self._cv:
    85	            self._inflight += 1
    86	        threading.Thread(
    87	            target=self._dispatch,
    88	            args=(ticket_id, role, prompt),
    89	            name=f"system-b-{ticket_id}",
    90	            daemon=True,
    91	        ).start()
    92	
    93	    def wait_idle(self, timeout: float | None = None) -> bool:
    94	        """Block until every set-off has fully settled (test helper)."""
    95	        with self._cv:
    96	            return self._cv.wait_for(lambda: self._inflight == 0, timeout)
    97	
    98	    # --- dispatch / serialization -------------------------------------------
    99	
   100	    def _dispatch(self, ticket_id: str, role: str, prompt: str) -> None:
   101	        try:
   102	            lock = self._ticket_lock(ticket_id)
   103	            lock.acquire()
   104	            try:
   105	                key = self._read_session_key(ticket_id)
   106	                if key is None:
   107	                    # kickoff/step-0: run under the lock; a concurrent same-ticket
   108	                    # set_off blocks here, then re-resolves the now-set key below.
   109	                    self._run(ticket_id, None, role, prompt)
   110	                    return
   111	            finally:
   112	                lock.release()
   113	            # continuing/step-N: current key known -> per-session queue.
   114	            item = _Item(ticket_id, role, prompt, threading.Event())
   115	            self._queue.submit(key, item)
   116	            item.done.wait()
   117	        except Exception:
   118	            _log.exception("system B dispatch failed (ticket=%s)", ticket_id)
   119	        finally:
   120	            with self._cv:
   121	                self._inflight -= 1
   122	                self._cv.notify_all()
   123	
   124	    def _run_by_key(self, key: str, item: _Item) -> None:
   125	        try:
   126	            self._run(item.ticket_id, key, item.role, item.prompt)
   127	        finally:
   128	            item.done.set()
   129	
   130	    def _ticket_lock(self, ticket_id: str) -> threading.Lock:
   131	        with self._klock:
   132	            lock = self._ticket_locks.get(ticket_id)
   133	            if lock is None:
   134	                lock = threading.Lock()
   135	                self._ticket_locks[ticket_id] = lock
   136	            return lock
   137	
   138	    def _read_session_key(self, ticket_id: str) -> str | None:
   139	        conn = connect(self._db_path, self._busy_timeout_ms)
   140	        try:
   141	            row = conn.execute(
   142	                "SELECT chat_session_key FROM tickets WHERE id = ?", (ticket_id,)
   143	            ).fetchone()
   144	            if row is None:
   145	                return None
   146	            value = row["chat_session_key"]
   147	            return str(value) if value is not None else None
   148	        finally:
   149	            conn.close()
   150	
   151	    # --- the step -----------------------------------------------------------
   152	
   153	    def _run(self, ticket_id: str, key: str | None, role: str, prompt: str) -> None:
   154	        """One step: agent_working (start write) -> run_step -> proposal-present
   155	        invariant -> awaiting_approval/errored (end write). Both writes go through the
   156	        single-door tickets_data.set_run_status; System B is the only caller."""
   157	        conn = connect(self._db_path, self._busy_timeout_ms)
   158	        try:
   159	            now = self._clock.now_unix()
   160	            # (1) start write: agent_working + worker, single atomic UPDATE.
   161	            tickets_data.set_run_status(
   162	                conn, ticket_id, status=TicketStatus.agent_working, worker=role, now=now
   163	            )
   164	            # (2) pre-run snapshot: the step the code asked for.
   165	            pre = tickets_data.read_ticket(conn, ticket_id)
   166	            pre_state = pre.state
   167	            pre_gating = machine.gating_field(pre_state)
   168	
   169	            # (3) run the mind (kickoff creates step 0; continuing resumes `key`).
   170	            result = run_step(
   171	                key, role, prompt, None, home=self._home, hermes_python=self._python,
   172	                spawn=self._spawn,
   173	            )
   174	
   175	            # (4) map RunResult + proposal-present invariant -> end status.
   176	            end_status = TicketStatus.errored
   177	            end_error: str | None = result.error
   178	            if result.status == "complete":
   179	                post = tickets_data.read_ticket(conn, ticket_id)
   180	                advanced = post.state != pre_state  # agent step only auto-accepts forward
   181	                parked = (
   182	                    pre_gating is not None
   183	                    and fields_codec.get_slot(post.fields, pre_gating).proposal is not None
   184	                )
   185	                if advanced or parked:
   186	                    end_status = TicketStatus.awaiting_approval
   187	                    end_error = None
   188	                else:
   189	                    end_error = "agent left no proposal — you haven't done your job"
   190	
   191	            # (5) end write: status + cleared worker + resolved durable key, one UPDATE.
   192	            tickets_data.set_run_status(
   193	                conn,
   194	                ticket_id,
   195	                status=end_status,
   196	                worker=None,
   197	                session_key=result.session_key,
   198	                error=end_error if end_status == TicketStatus.errored else None,
   199	                now=now,
   200	            )
   201	        finally:
   202	            conn.close()

