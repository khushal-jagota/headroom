   230	@router.post("/tickets")
   231	async def create_ticket(raw: dict[str, Any], conn: DbConn, ctx: Ctx, cfg: Cfg,
   232	                        clk: Clk) -> JsonDict:
   233	    body = _marshal_create_ticket(raw)
   234	    now = clk.now_unix()
   235	    priority = parse_enum(Priority, body["priority"], "priority") \
   236	        if body["priority"] is not None else Priority.P3
   237	    project = parse_enum(Project, body["project"], "project") \
   238	        if body["project"] is not None else None
   239	    ticket = tickets_data.create_ticket(
   240	        conn,
   241	        title=body["title"],
   242	        actor=ctx.actor,
   243	        now=now,
   244	        title_max_chars=TITLE_MAX_CHARS,
   245	        project=project,
   246	        priority=priority,
   247	        deadline=body["deadline"],
   248	        sprint_id=body["sprint_id"],
   249	        sprint_item_id=body["sprint_item_id"],
   250	    )
   251	    return tickets_views.ticket_json(ticket, now)
   252	
   253	
   254	@router.get("/tickets")
   255	async def list_tickets(conn: DbConn, clk: Clk, state: str | None = None,
   256	                       project: str | None = None, sprint_id: str | None = None,
   257	                       sprint_item_id: str | None = None) -> JsonDict:
   258	    state_enum = parse_enum(TicketState, state, "state") if state is not None else None
   259	    project_enum = parse_enum(Project, project, "project") if project is not None else None
   260	    return {
   261	        "tickets": tickets_views.list_tickets(
   262	            conn,
   263	            clk.now_unix(),
   264	            state=state_enum,
   265	            project=project_enum,
   266	            sprint_id=sprint_id,
   267	            sprint_item_id=sprint_item_id,
   268	        )
   269	    }
