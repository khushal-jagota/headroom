    69	        prompt = (
    70	            "You are the planning boundary judgment. Reply with exactly one JSON "
    71	            'object {"focus": string, "brief_take": string, "watchout": string, '
    72	            '"if_today_lands": string} and nothing else. Inputs: '
    73	            + json.dumps(asdict(inputs))
    74	        )
    75	        payload = _parse_json_object(self._invoke(prompt))
    76	        return BoundaryJudgment(
    77	            focus=str(payload["focus"]),
    78	            brief_take=str(payload["brief_take"]),
    79	            watchout=str(payload["watchout"]),
    80	            if_today_lands=str(payload["if_today_lands"]),
    81	        )
