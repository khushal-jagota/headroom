    46	  blocked_by          TEXT NOT NULL DEFAULT '[]',    -- JSON list[str] of ticket ids
    47	  status_proposal     TEXT,                          -- JSON ItemStatusProposal | NULL
    48	  created_at          INTEGER NOT NULL,
    49	  updated_at          INTEGER NOT NULL
    50	);
    51	
    52	CREATE TABLE IF NOT EXISTS tickets (
    53	  id                   TEXT PRIMARY KEY,             -- t_<slug>
    54	  title                TEXT NOT NULL CHECK (length(title) <= 200),
    55	  state                TEXT NOT NULL DEFAULT 'needs_success'
    56	                       CHECK (state IN ('needs_success','needs_approach','needs_plan',
    57	                                        'in_progress','needs_review','done','dropped')),
    58	  priority             TEXT NOT NULL DEFAULT 'P3' CHECK (priority IN ('P0','P1','P2','P3')),
    59	  deadline             TEXT,
    60	  project              TEXT CHECK (project IN ('Vylo','Tribe','Learning','Other')),  -- NULL when parented
    61	  sprint_item_id       TEXT REFERENCES sprint_items(id),
    62	  sprint_id            TEXT REFERENCES sprints(id),  -- writable only when sprint_item_id IS NULL
    63	  recap                TEXT NOT NULL DEFAULT '',
    64	  ceiling              TEXT NOT NULL DEFAULT 'needs_success'
    65	                       CHECK (ceiling IN ('needs_success','needs_approach','needs_plan',
    66	                                          'in_progress','needs_review','done')),
    67	  at_cap               TEXT NOT NULL DEFAULT 'propose' CHECK (at_cap IN ('stop','propose')),
    68	  status               TEXT NOT NULL DEFAULT 'empty'  -- code-owned run status (System B is the writer)
    69	                       CHECK (status IN ('empty','agent_working','awaiting_approval','errored')),
    70	  worker               TEXT,                         -- who/what is working it; NULL unless agent_working
    71	  chat_session_key     TEXT,                         -- the ticket-mind's durable Hermes session_key
    72	  alias                TEXT,                         -- migration "Ticket ID:" (seed importer dedup)
    73	  fields               TEXT NOT NULL DEFAULT '{"success":{"value":null,"proposal":null,"notes":null},"approach":{"value":null,"proposal":null,"notes":null},"plan":{"value":null,"proposal":null,"notes":null},"result":{"value":null,"proposal":null,"notes":null}}',
    74	  created_at           INTEGER NOT NULL,
    75	  updated_at           INTEGER NOT NULL
    76	);
    77	CREATE UNIQUE INDEX IF NOT EXISTS idx_tickets_alias ON tickets(alias) WHERE alias IS NOT NULL;
    78	CREATE INDEX IF NOT EXISTS idx_tickets_state ON tickets(state);
    79	
    80	CREATE TABLE IF NOT EXISTS days (
    81	  id               TEXT PRIMARY KEY,                 -- day_YYYY-MM-DD (planning date, §3.4)
    82	  focus            TEXT NOT NULL DEFAULT '',         -- overview: the one-line hero (plain text)
    83	  brief_take       TEXT NOT NULL DEFAULT '',         -- overview: Brief Take (markdown)
    84	  watchout         TEXT NOT NULL DEFAULT '',         -- overview: Watchout (markdown)
    85	  if_today_lands   TEXT NOT NULL DEFAULT '',         -- overview: If Today Lands (markdown)
    86	  notes            TEXT NOT NULL DEFAULT '',
    87	  chat_session_key TEXT,
    88	  created_at       INTEGER NOT NULL,
    89	  updated_at       INTEGER NOT NULL
    90	);
    91	
    92	CREATE TABLE IF NOT EXISTS day_tickets (
    93	  day_id    TEXT NOT NULL REFERENCES days(id),
    94	  ticket_id TEXT NOT NULL REFERENCES tickets(id),
    95	  position  INTEGER NOT NULL CHECK (position >= 0),  -- contiguous from 0, writer-enforced
    96	  PRIMARY KEY (day_id, ticket_id)
    97	);
    98	
    99	CREATE TABLE IF NOT EXISTS ideas (
   100	  id         TEXT PRIMARY KEY,                       -- idea_<slug>
   101	  title      TEXT NOT NULL,
   102	  body       TEXT NOT NULL DEFAULT '',
   103	  project    TEXT CHECK (project IN ('Vylo','Tribe','Learning','Other')),  -- nullable (§3.5)
   104	  created_at INTEGER NOT NULL,
   105	  updated_at INTEGER NOT NULL
   106	);
   107	
   108	CREATE TABLE IF NOT EXISTS links (                   -- §3.6, exactly the spec's three columns
   109	  from_id TEXT NOT NULL,
   110	  to_id   TEXT NOT NULL,
   111	  kind    TEXT NOT NULL CHECK (kind IN ('belongs_to','parent_child','blocks','relates')),
   112	  PRIMARY KEY (from_id, to_id, kind),
   113	  CHECK (from_id <> to_id)
   114	);
   115	CREATE UNIQUE INDEX IF NOT EXISTS idx_links_one_belongs_to
   116	  ON links(from_id) WHERE kind = 'belongs_to';       -- at most one belongs_to per ticket
   117	CREATE INDEX IF NOT EXISTS idx_links_to ON links(to_id, kind);
   118	
   119	CREATE TABLE IF NOT EXISTS events (                  -- §3, append-only
   120	  id         INTEGER PRIMARY KEY AUTOINCREMENT,
   121	  entity_id  TEXT NOT NULL,
   122	  kind       TEXT NOT NULL,
   123	  payload    TEXT NOT NULL DEFAULT '{}',             -- JSON
   124	  created_at INTEGER NOT NULL
   125	);
   126	CREATE INDEX IF NOT EXISTS idx_events_entity ON events(entity_id, id);
   127	"""
   128	
   129	
   130	def connect(db_path: str, busy_timeout_ms: int = 5000) -> sqlite3.Connection:
   131	    conn = sqlite3.connect(db_path, isolation_level=None)
   132	    conn.row_factory = sqlite3.Row
   133	    conn.execute("PRAGMA journal_mode=WAL")
   134	    conn.execute("PRAGMA foreign_keys=ON")
   135	    conn.execute(f"PRAGMA busy_timeout={int(busy_timeout_ms)}")
   136	    return conn
   137	
   138	
   139	def create_schema(conn: sqlite3.Connection) -> None:
   140	    conn.executescript(DDL)
   141	    conn.execute(f"PRAGMA user_version={SCHEMA_VERSION}")

