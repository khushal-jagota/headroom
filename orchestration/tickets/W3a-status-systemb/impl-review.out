    42	    def send(self, session_key: str | None, entity_id: str, text: str) -> ChatSendResult:
    43	        self.calls.append((session_key, entity_id, text))
    44	        if session_key is None:
    45	            session_key = f"fake-sess-{self.next_session}"
    46	            self.next_session += 1
    47	        return ChatSendResult(reply_text=f"echo: {text}", session_key=session_key)
