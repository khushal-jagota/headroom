     1	"""Scriptable fake gateway child (test double). Implements the ChildProcess
     2	protocol so runner/queue/gateway tests exercise the real frame router with
     3	no subprocess and no model calls."""
     4	
     5	from __future__ import annotations
     6	
     7	import json
     8	import queue
     9	import threading
    10	from collections import deque
    11	from collections.abc import Mapping, Sequence
    12	from dataclasses import dataclass
    13	
    14	from planner.minds.gateway import ChildProcess, JsonDict
    15	
    16	
    17	def ev(type_: str, session_id: str | None = None, payload: JsonDict | None = None) -> JsonDict:
    18	    """Build an event frame exactly as server.py _emit does (server.py:803-807):
    19	    the payload key is OMITTED when payload is None; session_id omitted when None
    20	    (gateway.ready is the only such event — entry.py:316-322)."""
    21	    params: JsonDict = {"type": type_}
    22	    if session_id is not None:
    23	        params["session_id"] = session_id
    24	    if payload is not None:
    25	        params["payload"] = payload
    26	    return {"jsonrpc": "2.0", "method": "event", "params": params}
    27	
    28	
    29	@dataclass(frozen=True)
    30	class Reply:
    31	    result: JsonDict | None = None  # -> {"jsonrpc":"2.0","id":<rid>,"result":...}
    32	    error: tuple[int, str] | None = None  # -> {"jsonrpc":"2.0","id":<rid>,"error":{...}}
    33	    events_before: tuple[JsonDict, ...] = ()  # event frames written BEFORE the response
    34	    events_after: tuple[JsonDict, ...] = ()  # event frames written AFTER the response
    35	    frames: tuple[JsonDict | str, ...] = ()  # raw frames (dict) or raw lines (str), written last
    36	    die: bool = False  # then: stdout EOF (child death)
    37	
    38	    def __post_init__(self) -> None:
    39	        if self.result is not None and self.error is not None:
    40	            raise ValueError("Reply cannot carry both result and error")
    41	
    42	
    43	class FakeGateway:
    44	    """One scriptable fake child. Build one per child; run_step spawns exactly one."""
    45	
    46	    def __init__(
    47	        self,
    48	        script: Mapping[str, Sequence[Reply]],
    49	        *,
    50	        ready: bool = True,
    51	        stderr_lines: Sequence[str] = (),
    52	    ) -> None:
    53	        self._script: dict[str, deque[Reply]] = {
    54	            method: deque(replies) for method, replies in script.items()
    55	        }
    56	        self._out: queue.Queue[str | None] = queue.Queue()
    57	        self._err: queue.Queue[str | None] = queue.Queue()
    58	        for line in stderr_lines:
    59	            self._err.put(line)
    60	        if ready:
    61	            self._out.put(json.dumps(ev("gateway.ready", None, {"skin": "fake"})))
    62	        self._sent_cond = threading.Condition()
    63	        self._exited = threading.Event()
    64	        self._dead = threading.Event()
    65	        # assertion surface
    66	        self.sent: list[JsonDict] = []
    67	        self.argv: list[str] | None = None
    68	        self.env: dict[str, str] | None = None
    69	        self.closed: bool = False
    70	
    71	    # the spawn hook to inject: GatewayChild(..., spawn=fake.spawn)
    72	    def spawn(self, argv: list[str], env: dict[str, str]) -> ChildProcess:
    73	        self.argv = list(argv)
    74	        self.env = dict(env)
    75	        return self
    76	
    77	    # --- ChildProcess protocol --------------------------------------------
    78	
    79	    def send(self, line: str) -> None:
    80	        if self.closed or self._dead.is_set():
    81	            raise BrokenPipeError("fake stdin closed")
    82	        frame: JsonDict = json.loads(line)
    83	        with self._sent_cond:
    84	            self.sent.append(frame)
    85	            self._sent_cond.notify_all()
    86	        method = frame.get("method")
    87	        rid = frame.get("id")
    88	        replies = self._script.get(method) if isinstance(method, str) else None
    89	        if replies is None or len(replies) == 0:
    90	            # unscripted or exhausted → fail loud but structured (mirrors server.py:910)
    91	            self._out.put(
    92	                json.dumps(
    93	                    {
    94	                        "jsonrpc": "2.0",
    95	                        "id": rid,
    96	                        "error": {"code": -32601, "message": f"unknown method: {method}"},
    97	                    }
    98	                )
    99	            )
   100	            return
   101	        reply = replies.popleft()
   102	        for frame_before in reply.events_before:
   103	            self._out.put(json.dumps(frame_before))
   104	        if reply.result is not None:
   105	            self._out.put(json.dumps({"jsonrpc": "2.0", "id": rid, "result": reply.result}))
   106	        elif reply.error is not None:
   107	            code, message = reply.error
   108	            self._out.put(
   109	                json.dumps(
   110	                    {"jsonrpc": "2.0", "id": rid, "error": {"code": code, "message": message}}
   111	                )
   112	            )
   113	        for frame_after in reply.events_after:
   114	            self._out.put(json.dumps(frame_after))
   115	        for raw in reply.frames:
   116	            self._out.put(raw if isinstance(raw, str) else json.dumps(raw))
   117	        if reply.die:
   118	            self._die()
   119	
   120	    def read_stdout(self) -> str | None:
   121	        item = self._out.get()
   122	        if item is None:
   123	            self._out.put(None)
   124	            return None
   125	        return item
   126	
   127	    def read_stderr(self) -> str | None:
   128	        item = self._err.get()
   129	        if item is None:
   130	            self._err.put(None)
   131	            return None
   132	        return item
   133	
   134	    def close_stdin(self) -> None:
   135	        self.closed = True
   136	        if not self._dead.is_set():
   137	            self._die()  # real gateway exits on stdin EOF (entry.py:344)
   138	
   139	    def kill(self) -> None:
   140	        self.closed = True
   141	        self._die()
   142	
   143	    def wait(self, timeout: float | None = None) -> int | None:
   144	        return 0 if self._exited.wait(timeout) else None
   145	
   146	    # --- internal ----------------------------------------------------------
   147	
   148	    def _die(self) -> None:
   149	        if self._dead.is_set():
   150	            return
   151	        self._dead.set()
   152	        self._exited.set()
   153	        self._err.put(None)
   154	        self._out.put(None)
   155	
   156	    # --- assertion helpers -------------------------------------------------
   157	
   158	    def sent_methods(self) -> list[str]:
   159	        return [str(frame.get("method")) for frame in self.sent]
   160	
   161	    def wait_sent(self, count: int, timeout: float = 5.0) -> bool:
   162	        with self._sent_cond:
   163	            return self._sent_cond.wait_for(lambda: len(self.sent) >= count, timeout)

