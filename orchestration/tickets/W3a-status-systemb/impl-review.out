    64	        self._stdin = proc.stdin
    65	        self._stdout = proc.stdout
    66	        self._stderr = proc.stderr
    67	
    68	    def send(self, line: str) -> None:
    69	        self._stdin.write(line)
    70	        self._stdin.flush()
    71	
    72	    def read_stdout(self) -> str | None:
    73	        line = self._stdout.readline()
