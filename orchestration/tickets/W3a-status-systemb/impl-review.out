    40	def send(
    41	    method: str,
    42	    path: str,
    43	    *,
    44	    as_json: bool,
    45	    json_body: Any | None = None,
    46	    params: dict[str, Any] | None = None,
    47	) -> Any:
    48	    """Execute one request and apply the failure half of the exit contract. Transport
    49	    failure -> stderr + exit 2. Non-2xx (or a 2xx body that still carries an "error"
    50	    key) -> stderr + exit 1. On 2xx: return the parsed JSON body to the caller."""
    51	    try:
    52	        resp = httpx.request(
    53	            method, _url(path), json=json_body, params=params, headers=_headers(),
    54	            timeout=_TIMEOUT,
    55	        )
    56	    except httpx.TransportError as exc:
    57	        _fail_connection(exc, as_json)
    58	    try:
    59	        data: Any = resp.json()
    60	    except ValueError:
    61	        data = None
    62	    if resp.is_success:
    63	        if isinstance(data, dict) and "error" in data:
    64	            _fail_response(resp, data, as_json)  # A1: unconditional error-envelope contract
    65	        return data
    66	    _fail_response(resp, data, as_json)
