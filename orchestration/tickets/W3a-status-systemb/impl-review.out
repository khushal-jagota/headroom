    41	class RealBoundaryAdapter:
    42	    def __init__(self, config: Config) -> None:
    43	        self._config = config
    44	
    45	    def _invoke(self, prompt: str) -> str:
    46	        """Run hermes non-interactively. The CALLER owns the timeout (no subprocess
    47	        timeout here); a non-zero exit raises."""
    48	        result = subprocess.run(
    49	            [
    50	                self._config.hermes_bin,
    51	                "-p",
    52	                self._config.hermes_profile,
    53	                "--skills",
    54	                BOUNDARY_SKILL,
    55	                "chat",
    56	                "-q",
    57	                prompt,
    58	            ],
    59	            capture_output=True,
    60	            text=True,
    61	            check=False,
    62	        )
    63	        if result.returncode != 0:
    64	            tail = result.stderr.strip()[-500:]
    65	            raise RuntimeError(f"hermes exited {result.returncode}: {tail}")
    66	        return result.stdout
