   102	        argv,
   103	        stdin=subprocess.PIPE,
   104	        stdout=subprocess.PIPE,
   105	        stderr=subprocess.PIPE,
   106	        text=True,
   107	        bufsize=1,
   108	        env=env,
   109	    )
   110	    return PopenChild(proc)
