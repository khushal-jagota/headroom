    55	class PopenChild:
    56	    """Real ChildProcess backed by a subprocess.Popen in text/line-buffered mode."""
    57	
    58	    def __init__(self, proc: subprocess.Popen[str]) -> None:
    59	        # PIPEs by construction (see spawn_popen); assert once, store typed refs.
    60	        assert proc.stdin is not None
    61	        assert proc.stdout is not None
    62	        assert proc.stderr is not None
