    81	    """Client-side validation error, rendered in the same style as a server error. exit 1."""
    82	    payload = {"error": {"code": "validation", "message": message, "detail": detail or {}}}
    83	    if as_json:
    84	        print(json.dumps(payload), file=sys.stderr)
    85	    else:
    86	        print(f"error: validation: {message}", file=sys.stderr)
    87	    sys.exit(EXIT_ERROR)
