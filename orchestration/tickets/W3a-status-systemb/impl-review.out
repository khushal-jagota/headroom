   121	class GatewayChild:
   122	    """One gateway child + its frame router (reader thread, pending table, event queue)."""
   123	
   124	    def __init__(
   125	        self,
   126	        hermes_python: str,
   127	        env: Mapping[str, str],
   128	        *,
   129	        spawn: SpawnFn = spawn_popen,
   130	        stderr_tail_lines: int = STDERR_TAIL_LINES,
   131	    ) -> None:
   132	        argv = [hermes_python, "-m", "tui_gateway.entry"]
   133	        try:
   134	            self._child: ChildProcess = spawn(argv, dict(env))
   135	        except OSError as exc:
   136	            raise GatewayError(f"failed to spawn gateway child: {exc}") from exc
   137	        self._pending: dict[int, _Pending] = {}
   138	        self._lock = threading.Lock()
   139	        self._next_id = 1
   140	        self._events: queue.Queue[JsonDict | None] = queue.Queue()
   141	        self._ready_gate = threading.Event()
   142	        self._ready_seen = False
   143	        self._dead = threading.Event()
   144	        self._stderr_lines: deque[str] = deque(maxlen=stderr_tail_lines)
   145	        self._stdout_thread = threading.Thread(
   146	            target=self._stdout_loop, name="minds-gw-stdout", daemon=True
   147	        )
   148	        self._stderr_thread = threading.Thread(
   149	            target=self._stderr_loop, name="minds-gw-stderr", daemon=True
   150	        )
   151	        self._stdout_thread.start()
   152	        self._stderr_thread.start()
   153	
   154	    # --- reader threads ----------------------------------------------------
   155	
   156	    def _stdout_loop(self) -> None:
   157	        while True:
   158	            line = self._child.read_stdout()
   159	            if line is None:
   160	                break
   161	            line = line.strip()
   162	            if not line:
   163	                continue
   164	            try:
   165	                frame = json.loads(line)
   166	            except json.JSONDecodeError:
   167	                continue  # tolerate garbage; stdout is JSON-only per server.py:203-207
   168	            if not isinstance(frame, dict):
   169	                continue
   170	            if frame.get("method") == "event":
   171	                raw = frame.get("params")
   172	                params: JsonDict = raw if isinstance(raw, dict) else {}
   173	                if params.get("type") == "gateway.ready":  # entry.py:316-322 — no session_id
   174	                    self._ready_seen = True
   175	                    self._ready_gate.set()
   176	                    continue
   177	                self._events.put(params)  # ALL other events, known or unknown, enqueue
   178	                continue
   179	            rid = frame.get("id")
   180	            if rid is not None and ("result" in frame or "error" in frame):
   181	                with self._lock:
   182	                    pending = self._pending.pop(rid, None)
   183	                if pending is not None:
   184	                    pending.frame = frame
   185	                    pending.done.set()
   186	            # else: ignore — e.g. -32700 parse-error frames carry id null, uncorrelatable
   187	        self._on_child_dead()
   188	
   189	    def _on_child_dead(self) -> None:
   190	        self._dead.set()
   191	        with self._lock:
   192	            pending = list(self._pending.values())
   193	            self._pending.clear()
   194	        for entry in pending:
   195	            entry.done.set()  # frame stays None -> waiter raises child-died
   196	        self._ready_gate.set()  # wakes wait_ready, which checks _ready_seen first
   197	        self._events.put(None)  # wakes an event drainer
   198	
   199	    def _stderr_loop(self) -> None:
   200	        while True:
   201	            line = self._child.read_stderr()
   202	            if line is None:
   203	                break
   204	            self._stderr_lines.append(line.rstrip("\n"))
   205	
   206	    # --- public API --------------------------------------------------------
   207	
   208	    def wait_ready(self, timeout: float = READY_TIMEOUT_DEFAULT) -> None:
   209	        if not self._ready_gate.wait(timeout):
   210	            raise GatewayError(
   211	                f"gateway.ready not received within {timeout}s; stderr: {self.stderr_tail()!r}"
   212	            )
   213	        if not self._ready_seen:  # gate was set by death
   214	            raise GatewayError(
   215	                f"gateway child exited before ready; stderr: {self.stderr_tail()!r}"
   216	            )
   217	
   218	    def request(
   219	        self,
   220	        method: str,
   221	        params: JsonDict | None = None,
   222	        *,
   223	        timeout: float = REQUEST_TIMEOUT_DEFAULT,
   224	    ) -> JsonDict:
   225	        if self._dead.is_set():
   226	            raise GatewayError(f"gateway child is dead; cannot send {method}")
   227	        with self._lock:
   228	            rid = self._next_id
   229	            self._next_id += 1
   230	            pending = _Pending()
   231	            self._pending[rid] = pending
   232	        frame: JsonDict = {"jsonrpc": "2.0", "id": rid, "method": method}
   233	        if params is not None:
   234	            frame["params"] = params
   235	        try:
   236	            self._child.send(json.dumps(frame) + "\n")
   237	        except OSError as exc:  # BrokenPipeError is an OSError
   238	            with self._lock:
   239	                self._pending.pop(rid, None)
   240	            raise GatewayError(f"gateway stdin write failed for {method}: {exc}") from exc

