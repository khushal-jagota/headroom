    26	
    27	def _parse_json_object(text: str) -> dict[str, Any]:
    28	    """Slice the first ``{`` to the last ``}`` inclusive and parse. All failures
    29	    raise; the caller event-logs them (RD-16)."""
    30	    start = text.find("{")
    31	    end = text.rfind("}")
    32	    if start == -1 or end == -1 or end < start:
    33	        raise ValueError("no JSON object in hermes output")
    34	    parsed = json.loads(text[start : end + 1])
    35	    if not isinstance(parsed, dict):
    36	        raise ValueError("hermes output is not a JSON object")
    37	    result: dict[str, Any] = parsed
    38	    return result
