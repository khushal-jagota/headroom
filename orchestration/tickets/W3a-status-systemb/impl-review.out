    65	# §8: agents drive priority/deadline/day/sprint via `ticket set`; title and project are
    66	# human-only, so an agent-classified PATCH touching them is agent_forbidden (§14).
    67	_TICKET_HUMAN_ONLY_FIELDS = ("title", "project")
    68	
    69	
    70	# --- shared plumbing (imported by the other api modules) -----------------------
    71	
    72	
    73	def get_config(request: Request) -> Config:
    74	    return cast(Config, request.app.state.config)
    75	
    76	
    77	def get_clock(request: Request) -> Clock:
    78	    return cast(Clock, request.app.state.clock)
    79	
    80	
    81	async def db_conn(request: Request) -> AsyncIterator[sqlite3.Connection]:
    82	    conn = cast(Callable[[], sqlite3.Connection], request.app.state.conn_factory)()
    83	    try:
    84	        yield conn
    85	    finally:
    86	        conn.close()
    87	
    88	
    89	DbConn = Annotated[sqlite3.Connection, Depends(db_conn)]
    90	Ctx = Annotated[RequestContext, Depends(request_context)]
    91	Cfg = Annotated[Config, Depends(get_config)]
    92	Clk = Annotated[Clock, Depends(get_clock)]
    93	
    94	
    95	@contextmanager
    96	def txn(conn: sqlite3.Connection) -> Iterator[None]:
    97	    """Wrap a NON-self-transacting writer (days/dispatch/links) so a mid-sequence
    98	    PlannerError rolls back cleanly. Never wrap a ticket/sprint writer — those open
    99	    their own BEGIN IMMEDIATE and would raise 'transaction within a transaction'."""
   100	    conn.execute("BEGIN IMMEDIATE")
   101	    try:
   102	        yield
   103	    except BaseException:
   104	        conn.execute("ROLLBACK")
   105	        raise
   106	    else:
   107	        conn.execute("COMMIT")
   108	
   109	
   110	def parse_enum[E: StrEnum](enum_cls: type[E], raw: str, what: str) -> E:
   111	    try:
   112	        return enum_cls(raw)
   113	    except ValueError:
   114	        raise PlannerError(ErrorCode.validation, f"invalid {what}", {what: raw}) from None
   115	
   116	
   117	def body_str(body: JsonDict, key: str, default: str = "") -> str:
   118	    """Marshal an optional string body key: absent -> default; null or non-string ->
   119	    the validation envelope. Unknown keys are ignored by the callers, matching the
   120	    §14 body shapes."""
   121	    raw = body.get(key, default)
   122	    if not isinstance(raw, str):
   123	        raise PlannerError(ErrorCode.validation, f"invalid {key}", {key: raw})
   124	    return raw
   125	
   126	
   127	def body_opt_str(body: JsonDict, key: str) -> str | None:
   128	    raw = body.get(key)
   129	    if raw is None:
   130	        return None
   131	    if not isinstance(raw, str):
   132	        raise PlannerError(ErrorCode.validation, f"invalid {key}", {key: raw})
   133	    return raw
   134	
   135	
   136	# --- request-body marshallers (contract shapes in tickets/contracts.py) ---------
   137	
   138	
   139	def _marshal_create_ticket(raw: JsonDict) -> CreateTicketBody:
   140	    return CreateTicketBody(
   141	        title=body_str(raw, "title"),
   142	        priority=body_opt_str(raw, "priority"),
   143	        deadline=body_opt_str(raw, "deadline"),
   144	        project=body_opt_str(raw, "project"),
   145	        sprint_id=body_opt_str(raw, "sprint_id"),
   146	        sprint_item_id=body_opt_str(raw, "sprint_item_id"),
   147	    )
   148	
   149	
   150	def _marshal_accept(raw: JsonDict) -> AcceptBody:
   151	    return AcceptBody(
   152	        edited_body=body_opt_str(raw, "edited_body"),
   153	        next_ceiling=body_opt_str(raw, "next_ceiling"),
   154	        at_cap=body_opt_str(raw, "at_cap"),
   155	    )
   156	
   157	
   158	# --- grant marshallers ---------------------------------------------------------
   159	
   160	
   161	def _parse_next_ceiling(raw: str | None) -> NextCeiling | None:
   162	    if raw is None:
   163	        return None
   164	    if raw == NO_FURTHER:
   165	        return NO_FURTHER
   166	    try:
   167	        return TicketState(raw)
   168	    except ValueError:
   169	        raise PlannerError(
   170	            ErrorCode.grant_invalid, "unknown next_ceiling", {"next_ceiling": raw}
   171	        ) from None
   172	
   173	
   174	def _parse_grant_at_cap(raw: str | None) -> AtCap | None:
   175	    if raw is None:
   176	        return None
   177	    try:
   178	        return AtCap(raw)
   179	    except ValueError:
   180	        raise PlannerError(ErrorCode.grant_invalid, "unknown at_cap", {"at_cap": raw}) from None
   181	
   182	
   183	# --- private gap-fill writers (D2; A1: writer-shaped for relocation) ------------
   184	
   185	
   186	def _set_title(conn: sqlite3.Connection, ticket_id: str, title: str, *,
   187	               title_max_chars: int, now: int) -> Ticket:
   188	    admission.validate_title(title, title_max_chars)
   189	    with txn(conn):
   190	        ticket = tickets_data.read_ticket(conn, ticket_id)
   191	        prev = ticket.title
   192	        conn.execute(
   193	            "UPDATE tickets SET title = ?, updated_at = ? WHERE id = ?", (title, now, ticket_id)
   194	        )
   195	        append_event(
   196	            conn,
   197	            ticket_id,
   198	            EventKind.ticket_updated,
   199	            {"field": "title", "from": prev, "to": title},
   200	            now,
   201	        )
   202	        return tickets_data.read_ticket(conn, ticket_id)
   203	
   204	
   205	def _set_project(conn: sqlite3.Connection, ticket_id: str, project: Project | None, *,
   206	                 now: int) -> Ticket:
   207	    with txn(conn):
   208	        ticket = tickets_data.read_ticket(conn, ticket_id)
   209	        if ticket.sprint_item_id is not None:
   210	            raise PlannerError(ErrorCode.validation, "project is derived when parented")
   211	        prev = ticket.project.value if ticket.project is not None else None
   212	        new_value = project.value if project is not None else None
   213	        conn.execute(
   214	            "UPDATE tickets SET project = ?, updated_at = ? WHERE id = ?",
   215	            (new_value, now, ticket_id),
   216	        )
   217	        append_event(
   218	            conn,
   219	            ticket_id,
   220	            EventKind.ticket_updated,
   221	            {"field": "project", "from": prev, "to": new_value},
   222	            now,
   223	        )
   224	        return tickets_data.read_ticket(conn, ticket_id)
   225	
