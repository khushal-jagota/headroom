   233	@router.post("/tickets")
   234	async def create_ticket(raw: dict[str, Any], conn: DbConn, ctx: Ctx, cfg: Cfg,
   235	                        clk: Clk) -> JsonDict:
   236	    body = _marshal_create_ticket(raw)
   237	    now = clk.now_unix()
   238	    priority = parse_enum(Priority, body["priority"], "priority") \
   239	        if body["priority"] is not None else Priority.P3
   240	    project = parse_enum(Project, body["project"], "project") \
   241	        if body["project"] is not None else None
   242	    ticket = tickets_data.create_ticket(
   243	        conn,
   244	        title=body["title"],
   245	        actor=ctx.actor,
   246	        now=now,
   247	        title_max_chars=TITLE_MAX_CHARS,
   248	        project=project,
   249	        priority=priority,
   250	        deadline=body["deadline"],
   251	        sprint_id=body["sprint_id"],
   252	        sprint_item_id=body["sprint_item_id"],
   253	    )
   254	    return tickets_views.ticket_json(ticket, now)
