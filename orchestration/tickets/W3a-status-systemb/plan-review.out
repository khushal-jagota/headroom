    39	    text: str
    40	    usage: JsonDict | None
    41	    session_key: str | None
    42	    error: str | None
    43	
    44	
    45	def _notify(on_event: OnEvent | None, event: JsonDict) -> None:
    46	    if on_event is None:
    47	        return
    48	    try:
    49	        on_event(event)
    50	    except Exception:
    51	        logging.getLogger(__name__).exception("on_event observer failed")
    52	
    53	
    54	def run_step(
    55	    session_key: str | None,
    56	    role: str,
    57	    prompt_text: str,
    58	    on_event: OnEvent | None,
    59	    *,
    60	    home: str | Path,
    61	    hermes_python: str | Path,
    62	    context_env: Mapping[str, str] | None = None,
    63	    spawn: SpawnFn = spawn_popen,
    64	    ready_timeout: float = READY_TIMEOUT_DEFAULT,
    65	    request_timeout: float = REQUEST_TIMEOUT_DEFAULT,
    66	    base_env: Mapping[str, str] | None = None,
    67	) -> RunResult:
    68	    python = Path(hermes_python).expanduser()
    69	    env: dict[str, str] = dict(base_env if base_env is not None else os.environ)
    70	    env["HERMES_PYTHON_SRC_ROOT"] = str(hermes_src_root(python))  # entry.py:4-12 guard
    71	    env["HERMES_HOME"] = str(Path(home).expanduser())  # spike isolation probe
    72	    env["HERMES_TUI_SKILLS"] = role  # spike §2 Q2 — per-process role skill
    73	    if context_env:
    74	        env.update(context_env)  # kanban HERMES_KANBAN_* pattern
    75	
    76	    try:
    77	        child = GatewayChild(str(python), env, spawn=spawn)
    78	    except GatewayError as exc:
    79	        return RunResult("errored", "", None, session_key, f"spawn failed: {exc}")
    80	
    81	    resolved_key = session_key
    82	    try:
    83	        child.wait_ready(ready_timeout)
    84	        if session_key is None:
    85	            created = child.request(
    86	                "session.create",
    87	                {"source": SESSION_SOURCE, "cols": SESSION_COLS},
    88	                timeout=request_timeout,
    89	            )
    90	            live_sid = str(created.get("session_id") or "")
    91	            stored = created.get("stored_session_id")  # server.py:4417
    92	            resolved_key = str(stored) if stored else None
    93	        else:
    94	            resumed = child.request(
    95	                "session.resume", {"session_id": session_key}, timeout=request_timeout
    96	            )
    97	            live_sid = str(resumed.get("session_id") or "")  # NEW live handle
    98	            tip = resumed.get("resumed")  # durable key, maybe rotated tip
    99	            resolved_key = str(tip) if tip else session_key  # server.py:4612-4619, 4633
   100	        child.request(
   101	            "prompt.submit",
   102	            {"session_id": live_sid, "text": prompt_text},
   103	            timeout=request_timeout,
   104	        )  # {"status":"streaming"} — value unused
   105	        while True:  # D5: no deadline
   106	            event = child.next_event()
   107	            if event is None:
   108	                return RunResult(
   109	                    "errored",
   110	                    "",
   111	                    None,
   112	                    resolved_key,
   113	                    f"gateway child died mid-run; stderr: {child.stderr_tail()!r}",
   114	                )
   115	            _notify(on_event, event)  # D8: forward everything, guarded
   116	            etype = str(event.get("type") or "")
   117	            if etype == "error":
   118	                raw = event.get("payload")
   119	                payload = raw if isinstance(raw, dict) else {}
   120	                return RunResult(
   121	                    "errored",
   122	                    "",
   123	                    None,
   124	                    resolved_key,
   125	                    str(payload.get("message") or "gateway error event"),
   126	                )
   127	            if etype == "message.complete":
   128	                raw = event.get("payload")
   129	                payload = raw if isinstance(raw, dict) else {}
   130	                text = str(payload.get("text") or "")
   131	                usage_raw = payload.get("usage")
   132	                usage = usage_raw if isinstance(usage_raw, dict) else None
   133	                gw_status = str(payload.get("status") or "complete")
   134	                if gw_status == "complete":
   135	                    return RunResult("complete", text, usage, resolved_key, None)
   136	                if gw_status == "interrupted":
   137	                    return RunResult("interrupted", text, usage, resolved_key, None)
   138	                return RunResult(
   139	                    "errored",
   140	                    text,
   141	                    usage,
   142	                    resolved_key,
   143	                    text or "run ended with status=error",
   144	                )
   145	            # any other event type: forwarded above, otherwise ignored — keep draining
   146	    except GatewayRpcError as exc:
   147	        return RunResult("errored", "", None, resolved_key, str(exc))
   148	    except GatewayError as exc:
   149	        return RunResult("errored", "", None, resolved_key, str(exc))
   150	    finally:
   151	        child.shutdown()  # child ALWAYS reaped

