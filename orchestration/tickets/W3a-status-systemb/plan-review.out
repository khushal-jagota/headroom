   143	            build_test_router(config, clock, adapters, conn_factory), prefix="/api"
   144	        )
   145	
   146	    app.mount("/assets", StaticFiles(directory="assets"), name="assets")
   147	    app.mount("/static", StaticFiles(directory="static"), name="static")
   148	    return app

