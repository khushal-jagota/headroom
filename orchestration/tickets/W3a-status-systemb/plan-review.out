   469	def _validate_link_claim(conn: sqlite3.Connection, ctx: RequestContext,
   470	                         from_id: str, to_id: str, now: int) -> None:
   471	    """§7.6 for link writes: a claim-carrying request must hold the active claim on a
   472	    ticket endpoint of the link (either side — an agent may link its own ticket in
   473	    both directions). Non-ticket endpoints have no claim to validate against; a claim
   474	    matching neither ticket endpoint is rejected naming the from-side mismatch."""
   475	    if not ctx.is_claimed_agent:
   476	        return None
   477	    ticket_ids = [
   478	        entity_id
   479	        for entity_id in (from_id, to_id)
   480	        if conn.execute("SELECT 1 FROM tickets WHERE id = ?", (entity_id,)).fetchone()
   481	        is not None
   482	    ]
   483	    first_error: PlannerError | None = None
   484	    for ticket_id in ticket_ids:
   485	        try:
   486	            require_claim(conn, ctx, ticket_id, now)
   487	            return None
   488	        except PlannerError as exc:
   489	            if first_error is None:
   490	                first_error = exc
   491	    if first_error is not None:
   492	        raise first_error
   493	    return None
