   125	        return {
   126	            "ui_debounce_ms": config.ui_debounce_ms,
   127	            "ws_poll_ms": config.ws_poll_ms,
   128	            "test_mode": config.test_mode,
   129	        }
   130	
   131	    @app.websocket("/api/events")
   132	    async def events_ws(websocket: WebSocket, since: int = 0) -> None:
   133	        await tail_events(
   134	            websocket, since, conn_factory, config.ws_poll_ms, config.events_read_limit
   135	        )
   136	
   137	    @app.get("/", response_class=HTMLResponse)
   138	    async def index() -> str:
   139	        return _SHELL
   140	
   141	    if config.test_mode:
