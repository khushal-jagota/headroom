     1	"""Ticket domain shapes: the state machine order, the four fields, the grant pair,
     2	and the ticket row. Stdlib only; Priority/Project are imported from core (shared
     3	vocabulary), never redeclared."""
     4	
     5	from __future__ import annotations
     6	
     7	from dataclasses import dataclass, field
     8	from enum import StrEnum
     9	from typing import Final, Literal, TypedDict
    10	
    11	from planner.core.contracts import Priority, Project
    12	
    13	# §3.3 ticket title length cap. The DDL carries the matching literal
    14	# `CHECK (length(title) <= 200)` as the DB-level backstop; this constant is the
    15	# single enforcement source the write paths pass to admission.validate_title.
    16	TITLE_MAX_CHARS: Final = 200
    17	
    18	
    19	class TicketState(StrEnum):        # §4.1, exact order
    20	    needs_success = "needs_success"
    21	    needs_approach = "needs_approach"
    22	    needs_plan = "needs_plan"
    23	    in_progress = "in_progress"
    24	    needs_review = "needs_review"
    25	    done = "done"
    26	    dropped = "dropped"            # terminal, human-only, outside the linear order
    27	
    28	
    29	# Linear pipeline order (dropped excluded). Index comparison implements "<= ceiling".
    30	# ceiling and next_ceiling values are restricted to members of this tuple (never dropped).
    31	STATE_ORDER: Final[tuple[TicketState, ...]] = (
    32	    TicketState.needs_success, TicketState.needs_approach, TicketState.needs_plan,
    33	    TicketState.in_progress, TicketState.needs_review, TicketState.done,
    34	)
    35	
    36	
    37	class FieldName(StrEnum):          # §4.2 — the exactly-four field keys
    38	    success = "success"
    39	    approach = "approach"
    40	    plan = "plan"
    41	    result = "result"
    42	
    43	
    44	class AtCap(StrEnum):              # §4.3
    45	    stop = "stop"
    46	    propose = "propose"
    47	
    48	
    49	# §4.2 table — gating field per pre-terminal state. needs_review has none (human approve).
    50	GATING_FIELD: Final[dict[TicketState, FieldName]] = {
    51	    TicketState.needs_success: FieldName.success,
    52	    TicketState.needs_approach: FieldName.approach,
    53	    TicketState.needs_plan: FieldName.plan,
    54	    TicketState.in_progress: FieldName.result,
    55	}
    56	
    57	# §4.2 table — accepted proposal advances to. in_progress -> needs_review is the
    58	# default route; the ceiling=done special case (§4.4.5) is resolution-engine logic,
    59	# not a second table entry.
    60	ADVANCE_TARGET: Final[dict[TicketState, TicketState]] = {
    61	    TicketState.needs_success: TicketState.needs_approach,
    62	    TicketState.needs_approach: TicketState.needs_plan,
    63	    TicketState.needs_plan: TicketState.in_progress,
    64	    TicketState.in_progress: TicketState.needs_review,
    65	}
    66	
    67	
    68	@dataclass(frozen=True)
    69	class Proposal:                    # §4.2 proposal slot
    70	    body: str
    71	    proposed_by: str               # actor string: "agent", run id context, or PLAN_ACTOR
    72	    created_at: int
    73	
    74	
    75	@dataclass
    76	class FieldSlot:                   # §4.2 — one of the four field objects
    77	    value: str | None = None       # canonical; resolution engine is the only writer
    78	    proposal: Proposal | None = None
    79	    notes: str | None = None       # free guidance; result.notes = review notes (§4.2)
    80	
    81	
    82	@dataclass
    83	class TicketFields:                # tickets.fields JSON column, exactly four keys
    84	    success: FieldSlot = field(default_factory=FieldSlot)
    85	    approach: FieldSlot = field(default_factory=FieldSlot)
    86	    plan: FieldSlot = field(default_factory=FieldSlot)
    87	    result: FieldSlot = field(default_factory=FieldSlot)
    88	
    89	
    90	# --- the grant pair (§4.4.7) ---
    91	NO_FURTHER: Final = "none"                     # wire sentinel: ceiling = the newly entered state
    92	NextCeiling = TicketState | Literal["none"]    # valid TicketState values are STATE_ORDER members
    93	
    94	
    95	@dataclass(frozen=True)
    96	class GrantPair:                   # required on every human accept/edit-accept
    97	    next_ceiling: NextCeiling
    98	    at_cap: AtCap
    99	
   100	
