   419	          whatLabel: pretty(gating),
   420	          proposalBody: slot.proposal.body,
   421	          note: slot.notes,
   422	          newState: C.advanceTarget(detail.state, detail.ceiling),
   423	          onApprove: function (payload) {
   424	            return api.fetchJson("/api/tickets/" + id + "/accept/" + gating, {
   425	              method: "POST",
   426	              body: payload
   427	            });
   428	          },
   429	          onNoteSave: function (note) {
   430	            return api.fetchJson("/api/tickets/" + id + "/notes/" + gating, {
   431	              method: "PUT",
   432	              body: { note: note }
   433	            });
   434	          }
   435	        });
