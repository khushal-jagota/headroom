   260	                       sprint_item_id: str | None = None) -> JsonDict:
   261	    state_enum = parse_enum(TicketState, state, "state") if state is not None else None
   262	    project_enum = parse_enum(Project, project, "project") if project is not None else None
   263	    return {
   264	        "tickets": tickets_views.list_tickets(
   265	            conn,
   266	            clk.now_unix(),
   267	            state=state_enum,
   268	            project=project_enum,
   269	            sprint_id=sprint_id,
   270	            sprint_item_id=sprint_item_id,
