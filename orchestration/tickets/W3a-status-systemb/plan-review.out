   437	        // "proposed by <who>" .proposal-meta inside the approval region (the body
   438	        // is already a visible .markdown-block via the draft preview).
   439	        var meta = el("div", "proposal-meta",
   440	          "proposed by " + slot.proposal.proposed_by);
   441	        var draftNode = block.querySelector(".approval-draft");
   442	        if (draftNode) {
   443	          block.insertBefore(meta, draftNode);
   444	        } else {
   445	          block.appendChild(meta);
   446	        }
   447	        return block;
   448	      }
   449	    }
   450	    if (detail.state === "needs_review") {
