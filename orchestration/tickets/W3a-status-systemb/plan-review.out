    80	def _read_yaml(path: str | None) -> dict[str, object]:
    81	    resolved = Path(path) if path is not None else Path(DEFAULT_CONFIG_PATH)
    82	    if not resolved.exists():
    83	        return {}
    84	    loaded = yaml.safe_load(resolved.read_text())
    85	    if loaded is None:
    86	        return {}
    87	    if not isinstance(loaded, dict):
    88	        raise PlannerError(ErrorCode.validation, f"config root must be a mapping: {resolved}")
    89	    return loaded
    90	
    91	
    92	def _str_value(
    93	    file_cfg: Mapping[str, object], env: Mapping[str, str], key: str, env_var: str, default: str
    94	) -> str:
    95	    value: object = default
    96	    if key in file_cfg:
    97	        value = file_cfg[key]
    98	    if env_var in env:
    99	        value = env[env_var]
   100	    return str(value)
   101	
   102	
   103	def _int_value(
   104	    file_cfg: Mapping[str, object], env: Mapping[str, str], key: str, env_var: str, default: int
   105	) -> int:
   106	    value: object = default
   107	    if key in file_cfg:
   108	        value = file_cfg[key]
   109	    if env_var in env:
   110	        value = env[env_var]
   111	    return _parse_int(value, key)
   112	
   113	
   114	def _bool_value(
   115	    file_cfg: Mapping[str, object], env: Mapping[str, str], key: str, env_var: str, default: bool
   116	) -> bool:
   117	    value: object = default
   118	    if key in file_cfg:
   119	        value = file_cfg[key]
   120	    if env_var in env:
   121	        value = env[env_var]
   122	    return _parse_bool(value, key)
   123	
   124	
   125	def load_config(path: str | None = None, env: Mapping[str, str] | None = None) -> Config:
   126	    env = os.environ if env is None else env
   127	    cfg = _read_yaml(path)
   128	
   129	    test_mode = _parse_bool(env.get("PLAN_TEST_MODE", "0"), "test_mode")
   130	    fake_now: str | None = env.get("PLAN_FAKE_NOW") or None
   131	    if not test_mode:
   132	        fake_now = None  # §13/item 21: PLAN_FAKE_NOW is ignored when test mode is off
   133	
   134	    return Config(
   135	        db_path=_str_value(cfg, env, "db_path", "PLAN_DB_PATH", "data/planning.db"),
   136	        port=_int_value(cfg, env, "port", "PLAN_PORT", 8767),
   137	        boundary_hour=_int_value(cfg, env, "boundary_hour", "PLAN_BOUNDARY_HOUR", 5),
   138	        tick_seconds=_int_value(cfg, env, "tick_seconds", "PLAN_TICK_SECONDS", 60),
   139	        claim_ttl_seconds=_int_value(cfg, env, "claim_ttl_seconds", "PLAN_CLAIM_TTL_SECONDS", 900),
   140	        max_runs=_int_value(cfg, env, "max_runs", "PLAN_MAX_RUNS", 2),
   141	        failure_limit=_int_value(cfg, env, "failure_limit", "PLAN_FAILURE_LIMIT", 2),
   142	        dispatch_enabled=_bool_value(cfg, env, "dispatch_enabled", "PLAN_DISPATCH_ENABLED", True),
   143	        hermes_bin=_str_value(cfg, env, "hermes_bin", "PLAN_HERMES_BIN", "hermes"),
   144	        hermes_profile=_str_value(cfg, env, "hermes_profile", "PLAN_HERMES_PROFILE", "default"),
   145	        worker_skill=_str_value(cfg, env, "worker_skill", "PLAN_WORKER_SKILL", "planning-worker"),
   146	        ws_poll_ms=_int_value(cfg, env, "ws_poll_ms", "PLAN_WS_POLL_MS", 300),
   147	        ui_debounce_ms=_int_value(cfg, env, "ui_debounce_ms", "PLAN_UI_DEBOUNCE_MS", 250),
   148	        run_max_seconds=_int_value(cfg, env, "run_max_seconds", "PLAN_RUN_MAX_SECONDS", 1800),
   149	        boundary_timeout_seconds=_int_value(
   150	            cfg, env, "boundary_timeout_seconds", "PLAN_BOUNDARY_TIMEOUT_SECONDS", 60
   151	        ),
   152	        dispatcher_lock_path=_str_value(
   153	            cfg, env, "dispatcher_lock_path", "PLAN_DISPATCHER_LOCK_PATH", "data/dispatcher.lock"
   154	        ),
   155	        logs_dir=_str_value(cfg, env, "logs_dir", "PLAN_LOGS_DIR", "data/logs"),
   156	        events_read_limit=_int_value(cfg, env, "events_read_limit", "PLAN_EVENTS_READ_LIMIT", 500),
   157	        db_busy_timeout_ms=_int_value(
   158	            cfg, env, "db_busy_timeout_ms", "PLAN_DB_BUSY_TIMEOUT_MS", 5000
   159	        ),
   160	        spawn_adapter=_str_value(cfg, env, "spawn_adapter", "PLAN_SPAWN_ADAPTER", "auto"),
   161	        boundary_adapter=_str_value(cfg, env, "boundary_adapter", "PLAN_BOUNDARY_ADAPTER", "auto"),
   162	        gateway_adapter=_str_value(cfg, env, "gateway_adapter", "PLAN_GATEWAY_ADAPTER", "auto"),
   163	        test_mode=test_mode,
   164	        fake_now=fake_now,
   165	    )
   166	
   167	
   168	def read_dispatch_enabled(path: str | None = None, env: Mapping[str, str] | None = None) -> bool:
   169	    """§7.1 fail-safe: the dispatcher re-reads this every tick. Any read/parse
   170	    failure returns False (a missing config file is not a failure — defaults apply)."""
   171	    try:
   172	        env = os.environ if env is None else env
   173	        return _bool_value(_read_yaml(path), env, "dispatch_enabled", "PLAN_DISPATCH_ENABLED", True)
   174	    except Exception:
   175	        return False

