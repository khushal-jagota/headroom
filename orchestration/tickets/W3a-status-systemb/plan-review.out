   100	
   101	# --- structured errors (SPEC §14: pure logic imports these from contracts) ------
   102	# Every domain rejection raises PlannerError with a stable code; the API renders
   103	# it as {"error": {code, message, detail}} and the CLI keys its exit code off the
   104	# presence of that envelope.
   105	
   106	
   107	class ErrorCode(StrEnum):
   108	    at_cap_stop = "at_cap_stop"                    # §4.3 agent proposal at ceiling with stop
   109	    grant_missing = "grant_missing"                # §4.4.7 accept without the full pair
   110	    grant_invalid = "grant_invalid"                # next_ceiling before the new state / unknown
   111	    stale_claim = "stale_claim"                    # §7.6 stale/foreign claim; detail names it
   112	    recap_too_early = "recap_too_early"            # §3.3 recap write at needs_success
   113	    title_too_long = "title_too_long"              # §3.3 > title_max_chars
   114	    sprint_overlap = "sprint_overlap"              # §3.1 overlapping date ranges
   115	    link_cycle = "link_cycle"                      # §3.6 blocks/parent_child transitive cycle
   116	    link_invalid = "link_invalid"                  # self-link, second belongs_to, bad endpoints
   117	    sprint_derived = "sprint_derived"              # §3.3 sprint_id write on a parented ticket
   118	    item_transition_forbidden = "item_transition_forbidden"  # §3.2 agent direct done/deferred
   119	    agent_forbidden = "agent_forbidden"            # claim/agent request hits a human-only action
   120	    gateway_offline = "gateway_offline"            # §11
   121	    not_found = "not_found"
   122	    validation = "validation"                      # generic input validation
   123	
   124	
   125	class PlannerError(Exception):
   126	    def __init__(self, code: ErrorCode, message: str, detail: JsonDict | None = None) -> None:
   127	        super().__init__(message)
   128	        self.code = code
   129	        self.message = message
   130	        self.detail: JsonDict = detail if detail is not None else {}
   131	
   132	    def to_payload(self) -> JsonDict:
   133	        return {"error": {"code": self.code.value, "message": self.message, "detail": self.detail}}

