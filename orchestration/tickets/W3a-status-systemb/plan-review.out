    26	    once-per-process lock acquisition), then sleep. A4: shield the in-flight tick
    27	    thread so cancellation waits it out — the lock is never released under a running
    28	    tick. Catch Exception only so CancelledError propagates."""
    29	    while True:
    30	        thread_task = asyncio.ensure_future(asyncio.to_thread(tick))
    31	        try:
    32	            await asyncio.shield(thread_task)
    33	        except asyncio.CancelledError:
    34	            with contextlib.suppress(BaseException):
    35	                await thread_task
    36	            raise
    37	        except Exception:
    38	            _LOGGER.exception("background %s tick failed", name)
    39	        await asyncio.sleep(interval)
    40	
    41	
    42	class BackgroundLoops:
    43	    def __init__(self, tasks: list[asyncio.Task[None]], lock_path: str) -> None:
    44	        self._tasks = tasks
    45	        self._lock_path = lock_path
    46	        self._stopped = False
    47	
    48	    async def stop(self) -> None:
    49	        """Cancel both tasks and wait them out (which also waits out any in-flight
    50	        tick thread), then release the dispatcher lock. Idempotent: a re-stopped
    51	        handle is a no-op and can never release a newer instance's lock (A2)."""
    52	        global _active
    53	        if self._stopped:
    54	            return
    55	        self._stopped = True
    56	        for task in self._tasks:
    57	            task.cancel()
    58	        await asyncio.gather(*self._tasks, return_exceptions=True)
    59	        if _active is self:
    60	            release_dispatcher_lock(self._lock_path)
    61	            _active = None
    62	
    63	
    64	_active: BackgroundLoops | None = None
    65	
    66	
    67	def start_background_loops(
    68	    config: Config, clock: Clock, adapters: Adapters, conn_factory: ConnFactory
    69	) -> BackgroundLoops:
    70	    """Start the two loops on the running event loop. A2: at most one live instance
    71	    per process (they share the cached flock fd)."""
    72	    global _active
    73	    if _active is not None:
    74	        raise RuntimeError("background loops already running")
    75	    dispatcher = asyncio.create_task(
    76	        _loop_forever(
    77	            "dispatcher",
    78	            partial(run_tick, conn_factory, config, clock, adapters),
    79	            config.tick_seconds,
    80	        )
    81	    )
    82	    boundary = asyncio.create_task(
    83	        _loop_forever(
    84	            "boundary",
    85	            partial(run_boundary_tick, conn_factory, config, clock, adapters),
    86	            config.tick_seconds,
    87	        )
    88	    )
    89	    loops = BackgroundLoops([dispatcher, boundary], config.dispatcher_lock_path)
    90	    _active = loops
    91	    return loops

