   107	@router.delete("/day/{date}/tickets/{ticket_id}")
   108	async def remove_day_ticket(date: str, ticket_id: str, conn: DbConn, ctx: Ctx, cfg: Cfg,
   109	                            clk: Clk) -> JsonDict:
