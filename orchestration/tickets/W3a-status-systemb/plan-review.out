     1	"""§4.4 resolution semantics as pure Decisions. _accept_gating_proposal is the
     2	sole constructor of any Decision that traverses the gating-acceptance edges 1-5
     3	(auto and human alike); _state_change is the sole constructor of state_changed
     4	EventSpecs. Together with data._apply_decision (the sole appender) this is the
     5	"one canonical writer per transition" guarantee (§4.4.6)."""
     6	
     7	from __future__ import annotations
     8	
     9	from typing import Final
    10	
    11	from planner.core.contracts import ErrorCode, EventKind, PlannerError
    12	from planner.tickets.contracts import (
    13	    AtCap,
    14	    FieldName,
    15	    FieldSlot,
    16	    GrantPair,
    17	    NextCeiling,
    18	    Proposal,
    19	    Ticket,
    20	    TicketState,
    21	)
    22	from planner.tickets.logic import admission, fields_codec, machine
    23	from planner.tickets.logic.decisions import Decision, EventSpec
    24	
    25	CAUSE_AUTO_ACCEPT: Final[str] = "auto_accept"
    26	CAUSE_HUMAN_ACCEPT: Final[str] = "human_accept"
    27	CAUSE_REVIEW_APPROVE: Final[str] = "review_approve"
    28	CAUSE_HUMAN_STATE_JUMP: Final[str] = "human_state_jump"
    29	CAUSE_DROP: Final[str] = "drop"
    30	CAUSE_ONWARD_GRANT: Final[str] = "onward_grant"
    31	CAUSE_HUMAN_GRANT: Final[str] = "human_grant"
    32	RESOLVED_BY_AUTO: Final[str] = "auto"
    33	RESOLVED_BY_HUMAN: Final[str] = "human"
