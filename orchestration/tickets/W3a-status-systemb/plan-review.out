     1	"""§7.6 request context and write validation. This is the server-side dependency
     2	that T10/T13 route bodies consume: it reads the X-Plan-* headers, classifies each
     3	request as a claimed agent, a plain agent, or the human, and validates a presented
     4	claim against a ticket's active lease. Lease liveness is decided only by
     5	dispatch.logic.claims — never re-derived here.
     6	
     7	FastAPI appears here because this is part of the server shell (the server.py
     8	family), not a logic or data module."""
     9	
    10	from __future__ import annotations
    11	
    12	import sqlite3
    13	from collections.abc import Collection, Iterable
    14	from dataclasses import dataclass
    15	from typing import Final, NoReturn
    16	
    17	from fastapi import Request
    18	
    19	from planner.core.contracts import JsonDict
    20	from planner.core.errors import ErrorCode, PlannerError
    21	from planner.dispatch.logic.claims import has_active_claim, is_expired
    22	
    23	X_PLAN_RUN_ID: Final = "X-Plan-Run-Id"
    24	X_PLAN_CLAIM: Final = "X-Plan-Claim"
    25	X_PLAN_ACTOR: Final = "X-Plan-Actor"
    26	_DEFAULT_AGENT_ACTOR: Final = "agent"    # §7.6: PLAN_ACTOR default "agent"
    27	_HUMAN_ACTOR: Final = "human"
    28	
    29	
    30	@dataclass(frozen=True)
    31	class RequestContext:
    32	    actor: str
    33	    run_id: str | None
    34	    claim: str | None
    35	    is_claimed_agent: bool
    36	    is_human: bool
    37	
    38	
    39	def _normalize(raw: str | None) -> str | None:
    40	    """strip(); an empty or whitespace-only header is an absent header."""
    41	    if raw is None:
    42	        return None
    43	    stripped = raw.strip()
    44	    return stripped or None
    45	
    46	
    47	def _classify(run_id: str | None, claim: str | None, actor: str | None) -> RequestContext:
    48	    """Pure classification over the §1.1 truth table; inputs are pre-normalized."""
    49	    if run_id is not None or claim is not None:
    50	        # Any claim header present (whole or half) is a claimed-agent attempt.
    51	        return RequestContext(
    52	            actor=actor if actor is not None else _DEFAULT_AGENT_ACTOR,
    53	            run_id=run_id,
    54	            claim=claim,
    55	            is_claimed_agent=True,
    56	            is_human=False,
    57	        )
    58	    if actor is not None:
    59	        # Non-dispatched agent context (planner-main chat agent): proposer from PLAN_ACTOR.
    60	        return RequestContext(
    61	            actor=actor,
    62	            run_id=None,
    63	            claim=None,
    64	            is_claimed_agent=False,
    65	            is_human=False,
    66	        )
    67	    # The human: UI requests carry no agent headers.
    68	    return RequestContext(
    69	        actor=_HUMAN_ACTOR,
    70	        run_id=None,
    71	        claim=None,
    72	        is_claimed_agent=False,
    73	        is_human=True,
    74	    )
    75	
    76	
    77	def request_context(request: Request) -> RequestContext:
    78	    """FastAPI dependency: reads the three headers, normalizes, classifies. No DB, no clock."""
    79	    headers = request.headers
    80	    return _classify(
    81	        _normalize(headers.get(X_PLAN_RUN_ID)),
    82	        _normalize(headers.get(X_PLAN_CLAIM)),
    83	        _normalize(headers.get(X_PLAN_ACTOR)),
    84	    )
    85	
    86	
    87	def _reject_stale(
    88	    reason: str,
    89	    message: str,
    90	    ctx: RequestContext,
    91	    ticket_id: str,
    92	    active_claim_present: bool,
    93	    stored_lock: str | None,
    94	    extra: JsonDict | None = None,
    95	) -> NoReturn:
    96	    # Presented values are echoed back — except a presented token equal to the stored
    97	    # claim_lock (the expired/run_mismatch/missing-half paths reach here with a correct
    98	    # token): verbatim it would put the live stored token into a detail that may be
    99	    # logged or displayed, so it is redacted.
   100	    presented_claim = ctx.claim
   101	    if presented_claim is not None and presented_claim == stored_lock:
   102	        presented_claim = "(redacted)"
   103	    detail: JsonDict = {
   104	        "reason": reason,
   105	        "ticket_id": ticket_id,
   106	        "presented_run_id": ctx.run_id,
   107	        "presented_claim": presented_claim,
   108	        "active_claim_present": active_claim_present,
   109	    }
   110	    if extra is not None:
   111	        detail.update(extra)
   112	    raise PlannerError(ErrorCode.stale_claim, message, detail)
   113	
   114	
   115	def require_claim(
   116	    conn: sqlite3.Connection, ctx: RequestContext, ticket_id: str, now: int
   117	) -> None:
   118	    """§7.6 write validation. Checks run in the fixed order (ticket exists → active
   119	    claim → unexpired → token → run id); the first failure raises stale_claim naming
   120	    which check failed. The stored token is never echoed. now is unix seconds."""
   121	    row = conn.execute(
   122	        "SELECT claim_lock, claim_expires FROM tickets WHERE id=?", (ticket_id,)
   123	    ).fetchone()
   124	    if row is None:
   125	        raise PlannerError(ErrorCode.not_found, "ticket not found", {"ticket_id": ticket_id})
   126	    claim_lock = str(row["claim_lock"]) if row["claim_lock"] is not None else None
   127	    claim_expires = int(row["claim_expires"]) if row["claim_expires"] is not None else None
   128	    active = has_active_claim(claim_lock, claim_expires, now)
   129	
   130	    if ctx.run_id is None or ctx.claim is None:
   131	        missing = [
   132	            name
   133	            for name, value in ((X_PLAN_RUN_ID, ctx.run_id), (X_PLAN_CLAIM, ctx.claim))
   134	            if value is None
   135	        ]
   136	        _reject_stale(
   137	            "missing_header",
   138	            "claim headers incomplete",
   139	            ctx,
   140	            ticket_id,
   141	            active,
   142	            claim_lock,
   143	            {"missing": missing},
   144	        )
   145	    if claim_lock is None:
   146	        _reject_stale(
   147	            "none_active", "ticket has no active claim", ctx, ticket_id, active, claim_lock
   148	        )
   149	    if is_expired(claim_expires, now):
   150	        _reject_stale(
   151	            "expired",
   152	            "claim expired",
   153	            ctx,
   154	            ticket_id,
   155	            active,
   156	            claim_lock,
   157	            {"claim_expires": claim_expires},
   158	        )
   159	    if ctx.claim != claim_lock:
   160	        _reject_stale(
   161	            "foreign",
   162	            "claim token does not match the ticket's active claim",
   163	            ctx,
   164	            ticket_id,
   165	            active,
   166	            claim_lock,
   167	        )
   168	    run_row = conn.execute(
   169	        "SELECT id FROM runs WHERE ticket_id=? AND status='running' "
   170	        "ORDER BY started_at DESC LIMIT 1",
   171	        (ticket_id,),
   172	    ).fetchone()
   173	    if run_row is None or str(run_row["id"]) != ctx.run_id:
   174	        _reject_stale(
   175	            "run_mismatch",
   176	            "run id does not match the ticket's running run",
   177	            ctx,
   178	            ticket_id,
   179	            active,
   180	            claim_lock,
   181	        )
   182	    return None
   183	
   184	
   185	def validate_carried_claim(
   186	    conn: sqlite3.Connection, ctx: RequestContext, ticket_id: str, now: int
   187	) -> None:
   188	    """§7.6 gate for mutating ticket-target routes: a request carrying claim headers
   189	    must hold the target ticket's active claim (the full require_claim order applies);
   190	    human and plain-agent requests pass through unchanged."""
   191	    if ctx.is_claimed_agent:
   192	        require_claim(conn, ctx, ticket_id, now)
   193	    return None
   194	
   195	
   196	def reject_agents(ctx: RequestContext) -> None:
   197	    """(H) routes: any agent-classified request (claimed or plain) is agent_forbidden."""
   198	    if ctx.is_human:
   199	        return None
   200	    raise PlannerError(
   201	        ErrorCode.agent_forbidden,
   202	        "human-only action",
   203	        {"actor": ctx.actor, "is_claimed_agent": ctx.is_claimed_agent},
   204	    )
   205	
   206	
   207	def reject_agent_fields(
   208	    ctx: RequestContext, body_keys: Iterable[str], human_only_keys: Collection[str]
   209	) -> None:
   210	    """Field-level agent boundary for PATCH routes that expose both agent-permitted and
   211	    human-only keys (§8, §14): an agent-classified request (claimed or plain) that
   212	    touches any human-only field is agent_forbidden, naming the first offending field.
   213	    Human requests pass through untouched."""
   214	    if ctx.is_human:
   215	        return None
   216	    for key in body_keys:
   217	        if key in human_only_keys:
   218	            raise PlannerError(
   219	                ErrorCode.agent_forbidden,
   220	                "human-only field",
   221	                {
   222	                    "field": key,
   223	                    "actor": ctx.actor,
   224	                    "is_claimed_agent": ctx.is_claimed_agent,
   225	                },
   226	            )
   227	    return None

