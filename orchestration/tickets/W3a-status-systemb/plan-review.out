   111	    now = clk.now_unix()
   112	    validate_carried_claim(conn, ctx, ticket_id, now)
   113	    with txn(conn):
   114	        days_data.remove_day_ticket(conn, did, ticket_id, now)
   115	    return _day_view(conn, did, now)

