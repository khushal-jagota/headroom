    73	# --- shared plumbing (imported by the other api modules) -----------------------
    74	
    75	
    76	def get_config(request: Request) -> Config:
    77	    return cast(Config, request.app.state.config)
    78	
    79	
    80	def get_clock(request: Request) -> Clock:
    81	    return cast(Clock, request.app.state.clock)
