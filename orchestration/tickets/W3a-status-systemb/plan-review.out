    37	
    38	def ticket_json(ticket: Ticket, now: int) -> JsonDict:
    39	    """§3.3 ticket. claim_lock is deliberately omitted (never echo the stored token);
    40	    the derived claim_active carries lease liveness instead."""
    41	    return {
    42	        "id": ticket.id,
    43	        "title": ticket.title,
    44	        "state": ticket.state.value,
    45	        "priority": ticket.priority.value,
    46	        "deadline": ticket.deadline,
    47	        "project": ticket.project.value if ticket.project is not None else None,
    48	        "sprint_item_id": ticket.sprint_item_id,
    49	        "sprint_id": ticket.sprint_id,
    50	        "recap": ticket.recap,
    51	        "ceiling": ticket.ceiling.value,
    52	        "at_cap": ticket.at_cap.value,
    53	        "auto_blocked": ticket.auto_blocked,
    54	        "consecutive_failures": ticket.consecutive_failures,
    55	        "chat_session_key": ticket.chat_session_key,
    56	        "alias": ticket.alias,
    57	        "fields": json.loads(fields_codec.fields_to_json(ticket.fields)),
    58	        "claim_expires": ticket.claim_expires,
    59	        "claim_active": has_active_claim(ticket.claim_lock, ticket.claim_expires, now),
    60	        "created_at": ticket.created_at,
    61	        "updated_at": ticket.updated_at,
    62	    }
    63	
    64	
    65	def run_json(row: sqlite3.Row) -> JsonDict:
    66	    return {
    67	        "id": str(row["id"]),
    68	        "ticket_id": str(row["ticket_id"]),
    69	        "status": str(row["status"]),
    70	        "started_at": int(row["started_at"]),
    71	        "ended_at": int(row["ended_at"]) if row["ended_at"] is not None else None,
    72	        "summary": str(row["summary"]) if row["summary"] is not None else None,
    73	        "error": str(row["error"]) if row["error"] is not None else None,
    74	        "pid": int(row["pid"]) if row["pid"] is not None else None,
    75	    }
    76	
    77	
    78	def event_json(row: sqlite3.Row) -> JsonDict:
