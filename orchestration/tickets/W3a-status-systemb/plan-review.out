   280	@router.patch("/tickets/{ticket_id}")
   281	async def patch_ticket(ticket_id: str, body: dict[str, Any], conn: DbConn, ctx: Ctx,
   282	                       cfg: Cfg, clk: Clk) -> JsonDict:
   283	    recognized = ("title", "priority", "deadline", "project", "sprint_id")
   284	    for key in body:
   285	        if key not in recognized:
   286	            raise PlannerError(ErrorCode.validation, "unknown ticket field", {"field": key})
   287	    if not body:
   288	        raise PlannerError(ErrorCode.validation, "no ticket fields to update", {})
   289	    reject_agent_fields(ctx, body, _TICKET_HUMAN_ONLY_FIELDS)
   290	    now = clk.now_unix()
   291	    validate_carried_claim(conn, ctx, ticket_id, now)
   292	    if "title" in body:
   293	        _set_title(conn, ticket_id, body["title"], title_max_chars=TITLE_MAX_CHARS, now=now)
   294	    if "priority" in body:
   295	        priority = parse_enum(Priority, body["priority"], "priority")
   296	        tickets_data.set_priority(conn, ticket_id, priority=priority, actor=ctx.actor, now=now)
   297	    if "deadline" in body:
   298	        tickets_data.set_deadline(conn, ticket_id, deadline=body["deadline"], actor=ctx.actor,
   299	                                  now=now)
   300	    if "project" in body:
   301	        project = parse_enum(Project, body["project"], "project") \
   302	            if body["project"] is not None else None
   303	        _set_project(conn, ticket_id, project, now=now)
   304	    if "sprint_id" in body:
   305	        tickets_data.set_sprint(conn, ticket_id, sprint_id=body["sprint_id"], actor=ctx.actor,
   306	                                now=now)
   307	    return tickets_views.ticket_json(tickets_data.read_ticket(conn, ticket_id), now)
