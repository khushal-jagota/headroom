     1	"""Shared vocabulary used across every domain: cross-domain enums, the event
     2	kinds, the link kinds, the two infrastructure shapes (event row, link row), and
     3	the structured-error contract (ErrorCode, PlannerError) that pure logic raises.
     4	
     5	Stdlib only. Nothing here imports another planner module."""
     6	
     7	from __future__ import annotations
     8	
     9	from dataclasses import dataclass
    10	from enum import StrEnum
    11	from typing import Any
