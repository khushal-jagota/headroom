   186	# --- private gap-fill writers (D2; A1: writer-shaped for relocation) ------------
   187	
   188	
   189	def _set_title(conn: sqlite3.Connection, ticket_id: str, title: str, *,
   190	               title_max_chars: int, now: int) -> Ticket:
   191	    admission.validate_title(title, title_max_chars)
   192	    with txn(conn):
   193	        ticket = tickets_data.read_ticket(conn, ticket_id)
   194	        prev = ticket.title
   195	        conn.execute(
   196	            "UPDATE tickets SET title = ?, updated_at = ? WHERE id = ?", (title, now, ticket_id)
   197	        )
   198	        append_event(
   199	            conn,
   200	            ticket_id,
   201	            EventKind.ticket_updated,
   202	            {"field": "title", "from": prev, "to": title},
   203	            now,
   204	        )
   205	        return tickets_data.read_ticket(conn, ticket_id)
   206	
   207	
   208	def _set_project(conn: sqlite3.Connection, ticket_id: str, project: Project | None, *,
   209	                 now: int) -> Ticket:
   210	    with txn(conn):
   211	        ticket = tickets_data.read_ticket(conn, ticket_id)
   212	        if ticket.sprint_item_id is not None:
   213	            raise PlannerError(ErrorCode.validation, "project is derived when parented")
   214	        prev = ticket.project.value if ticket.project is not None else None
   215	        new_value = project.value if project is not None else None
   216	        conn.execute(
   217	            "UPDATE tickets SET project = ?, updated_at = ? WHERE id = ?",
   218	            (new_value, now, ticket_id),
   219	        )
   220	        append_event(
   221	            conn,
   222	            ticket_id,
   223	            EventKind.ticket_updated,
   224	            {"field": "project", "from": prev, "to": new_value},
   225	            now,
   226	        )
   227	        return tickets_data.read_ticket(conn, ticket_id)
   228	
