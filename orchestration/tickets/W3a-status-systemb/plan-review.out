   392	@router.post("/tickets/{ticket_id}/grant")
   393	async def grant_ticket(ticket_id: str, raw: dict[str, Any], conn: DbConn, ctx: Ctx,
   394	                       clk: Clk) -> JsonDict:
   395	    body = GrantBody(ceiling=body_opt_str(raw, "ceiling"), at_cap=body_opt_str(raw, "at_cap"))
   396	    reject_agents(ctx)
   397	    now = clk.now_unix()
   398	    ceiling_raw = body["ceiling"]
   399	    at_cap_raw = body["at_cap"]
   400	    if ceiling_raw is None or at_cap_raw is None:
   401	        missing = [name for name, value in (("ceiling", ceiling_raw), ("at_cap", at_cap_raw))
   402	                   if value is None]
   403	        raise PlannerError(
   404	            ErrorCode.grant_missing, "grant requires ceiling and at_cap", {"missing": missing}
   405	        )
   406	    try:
   407	        ceiling = TicketState(ceiling_raw)
   408	    except ValueError:
   409	        raise PlannerError(
   410	            ErrorCode.grant_invalid, "unknown ceiling", {"ceiling": ceiling_raw}
   411	        ) from None
   412	    try:
   413	        at_cap = AtCap(at_cap_raw)
   414	    except ValueError:
   415	        raise PlannerError(
   416	            ErrorCode.grant_invalid, "unknown at_cap", {"at_cap": at_cap_raw}
   417	        ) from None
   418	    ticket = tickets_data.change_grant(
   419	        conn, ticket_id, ceiling=ceiling, at_cap=at_cap, actor=ctx.actor, now=now
   420	    )
   421	    return tickets_views.ticket_json(ticket, now)
