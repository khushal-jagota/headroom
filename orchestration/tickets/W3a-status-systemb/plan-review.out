    83	
    84	async def db_conn(request: Request) -> AsyncIterator[sqlite3.Connection]:
    85	    conn = cast(Callable[[], sqlite3.Connection], request.app.state.conn_factory)()
    86	    try:
    87	        yield conn
    88	    finally:
    89	        conn.close()
    90	
    91	
    92	DbConn = Annotated[sqlite3.Connection, Depends(db_conn)]
    93	Ctx = Annotated[RequestContext, Depends(request_context)]
    94	Cfg = Annotated[Config, Depends(get_config)]
    95	Clk = Annotated[Clock, Depends(get_clock)]
    96	
    97	
    98	@contextmanager
    99	def txn(conn: sqlite3.Connection) -> Iterator[None]:
   100	    """Wrap a NON-self-transacting writer (days/dispatch/links) so a mid-sequence
   101	    PlannerError rolls back cleanly. Never wrap a ticket/sprint writer — those open
   102	    their own BEGIN IMMEDIATE and would raise 'transaction within a transaction'."""
   103	    conn.execute("BEGIN IMMEDIATE")
   104	    try:
   105	        yield
   106	    except BaseException:
   107	        conn.execute("ROLLBACK")
   108	        raise
   109	    else:
   110	        conn.execute("COMMIT")
   111	
   112	
   113	def parse_enum[E: StrEnum](enum_cls: type[E], raw: str, what: str) -> E:
   114	    try:
   115	        return enum_cls(raw)
   116	    except ValueError:
   117	        raise PlannerError(ErrorCode.validation, f"invalid {what}", {what: raw}) from None
   118	
   119	
   120	def body_str(body: JsonDict, key: str, default: str = "") -> str:
   121	    """Marshal an optional string body key: absent -> default; null or non-string ->
   122	    the validation envelope. Unknown keys are ignored by the callers, matching the
   123	    §14 body shapes."""
   124	    raw = body.get(key, default)
   125	    if not isinstance(raw, str):
   126	        raise PlannerError(ErrorCode.validation, f"invalid {key}", {key: raw})
   127	    return raw
   128	
   129	
   130	def body_opt_str(body: JsonDict, key: str) -> str | None:
   131	    raw = body.get(key)
   132	    if raw is None:
   133	        return None
   134	    if not isinstance(raw, str):
   135	        raise PlannerError(ErrorCode.validation, f"invalid {key}", {key: raw})
   136	    return raw
   137	
   138	
   139	# --- request-body marshallers (contract shapes in tickets/contracts.py) ---------
   140	
   141	
   142	def _marshal_create_ticket(raw: JsonDict) -> CreateTicketBody:
   143	    return CreateTicketBody(
   144	        title=body_str(raw, "title"),
   145	        priority=body_opt_str(raw, "priority"),
   146	        deadline=body_opt_str(raw, "deadline"),
   147	        project=body_opt_str(raw, "project"),
   148	        sprint_id=body_opt_str(raw, "sprint_id"),
   149	        sprint_item_id=body_opt_str(raw, "sprint_item_id"),
   150	    )
   151	
   152	
   153	def _marshal_accept(raw: JsonDict) -> AcceptBody:
   154	    return AcceptBody(
   155	        edited_body=body_opt_str(raw, "edited_body"),
   156	        next_ceiling=body_opt_str(raw, "next_ceiling"),
   157	        at_cap=body_opt_str(raw, "at_cap"),
   158	    )
   159	
   160	
   161	# --- grant marshallers ---------------------------------------------------------
   162	
   163	
   164	def _parse_next_ceiling(raw: str | None) -> NextCeiling | None:
   165	    if raw is None:
   166	        return None
   167	    if raw == NO_FURTHER:
   168	        return NO_FURTHER
   169	    try:
   170	        return TicketState(raw)
   171	    except ValueError:
   172	        raise PlannerError(
   173	            ErrorCode.grant_invalid, "unknown next_ceiling", {"next_ceiling": raw}
   174	        ) from None
   175	
   176	
   177	def _parse_grant_at_cap(raw: str | None) -> AtCap | None:
   178	    if raw is None:
   179	        return None
   180	    try:
   181	        return AtCap(raw)
   182	    except ValueError:
   183	        raise PlannerError(ErrorCode.grant_invalid, "unknown at_cap", {"at_cap": raw}) from None
   184	
