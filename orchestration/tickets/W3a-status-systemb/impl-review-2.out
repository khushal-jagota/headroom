    ticket = _read(db, tid)
    assert ticket.status == TicketStatus.errored
    assert ticket.worker is None
    # started (agent_working) then errored — the end write always fires.
    assert [e["status"] for e in _status_events(db, tid)] == ["agent_working", "errored"]

