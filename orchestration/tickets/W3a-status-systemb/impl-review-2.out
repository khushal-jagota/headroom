    61	class _ProposingFake(FakeGateway):
    62	    """A fake child that files a real proposal (via the production writer) the moment it
    63	    receives prompt.submit — simulating the agent doing its step mid-run."""
    64	
    65	    def __init__(
    66	        self, script: dict[str, list[Reply]], *, on_submit: Callable[[], None] | None = None
    67	    ) -> None:
    68	        super().__init__(script)
    69	        self._on_submit = on_submit
    70	
    71	    def send(self, line: str) -> None:
    72	        frame = json.loads(line)
    73	        if frame.get("method") == "prompt.submit" and self._on_submit is not None:
    74	            self._on_submit()
    75	        super().send(line)
