{
  "command_schema": {
    "$defs": {
      "AnswerPermission": {
        "properties": {
          "answer": {
            "anyOf": [
              {
                "$ref": "#/$defs/DurableAnswer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "ask_id": {
            "title": "Ask Id",
            "type": "string"
          },
          "kind": {
            "const": "answer_permission_ask",
            "default": "answer_permission_ask",
            "title": "Kind",
            "type": "string"
          },
          "option_id": {
            "title": "Option Id",
            "type": "string"
          }
        },
        "required": [
          "ask_id",
          "option_id"
        ],
        "title": "AnswerPermission",
        "type": "object"
      },
      "AnswerUserInput": {
        "properties": {
          "answer": {
            "anyOf": [
              {
                "$ref": "#/$defs/DurableAnswer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "answers": {
            "items": {
              "$ref": "#/$defs/UserInputAnswer"
            },
            "title": "Answers",
            "type": "array"
          },
          "kind": {
            "const": "answer_user_input",
            "default": "answer_user_input",
            "title": "Kind",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "answers"
        ],
        "title": "AnswerUserInput",
        "type": "object"
      },
      "AskKind": {
        "enum": [
          "permission",
          "user_input"
        ],
        "title": "AskKind",
        "type": "string"
      },
      "AskReference": {
        "properties": {
          "ask_id": {
            "title": "Ask Id",
            "type": "string"
          },
          "child": {
            "$ref": "#/$defs/ChildReference"
          },
          "kind": {
            "$ref": "#/$defs/AskKind"
          },
          "turn": {
            "$ref": "#/$defs/TurnToken"
          }
        },
        "required": [
          "child",
          "turn",
          "ask_id",
          "kind"
        ],
        "title": "AskReference",
        "type": "object"
      },
      "CancelTurn": {
        "properties": {
          "kind": {
            "const": "cancel_running_turn",
            "default": "cancel_running_turn",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "CancelTurn",
        "type": "object"
      },
      "CanonicalSkillSnapshot": {
        "description": "The complete canonical skills and the minimum set this Worker needs.",
        "properties": {
          "required_skill_names": {
            "items": {
              "type": "string"
            },
            "title": "Required Skill Names",
            "type": "array"
          },
          "sources": {
            "items": {
              "$ref": "#/$defs/CanonicalSkillSource"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "sources",
          "required_skill_names"
        ],
        "title": "CanonicalSkillSnapshot",
        "type": "object"
      },
      "CanonicalSkillSource": {
        "description": "One authoritative database row, transported without text transformation.",
        "properties": {
          "skill_name": {
            "title": "Skill Name",
            "type": "string"
          },
          "source_text": {
            "title": "Source Text",
            "type": "string"
          }
        },
        "required": [
          "skill_name",
          "source_text"
        ],
        "title": "CanonicalSkillSource",
        "type": "object"
      },
      "ChildCommandArguments": {
        "discriminator": {
          "mapping": {
            "answer_permission_ask": "#/$defs/AnswerPermission",
            "answer_user_input": "#/$defs/AnswerUserInput",
            "cancel_running_turn": "#/$defs/CancelTurn",
            "start": "#/$defs/StartRun",
            "steer": "#/$defs/Steer",
            "stop": "#/$defs/StopRun",
            "write_prompt": "#/$defs/WritePrompt"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/StartRun"
          },
          {
            "$ref": "#/$defs/WritePrompt"
          },
          {
            "$ref": "#/$defs/Steer"
          },
          {
            "$ref": "#/$defs/CancelTurn"
          },
          {
            "$ref": "#/$defs/AnswerPermission"
          },
          {
            "$ref": "#/$defs/AnswerUserInput"
          },
          {
            "$ref": "#/$defs/StopRun"
          }
        ]
      },
      "ChildOperation": {
        "enum": [
          "start",
          "write_prompt",
          "steer",
          "cancel_running_turn",
          "answer_permission_ask",
          "answer_user_input",
          "stop"
        ],
        "title": "ChildOperation",
        "type": "string"
      },
      "ChildReference": {
        "description": "Child IDs are UUIDs minted at child creation, never vendor session IDs.",
        "properties": {
          "child_id": {
            "title": "Child Id",
            "type": "string"
          },
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "executor_incarnation": {
            "title": "Executor Incarnation",
            "type": "string"
          }
        },
        "required": [
          "executor_incarnation",
          "child_id",
          "conversation_id"
        ],
        "title": "ChildReference",
        "type": "object"
      },
      "ConversationAccess": {
        "description": "The access posture the agent runs under inside its workspace folder.\n\n``full`` is the floor default and today the only posture. The backend-specific mode\nids that implement full access belong to the conversation system's backend adapters\nand do not appear here. When a second posture is ruled it is added to this enum, and\nthe ``access`` field already on the start request is what carries it.",
        "enum": [
          "full"
        ],
        "title": "ConversationAccess",
        "type": "string"
      },
      "ConversationBackendKey": {
        "description": "The production catalog of agent backends a conversation can run on.\n\nThe catalog is a closed set rather than an open string because this contract states\na per-backend capability as a fact. All three adapters can admit guidance to work\nowned by a captured running turn. Each adapter proves that admission through its\nown provider protocol.",
        "enum": [
          "hermes",
          "codex",
          "claude"
        ],
        "title": "ConversationBackendKey",
        "type": "string"
      },
      "ConversationRoleMaterials": {
        "description": "What the agent is told to be, and the identity its process runs under.\n\n``role_text`` is the role the agent is given. ``identity_environment_variables`` are\nthe name/value pairs its process runs with. The conversation system applies both\nwithout understanding them: it does not read meaning out of the role text and it\ndoes not interpret the variables.",
        "properties": {
          "identity_environment_variables": {
            "default": [],
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "type": "array"
            },
            "title": "Identity Environment Variables",
            "type": "array"
          },
          "role_text": {
            "title": "Role Text",
            "type": "string"
          }
        },
        "required": [
          "role_text"
        ],
        "title": "ConversationRoleMaterials",
        "type": "object"
      },
      "DurableAnswer": {
        "properties": {
          "accepted_at_vps_ms": {
            "title": "Accepted At Vps Ms",
            "type": "integer"
          },
          "answer_id": {
            "title": "Answer Id",
            "type": "string"
          },
          "ask": {
            "$ref": "#/$defs/AskReference"
          },
          "option_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Option Id"
          },
          "user_input_answers": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/UserInputAnswer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "User Input Answers"
          }
        },
        "required": [
          "answer_id",
          "ask",
          "option_id",
          "accepted_at_vps_ms"
        ],
        "title": "DurableAnswer",
        "type": "object"
      },
      "FileManifest": {
        "description": "Path is POSIX relative to its scope root, never an absolute host path.",
        "properties": {
          "byte_count": {
            "title": "Byte Count",
            "type": "integer"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          },
          "relative_path": {
            "title": "Relative Path",
            "type": "string"
          },
          "scope": {
            "$ref": "#/$defs/FileScope"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "scope",
          "owner_id",
          "relative_path",
          "sha256",
          "byte_count"
        ],
        "title": "FileManifest",
        "type": "object"
      },
      "FileScope": {
        "enum": [
          "ticket",
          "conversation"
        ],
        "title": "FileScope",
        "type": "string"
      },
      "MessageContent": {
        "items": {
          "$ref": "#/$defs/MessagePiece"
        },
        "type": "array"
      },
      "MessageFile": {
        "description": "A document or data file kept beside the conversation record.",
        "properties": {
          "byte_count": {
            "title": "Byte Count",
            "type": "integer"
          },
          "file_name": {
            "title": "File Name",
            "type": "string"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "stored_file_id": {
            "title": "Stored File Id",
            "type": "string"
          }
        },
        "required": [
          "stored_file_id",
          "media_type",
          "file_name",
          "byte_count"
        ],
        "title": "MessageFile",
        "type": "object"
      },
      "MessageImage": {
        "description": "A picture that is part of the message.\n\n``stored_file_id`` names the file this system kept for it, under the conversation the\nmessage belongs to. ``file_name`` is what the picture was called when it arrived, kept\nfor reading and for downloading it again; a picture that arrived without a name has\nnone rather than an invented one.",
        "properties": {
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "File Name"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "stored_file_id": {
            "title": "Stored File Id",
            "type": "string"
          }
        },
        "required": [
          "stored_file_id",
          "media_type"
        ],
        "title": "MessageImage",
        "type": "object"
      },
      "MessagePiece": {
        "anyOf": [
          {
            "$ref": "#/$defs/MessageText"
          },
          {
            "$ref": "#/$defs/MessageImage"
          },
          {
            "$ref": "#/$defs/MessageFile"
          }
        ]
      },
      "MessageText": {
        "description": "Written words. Markdown, as the sender wrote it or the backend finished it.",
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "MessageText",
        "type": "object"
      },
      "PromptDeliveryMode": {
        "description": "How a sent message should meet the agent. One parameter, three values.\n\n``queue`` is the default. If the agent is idle the message starts a turn\nstraight away. If the agent is busy the message is held, and it runs when the agent\nfrees up.\n\n``send_now`` makes this message the running turn. If the agent is idle it behaves\nexactly like the default. If the agent is busy the incumbent turn is killed \u2014 its\ninterruption is recorded as an event \u2014 and this message runs next, ahead of anything\nalready held. If its own delivery then turns out to be impossible, the incumbent is\ndead all the same and the agent is free, so the messages that were already held run\nfrom that point.\n\n``steer`` injects text into a running turn without ending it. It starts a turn when\nthe agent is idle. Attachments, run changes, and confirmed admission refusals enter\nthe queue. An uncertain admission never enters the queue because the backend may\nalready hold the message.",
        "enum": [
          "queue",
          "send_now",
          "steer"
        ],
        "title": "PromptDeliveryMode",
        "type": "string"
      },
      "ResolvedConversationStart": {
        "description": "A start request with the floor defaults already applied.\n\nThis is what a conversation is actually started with, and what every backend adapter\nis handed. ``backend_key``, ``workspace_folder`` and ``access`` are always concrete\nhere because each has a floor default; ``model`` is always concrete because the\nrequest had to name one. ``reasoning_effort`` and ``role_materials`` stay optional\nbecause neither has a floor default \u2014 there is nothing to fall back to, so absent\nstays absent. For executor_default, native admission must replace the folder\ninside the executor workspace and the policy before a local backend adapter can\nuse this request.",
        "properties": {
          "access": {
            "$ref": "#/$defs/ConversationAccess"
          },
          "backend_key": {
            "$ref": "#/$defs/ConversationBackendKey"
          },
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "reasoning_effort": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoning Effort"
          },
          "role_materials": {
            "anyOf": [
              {
                "$ref": "#/$defs/ConversationRoleMaterials"
              },
              {
                "type": "null"
              }
            ]
          },
          "workspace_folder": {
            "format": "path",
            "title": "Workspace Folder",
            "type": "string"
          },
          "workspace_path_policy": {
            "$ref": "#/$defs/WorkspacePathPolicy",
            "default": "home_relative"
          }
        },
        "required": [
          "conversation_id",
          "backend_key",
          "model",
          "reasoning_effort",
          "role_materials",
          "workspace_folder",
          "access"
        ],
        "title": "ResolvedConversationStart",
        "type": "object"
      },
      "StartRun": {
        "properties": {
          "canonical_skill_snapshot": {
            "$ref": "#/$defs/CanonicalSkillSnapshot"
          },
          "kind": {
            "const": "start",
            "default": "start",
            "title": "Kind",
            "type": "string"
          },
          "resolved_start": {
            "$ref": "#/$defs/ResolvedConversationStart"
          },
          "vendor_session_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Vendor Session Cursor"
          },
          "workspace_home_relative": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Workspace Home Relative"
          }
        },
        "required": [
          "resolved_start",
          "canonical_skill_snapshot"
        ],
        "title": "StartRun",
        "type": "object"
      },
      "Steer": {
        "properties": {
          "content": {
            "$ref": "#/$defs/MessageContent"
          },
          "kind": {
            "const": "steer",
            "default": "steer",
            "title": "Kind",
            "type": "string"
          },
          "sender_content": {
            "anyOf": [
              {
                "$ref": "#/$defs/MessageContent"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "sender_label": {
            "title": "Sender Label",
            "type": "string"
          }
        },
        "required": [
          "content",
          "sender_label"
        ],
        "title": "Steer",
        "type": "object"
      },
      "StopRun": {
        "properties": {
          "kind": {
            "const": "stop",
            "default": "stop",
            "title": "Kind",
            "type": "string"
          }
        },
        "title": "StopRun",
        "type": "object"
      },
      "TurnToken": {
        "description": "The core's name for one started turn.\n\nThe core reserves its number durably before provider I/O. Numbers never repeat\nafter restart, and historical identities never restore a process or callback.\nThe core hands it to the adapter with the prompt that starts the turn, and\nthe adapter puts it on everything it later reports about that turn. It is what lets\nthe core tell this turn's news from the news of a turn that has already been ended and\nreplaced. A cancelled turn's late-arriving live and operational events are dropped.\nFinished backend prose is runtime-only, including when it arrives after the ending.",
        "properties": {
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "turn_number": {
            "title": "Turn Number",
            "type": "integer"
          }
        },
        "required": [
          "conversation_id",
          "turn_number"
        ],
        "title": "TurnToken",
        "type": "object"
      },
      "UserInputAnswer": {
        "description": "Every selected or typed answer for one question.",
        "properties": {
          "answers": {
            "items": {
              "type": "string"
            },
            "title": "Answers",
            "type": "array"
          },
          "question_id": {
            "title": "Question Id",
            "type": "string"
          }
        },
        "required": [
          "question_id",
          "answers"
        ],
        "title": "UserInputAnswer",
        "type": "object"
      },
      "WorkspacePathPolicy": {
        "description": "Select a mapped path, an absolute path, or the executor-owned workspace.\n\nFor executor_default, workspace_folder names a folder inside the executor's own\nworkspace, written with that workspace as ``/``. Only native admission resolves and\nprovisions it.",
        "enum": [
          "home_relative",
          "absolute",
          "executor_default"
        ],
        "title": "WorkspacePathPolicy",
        "type": "string"
      },
      "WritePrompt": {
        "properties": {
          "automatic_compaction": {
            "default": false,
            "title": "Automatic Compaction",
            "type": "boolean"
          },
          "content": {
            "$ref": "#/$defs/MessageContent"
          },
          "kind": {
            "const": "write_prompt",
            "default": "write_prompt",
            "title": "Kind",
            "type": "string"
          },
          "mode": {
            "$ref": "#/$defs/PromptDeliveryMode"
          },
          "model_change": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model Change"
          },
          "reasoning_effort_change": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reasoning Effort Change"
          },
          "reasoning_effort_is_set": {
            "default": false,
            "title": "Reasoning Effort Is Set",
            "type": "boolean"
          },
          "sender_content": {
            "$ref": "#/$defs/MessageContent"
          },
          "sender_label": {
            "title": "Sender Label",
            "type": "string"
          },
          "sender_message_count": {
            "default": 1,
            "title": "Sender Message Count",
            "type": "integer"
          }
        },
        "required": [
          "content",
          "sender_content",
          "sender_label",
          "mode"
        ],
        "title": "WritePrompt",
        "type": "object"
      }
    },
    "properties": {
      "arguments": {
        "$ref": "#/$defs/ChildCommandArguments"
      },
      "child": {
        "$ref": "#/$defs/ChildReference"
      },
      "command_id": {
        "title": "Command Id",
        "type": "string"
      },
      "file_dependencies": {
        "default": [],
        "items": {
          "$ref": "#/$defs/FileManifest"
        },
        "title": "File Dependencies",
        "type": "array"
      },
      "operation": {
        "$ref": "#/$defs/ChildOperation"
      },
      "turn": {
        "anyOf": [
          {
            "$ref": "#/$defs/TurnToken"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "command_id",
      "child",
      "operation",
      "turn",
      "arguments"
    ],
    "title": "ChildCommand",
    "type": "object"
  },
  "protocol_version": 20,
  "source_revision": "83f924010b4815aa443c2c2e05647c734c80401c"
}
