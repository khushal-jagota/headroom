          "kind": "owner",
          "id": "owner"
        }
      },
      "capture": {
        "ticket": "id"
      }
    },
    {
      "method": "POST",
      "path": "/api/tickets/${ticket}/conversation/send",
      "status": 200,
      "json": {
        "content": [
          {
            "piece": "text",
            "text": "Seed ticket notification facts"
          }
        ],
        "sender_label": "Owner",
        "sender_message_id": "unit10-seed-ticket"
      },
      "capture": {
        "ticket_conversation": "conversation_id"
      }
    },
    {
      "method": "POST",
      "path": "/api/test/signals/${ticket_conversation}/message",
      "status": 200,
      "json": {
