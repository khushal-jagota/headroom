[Unit]
Description=Panels TypeScript environment
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile={{ENVIRONMENT_FILE}}
RuntimeDirectory={{RUNTIME_DIRECTORY}}
RuntimeDirectoryMode=0700
ExecStart={{EXEC_START}}
ExecStop={{EXEC_STOP}}
TimeoutStopSec={{TIMEOUT_STOP}}
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
OOMPolicy=continue
OOMScoreAdjust=-500
MemoryAccounting=yes
MemoryLow=1G
CPUWeight=100

[Install]
WantedBy=default.target
