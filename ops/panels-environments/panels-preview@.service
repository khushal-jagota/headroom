[Unit]
Description=Panels preview environment %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=panels-worker
WorkingDirectory=/opt/panels/previews/%i
EnvironmentFile=/etc/panels/environments/previews/%i.env
ExecStart=/usr/bin/env panels environment run --kind preview --instance-id %i --environment-root /var/lib/panels/environments --repository-root /opt/panels/previews/%i
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/panels/environments /opt/panels/previews/%i
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
