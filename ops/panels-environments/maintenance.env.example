# Operator-owned paths for the host-local status and maintenance commands.
# Copy this file outside Git, then set all three values to the live environment's
# absolute paths.  The maintenance unit loads this file directly.
PLAN_DB_PATH=/var/lib/panels/environments/live/state/planning.db
PLAN_LOGS_DIR=/var/log/panels
PLAN_BACKUP_DIR=/var/lib/panels/environments/live/backups
