[Unit]
Description=Panels SQLite database backup
After=panels-live.service

[Service]
Type=oneshot
User=panels-live
EnvironmentFile=/etc/panels/environments/backup.env
ExecStart=/opt/panels/environment-manager/.venv/bin/python -m planner environment backup-current --source-db ${PANELS_BACKUP_SOURCE_DB} --backup-dir ${PANELS_BACKUP_DIRECTORY} --current-release ${PANELS_CURRENT_RELEASE}
NoNewPrivileges=yes
