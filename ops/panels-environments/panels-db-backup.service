[Unit]
Description=Panels SQLite database backup
After=panels-live.service

[Service]
Type=oneshot
User=panels-live
EnvironmentFile=/etc/panels/environments/backup.env
ExecStart=/opt/panels/current/app/bin/panels-launcher environment backup-current --source-db ${PANELS_BACKUP_SOURCE_DB} --backup-dir ${PANELS_BACKUP_DIRECTORY} --current-app ${PANELS_CURRENT_APP}
NoNewPrivileges=yes
