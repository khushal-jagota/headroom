# Render/install input only. The final VPS install applies these paths.
d /var/lib/panels/environments/live 0750 panels-live panels-live -
d /var/lib/panels/environments/staging 0750 panels-worker panels-worker -
d /opt/panels/releases 0750 root root -
d /opt/panels/current 0750 root root -
d /opt/panels/staging 0750 panels-worker panels-worker -
d /opt/panels/environment-manager 0755 root root -
d /etc/panels/environments 0755 root root -
z /etc/panels/environments/live.env 0640 panels-live panels-live -
z /etc/panels/environments/staging.env 0640 panels-worker panels-worker -
