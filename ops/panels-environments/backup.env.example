# Operator-owned nightly backup inputs. Copy outside Git and set paths
# for the host where Panels is deployed.
PANELS_BACKUP_SOURCE_DB=
PANELS_BACKUP_DIRECTORY=
PANELS_CURRENT_RELEASE=
PANELS_ENVIRONMENT_MANAGER_PYTHON=
# Only if the live service sets PLAN_HERMES_HOME: set the same value here so the
# backup captures the skills home the server actually uses. Leave blank otherwise
# (the skills home is then read from hermes-home beside the database).
PLAN_HERMES_HOME=
